---
/**
 * ViewmaxxingHero — bespoke hero for Viewmaxxing (/viewmaxxing).
 *
 * "One Remote": a living-room TV self-surfs through the real app's surfaces
 * (Home, Anime, Movies, TV, YouTube ad-free, Search, live Twitch+chat) with a
 * fluid directional slide, while a floating remote gives a crisp right-arrow
 * press on each hop. Every frame is a REAL screenshot captured from the app.
 *
 * Its OWN background (not the cosmic aurora used on OM/DM): AMBILIGHT — the
 * colored bias-light a TV spills onto the wall, which MORPHS to match the
 * on-screen surface (emerald→violet→blue→teal→coral→cyan→twitch-purple). It is
 * literally "One app. Every mood." Colours are driven by @property custom props
 * so they interpolate smoothly; the JS sets them per surface.
 */
import type { Product } from '../data/products';
type Props = { product: Product };
const { product } = Astro.props;
const primary = product.primaryCta;
const stat = product.stats ?? [];
const heroVal = product.heroStat?.value ?? '5';
const [statTop, statBot] = (product.heroStat?.label ?? 'apps in one · $0 forever').split(' · ');

// Order matches the app's own left-to-right nav so the tab highlight walks in
// sequence as the remote presses right. g1/g2 = the Ambilight mood colours.
const shots = [
  { src: '/screenshots/viewmaxxing/home.webp',   alt: 'Viewmaxxing home screen',         cap: 'Home &middot; <b>picks up where you left off</b>', g1: '#10b981', g2: '#34e6a8' },
  { src: '/screenshots/viewmaxxing/anime.webp',  alt: 'Viewmaxxing anime catalog',        cap: 'Anime &middot; <b>sub or dub, real art</b>',       g1: '#8b5cf6', g2: '#c084fc' },
  { src: '/screenshots/viewmaxxing/movies.webp', alt: 'Viewmaxxing movies catalog',       cap: 'Movies &middot; <b>thousands, one tap</b>',        g1: '#3b6ef6', g2: '#6366f1' },
  { src: '/screenshots/viewmaxxing/tv.webp',     alt: 'Viewmaxxing TV catalog',           cap: 'TV shows &middot; <b>continue watching</b>',       g1: '#14b8a6', g2: '#2dd4bf' },
  { src: '/screenshots/viewmaxxing/youtube.webp',alt: 'Viewmaxxing ad-free YouTube',      cap: 'YouTube &middot; <b>native, zero ads</b>',         g1: '#f43f5e', g2: '#fb7185' },
  { src: '/screenshots/viewmaxxing/snowfall-search.webp', alt: 'Viewmaxxing search results', cap: 'One search &middot; <b>every app at once</b>',   g1: '#06b6d4', g2: '#22d3ee' },
  { src: '/screenshots/viewmaxxing/twitch.webp', alt: 'Viewmaxxing live Twitch with chat', cap: 'Twitch &middot; <b>live, with chat, zero ads</b>', g1: '#9146ff', g2: '#b07bff' },
];
---

<section class="viewmaxxing-tv" aria-label={`${product.name} hero`}>
  <!-- Ambilight bias-light: colored wall glow that morphs with the on-screen surface -->
  <div class="vm-bias" aria-hidden="true"><span class="g-top"></span><span class="g-left"></span><span class="g-right"></span><span class="g-floor"></span></div>

  <div class="vm-hero">
    <a href="/#apps" class="vm-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>

    <div class="vm-grid">
      <!-- LEFT: the TV, running the real app -->
      <div class="vm-stage" id="vm-stage">
        <div class="vm-room" aria-hidden="true"></div>

        <div class="vm-tv">
          <div class="vm-bezel">
            <div class="vm-screen">
              {shots.map((s, i) => (
                <img class:list={["vm-shot", { on: i === 0 }]} data-shot data-cap={s.cap} data-g1={s.g1} data-g2={s.g2}
                  src={s.src} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              ))}
              <div class="vm-glare" aria-hidden="true"></div>
              <div class="vm-cap" id="vm-cap" aria-hidden="true"><i></i><span set:html={shots[0].cap}></span></div>
            </div>
          </div>
          <div class="vm-stand" aria-hidden="true"></div>
          <div class="vm-foot" aria-hidden="true"></div>
        </div>

        <!-- the one remote -->
        <div class="vm-remote" id="vm-remote" aria-hidden="true">
          <div class="vm-pwr"></div>
          <div class="vm-dpad" id="vm-dpad">
            <div class="ring"></div>
            <span class="vm-arrow up"><svg viewBox="0 0 24 24"><path d="M12 4l7 8H5z"/></svg></span>
            <span class="vm-arrow down"><svg viewBox="0 0 24 24"><path d="M12 4l7 8H5z"/></svg></span>
            <span class="vm-arrow left" id="vm-al"><svg viewBox="0 0 24 24"><path d="M12 4l7 8H5z"/></svg></span>
            <span class="vm-arrow right" id="vm-ar"><svg viewBox="0 0 24 24"><path d="M12 4l7 8H5z"/></svg></span>
            <div class="vm-ok" id="vm-ok"></div>
          </div>
          <div class="vm-btns"><span></span><span></span></div>
        </div>
      </div>

      <!-- RIGHT: copy -->
      <div class="vm-copy">
        <p class="vm-eyebrow"><span class="vm-edot" aria-hidden="true"></span>Five surfaces &middot; one remote</p>
        <div class="vm-num"><b class="gradient-view">{heroVal}</b><small>{statTop}<br>{statBot}</small></div>
        <h1 class="vm-h1"><span>One app.</span><br><span class="vm-h1-accent">Every mood.</span></h1>
        <p class="vm-sub"><b>5 apps, 1 remote.</b> Ad-free YouTube, movies, anime &amp; <b>live</b> Twitch &mdash;
          running local on your box. <b class="vm-hl">No ads. No login. $0 forever.</b></p>
        <div class="vm-cta">
          <a class="vm-btn" href={primary.href} target={primary.external ? '_blank' : undefined} rel={primary.external ? 'noopener' : undefined}>
            {primary.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        {stat.length > 0 && (
          <div class="vm-specs">
            {stat.slice(0, 3).map((s) => (
              <div class="vm-spec"><div class="sv gradient-view">{s.value}</div><div class="sk">{s.label}</div></div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* smoothly-interpolating Ambilight colours */
  @property --vm-glow  { syntax: '<color>'; inherits: true; initial-value: #10b981; }
  @property --vm-glow2 { syntax: '<color>'; inherits: true; initial-value: #34e6a8; }

  .viewmaxxing-tv{
    --em:#10b981; --em2:#34e6a8; --em3:#0b7a5b;
    --vm-glow:#10b981; --vm-glow2:#34e6a8;
    --vm-bg:#070510; --vm-line:#221a3d; --vm-text:#f3fbf7; --vm-mid:#c7d8d0; --vm-muted:#8a93a6;
    position:relative; overflow:hidden; isolation:isolate; border-bottom:1px solid var(--vm-line);
    transition:--vm-glow 1.1s ease, --vm-glow2 1.1s ease;
    background:
      radial-gradient(85% 65% at 34% 12%, color-mix(in oklab,var(--vm-glow) 8%,transparent), transparent 60%),
      var(--vm-bg);
  }

  /* ---------- AMBILIGHT: colored bias-light spilling from behind the TV ---------- */
  .viewmaxxing-tv .vm-bias{ position:absolute; inset:0; z-index:0; overflow:hidden; pointer-events:none; }
  .viewmaxxing-tv .vm-bias span{ position:absolute; display:block; filter:blur(66px); mix-blend-mode:screen; will-change:opacity,transform; }
  .viewmaxxing-tv .vm-bias .g-top{ left:34%; top:-4%; width:46%; height:44%; transform:translateX(-50%);
    background:radial-gradient(closest-side, color-mix(in oklab,var(--vm-glow) 62%,transparent), transparent 72%); opacity:.8; animation:vm-breathe 7.5s ease-in-out infinite; }
  .viewmaxxing-tv .vm-bias .g-left{ left:0%; top:28%; width:34%; height:52%;
    background:radial-gradient(closest-side, color-mix(in oklab,var(--vm-glow2) 55%,transparent), transparent 72%); opacity:.72; animation:vm-breathe 9s ease-in-out infinite .7s; }
  .viewmaxxing-tv .vm-bias .g-right{ left:40%; top:18%; width:48%; height:58%;
    background:radial-gradient(closest-side, color-mix(in oklab,var(--vm-glow) 50%,transparent), transparent 74%); opacity:.66; animation:vm-breathe 8.2s ease-in-out infinite 1.2s; }
  .viewmaxxing-tv .vm-bias .g-floor{ left:32%; bottom:-6%; width:58%; height:34%; transform:translateX(-50%);
    background:radial-gradient(closest-side, color-mix(in oklab,var(--vm-glow2) 46%,transparent), transparent 74%); opacity:.7; animation:vm-breathe 10s ease-in-out infinite .3s; }
  @keyframes vm-breathe{ 0%,100%{opacity:.62} 50%{opacity:.92} }
  /* gentle vignette to seat the TV over the glow */
  .viewmaxxing-tv::after{ content:''; position:absolute; inset:0; z-index:1; pointer-events:none;
    background:radial-gradient(125% 100% at 50% 42%, transparent 52%, rgba(3,2,9,.6)); }

  .viewmaxxing-tv .vm-hero{ position:relative; z-index:2; max-width:1200px; margin:0 auto; padding:clamp(84px,10vh,120px) clamp(20px,4vw,40px) clamp(44px,7vh,72px); }
  .viewmaxxing-tv .vm-back{ display:inline-flex; align-items:center; gap:6px; margin-bottom:22px; font-family:var(--font-mono); font-size:12.5px; color:var(--vm-muted); text-decoration:none; transition:color .2s; }
  .viewmaxxing-tv .vm-back:hover{ color:var(--vm-mid); }
  .viewmaxxing-tv .vm-grid{ display:grid; grid-template-columns:1.28fr 1fr; align-items:center; gap:24px; }

  /* ---------- STAGE: the TV ---------- */
  .viewmaxxing-tv .vm-stage{ position:relative; justify-self:center; width:min(660px,100%); height:620px; }
  .viewmaxxing-tv .vm-room{ position:absolute; left:50%; bottom:34px; width:150%; height:240px; transform:translateX(-50%);
    background:radial-gradient(60% 100% at 50% 0%, color-mix(in oklab,var(--vm-glow) 30%,transparent), transparent 70%); filter:blur(8px); opacity:.7; }
  .viewmaxxing-tv .vm-tv{ position:absolute; left:50%; top:34px; transform:translateX(-50%); width:min(600px,100%); }
  .viewmaxxing-tv .vm-bezel{ position:relative; border-radius:22px; padding:14px; background:linear-gradient(160deg,#17132b,#0b0817);
    border:1px solid #2a2350; box-shadow:0 44px 100px rgba(0,0,0,.62), 0 0 0 1px rgba(255,255,255,.02) inset, 0 0 80px color-mix(in oklab,var(--vm-glow) 26%,transparent); transition:box-shadow 1.1s ease; }
  .viewmaxxing-tv .vm-screen{ position:relative; aspect-ratio:16/9; border-radius:12px; overflow:hidden; background:#05040c; box-shadow:0 0 0 1px rgba(255,255,255,.05) inset; }
  /* fluid directional SLIDE: new surface glides in from the right, old eases out left */
  .viewmaxxing-tv .vm-shot{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top center; opacity:0; z-index:1; }
  .viewmaxxing-tv .vm-shot.on{ opacity:1; z-index:2; animation:vm-slidein .62s cubic-bezier(.22,.61,.36,1) both; }
  .viewmaxxing-tv .vm-shot.out{ z-index:1; animation:vm-slideout .62s cubic-bezier(.4,0,.2,1) both; }
  @keyframes vm-slidein{ 0%{opacity:0; transform:translateX(9%) scale(1.015)} 60%{opacity:1} 100%{opacity:1; transform:translateX(0) scale(1)} }
  @keyframes vm-slideout{ 0%{opacity:1; transform:translateX(0)} 100%{opacity:0; transform:translateX(-7%)} }
  .viewmaxxing-tv .vm-glare{ position:absolute; inset:0; z-index:3; pointer-events:none;
    background:linear-gradient(135deg, rgba(255,255,255,.10), transparent 34%), radial-gradient(120% 80% at 50% -10%, rgba(255,255,255,.06), transparent 55%); }
  .viewmaxxing-tv .vm-glare::after{ content:''; position:absolute; inset:0; opacity:.12; background:repeating-linear-gradient(0deg, rgba(0,0,0,.5) 0 1px, transparent 1px 3px); }
  .viewmaxxing-tv .vm-cap{ position:absolute; left:11px; bottom:11px; z-index:4; display:inline-flex; align-items:center; gap:7px;
    font-family:var(--font-mono); font-size:11px; letter-spacing:.03em; color:var(--vm-text); padding:6px 11px; border-radius:999px;
    background:rgba(5,4,12,.72); border:1px solid color-mix(in oklab,var(--vm-glow) 45%,transparent); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
    box-shadow:0 6px 18px rgba(0,0,0,.4); max-width:calc(100% - 22px); transition:opacity .35s ease, border-color 1.1s ease; }
  .viewmaxxing-tv .vm-cap b{ color:color-mix(in oklab,var(--vm-glow2) 70%, #ffffff); font-weight:700; }
  .viewmaxxing-tv .vm-cap i{ width:6px; height:6px; border-radius:50%; background:var(--vm-glow); box-shadow:0 0 8px var(--vm-glow); flex:none; font-style:normal; transition:background 1.1s ease, box-shadow 1.1s ease; }
  .viewmaxxing-tv .vm-stand{ position:absolute; left:50%; top:calc(34px + 100%); transform:translateX(-50%); width:140px; height:22px; margin-top:-2px;
    background:linear-gradient(180deg,#1a1533,#0c0a1c); border:1px solid #2a2350; border-radius:0 0 7px 7px; }
  .viewmaxxing-tv .vm-foot{ position:absolute; left:50%; top:calc(34px + 100% + 18px); transform:translateX(-50%); width:250px; height:9px;
    background:linear-gradient(180deg,#151030,#0a0818); border-radius:8px; box-shadow:0 10px 30px rgba(0,0,0,.5); }

  /* ---------- REMOTE (crisp directional press) ---------- */
  .viewmaxxing-tv .vm-remote{ position:absolute; right:-2px; bottom:20px; width:86px; height:204px; z-index:8; border-radius:44px;
    background:linear-gradient(160deg,#1a1636,#0c0a1e); border:1px solid #2c2452; box-shadow:0 26px 54px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.03) inset;
    transform:rotate(9deg); padding:16px 0; }
  .viewmaxxing-tv .vm-pwr{ width:9px; height:9px; border-radius:50%; margin:0 auto 14px; background:var(--vm-glow); box-shadow:0 0 10px var(--vm-glow); animation:vm-blink 2.4s ease-in-out infinite; transition:background 1.1s ease; }
  @keyframes vm-blink{ 0%,100%{opacity:1} 50%{opacity:.32} }
  .viewmaxxing-tv .vm-dpad{ position:relative; width:62px; height:62px; margin:0 auto; }
  .viewmaxxing-tv .vm-dpad .ring{ position:absolute; inset:0; border-radius:50%; border:1px solid #ffffff14; background:#0a0818; transition:border-color .18s ease, box-shadow .18s ease; }
  .viewmaxxing-tv .vm-dpad.tap .ring{ border-color:color-mix(in oklab,var(--vm-glow) 60%,transparent); box-shadow:inset -8px 0 16px color-mix(in oklab,var(--vm-glow) 40%,transparent), 0 0 12px color-mix(in oklab,var(--vm-glow) 26%,transparent); }
  .viewmaxxing-tv .vm-ok{ position:absolute; inset:19px; border-radius:50%; background:linear-gradient(160deg,#241d47,#140f2c); border:1px solid #ffffff18; }
  .viewmaxxing-tv .vm-arrow{ position:absolute; width:11px; height:11px; color:#5a5378; transition:color .16s ease, filter .16s ease, transform .16s ease; }
  .viewmaxxing-tv .vm-arrow svg{ width:100%; height:100%; fill:currentColor; }
  .viewmaxxing-tv .vm-arrow.up{ top:4px; left:50%; transform:translateX(-50%); }
  .viewmaxxing-tv .vm-arrow.down{ bottom:4px; left:50%; transform:translateX(-50%) rotate(180deg); }
  .viewmaxxing-tv .vm-arrow.left{ left:4px; top:50%; transform:translateY(-50%) rotate(-90deg); }
  .viewmaxxing-tv .vm-arrow.right{ right:4px; top:50%; transform:translateY(-50%) rotate(90deg); }
  .viewmaxxing-tv .vm-arrow.flash{ color:#eafff6; filter:drop-shadow(0 0 10px var(--vm-glow)) drop-shadow(0 0 4px var(--vm-glow2)); }
  .viewmaxxing-tv .vm-arrow.right.flash{ transform:translateY(-50%) rotate(90deg) scale(1.5); }
  .viewmaxxing-tv .vm-btns{ display:flex; justify-content:center; gap:9px; margin-top:18px; }
  .viewmaxxing-tv .vm-btns span{ width:17px; height:17px; border-radius:5px; background:#0a0818; border:1px solid #ffffff12; }

  /* ---------- COPY ---------- */
  .viewmaxxing-tv .vm-copy{ position:relative; z-index:2; }
  .viewmaxxing-tv .vm-eyebrow{ display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--vm-muted); margin-bottom:16px; }
  .viewmaxxing-tv .vm-edot{ width:7px; height:7px; border-radius:50%; background:var(--vm-glow); box-shadow:0 0 10px var(--vm-glow); animation:vm-blink 2s ease-in-out infinite; transition:background 1.1s ease, box-shadow 1.1s ease; }
  .viewmaxxing-tv .vm-num{ display:flex; align-items:baseline; gap:16px; margin-bottom:6px; }
  .viewmaxxing-tv .vm-num b{ font-weight:800; font-size:clamp(74px,10.5vw,132px); line-height:.8; letter-spacing:-.02em; }
  .viewmaxxing-tv .vm-num small{ font-family:var(--font-mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--vm-muted); line-height:1.4; }
  .viewmaxxing-tv .vm-h1{ font-size:clamp(40px,5.4vw,68px); font-weight:900; letter-spacing:-.035em; line-height:.98; margin:10px 0 0; }
  .viewmaxxing-tv .vm-h1 span{ display:inline-block; background:linear-gradient(180deg,#ffffff,#dcf7ec); -webkit-background-clip:text; background-clip:text; color:transparent; text-shadow:0 2px 24px rgba(255,255,255,.06); }
  .viewmaxxing-tv .vm-h1 .vm-h1-accent{ background:linear-gradient(118deg,var(--em2),var(--em) 55%,#22c55e); -webkit-background-clip:text; background-clip:text; color:transparent;
    filter:drop-shadow(0 3px 20px color-mix(in oklab,var(--em) 48%,transparent)); }
  .viewmaxxing-tv .vm-sub{ margin-top:16px; font-size:17px; line-height:1.5; color:var(--vm-mid); max-width:30em; font-weight:500; }
  .viewmaxxing-tv .vm-sub b{ color:#eefaf3; font-weight:800; }
  .viewmaxxing-tv .vm-sub .vm-hl{ color:var(--em2); font-weight:800; text-shadow:0 0 16px color-mix(in oklab,var(--em) 45%,transparent); }
  .viewmaxxing-tv .vm-cta{ margin-top:30px; display:flex; gap:13px; align-items:center; flex-wrap:wrap; }
  .viewmaxxing-tv .vm-btn{ text-decoration:none; font-family:var(--font-mono); font-size:14px; font-weight:700; color:#04140d; padding:14px 22px; border-radius:12px;
    background:linear-gradient(120deg,var(--em2),var(--em) 60%,var(--em3)); display:inline-flex; align-items:center; gap:9px;
    box-shadow:0 8px 30px color-mix(in oklab,var(--em) 40%,transparent); transition:transform .18s, box-shadow .3s; border:none; }
  .viewmaxxing-tv .vm-btn:hover{ transform:translateY(-2px); box-shadow:0 12px 40px color-mix(in oklab,var(--em) 55%,transparent); }
  .viewmaxxing-tv .vm-btn svg{ width:14px; height:14px; fill:none; stroke:#04140d; stroke-width:2.5; }
  .viewmaxxing-tv .vm-specs{ margin-top:26px; display:flex; gap:22px; flex-wrap:wrap; }
  .viewmaxxing-tv .vm-spec .sv{ font-family:var(--font-mono); font-size:24px; font-weight:800; line-height:1; }
  .viewmaxxing-tv .vm-spec .sk{ font-family:var(--font-mono); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--vm-muted); margin-top:3px; }

  @media (max-width:940px){
    .viewmaxxing-tv .vm-grid{ grid-template-columns:1fr; gap:34px; }
    .viewmaxxing-tv .vm-stage{ height:560px; width:min(560px,100%); }
  }
  @media (max-width:520px){
    .viewmaxxing-tv .vm-stage{ height:470px; }
    .viewmaxxing-tv .vm-remote{ right:2px; bottom:14px; width:70px; height:166px; transform:rotate(9deg) scale(.92); }
    .viewmaxxing-tv .vm-cap{ font-size:9.5px; }
  }
  @media (prefers-reduced-motion:reduce){
    .viewmaxxing-tv .vm-pwr, .viewmaxxing-tv .vm-edot, .viewmaxxing-tv .vm-bias span{ animation:none; }
  }
</style>

<script>
  (function () {
    var stage = document.getElementById('vm-stage');
    var root = document.querySelector('.viewmaxxing-tv');
    if (!stage || !root) return;
    var shots = Array.prototype.slice.call(stage.querySelectorAll('[data-shot]'));
    if (shots.length < 2) return;
    var capEl = document.getElementById('vm-cap');
    var capText = capEl ? capEl.querySelector('span') : null;
    var ar = document.getElementById('vm-ar');
    var dpad = document.getElementById('vm-dpad');
    var i = 0;

    function applyGlow(el) {
      if (!el) return;
      root.style.setProperty('--vm-glow', el.getAttribute('data-g1') || '#10b981');
      root.style.setProperty('--vm-glow2', el.getAttribute('data-g2') || '#34e6a8');
    }
    applyGlow(shots[0]);

    function show(n) {
      var prev = i;
      i = n;
      // fluid directional slide
      shots[prev].classList.remove('on');
      shots[prev].classList.add('out');
      setTimeout(function () { shots[prev].classList.remove('out'); }, 640);
      shots[i].classList.add('on');
      // morph the Ambilight to the new surface's mood colour
      applyGlow(shots[i]);
      if (capEl && capText) {
        capEl.style.opacity = '0';
        setTimeout(function () { capText.innerHTML = shots[i].getAttribute('data-cap') || ''; capEl.style.opacity = '1'; }, 200);
      }
      // press the RIGHT arrow to advance (the real action; OK is select)
      if (ar) { ar.classList.add('flash'); setTimeout(function () { ar.classList.remove('flash'); }, 320); }
      if (dpad) { dpad.classList.add('tap'); setTimeout(function () { dpad.classList.remove('tap'); }, 300); }
    }

    var timer = null;
    function start() { if (!timer) timer = setInterval(function () { show((i + 1) % shots.length); }, 2600); }
    function stop() { clearInterval(timer); timer = null; }
    start();
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { e[0].isIntersecting ? start() : stop(); }, { threshold: 0.05 }).observe(stage);
    }
  })();
</script>
