---
/**
 * Coming-soon banner — replaces the diagonal "COMING SOON" tape.
 * Inspiration: Vercel deploy console + Apex/Riot "in lab" badges.
 * Reads as "this product is being built right now" — live build,
 * progress bar, drop window, waitlist counter.
 *
 * Per-product tuning controlled through props so each soon product
 * can show a different ETA and a different progress %.
 */

type Props = {
  productName: string;
  /** 0..100 — drives the bar fill. Tune per product. */
  progress?: number;
  /** Free-form drop window. e.g. "Q3 · 2026" or "JUL 2026". */
  dropTarget?: string;
  /** Faked-for-now waitlist count. Real wire-up when KV lands. */
  waitlistCount?: number;
  /** Build channel label (e.g. "v0.1 · INTERNAL", "BETA WAVE 1"). */
  channel?: string;
};

const {
  productName,
  progress = 62,
  dropTarget = 'Q3 · 2026',
  waitlistCount = 247,
  channel = 'v0.1 · INTERNAL',
} = Astro.props;

const safe = Math.min(100, Math.max(0, progress));
const fakeBuildLines = [
  `> ${productName.toLowerCase()}/build  passing`,
  `> typecheck                ok`,
  `> lint                     ok`,
  `> bench-suite              running…`,
];
---

<section class="build-status reveal-on-scroll" aria-label={`${productName} build status`}>
  <div class="build-status__inner">
    <!-- Top row — live dot + channel + waitlist counter -->
    <div class="build-status__topbar">
      <span class="build-status__live">
        <span class="build-status__dot" aria-hidden="true"></span>
        <span class="build-status__live-text">LIVE BUILD</span>
      </span>
      <span class="build-status__channel">{channel}</span>
      <span class="build-status__count">
        <strong class="font-display">{waitlistCount.toLocaleString()}</strong>
        <span>in line</span>
      </span>
    </div>

    <!-- Massive number — progress percent -->
    <div class="build-status__hero">
      <p class="build-status__pct font-display">{safe}<span class="build-status__pct-symbol">%</span></p>
      <p class="build-status__hero-label">build complete</p>
    </div>

    <!-- Progress bar — animated gradient fill -->
    <div class="build-status__bar" role="progressbar" aria-valuenow={safe} aria-valuemin="0" aria-valuemax="100">
      <div class="build-status__fill" style={`--pct: ${safe}%`}></div>
      <div class="build-status__shine" aria-hidden="true"></div>
    </div>

    <!-- Drop target -->
    <div class="build-status__drop">
      <span class="build-status__drop-eyebrow">DROP TARGET</span>
      <span class="build-status__drop-target font-display">{dropTarget}</span>
    </div>

    <!-- Fake build log — three lines of "ok / running" status -->
    <ul class="build-status__log" aria-hidden="true">
      {fakeBuildLines.map((line) => (
        <li class="build-status__log-line">{line}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .build-status {
    position: relative;
    margin-top: 16px;
    margin-bottom: 32px;
    border-radius: 22px;
    border: 1px solid var(--color-line-strong);
    background:
      radial-gradient(ellipse at 0% 0%, rgba(226, 91, 255, 0.10), transparent 60%),
      radial-gradient(ellipse at 100% 100%, rgba(0, 212, 255, 0.08), transparent 50%),
      linear-gradient(180deg, rgba(20, 12, 36, 0.92), rgba(10, 6, 18, 0.96));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 30px 60px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(226, 91, 255, 0.10);
    overflow: hidden;
  }
  .build-status::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    opacity: 0.6;
  }
  .build-status__inner {
    position: relative;
    padding: 22px 24px 26px;
  }

  /* Top bar */
  .build-status__topbar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .build-status__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(226, 91, 255, 0.14);
    border: 1px solid rgba(226, 91, 255, 0.45);
    color: #fbe7ff;
    font-weight: 600;
  }
  .build-status__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #ff5dff;
    box-shadow: 0 0 12px #ff5dff, 0 0 24px rgba(255, 93, 255, 0.6);
    animation: bs-pulse 1.6s ease-in-out infinite;
  }
  @keyframes bs-pulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%      { transform: scale(1.4); opacity: 0.6; }
  }
  .build-status__channel {
    color: var(--color-text-mid);
  }
  .build-status__count {
    margin-left: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--color-muted);
  }
  .build-status__count strong {
    color: var(--color-text);
    font-size: 20px;
    letter-spacing: 0.04em;
  }

  /* Hero number */
  .build-status__hero {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
  }
  .build-status__pct {
    font-size: clamp(72px, 14vw, 156px);
    line-height: 0.85;
    letter-spacing: 0;
    background: linear-gradient(135deg, #ff86ff 0%, #e25bff 35%, #4c51f7 70%, #00d4ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 60px rgba(226, 91, 255, 0.3);
  }
  .build-status__pct-symbol {
    font-size: 0.5em;
    margin-left: 6px;
    opacity: 0.7;
  }
  .build-status__hero-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Progress bar */
  .build-status__bar {
    position: relative;
    margin-top: 22px;
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .build-status__fill {
    height: 100%;
    width: var(--pct, 0%);
    background: linear-gradient(90deg, #ff5dff 0%, #e25bff 35%, #7d51f7 60%, #00d4ff 100%);
    border-radius: 999px;
    box-shadow: 0 0 18px rgba(226, 91, 255, 0.6);
    animation: bs-fill 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes bs-fill {
    from { width: 0%; }
  }
  .build-status__shine {
    position: absolute;
    top: 0; left: -30%;
    height: 100%; width: 30%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    animation: bs-shine 3.6s ease-in-out infinite;
  }
  @keyframes bs-shine {
    0%   { left: -30%; }
    50%  { left: 100%; }
    100% { left: 100%; }
  }

  /* Drop target */
  .build-status__drop {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .build-status__drop-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }
  .build-status__drop-target {
    font-size: clamp(28px, 5vw, 44px);
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  /* Fake build log */
  .build-status__log {
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-muted);
    list-style: none;
  }
  .build-status__log-line + .build-status__log-line { margin-top: 4px; }
  .build-status__log-line {
    opacity: 0;
    animation: bs-log-in 400ms ease-out forwards;
  }
  .build-status__log-line:nth-child(1) { animation-delay: 200ms; }
  .build-status__log-line:nth-child(2) { animation-delay: 400ms; }
  .build-status__log-line:nth-child(3) { animation-delay: 600ms; }
  .build-status__log-line:nth-child(4) { animation-delay: 800ms; }
  @keyframes bs-log-in {
    from { opacity: 0; transform: translateX(-4px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  .build-status__log-line:last-child {
    color: var(--color-text-mid);
  }

  @media (prefers-reduced-motion: reduce) {
    .build-status__dot,
    .build-status__shine,
    .build-status__fill,
    .build-status__log-line { animation: none !important; }
    .build-status__log-line { opacity: 1; }
  }
</style>
