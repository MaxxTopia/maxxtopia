</style>

<script>
  type SkillKey = 'flick' | 'track' | 'switch';
  type Routine = { name: string; code: string; focus: string };

  const gameNames = {
    fortnite: 'Fortnite', valorant: 'Valorant', cs2: 'CS2',
    apex: 'Apex Legends', overwatch: 'Overwatch 2', cod: 'Call of Duty',
  } as const;

  const weaknessRoutines: Record<SkillKey, Record<string, Routine>> = {
    flick: {
      default: { name: "('C_C) · Lite", code: 'KovaaKsParachutingFarIdentity', focus: 'isolates static and dynamic clicking' },
      fortnite: { name: 'FN Shotty Routine', code: 'KovaaKsRevolvingScaredReset', focus: 'isolates shotgun flicks and micro-dashes' },
      valorant: { name: 'Shah · RADIANT Warm Up', code: 'KovaaKsBuyingStaticInitiator', focus: 'isolates one-taps and micro-adjustments' },
      cs2: { name: 'm0narcS · TacFPS Euphoria', code: 'KovaaKsBouncingFedSuper', focus: 'isolates static precision and wide-peek flicks' },
    },
    track: {
      default: { name: 'Shah · Microtech 2026', code: 'KovaaKsRevolvingGoodFlashbang', focus: 'isolates micro-tracking precision' },
      apex: { name: 'higheuphoria · air', code: 'KovaaKsBloomingFastPerk', focus: 'isolates long and mid-air tracking' },
      overwatch: { name: 'higheuphoria · control', code: 'KovaaKsBlinkingFastAce', focus: 'isolates close hitscan control' },
    },
    switch: {
      default: { name: 'm0narcS · Switching Fundamentals', code: 'KovaaKsLosingCornflowerGod', focus: 'isolates target-switch speed and confirmation' },
    },
  };

  document.querySelectorAll<HTMLElement>('[data-aim-diagnostic]').forEach((root) => {
    const keys: SkillKey[] = ['flick', 'track', 'switch'];
    const arena = root.querySelector<HTMLElement>('[data-aim-arena]')!;
    const targets = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-aim-target]'));
    const startButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-aim-start],[data-aim-replay]'));
    const exitButton = root.querySelector<HTMLButtonElement>('[data-aim-exit]')!;
    const game = root.querySelector<HTMLSelectElement>('[data-aim-game]')!;
    const phaseEl = root.querySelector<HTMLElement>('[data-aim-phase]')!;
    const timeEl = root.querySelector<HTMLElement>('[data-aim-time]')!;
    const instruction = root.querySelector<HTMLElement>('[data-aim-instruction]')!;
    const status = root.querySelector<HTMLElement>('[data-aim-status]')!;
    const resultTitle = root.querySelector<HTMLElement>('[data-aim-result-title]')!;
    const resultCopy = root.querySelector<HTMLElement>('[data-aim-result-copy]')!;
    const inputNote = root.querySelector<HTMLElement>('[data-aim-input-note]')!;
    const codeEl = root.querySelector<HTMLElement>('[data-aim-code]')!;
    const copyButton = root.querySelector<HTMLButtonElement>('[data-aim-copy]')!;
    const scoreEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-score="${k}"]`)!])) as Record<SkillKey, HTMLElement>;
    const fillEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-fill="${k}"]`)!])) as Record<SkillKey, HTMLElement>;
    const detailEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-detail="${k}"]`)!])) as Record<SkillKey, HTMLElement>;

    const hardened = { flickSize: 48, trackSize: 44, switchSize: 46 } as const;
    const switchLayouts = [
      { a: [23, 31], b: [77, 69] },
      { a: [68, 28], b: [34, 72] },
      { a: [27, 68], b: [74, 35] },
      { a: [58, 25], b: [39, 76] },
    ] as const;
    let frame = 0, started = 0, phaseStarted = 0, lastSpawn = 0, lastFrame = 0, active = 'a';
    let switchStep = 0;
    let pointerX = -999, pointerY = -999;
    let flickMisses = 0, switchMisses = 0;
    let trackTotalMs = 0, trackInsideMs = 0, trackErrorPxMs = 0, trackClosenessMs = 0;
    let flickTimes: number[] = [], switchTimes: number[] = [];
    let immersive = false, previousFocus: HTMLElement | null = null, pauseStarted = 0, pausedMs = 0;

    const clamp = (n: number) => Math.max(0, Math.min(99, Math.round(n)));
    const median = (values: number[]) => {
      if (!values.length) return 999;
      const sorted = [...values].sort((a, b) => a - b);
      const mid = Math.floor(sorted.length / 2);
      return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    };
    const accuracy = (hits: number, misses: number) => Math.round((hits / Math.max(1, hits + misses)) * 100);
    const clickScore = (times: number[], misses: number) => {
      const speed = clamp(100 - Math.max(0, median(times) - 180) / 5.2);
      const acc = accuracy(times.length, misses);
      return Math.min(clamp(speed * .72 + acc * .28), times.length * 24);
    };
    const setTargetSize = (target: HTMLElement, size: number) => {
      target.style.setProperty('--ad-target-size', `${size}px`);
    };
    const place = (target: HTMLElement, size = hardened.flickSize) => {
      setTargetSize(target, size);
      target.style.left = `${14 + Math.random() * 72}%`;
      target.style.top = `${22 + Math.random() * 56}%`;
      lastSpawn = performance.now();
    };
    const applySwitchLayout = () => {
      const layout = switchLayouts[switchStep % switchLayouts.length];
      targets[0].style.left = `${layout.a[0]}%`;
      targets[0].style.top = `${layout.a[1]}%`;
      targets[1].style.left = `${layout.b[0]}%`;
      targets[1].style.top = `${layout.b[1]}%`;
      targets.forEach(target => setTargetSize(target, hardened.switchSize));
    };
    const setScore = (key: SkillKey, value: number) => {
      scoreEls[key].textContent = String(value);
      fillEls[key].style.width = `${value}%`;
    };
    const routineFor = (skill: SkillKey) =>
      weaknessRoutines[skill][game.value] || weaknessRoutines[skill].default;

    const resetScores = () => {
      keys.forEach(key => {
        scoreEls[key].textContent = '--';
        fillEls[key].style.width = '0';
        detailEls[key].textContent = '--';
      });
    };

    const resetSurface = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      pauseStarted = 0;
      pausedMs = 0;
      root.dataset.state = 'idle';
      root.removeAttribute('data-phase');
      root.removeAttribute('data-active-target');
      phaseEl.textContent = 'READY';
      timeEl.textContent = '12.0';
      instruction.textContent = 'Press start — or watch the calibration run';
      status.textContent = 'AUTO CALIBRATION';
      resetScores();
      targets.forEach(target => {
        target.style.display = '';
        target.style.opacity = '';
        target.style.transform = '';
        target.style.removeProperty('--ad-target-size');
        target.style.removeProperty('left');
        target.style.removeProperty('top');
      });
    };

    const focusCalibrationTarget = () => {
      window.setTimeout(() => {
        if (root.dataset.state === 'calibration') targets[0].focus({ preventScroll: true });
      }, 0);
    };

    const exitImmersive = () => {
      if (!immersive && !root.classList.contains('is-immersive')) return;
      immersive = false;
      resetSurface();
      root.classList.remove('is-immersive');
      root.removeAttribute('role');
      root.removeAttribute('aria-modal');
      document.documentElement.classList.remove('aim-diagnostic-active');
      const focusTarget = previousFocus;
      previousFocus = null;
      focusTarget?.focus({ preventScroll: true });
    };

    const enterImmersive = () => {
      if (!immersive) {
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        immersive = true;
        root.classList.add('is-immersive');
        root.setAttribute('role', 'dialog');
        root.setAttribute('aria-modal', 'true');
        document.documentElement.classList.add('aim-diagnostic-active');
      }
    };

    const setPhaseInstruction = (phase: SkillKey) => {
      instruction.textContent = phase === 'flick'
        ? 'Click each target · misses reduce precision'
        : phase === 'track'
          ? 'Keep your pointer centered on the moving target'
          : 'Alternate between the lit targets · misses count';
    };

    const finish = () => {
      cancelAnimationFrame(frame);
      const flickMedian = Math.round(median(flickTimes));
      const switchMedian = Math.round(median(switchTimes));
      const flickAccuracy = accuracy(flickTimes.length, flickMisses);
      const switchAccuracy = accuracy(switchTimes.length, switchMisses);
      const trackContact = Math.round((trackInsideMs / Math.max(1, trackTotalMs)) * 100);
      const trackError = Math.round(trackErrorPxMs / Math.max(1, trackTotalMs));
      const trackCloseness = (trackClosenessMs / Math.max(1, trackTotalMs)) * 100;
      const scores: Record<SkillKey, number> = {
        flick: clickScore(flickTimes, flickMisses),
        track: clamp(trackContact * .62 + trackCloseness * .38),
        switch: clickScore(switchTimes, switchMisses),
      };
      keys.forEach(key => setScore(key, scores[key]));
      detailEls.flick.textContent = `${flickTimes.length ? flickMedian : '--'} ms · ${flickAccuracy}% accurate`;
      detailEls.track.textContent = `${trackContact}% contact · ${trackError} px error`;
      detailEls.switch.textContent = `${switchTimes.length ? switchMedian : '--'} ms · ${switchAccuracy}% accurate`;
      const weak = [...keys].sort((a, b) => scores[a] - scores[b])[0] || 'track';
      const routine = routineFor(weak);
      const selectedGame = gameNames[game.value as keyof typeof gameNames] || 'your game';
      const titles: Record<SkillKey, string> = {
        flick: 'FLICK SPEED IS THE LIMIT',
        track: 'TRACKING IS THE LIMIT',
        switch: 'SWITCHING IS THE LIMIT',
      };
      resultTitle.textContent = titles[weak];
      resultCopy.textContent = `${routine.name} ${routine.focus} for ${selectedGame}.`;
      inputNote.textContent = matchMedia('(pointer: coarse)').matches
        ? 'Touch preview only · desktop mouse scores are not comparable.'
        : 'Hardened run · measured locally from this mouse session · no data leaves the tab.';
      codeEl.textContent = routine.code;
      phaseEl.textContent = 'COMPLETE';
      timeEl.textContent = '0.0';
      status.textContent = 'ROUTINE RESOLVED';
      root.dataset.state = 'result';
      root.dataset.phase = weak;
    };

    const loop = (now: number) => {
      const elapsed = now - started - pausedMs;
      const dt = Math.min(50, Math.max(0, now - lastFrame));
      lastFrame = now;
      const phase: SkillKey = elapsed < 4000 ? 'flick' : elapsed < 8000 ? 'track' : 'switch';
      root.dataset.phase = phase;
      phaseEl.textContent = phase.toUpperCase();
      timeEl.textContent = Math.max(0, (12000 - elapsed) / 1000).toFixed(1);
      setPhaseInstruction(phase);
      const phaseIndex = phase === 'flick' ? 1 : phase === 'track' ? 2 : 3;
      if (phaseStarted !== phaseIndex) {
        phaseStarted = phaseIndex;
        if (phase === 'track') {
          targets[1].style.display = 'none';
          setTargetSize(targets[0], hardened.trackSize);
          targets[0].setAttribute('aria-label', 'Tracking target');
        }
        if (phase === 'switch') {
          targets[1].style.display = '';
          switchStep = 0;
          applySwitchLayout();
          lastSpawn = performance.now();
          active = 'a'; root.dataset.activeTarget = active;
          targets[0].setAttribute('aria-label', 'Active switch target');
          targets[1].setAttribute('aria-label', 'Inactive switch target');
        }
      }
      if (phase === 'track') {
        const t = elapsed - 4000;
        const x = 50 + Math.sin(t / 430) * 28 + Math.sin(t / 860 + .8) * 10;
        const y = 50 + Math.sin(t / 285) * 18 + Math.cos(t / 620) * 8;
        targets[0].style.left = `${Math.max(14, Math.min(86, x))}%`;
        targets[0].style.top = `${Math.max(22, Math.min(78, y))}%`;
        const r = targets[0].getBoundingClientRect();
        const distance = Math.hypot(pointerX - (r.left + r.width / 2), pointerY - (r.top + r.height / 2));
        const radius = r.width / 2;
        trackTotalMs += dt;
        if (distance <= radius) trackInsideMs += dt;
        trackErrorPxMs += Math.min(distance, radius * 4) * dt;
        trackClosenessMs += Math.max(0, 1 - distance / (radius * 2.5)) * dt;
      }
      if (elapsed >= 12000) return finish();
      frame = requestAnimationFrame(loop);
    };

    const beginTest = () => {
      root.dataset.state = 'running';
      root.dataset.phase = 'flick';
      root.dataset.activeTarget = 'a';
      phaseStarted = 0; active = 'a';
      switchStep = 0;
      pauseStarted = 0;
      pausedMs = 0;
      targets[1].style.display = 'none';
      targets[0].setAttribute('aria-label', 'Flick target');
      place(targets[0], hardened.flickSize);
      started = lastFrame = performance.now();
      status.textContent = 'TEST RUNNING';
      frame = requestAnimationFrame(loop);
    };

    const prepare = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      pauseStarted = 0;
      pausedMs = 0;
      document.getElementById('daily-quote-close')?.click();
      root.dataset.state = 'calibration';
      root.dataset.phase = 'calibration';
      root.dataset.activeTarget = 'a';
      flickTimes = []; switchTimes = [];
      switchStep = 0;
      flickMisses = switchMisses = 0;
      trackTotalMs = trackInsideMs = trackErrorPxMs = trackClosenessMs = 0;
      pointerX = pointerY = -999;
      resetScores();
      targets.forEach(t => { t.style.display = ''; t.style.opacity = ''; t.style.transform = ''; t.style.removeProperty('--ad-target-size'); });
      targets[1].style.display = 'none';
      targets[0].setAttribute('aria-label', 'Calibration target');
      targets[0].style.left = '50%'; targets[0].style.top = '50%';
      phaseEl.textContent = 'CALIBRATE';
      timeEl.textContent = '12.0';
      instruction.textContent = 'Click the center target when your pointer is ready';
      status.textContent = matchMedia('(pointer: coarse)').matches ? 'TOUCH PREVIEW' : 'MOUSE CALIBRATION';
      focusCalibrationTarget();
    };

    targets.forEach((target) => target.addEventListener('click', () => {
      if (root.dataset.state === 'calibration' && target.dataset.aimTarget === 'a') return beginTest();
      if (root.dataset.state !== 'running') return;
      const phase = root.dataset.phase as SkillKey;
      if (phase === 'flick' && target.dataset.aimTarget === 'a') {
        flickTimes.push(performance.now() - lastSpawn);
        place(target, hardened.flickSize);
      } else if (phase === 'switch' && target.dataset.aimTarget === active) {
        switchTimes.push(performance.now() - lastSpawn);
        active = active === 'a' ? 'b' : 'a';
        switchStep++;
        applySwitchLayout();
        root.dataset.activeTarget = active;
        targets[0].setAttribute('aria-label', active === 'a' ? 'Active switch target' : 'Inactive switch target');
        targets[1].setAttribute('aria-label', active === 'b' ? 'Active switch target' : 'Inactive switch target');
        lastSpawn = performance.now();
      }
    }));
    arena.addEventListener('pointermove', (event) => { pointerX = event.clientX; pointerY = event.clientY; });
    arena.addEventListener('pointerdown', (event) => {
      pointerX = event.clientX; pointerY = event.clientY;
      if (root.dataset.state !== 'running') return;
      if ((event.target as HTMLElement).closest('[data-aim-target]')) return;
      if (root.dataset.phase === 'flick') flickMisses++;
      if (root.dataset.phase === 'switch') switchMisses++;
    });
    arena.addEventListener('pointerleave', () => { pointerX = pointerY = -999; });
    const onVisibilityChange = () => {
      if (!immersive || root.dataset.state !== 'running') return;
      if (document.hidden) {
        if (pauseStarted) return;
        pauseStarted = performance.now();
        cancelAnimationFrame(frame);
        frame = 0;
        phaseEl.textContent = 'PAUSED';
        status.textContent = 'RETURN TO RESUME';
        instruction.textContent = 'Return to this tab to continue the diagnostic';
        return;
      }
      if (!pauseStarted) return;
      pausedMs += performance.now() - pauseStarted;
      pauseStarted = 0;
      lastFrame = performance.now();
      phaseEl.textContent = (root.dataset.phase || 'flick').toUpperCase();
      status.textContent = 'TEST RUNNING';
      frame = requestAnimationFrame(loop);
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (!immersive || event.key !== 'Escape') return;
      event.preventDefault();
      exitImmersive();
    };
    exitButton.addEventListener('click', exitImmersive);
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('keydown', onKeyDown);
    startButtons.forEach(button => button.addEventListener('click', () => {
      if (root.dataset.state === 'running' || root.dataset.state === 'calibration') return;
      enterImmersive();
      prepare();
    }));
    copyButton.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(codeEl.textContent || ''); } catch {}
      copyButton.textContent = 'Copied'; copyButton.classList.add('is-copied');
      window.setTimeout(() => { copyButton.textContent = 'Copy code'; copyButton.classList.remove('is-copied'); }, 1400);
    });
  });
</script>
