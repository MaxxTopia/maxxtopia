  /* Aimmaxxer's visual language is a quiet black/red instrument panel with a
     warm signal accent. Keep the page calm; the arena carries the motion. */
  .aim-diagnostic {
    background:
      radial-gradient(58% 76% at 86% 16%, rgba(209, 24, 32, .12), transparent 72%),
      linear-gradient(135deg, #080705 0%, #130507 54%, #050304 100%);
  }
  .aim-diagnostic::after {
    display: none;
  }
  .aim-diag__shell { max-width: 1440px; }
  .aim-diag__grid { grid-template-columns: minmax(390px, .84fr) minmax(620px, 1.16fr); gap: clamp(52px, 6.5vw, 104px); }
  .aim-diag__copy {
    padding-left: 20px;
    border-left: 2px solid #d11820;
    box-shadow: -1px 0 0 rgba(255, 72, 79, .12);
  }
  .aim-diag__machine {
    border-radius: 18px;
    background: linear-gradient(145deg, #170306, #0c0406 42%, #090204);
    box-shadow: 0 38px 100px rgba(0, 0, 0, .72), 0 0 0 1px rgba(255, 255, 255, .03) inset, 0 0 90px rgba(209, 24, 32, .16);
  }
  .aim-diag__machine::before {
    content: '';
    position: absolute;
    inset: 8px;
    z-index: 1;
    border: 1px solid rgba(243, 175, 25, .08);
    border-radius: 11px;
