---
/**
 * AimDiagnosticHero — a real, playable 12-second warm-up diagnostic.
 *
 * The test measures three public training skills (flicking, tracking and
 * switching), then recommends one of the verified KovaaK's routines already
 * maintained by AimWarmup. It deliberately does not depict or promise the
 * private experimental runtime.
 */
import type { Product } from '../data/products';

type Props = { product: Product };
const { product } = Astro.props;
---

<section class="aim-diagnostic" data-aim-diagnostic data-state="idle" aria-label="Aimmaxxer interactive aim diagnostic">
  <div class="aim-diag__noise" aria-hidden="true"></div>
  <div class="aim-diag__shell">
    <button type="button" class="aim-diag__exit" data-aim-exit aria-keyshortcuts="Escape" aria-label="Exit the aim diagnostic">
      <span>Exit diagnostic</span>
      <kbd>Esc</kbd>
    </button>
    <a href="/#apps" class="aim-diag__back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>

    <div class="aim-diag__grid">
      <div class="aim-diag__copy">
        <div class="aim-diag__brand">
          <img src={product.icon} alt="" />
          <span>TRAINING / AIMMAXXER</span>
          <i>COMING SOON</i>
        </div>
        <p class="aim-diag__eyebrow"><span></span>12-second browser diagnostic <b>HARDENED RUN</b></p>
        <h1>Don’t guess what<br />your aim <em>needs.</em></h1>
        <p class="aim-diag__lede">
          Flick. Track. Switch. Aimmaxxer finds the weakest link, then hands you
          a verified KovaaK’s warm-up for the game you actually play.
        </p>
        <p class="aim-diag__method">Local browser check · best with a mouse or trackpad · no data leaves this tab</p>
        <div class="aim-diag__skill-key" aria-label="Diagnostic stages">
          <span data-skill-key="flick"><i></i><b>Flick</b><small>precision</small></span>
          <span data-skill-key="track"><i></i><b>Track</b><small>control</small></span>
          <span data-skill-key="switch"><i></i><b>Switch</b><small>speed</small></span>
        </div>
        <div class="aim-diag__actions">
          <button type="button" class="aim-diag__start" data-aim-start>
            Run the diagnostic
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <a class="aim-diag__notify" href={product.primaryCta.href} target={product.primaryCta.external ? '_blank' : undefined} rel={product.primaryCta.external ? 'noopener' : undefined}>
            {product.primaryCta.label}
          </a>
        </div>
        <div class="aim-diag__proof">
          <span><b>6</b> games</span>
          <span><b>12</b> real routines</span>
          <span><b>0</b> login</span>
        </div>
      </div>

      <div class="aim-diag__machine">
        <div class="aim-diag__machine-top">
          <span class="aim-diag__machine-label"><i></i>AIM DIAGNOSTIC <small data-aim-mode>HARDENED RUN</small></span>
          <label>
            GAME
            <select data-aim-game aria-label="Choose your game">
              <option value="fortnite">Fortnite</option>
              <option value="valorant">Valorant</option>
              <option value="cs2">CS2</option>
              <option value="apex">Apex Legends</option>
              <option value="overwatch">Overwatch 2</option>
              <option value="cod">Call of Duty</option>
            </select>
          </label>
        </div>

        <div class="aim-diag__arena" data-aim-arena>
          <div class="aim-diag__gridlines" aria-hidden="true"></div>
          <div class="aim-diag__range-mark" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="aim-diag__hud">
            <span data-aim-phase>READY</span>
            <b data-aim-time>12.0</b>
          </div>
          <button type="button" class="aim-diag__target aim-diag__target--a" data-aim-target="a" aria-label="Aim target"><i></i></button>
          <button type="button" class="aim-diag__target aim-diag__target--b" data-aim-target="b" aria-label="Second aim target"><i></i></button>
          <div class="aim-diag__crosshair" aria-hidden="true"><i></i></div>
          <p class="aim-diag__instruction" data-aim-instruction>Press start — or watch the calibration run</p>

          <div class="aim-diag__result" data-aim-result aria-live="polite">
            <p>DIAGNOSTIC COMPLETE</p>
            <strong data-aim-result-title>TRACKING IS THE LIMIT</strong>
            <span data-aim-result-copy>Your Fortnite warm-up is ready.</span>
            <div class="aim-diag__breakdown">
              <span><b>FLICK</b><i data-aim-detail="flick">-- ms · --% accurate</i></span>
              <span><b>TRACK</b><i data-aim-detail="track">--% contact · -- px error</i></span>
              <span><b>SWITCH</b><i data-aim-detail="switch">-- ms · --% accurate</i></span>
            </div>
            <small data-aim-input-note>Measured locally from this mouse session.</small>
            <div class="aim-diag__result-action">
              <code data-aim-code>KovaaKsPullingChestnutMap</code>
              <button type="button" data-aim-copy>Copy code</button>
            </div>
          </div>
        </div>

        <div class="aim-diag__scores" aria-label="Diagnostic scores">
          <div><span>FLICK</span><b data-aim-score="flick">--</b><i><em data-aim-fill="flick"></em></i></div>
          <div><span>TRACK</span><b data-aim-score="track">--</b><i><em data-aim-fill="track"></em></i></div>
          <div><span>SWITCH</span><b data-aim-score="switch">--</b><i><em data-aim-fill="switch"></em></i></div>
        </div>
        <div class="aim-diag__machine-bottom">
          <span><i></i>POINTER READY</span>
          <span data-aim-status aria-live="polite">AUTO CALIBRATION</span>
          <button type="button" data-aim-replay>RESTART</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .aim-diagnostic{
    --ad-ember:var(--color-magenta);--ad-red:#ff6b8b;--ad-track:var(--color-cyan);--ad-switch:#ff6b8b;--ad-phase:var(--ad-ember);--ad-phase-rgb:226,91,255;--ad-cream:var(--color-text);--ad-ink:var(--color-bg);--ad-panel:var(--color-bg-raised);--ad-line:var(--color-line);
    position:relative;isolation:isolate;overflow:hidden;min-height:clamp(760px,calc(100svh - 58px),920px);
    color:var(--ad-cream);border-bottom:1px solid var(--color-line);background:
      radial-gradient(65% 85% at 78% 48%,rgba(226,91,255,.13),transparent 64%),
      radial-gradient(38% 50% at 18% 16%,rgba(0,212,255,.08),transparent 72%),
      linear-gradient(135deg,#07040f,#0b0718 48%,#05030c);
  }
  .aim-diagnostic::before{content:"";position:absolute;inset:0;opacity:.22;background-image:linear-gradient(rgba(0,212,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(226,91,255,.05) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,transparent,#000 55%,#000)}
  .aim-diagnostic[data-phase="flick"]{--ad-phase:var(--ad-ember);--ad-phase-rgb:226,91,255}.aim-diagnostic[data-phase="track"]{--ad-phase:var(--ad-track);--ad-phase-rgb:0,212,255}.aim-diagnostic[data-phase="switch"]{--ad-phase:var(--ad-switch);--ad-phase-rgb:255,107,139}
  .aim-diag__noise{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:.07;background:repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 4px)}
  .aim-diag__shell{position:relative;z-index:2;max-width:1380px;margin:0 auto;padding:clamp(76px,9vh,106px) clamp(20px,4vw,54px) 58px}
  .aim-diag__back{display:inline-flex;align-items:center;gap:7px;margin-bottom:32px;color:var(--color-muted);font:600 11px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:color .2s}.aim-diag__back:hover{color:var(--ad-cream)}.aim-diag__back svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.4}
  .aim-diag__grid{display:grid;grid-template-columns:minmax(360px,.8fr) minmax(610px,1.25fr);align-items:center;gap:clamp(46px,6vw,88px)}
  .aim-diag__copy{position:relative}.aim-diag__brand{display:flex;align-items:center;gap:9px;margin-bottom:31px;color:var(--color-text-mid);font:650 9px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__brand img{width:34px;height:34px;border-radius:8px}.aim-diag__brand i{margin-left:auto;padding:6px 8px;border:1px solid rgba(226,91,255,.25);border-radius:4px;color:var(--ad-ember);font-style:normal;font-size:8px}
  .aim-diag__eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 18px;color:var(--ad-ember);font:650 10px/1 var(--font-mono),monospace;letter-spacing:.15em;text-transform:uppercase}.aim-diag__eyebrow span{width:7px;height:7px;border:1px solid var(--ad-ember);border-radius:50%;box-shadow:0 0 13px var(--ad-ember);animation:ad-ready 1.5s ease-in-out infinite}@keyframes ad-ready{50%{background:var(--ad-ember);box-shadow:0 0 4px var(--ad-ember)}}
  .aim-diag__copy h1{max-width:630px;margin:0;font-size:clamp(54px,5.6vw,88px);font-weight:780;line-height:.9;letter-spacing:-.06em}.aim-diag__copy h1 em{color:var(--ad-ember);font-style:normal;text-shadow:0 0 35px rgba(226,91,255,.17)}
  .aim-diag__lede{max-width:540px;margin:27px 0 0;color:var(--color-text-mid);font-size:clamp(15px,1.15vw,18px);line-height:1.62}.aim-diag__method{max-width:540px;margin:13px 0 0;color:var(--color-muted);font:650 8px/1.5 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}.aim-diag__actions{display:flex;flex-wrap:wrap;align-items:center;gap:11px;margin-top:30px}
  .aim-diag__eyebrow b{margin-left:2px;color:var(--color-text);font-size:8px;letter-spacing:.1em}.aim-diag__skill-key{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:540px;margin-top:23px;border:1px solid var(--color-line-strong);background:rgba(10,6,18,.55)}.aim-diag__skill-key span{display:grid;grid-template-columns:auto 1fr;column-gap:7px;align-items:center;padding:9px 10px;border-left:2px solid var(--skill-color)}.aim-diag__skill-key span:first-child{border-left:0}.aim-diag__skill-key [data-skill-key="flick"]{--skill-color:var(--ad-ember)}.aim-diag__skill-key [data-skill-key="track"]{--skill-color:var(--ad-track)}.aim-diag__skill-key [data-skill-key="switch"]{--skill-color:var(--ad-switch)}.aim-diag__skill-key i{grid-row:span 2;width:6px;height:6px;border:1px solid var(--skill-color);border-radius:50%;box-shadow:0 0 9px color-mix(in srgb,var(--skill-color) 55%,transparent)}.aim-diag__skill-key b{color:var(--color-text-mid);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.12em;text-transform:uppercase}.aim-diag__skill-key small{color:var(--color-muted);font:7px/1 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}
  .aim-diag__start,.aim-diag__notify{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:49px;padding:0 20px;border-radius:6px;font-size:12px;font-weight:800;text-decoration:none;cursor:pointer}.aim-diag__start{border:1px solid var(--ad-ember);background:var(--ad-ember);color:#180b20;box-shadow:0 14px 35px rgba(226,91,255,.17);transition:transform .2s,box-shadow .2s}.aim-diag__start:hover{transform:translateY(-2px);box-shadow:0 18px 42px rgba(226,91,255,.3)}.aim-diag__start svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.5}.aim-diag__notify{border:1px solid var(--color-line-strong);background:var(--color-bg);color:var(--color-text-mid);transition:border-color .2s,color .2s}.aim-diag__notify:hover{border-color:var(--color-cyan);color:var(--color-text)}
  .aim-diag__proof{display:grid;grid-template-columns:repeat(3,1fr);max-width:470px;margin-top:36px;border-top:1px solid var(--color-line-strong)}.aim-diag__proof span{padding:15px 14px 0 0;color:var(--color-muted);font:9px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase}.aim-diag__proof span+span{padding-left:17px;border-left:1px solid var(--color-line-strong)}.aim-diag__proof b{display:block;margin-bottom:7px;color:var(--color-text);font:700 23px/1 var(--font-display),sans-serif}

  .aim-diag__machine{position:relative;min-width:0;border:1px solid var(--color-line-strong);border-radius:13px;overflow:hidden;background:#090512;box-shadow:0 35px 90px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.025) inset,0 0 75px rgba(226,91,255,.09)}
  .aim-diag__exit{display:none;align-items:center;gap:9px;padding:8px 11px;border:1px solid #4a3a68;border-radius:6px;background:rgba(10,6,18,.88);color:var(--color-text-mid);font:700 9px var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.aim-diag__exit:hover{border-color:var(--ad-ember);color:var(--color-text)}.aim-diag__exit kbd{padding:3px 5px;border:1px solid #5b4582;border-radius:3px;color:var(--ad-ember);font:700 8px var(--font-mono),monospace}
  .aim-diag__machine::after{content:"";position:absolute;inset:0;z-index:20;pointer-events:none;box-shadow:inset 0 0 28px rgba(0,0,0,.58)}
  .aim-diag__machine-top,.aim-diag__machine-bottom{display:flex;align-items:center;justify-content:space-between;height:39px;padding:0 13px;background:linear-gradient(180deg,#1b1233,#0b0714);color:var(--color-muted);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__machine-top>span,.aim-diag__machine-bottom>span{display:flex;align-items:center;gap:6px}.aim-diag__machine-top i,.aim-diag__machine-bottom i{width:5px;height:5px;border-radius:50%;background:var(--ad-phase);box-shadow:0 0 8px var(--ad-phase)}.aim-diag__machine-label small{padding-left:6px;color:var(--ad-phase);font-size:7px;letter-spacing:.1em}
  .aim-diag__machine-top label{display:flex;align-items:center;gap:7px}.aim-diag__machine-top select{height:25px;padding:0 23px 0 8px;border:1px solid #4a3a68;border-radius:4px;outline:none;background:var(--color-bg-raised);color:var(--color-text-mid);font:700 8px var(--font-mono),monospace;text-transform:uppercase;cursor:pointer}
  .aim-diag__arena{position:relative;aspect-ratio:16/9;overflow:hidden;touch-action:none;cursor:crosshair;background:
    radial-gradient(circle at 50% 48%,rgba(var(--ad-phase-rgb),.09),transparent 34%),
    linear-gradient(180deg,#17102e,#090613 72%)}
  .aim-diag__arena::before{content:"";position:absolute;left:50%;bottom:0;width:68%;height:65%;transform:translateX(-50%);clip-path:polygon(34% 0,66% 0,100% 100%,0 100%);opacity:.35;background:repeating-linear-gradient(90deg,transparent 0 11.5%,rgba(var(--ad-phase-rgb),.12) 12%,transparent 12.5%),repeating-linear-gradient(0deg,transparent 0 15.5%,rgba(var(--ad-phase-rgb),.12) 16%,transparent 16.5%)}
  .aim-diag__gridlines{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.8%,rgba(var(--ad-phase-rgb),.1) 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,rgba(var(--ad-phase-rgb),.08) 50%,transparent 50.2%)}
  .aim-diag__range-mark{position:absolute;inset:0;pointer-events:none}.aim-diag__range-mark i{position:absolute;left:50%;top:50%;border:1px solid rgba(var(--ad-phase-rgb),.09);border-radius:50%;transform:translate(-50%,-50%)}.aim-diag__range-mark i:nth-child(1){width:24%;aspect-ratio:1}.aim-diag__range-mark i:nth-child(2){width:48%;aspect-ratio:1}.aim-diag__range-mark i:nth-child(3){width:76%;aspect-ratio:1}
  .aim-diag__hud{position:absolute;z-index:8;left:12px;right:12px;top:10px;display:flex;justify-content:space-between;color:var(--color-text-mid);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.13em}.aim-diag__hud span{padding:5px 7px;border-left:2px solid var(--ad-phase);background:rgba(10,6,18,.72)}.aim-diag__hud b{color:var(--ad-phase);font-size:12px}
  .aim-diag__target{position:absolute;z-index:6;left:50%;top:50%;display:grid;place-items:center;width:var(--ad-target-size,58px);height:var(--ad-target-size,58px);margin:0;padding:0;border:2px solid color-mix(in srgb,var(--ad-phase) 85%,var(--ad-red));border-radius:50%;background:radial-gradient(circle,#f8f6ff 0 10%,var(--ad-switch) 11% 25%,#160c2e 26% 43%,var(--ad-ember) 44% 57%,#160c2e 58%);box-shadow:0 0 0 5px rgba(var(--ad-phase-rgb),.1),0 0 24px rgba(255,107,139,.25);cursor:crosshair;transform:translate(-50%,-50%);transition:left .12s ease,top .12s ease,transform .12s}.aim-diag__target::before,.aim-diag__target::after{content:"";position:absolute;background:rgba(248,246,255,.55)}.aim-diag__target::before{left:-8px;right:-8px;top:50%;height:1px}.aim-diag__target::after{top:-8px;bottom:-8px;left:50%;width:1px}.aim-diag__target i{width:7px;height:7px;border:1px solid #fff;border-radius:50%}.aim-diag__target--b{display:none}[data-state="running"] .aim-diag__target{transition:none}[data-state="calibration"] .aim-diag__target--a{animation:ad-calibrate 1.25s ease-in-out infinite}@keyframes ad-calibrate{50%{box-shadow:0 0 0 12px rgba(var(--ad-phase-rgb),.05),0 0 32px rgba(255,107,139,.42);transform:translate(-50%,-50%) scale(1.06)}}
  .aim-diag__crosshair{position:absolute;z-index:7;left:50%;top:50%;width:34px;height:34px;margin:-17px;pointer-events:none}.aim-diag__crosshair::before,.aim-diag__crosshair::after,.aim-diag__crosshair i::before,.aim-diag__crosshair i::after{content:"";position:absolute;background:#fff;box-shadow:0 0 4px #000}.aim-diag__crosshair::before{left:0;top:16px;width:11px;height:2px}.aim-diag__crosshair::after{right:0;top:16px;width:11px;height:2px}.aim-diag__crosshair i::before{left:16px;top:0;width:2px;height:11px}.aim-diag__crosshair i::after{left:16px;bottom:0;width:2px;height:11px}
  [data-state="idle"] .aim-diag__target--a{animation:ad-target-demo 6s cubic-bezier(.4,0,.2,1) infinite}[data-state="idle"] .aim-diag__crosshair{animation:ad-cross-demo 6s cubic-bezier(.2,.8,.2,1) infinite}
  @keyframes ad-target-demo{0%,12%{left:26%;top:33%}25%,38%{left:72%;top:62%}50%,63%{left:62%;top:27%}75%,88%{left:34%;top:69%}100%{left:26%;top:33%}}
  @keyframes ad-cross-demo{0%,8%{left:50%;top:50%}16%,23%{left:26%;top:33%}31%,46%{left:72%;top:62%}54%,69%{left:62%;top:27%}77%,94%{left:34%;top:69%}100%{left:50%;top:50%}}
  .aim-diag__instruction{position:absolute;z-index:8;left:50%;bottom:13px;margin:0;transform:translateX(-50%);color:var(--color-muted);font:650 7px/1 var(--font-mono),monospace;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .aim-diag__scores{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--color-line);border-bottom:1px solid var(--color-line)}.aim-diag__scores>div{position:relative;padding:11px 13px 12px}.aim-diag__scores>div+div{border-left:1px solid var(--color-line)}.aim-diag__scores span{color:var(--color-muted);font:700 7px/1 var(--font-mono),monospace;letter-spacing:.14em}.aim-diag__scores b{float:right;color:var(--color-text-mid);font:800 12px/1 var(--font-mono),monospace}.aim-diag__scores i{position:absolute;left:13px;right:13px;bottom:6px;height:2px;overflow:hidden;background:#27183f}.aim-diag__scores em{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--ad-red),var(--ad-phase));box-shadow:0 0 6px var(--ad-phase);transition:width .4s}
  .aim-diag__machine-bottom{height:31px}.aim-diag__machine-bottom button{position:relative;z-index:21;border:0;background:none;color:var(--color-muted);font:700 7px var(--font-mono),monospace;letter-spacing:.12em;cursor:pointer}.aim-diag__machine-bottom button:hover{color:var(--ad-ember)}
  .aim-diag__result{position:absolute;z-index:12;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:22px;text-align:center;opacity:0;pointer-events:none;background:radial-gradient(circle,rgba(var(--ad-phase-rgb),.16),rgba(10,6,18,.97) 72%);transform:scale(1.03);transition:opacity .35s,transform .5s}.aim-diag__result p{margin:0 0 8px;color:var(--ad-phase);font:700 8px var(--font-mono),monospace;letter-spacing:.18em}.aim-diag__result>strong{color:var(--color-text);font:750 clamp(22px,2.7vw,35px)/1 var(--font-display),sans-serif;letter-spacing:.01em}.aim-diag__result>span{margin-top:7px;color:var(--color-text-mid);font-size:11px}.aim-diag__breakdown{display:grid;grid-template-columns:repeat(3,1fr);width:min(480px,100%);margin-top:13px;border:1px solid var(--color-line-strong);border-radius:5px;background:rgba(10,6,18,.66)}.aim-diag__breakdown span{padding:7px 8px}.aim-diag__breakdown span+span{border-left:1px solid var(--color-line-strong)}.aim-diag__breakdown b,.aim-diag__breakdown i{display:block;font-family:var(--font-mono),monospace}.aim-diag__breakdown b{color:var(--ad-phase);font-size:7px;letter-spacing:.12em}.aim-diag__breakdown i{margin-top:4px;color:var(--color-text-mid);font-size:7px;font-style:normal;white-space:nowrap}.aim-diag__result>small{margin-top:7px;color:var(--color-muted);font:6px var(--font-mono),monospace;letter-spacing:.08em}.aim-diag__result-action{display:flex;align-items:center;gap:7px;margin-top:12px}.aim-diag__result code{padding:8px 10px;border:1px solid #4a3a68;border-radius:5px;background:var(--color-bg);color:var(--color-text-mid);font:10px var(--font-mono),monospace}.aim-diag__result button{padding:9px 11px;border:1px solid var(--ad-phase);border-radius:5px;background:var(--ad-phase);color:#180b20;font:800 9px var(--font-mono),monospace;cursor:pointer}.aim-diag__result button.is-copied{background:#73d89f;border-color:#73d89f}
  [data-state="result"] .aim-diag__result{opacity:1;pointer-events:auto;transform:scale(1)}[data-state="running"] .aim-diag__crosshair,[data-state="calibration"] .aim-diag__crosshair,[data-state="result"] .aim-diag__crosshair{display:none}[data-state="result"] .aim-diag__target{display:none!important}
  [data-phase="switch"] .aim-diag__target--b{display:grid}[data-phase="switch"][data-active-target="a"] .aim-diag__target--a,[data-phase="switch"][data-active-target="b"] .aim-diag__target--b{z-index:8}[data-phase="switch"][data-active-target="a"] .aim-diag__target--b,[data-phase="switch"][data-active-target="b"] .aim-diag__target--a{z-index:5;opacity:.25;filter:grayscale(.7);transform:translate(-50%,-50%) scale(.75);pointer-events:none}
  html.aim-diagnostic-active,html.aim-diagnostic-active body{cursor:auto!important}html.aim-diagnostic-active body{overflow:hidden}html.aim-diagnostic-active .custom-cursor{display:none!important}html.aim-diagnostic-active a,html.aim-diagnostic-active button,html.aim-diagnostic-active select{cursor:pointer!important}html.aim-diagnostic-active .aim-diag__arena,html.aim-diagnostic-active .aim-diag__target{cursor:default!important}
  .aim-diagnostic.is-immersive{position:fixed;inset:0;z-index:2147483000;width:100%;height:100svh;min-height:100svh;max-height:none;overflow:auto;border-bottom:0}
  .aim-diagnostic.is-immersive .aim-diag__shell{display:flex;flex-direction:column;justify-content:center;min-height:100%;padding-block:clamp(58px,7vh,78px)}
  .aim-diagnostic.is-immersive .aim-diag__back{display:none}
  .aim-diagnostic.is-immersive .aim-diag__exit{display:inline-flex;position:fixed;top:max(16px,env(safe-area-inset-top));right:clamp(18px,4vw,54px);z-index:30}
  .aim-diagnostic.is-immersive .aim-diag__copy{display:none}
