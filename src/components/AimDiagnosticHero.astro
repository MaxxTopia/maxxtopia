---
/**
 * AimDiagnosticHero — a real, playable browser warm-up diagnostic.
 *
 * The test measures three public training skills (flicking, tracking and
 * switching), then recommends one of the verified KovaaK's routines already
 * maintained by AimWarmup. It deliberately does not depict or promise the
 * private experimental runtime.
 */
import type { Product } from '../data/products';

type Props = { product: Product };
const { product } = Astro.props;
---

<section id="aim-diagnostic" class="aim-diagnostic" data-aim-diagnostic data-state="idle" aria-label="Aimmaxxer interactive aim diagnostic">
  <div class="aim-diag__noise" aria-hidden="true"></div>
  <div class="aim-diag__shell">
    <button type="button" class="aim-diag__exit" data-aim-exit aria-keyshortcuts="Escape" aria-label="Exit the aim diagnostic">
      <span>Exit diagnostic</span>
      <kbd>Esc</kbd>
    </button>
    <a href="/#apps" class="aim-diag__back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>

    <div class="aim-diag__grid">
      <div class="aim-diag__copy">
        <div class="aim-diag__brand">
          <img src={product.icon} alt="" />
          <span>TRAINING / AIMMAXXER</span>
          <i>COMING SOON</i>
        </div>
        <p class="aim-diag__eyebrow"><span></span>~32-second browser diagnostic <b>OPTIONAL VERIFY</b></p>
        <h1>Don’t guess what<br />your <span class="aim-word">aim</span><br /><em>needs.</em></h1>
        <p class="aim-diag__lede">
          Flick. Track. Switch. Aimmaxxer finds the clearest first-pass gap,
          then lets you verify it if you want more confidence.
        </p>
        <p class="aim-diag__method">32-second scan · optional 10-second confirmation · native pointer · local only · no account required</p>
        <div class="aim-diag__expectation">
          <strong>How to play</strong>
          <span>Click Run the diagnostic, then click the center target to start. Your native browser pointer stays the reticle. Flick: click each target once. Track: move over the moving target — do not click or hold. Switch: click the lit target, then move to the next one.</span>
        </div>
        <div class="aim-diag__skill-key" aria-label="Diagnostic stages">
          <span data-skill-key="flick"><i></i><b>Flick</b><small>precision</small></span>
          <span data-skill-key="track"><i></i><b>Track</b><small>control</small></span>
          <span data-skill-key="switch"><i></i><b>Switch</b><small>speed</small></span>
        </div>
        <div class="aim-diag__actions">
          <button type="button" class="aim-diag__start" data-aim-start>
            Run the diagnostic
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <a class="aim-diag__notify" href={product.primaryCta.href} target={product.primaryCta.external ? '_blank' : undefined} rel={product.primaryCta.external ? 'noopener' : undefined}>
            <span>{product.primaryCta.label}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-6-6 6 6-6 6"/></svg>
          </a>
          <a class="aim-diag__browse" href="#aim-warmup-heading">Browse routines</a>
        </div>
        <div class="aim-diag__proof">
          <span><b>6</b> games</span>
          <span><b>30</b> verified routes</span>
          <span><b>0</b> account required</span>
        </div>
      </div>

      <div class="aim-diag__machine">
        <div class="aim-diag__machine-top">
          <span class="aim-diag__machine-label"><i></i>AIM DIAGNOSTIC <small data-aim-mode>EVIDENCE RUN</small></span>
          <div class="aim-diag__selectors">
            <label>
              GAME CONTEXT
              <select data-aim-game aria-label="Choose the game for your recommendation">
                <option value="fortnite">Fortnite</option>
                <option value="valorant">Valorant</option>
                <option value="cs2">CS2</option>
                <option value="apex">Apex Legends</option>
                <option value="overwatch">Overwatch 2</option>
                <option value="cod">Call of Duty</option>
              </select>
            </label>
            <label>
              TRAINING PRIORITY
              <select data-aim-goal aria-label="Choose your training priority">
                <option value="balanced">Find my limiter</option>
                <option value="speed">Get faster</option>
                <option value="control">Get steadier</option>
                <option value="consistency">Clean up misses</option>
              </select>
            </label>
          </div>
        </div>

        <div class="aim-diag__loadout" aria-live="polite">
          <span data-aim-game-note>Fortnite · mixed combat / burst flicks + target transfers</span>
          <span data-aim-goal-note>Find my limiter</span>
        </div>

        <div class="aim-diag__rank-meter" data-aim-rank-meter hidden aria-label="Live aim rank">
          <div class="aim-diag__rank-meter-head">
            <span><i></i>LIVE RANK</span>
            <strong data-aim-live-rank>NEEDS WORK</strong>
            <b data-aim-live-rank-score>0 / 1000</b>
          </div>
          <div class="aim-diag__rank-meter-track" data-aim-live-rank-bar role="progressbar" aria-label="Live aim rank progress" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="0" aria-valuetext="Needs Work, 0 out of 1000">
            <i data-aim-live-rank-fill></i>
          </div>
          <div class="aim-diag__rank-meter-tiers" aria-hidden="true">
            <span>NEEDS WORK</span>
            <span>APPRENTICE</span>
            <span>AMATEUR</span>
            <span>MASTER</span>
            <span>GOD AIMER</span>
            <span>AIMMAXXER</span>
          </div>
          <small data-aim-live-rank-next>Next: APPRENTICE at 180</small>
        </div>

        <div class="aim-diag__arena" data-aim-arena>
          <div class="aim-diag__gridlines" aria-hidden="true"></div>
          <div class="aim-diag__range-mark" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="aim-diag__course" aria-hidden="true">
            <b hidden>SWITCH COURSE</b>
            <span hidden data-aim-switch-step>00 / 12</span>
            <small hidden data-aim-switch-state>WARMING UP</small>
            <div>
              <i data-switch-gate="0"></i><i data-switch-gate="1"></i><i data-switch-gate="2"></i>
              <i data-switch-gate="3"></i><i data-switch-gate="4"></i><i data-switch-gate="5"></i>
              <i data-switch-gate="6"></i><i data-switch-gate="7"></i><i data-switch-gate="8"></i>
              <i data-switch-gate="9"></i><i data-switch-gate="10"></i><i data-switch-gate="11"></i>
            </div>
          </div>
          <div class="aim-diag__hud">
            <span data-aim-phase>READY</span>
            <div class="aim-diag__hud-readout">
              <span class="aim-diag__hud-score"><i>RUN SCORE</i><b data-aim-live-score>0</b></span>
              <span class="aim-diag__hud-combo" data-aim-combo>COMBO 0</span>
            <b data-aim-time>32.0</b>
            </div>
          </div>
          <div class="aim-diag__start-guide" data-aim-start-guide hidden>
            <div class="aim-diag__start-guide-head">
              <strong>How to play</strong>
              <span>Before you start</span>
            </div>
            <div class="aim-diag__start-guide-list">
              <span><b>Flick</b><i>Click each target once</i></span>
              <span><b>Track</b><i>Move the crosshair over it · no click or hold</i></span>
              <span><b>Switch</b><i>Click the lit target, then find the next</i></span>
            </div>
            <p><b>Ready?</b> Click the center target to begin. Your pointer becomes the reticle inside the arena.</p>
          </div>
          <button type="button" class="aim-diag__target aim-diag__target--a" data-aim-target="a" aria-label="Aim target"><i></i><span>A</span></button>
          <button type="button" class="aim-diag__target aim-diag__target--b" data-aim-target="b" aria-label="Second aim target"><i></i><span>B</span></button>
          <button type="button" class="aim-diag__target aim-diag__target--c" data-aim-target="c" aria-label="Third aim target"><i></i><span>C</span></button>
          <button type="button" class="aim-diag__target aim-diag__target--d" data-aim-target="d" aria-label="Fourth aim target"><i></i><span>D</span></button>
          <div class="aim-diag__crosshair" data-pointer="preview" aria-hidden="true"><i></i></div>
          <p class="aim-diag__instruction" data-aim-instruction>Click Run the diagnostic, then the center target</p>

          <div class="aim-diag__result" data-aim-result aria-live="polite" aria-atomic="true" aria-hidden="true" inert>
            <p data-aim-result-kicker>AWAITING RUN</p>
            <h2 data-aim-result-title tabindex="-1">YOUR NEXT EDGE WILL LAND HERE</h2>
            <span data-aim-result-copy>Complete the 32-second scan to get a first-pass read. The 10-second confirmation is optional.</span>
            <div class="aim-diag__result-rating">
              <span data-aim-stars aria-label="No result yet">FOCUS PRIORITY · VERIFY</span>
              <div class="aim-diag__result-rank">
                <small>PERSONAL RANK</small>
                <b data-aim-priority>NO RANK YET</b>
              </div>
            </div>
            <div class="aim-diag__result-plan">
              <span data-aim-plan-label>RECOMMENDED KOVAAK'S BLOCK</span>
              <strong data-aim-plan-title>Finish the read to reveal your warm-up</strong>
              <small data-aim-plan-meta>Your focused routine appears after enough confirmed input.</small>
            </div>
            <div class="aim-diag__breakdown">
              <span><b>FLICK</b><i data-aim-detail="flick">-- sec · --% accurate</i></span>
              <span><b>TRACK</b><i data-aim-detail="track">--% on target · -- px away</i></span>
              <span><b>SWITCH</b><i data-aim-detail="switch">-- sec · --% accurate</i></span>
            </div>
            <p class="aim-diag__result-next" data-aim-next-step>Run the diagnostic, hit the center target, then follow each phase prompt.</p>
            <details class="aim-diag__result-more" data-aim-result-more>
              <summary>More evidence <span>analysis, history, and scores</span></summary>
              <div class="aim-diag__result-more-body">
                <p class="aim-diag__result-why" data-aim-result-why>Each phase measures a different aim skill so the recommendation is based on what you actually did.</p>
                <p class="aim-diag__result-confidence" data-aim-confidence>Your read appears after enough confirmed input.</p>
                <small data-aim-input-note>Local only · no data leaves this tab.</small>
                <p class="aim-diag__history" data-aim-history>Runs stay on this browser only.</p>
                <div class="aim-diag__run-summary" data-aim-run-summary hidden>
                  <div><span>RUN SCORE</span><strong data-aim-run-score>0</strong></div>
                  <div><span>CLICK ACCURACY</span><strong data-aim-run-accuracy>--%</strong></div>
                  <div><span>BEST SO FAR</span><strong data-aim-run-best>--</strong></div>
                  <small class="aim-diag__run-summary-note" data-aim-run-summary-note>Compare this score with your own attempts; it is not an overall skill rating.</small>
                </div>
                <div class="aim-diag__personal-board" data-aim-personal-board hidden>
                  <div class="aim-diag__personal-head"><span>PERSONAL BOARD</span><small>THIS BROWSER</small></div>
                  <ol data-aim-personal-list><li>Complete a full read to set your first score.</li></ol>
                </div>
              </div>
            </details>
            <span class="aim-diag__score-announcer" data-aim-score-announcer aria-live="polite"></span>
            <div class="aim-diag__result-action">
              <code data-aim-code>Run the diagnostic first</code>
              <button type="button" data-aim-copy aria-label="Copy KovaaK's share code">Copy code</button>
              <a href="#aim-warmup-heading" data-aim-result-link>Start this warm-up</a>
              <button type="button" data-aim-confirm hidden>Verify the read</button>
              <button type="button" data-aim-retest>Retest</button>
            </div>
          </div>
        </div>

        <div class="aim-diag__scores" aria-label="Diagnostic scores">
          <div><span>FLICK</span><b data-aim-score="flick">--</b><i><em data-aim-fill="flick"></em></i></div>
          <div><span>TRACK</span><b data-aim-score="track">--</b><i><em data-aim-fill="track"></em></i></div>
          <div><span>SWITCH</span><b data-aim-score="switch">--</b><i><em data-aim-fill="switch"></em></i></div>
        </div>
        <div class="aim-diag__machine-bottom">
          <span><i></i>POINTER READY</span>
          <span data-aim-status aria-live="polite">AUTO CALIBRATION</span>
          <button type="button" data-aim-replay>RESTART</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .aim-diagnostic{
    --ad-ember:#f3af19;--ad-green:#39d66e;--ad-cyan:#44e5f3;--ad-cyan-rgb:68,229,243;--ad-red:#7e0a10;--ad-logo-red:#d11820;--ad-blood:#9f1118;--ad-track:#ffd166;--ad-switch:#e94a2f;--ad-phase:var(--ad-ember);--ad-phase-rgb:243,175,25;--ad-cream:#fff4de;--ad-ink:#080705;--ad-panel:#100e0a;--ad-line:#3a3022;
    position:relative;isolation:isolate;overflow:hidden;min-height:clamp(760px,calc(100svh - 58px),920px);
    color:var(--ad-cream);border-bottom:1px solid var(--color-line);background:
      radial-gradient(58% 74% at 82% 34%,rgba(209,24,32,.12),transparent 70%),
      radial-gradient(36% 48% at 18% 12%,rgba(243,175,25,.05),transparent 74%),
      linear-gradient(135deg,#080705 0%,#130507 52%,#050304 100%);
  }
  .aim-diagnostic::before{display:none}
  .aim-diagnostic[data-phase="flick"]{--ad-phase:var(--ad-ember);--ad-phase-rgb:243,175,25}.aim-diagnostic[data-phase="track"]{--ad-phase:var(--ad-track);--ad-phase-rgb:255,209,102}.aim-diagnostic[data-phase="switch"]{--ad-phase:var(--ad-switch);--ad-phase-rgb:233,74,47}
  .aim-diag__noise{display:none}
  .aim-diag__shell{position:relative;z-index:2;max-width:1380px;margin:0 auto;padding:clamp(76px,9vh,106px) clamp(20px,4vw,54px) 58px}
  .aim-diag__back{display:inline-flex;align-items:center;gap:7px;margin-bottom:32px;color:var(--color-muted);font:600 11px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:color .2s}.aim-diag__back:hover{color:var(--ad-cream)}.aim-diag__back svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.4}
  .aim-diag__grid{display:grid;grid-template-columns:minmax(360px,.8fr) minmax(610px,1.25fr);align-items:center;gap:clamp(46px,6vw,88px)}
  .aim-diag__copy{position:relative}.aim-diag__brand{display:flex;align-items:center;gap:9px;margin-bottom:31px;color:var(--color-text-mid);font:650 9px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__brand img{width:34px;height:34px;border-radius:8px}.aim-diag__brand i{margin-left:auto;padding:6px 8px;border:1px solid rgba(243,175,25,.35);border-radius:4px;color:var(--ad-ember);font-style:normal;font-size:8px;box-shadow:0 0 20px rgba(243,175,25,.08)}
  .aim-diag__eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 18px;color:var(--ad-ember);font:650 10px/1 var(--font-mono),monospace;letter-spacing:.15em;text-transform:uppercase}.aim-diag__eyebrow span{width:7px;height:7px;border:1px solid var(--ad-ember);border-radius:50%;box-shadow:0 0 13px var(--ad-ember);animation:ad-ready 1.5s ease-in-out infinite}@keyframes ad-ready{50%{background:var(--ad-ember);box-shadow:0 0 4px var(--ad-ember)}}
  .aim-diag__copy h1{max-width:630px;margin:0;font-size:clamp(54px,5.6vw,88px);font-weight:780;line-height:.9;letter-spacing:-.06em}.aim-diag__copy h1 .aim-word{color:var(--ad-logo-red);text-shadow:0 0 35px rgba(209,24,32,.22)}.aim-diag__copy h1 em{color:var(--ad-green);font-style:normal;text-shadow:0 0 35px rgba(57,214,110,.24)}
  .aim-diag__lede{max-width:540px;margin:27px 0 0;color:var(--color-text-mid);font-size:clamp(15px,1.15vw,18px);line-height:1.62}.aim-diag__method{max-width:540px;margin:13px 0 0;color:var(--color-muted);font:650 8px/1.5 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}.aim-diag__expectation{display:grid;gap:5px;max-width:540px;margin-top:16px;padding:11px 13px;border-left:2px solid var(--ad-ember);background:rgba(243,175,25,.045)}.aim-diag__expectation strong{color:var(--color-text);font-size:12px;font-weight:700}.aim-diag__expectation span{color:var(--color-text-mid);font-size:12px;line-height:1.45}.aim-diag__actions{display:flex;flex-wrap:wrap;align-items:center;gap:11px;margin-top:24px}
  .aim-diag__eyebrow b{margin-left:2px;color:var(--color-text);font-size:8px;letter-spacing:.1em}.aim-diag__skill-key{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:540px;margin-top:23px;border:1px solid var(--color-line-strong);background:rgba(12,4,6,.68)}.aim-diag__skill-key span{display:grid;grid-template-columns:auto 1fr;column-gap:7px;align-items:center;padding:9px 10px;border-left:2px solid var(--skill-color)}.aim-diag__skill-key span:first-child{border-left:0}.aim-diag__skill-key [data-skill-key="flick"]{--skill-color:var(--ad-ember)}.aim-diag__skill-key [data-skill-key="track"]{--skill-color:var(--ad-track)}.aim-diag__skill-key [data-skill-key="switch"]{--skill-color:var(--ad-switch)}.aim-diag__skill-key i{grid-row:span 2;width:6px;height:6px;border:1px solid var(--skill-color);border-radius:50%;box-shadow:0 0 9px color-mix(in srgb,var(--skill-color) 55%,transparent)}.aim-diag__skill-key b{color:var(--color-text-mid);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.12em;text-transform:uppercase}.aim-diag__skill-key small{color:var(--color-muted);font:7px/1 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}
  .aim-diag__start,.aim-diag__notify,.aim-diag__browse{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:49px;padding:0 20px;border-radius:6px;font-size:12px;font-weight:800;text-decoration:none;cursor:pointer}.aim-diag__start{border:1px solid #c3262c;background:linear-gradient(180deg,#b51721,var(--ad-blood));color:var(--ad-cream);box-shadow:0 14px 35px rgba(159,17,24,.28);transition:transform .2s,box-shadow .2s,background .2s}.aim-diag__start:hover{transform:translateY(-2px);background:linear-gradient(180deg,#ca1b27,#a51019);box-shadow:0 18px 42px rgba(159,17,24,.42)}.aim-diag__start svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.5}.aim-diag__notify{position:relative;isolation:isolate;overflow:hidden;border:1px solid rgba(209,24,32,.86);background:linear-gradient(180deg,rgba(44,8,13,.98),rgba(17,4,6,.98));color:var(--ad-cream);box-shadow:inset 0 0 0 1px rgba(255,244,222,.06),0 10px 24px rgba(0,0,0,.2),0 0 22px rgba(209,24,32,.28),0 0 42px rgba(209,24,32,.10);transition:transform .2s,border-color .2s,background .2s,box-shadow .2s}.aim-diag__notify::before{content:"";position:absolute;z-index:0;inset:1px;border-radius:5px;background:linear-gradient(180deg,rgba(209,24,32,.23),rgba(209,24,32,.08));opacity:.78;animation:ad-v2-ambient 4.8s ease-in-out infinite;pointer-events:none}.aim-diag__notify span{position:relative;z-index:1;display:inline-block;color:var(--ad-cream);text-shadow:0 0 6px rgba(255,244,222,.32);filter:drop-shadow(0 0 5px rgba(255,244,222,.24));animation:ad-v2-letter-glow 4.8s ease-in-out infinite}.aim-diag__notify svg{position:relative;z-index:1;width:14px;fill:none;stroke:currentColor;stroke-width:2}.aim-diag__notify:hover{transform:translateY(-2px);border-color:#e24a4f;background:linear-gradient(180deg,rgba(57,9,14,.98),rgba(24,5,8,.98));box-shadow:inset 0 0 0 1px rgba(255,244,222,.06),0 14px 28px rgba(159,17,24,.22),0 0 25px rgba(209,24,32,.20)}.aim-diag__notify:hover::before,.aim-diag__notify:hover span{animation-play-state:paused}.aim-diag__browse{min-height:40px;padding-inline:4px;border:0;color:var(--color-muted);font-size:11px;text-decoration:underline;text-decoration-color:rgba(243,175,25,.55);text-underline-offset:4px}.aim-diag__browse:hover{color:var(--ad-cream)}
  @keyframes ad-v2-ambient{0%,100%{opacity:.78}50%{opacity:1}}
  @keyframes ad-v2-letter-glow{0%,100%{text-shadow:0 0 6px rgba(255,244,222,.32);filter:drop-shadow(0 0 5px rgba(255,244,222,.24))}50%{text-shadow:0 0 10px rgba(255,244,222,.44);filter:drop-shadow(0 0 8px rgba(255,244,222,.38))}}
  @media(prefers-reduced-motion:reduce){.aim-diag__notify::before{animation:none;opacity:.78}.aim-diag__notify span{animation:none;text-shadow:0 0 6px rgba(255,244,222,.32);filter:drop-shadow(0 0 5px rgba(255,244,222,.24))}}
  .aim-diag__proof{display:grid;grid-template-columns:repeat(3,1fr);max-width:470px;margin-top:36px;border-top:1px solid var(--color-line-strong)}.aim-diag__proof span{padding:15px 14px 0 0;color:var(--color-muted);font:9px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase}.aim-diag__proof span+span{padding-left:17px;border-left:1px solid var(--color-line-strong)}.aim-diag__proof b{display:block;margin-bottom:7px;color:var(--color-text);font:700 23px/1 var(--font-display),sans-serif}

  .aim-diag__machine{position:relative;min-width:0;border:1px solid var(--color-line-strong);border-radius:13px;overflow:hidden;background:#0c0406;box-shadow:0 35px 90px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.025) inset,0 0 75px rgba(209,24,32,.1)}
  .aim-diag__exit{display:none;align-items:center;gap:9px;padding:8px 11px;border:1px solid #5a0b10;border-radius:6px;background:rgba(12,4,6,.88);color:var(--color-text-mid);font:700 9px var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.aim-diag__exit:hover{border-color:var(--ad-ember);color:var(--color-text)}.aim-diag__exit kbd{padding:3px 5px;border:1px solid #7e0a10;border-radius:3px;color:var(--ad-ember);font:700 8px var(--font-mono),monospace}
  .aim-diag__machine::after{content:"";position:absolute;inset:0;z-index:20;pointer-events:none;box-shadow:inset 0 0 28px rgba(0,0,0,.58)}
  .aim-diag__machine-top,.aim-diag__machine-bottom{display:flex;align-items:center;justify-content:space-between;height:39px;padding:0 13px;background:linear-gradient(180deg,#2a080c,#0c0406);color:var(--color-muted);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__machine-top>span,.aim-diag__machine-bottom>span{display:flex;align-items:center;gap:6px}.aim-diag__machine-top i,.aim-diag__machine-bottom i{width:5px;height:5px;border-radius:50%;background:var(--ad-phase);box-shadow:0 0 8px var(--ad-phase)}.aim-diag__machine-label small{padding-left:6px;color:var(--ad-phase);font-size:7px;letter-spacing:.1em}
