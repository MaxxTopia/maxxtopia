  .aim-diag__result-rating span { max-width: 170px; color: var(--ad-ember); font-size: 7px; line-height: 1.25; letter-spacing: .12em; }
  .aim-diag__result-next, .aim-diag__result-why { font: 500 10px/1.45 var(--font-sans),sans-serif !important; letter-spacing: normal !important; }
  .aim-diag__result-confidence { font-family: var(--font-mono),monospace !important; }
  .aim-diag__result button[data-aim-confirm] { order: -1; }
  .aim-diag__personal-board[hidden] { display: none; }

