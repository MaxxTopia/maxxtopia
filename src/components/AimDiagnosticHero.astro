---
/**
 * AimDiagnosticHero — a real, playable 12-second warm-up diagnostic.
 *
 * The test measures three public training skills (flicking, tracking and
 * switching), then recommends one of the verified KovaaK's routines already
 * maintained by AimWarmup. It deliberately does not depict or promise the
 * private experimental runtime.
 */
import type { Product } from '../data/products';

type Props = { product: Product };
const { product } = Astro.props;
---

<section class="aim-diagnostic" data-aim-diagnostic data-state="idle" aria-label="Aimmaxxer interactive aim diagnostic">
  <div class="aim-diag__noise" aria-hidden="true"></div>
  <div class="aim-diag__shell">
    <button type="button" class="aim-diag__exit" data-aim-exit aria-keyshortcuts="Escape" aria-label="Exit the aim diagnostic">
      <span>Exit diagnostic</span>
      <kbd>Esc</kbd>
    </button>
    <a href="/#apps" class="aim-diag__back">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>

    <div class="aim-diag__grid">
      <div class="aim-diag__copy">
        <div class="aim-diag__brand">
          <img src={product.icon} alt="" />
          <span>TRAINING / AIMMAXXER</span>
          <i>COMING SOON</i>
        </div>
        <p class="aim-diag__eyebrow"><span></span>12-second browser diagnostic <b>HARDENED RUN</b></p>
        <h1>Don’t guess what<br />your aim <em>needs.</em></h1>
        <p class="aim-diag__lede">
          Flick. Track. Switch. Aimmaxxer finds the weakest link, then hands you
          a verified KovaaK’s warm-up for the game you actually play.
        </p>
        <p class="aim-diag__method">Local browser check · best with a mouse or trackpad · no data leaves this tab</p>
        <div class="aim-diag__skill-key" aria-label="Diagnostic stages">
          <span data-skill-key="flick"><i></i><b>Flick</b><small>precision</small></span>
          <span data-skill-key="track"><i></i><b>Track</b><small>control</small></span>
          <span data-skill-key="switch"><i></i><b>Switch</b><small>speed</small></span>
        </div>
        <div class="aim-diag__actions">
          <button type="button" class="aim-diag__start" data-aim-start>
            Run the diagnostic
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <a class="aim-diag__notify" href={product.primaryCta.href} target={product.primaryCta.external ? '_blank' : undefined} rel={product.primaryCta.external ? 'noopener' : undefined}>
            {product.primaryCta.label}
          </a>
        </div>
        <div class="aim-diag__proof">
          <span><b>6</b> games</span>
          <span><b>12</b> real routines</span>
          <span><b>0</b> login</span>
        </div>
      </div>

      <div class="aim-diag__machine">
        <div class="aim-diag__machine-top">
          <span class="aim-diag__machine-label"><i></i>AIM DIAGNOSTIC <small data-aim-mode>HARDENED RUN</small></span>
          <div class="aim-diag__selectors">
            <label>
              GAME
              <select data-aim-game aria-label="Choose your game">
                <option value="fortnite">Fortnite</option>
                <option value="valorant">Valorant</option>
                <option value="cs2">CS2</option>
                <option value="apex">Apex Legends</option>
                <option value="overwatch">Overwatch 2</option>
                <option value="cod">Call of Duty</option>
              </select>
            </label>
            <label>
              GOAL
              <select data-aim-goal aria-label="Choose what you want to improve">
                <option value="balanced">Find my limiter</option>
                <option value="speed">Get faster</option>
                <option value="control">Get steadier</option>
                <option value="consistency">Clean up misses</option>
              </select>
            </label>
          </div>
        </div>

        <div class="aim-diag__loadout" aria-live="polite">
          <span data-aim-game-note>Fortnite · mixed combat / burst flicks + target transfers</span>
          <span data-aim-goal-note>Find my limiter</span>
        </div>

        <div class="aim-diag__arena" data-aim-arena>
          <div class="aim-diag__gridlines" aria-hidden="true"></div>
          <div class="aim-diag__range-mark" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="aim-diag__course" aria-hidden="true">
            <b>TRANSFER COURSE</b>
            <span data-aim-switch-step>01 / 10</span>
            <div>
              <i data-switch-gate="0"></i><i data-switch-gate="1"></i><i data-switch-gate="2"></i>
              <i data-switch-gate="3"></i><i data-switch-gate="4"></i><i data-switch-gate="5"></i>
              <i data-switch-gate="6"></i><i data-switch-gate="7"></i><i data-switch-gate="8"></i>
              <i data-switch-gate="9"></i>
            </div>
          </div>
          <div class="aim-diag__hud">
            <span data-aim-phase>READY</span>
            <b data-aim-time>12.0</b>
          </div>
          <button type="button" class="aim-diag__target aim-diag__target--a" data-aim-target="a" aria-label="Aim target"><i></i><span>A</span></button>
          <button type="button" class="aim-diag__target aim-diag__target--b" data-aim-target="b" aria-label="Second aim target"><i></i><span>B</span></button>
          <div class="aim-diag__crosshair" aria-hidden="true"><i></i></div>
          <p class="aim-diag__instruction" data-aim-instruction>Press start — or watch the calibration run</p>

          <div class="aim-diag__result" data-aim-result aria-live="polite">
            <p data-aim-result-kicker>AWAITING RUN</p>
            <strong data-aim-result-title>YOUR READ WILL LAND HERE</strong>
            <span data-aim-result-copy>Complete the 12-second run to unlock a game-specific warm-up.</span>
            <div class="aim-diag__result-rating">
              <span data-aim-stars aria-label="No result yet">☆☆☆☆☆</span>
              <b data-aim-priority>AWAITING INPUT</b>
            </div>
            <div class="aim-diag__breakdown">
              <span><b>FLICK</b><i data-aim-detail="flick">-- ms · --% accurate</i></span>
              <span><b>TRACK</b><i data-aim-detail="track">--% contact · -- px error</i></span>
              <span><b>SWITCH</b><i data-aim-detail="switch">-- ms · --% accurate</i></span>
            </div>
            <p class="aim-diag__result-next" data-aim-next-step>Click start, then follow the lit target through each stage.</p>
            <small data-aim-input-note>Local only · no data leaves this tab.</small>
            <div class="aim-diag__result-action">
              <code data-aim-code>Run the diagnostic first</code>
              <button type="button" data-aim-copy>Copy code</button>
              <a href="#aim-warmup-heading" data-aim-result-link>View plan</a>
            </div>
          </div>
        </div>

        <div class="aim-diag__scores" aria-label="Diagnostic scores">
          <div><span>FLICK</span><b data-aim-score="flick">--</b><i><em data-aim-fill="flick"></em></i></div>
          <div><span>TRACK</span><b data-aim-score="track">--</b><i><em data-aim-fill="track"></em></i></div>
          <div><span>SWITCH</span><b data-aim-score="switch">--</b><i><em data-aim-fill="switch"></em></i></div>
        </div>
        <div class="aim-diag__machine-bottom">
          <span><i></i>POINTER READY</span>
          <span data-aim-status aria-live="polite">AUTO CALIBRATION</span>
          <button type="button" data-aim-replay>RESTART</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .aim-diagnostic{
    --ad-ember:#ff4b3e;--ad-red:#7e0a10;--ad-track:#ff8a72;--ad-switch:#d11820;--ad-phase:var(--ad-ember);--ad-phase-rgb:255,75,62;--ad-cream:#fff4f2;--ad-ink:#0c0406;--ad-panel:#1c0305;--ad-line:#3c060a;
    position:relative;isolation:isolate;overflow:hidden;min-height:clamp(760px,calc(100svh - 58px),920px);
    color:var(--ad-cream);border-bottom:1px solid var(--color-line);background:
      radial-gradient(65% 85% at 78% 48%,rgba(209,24,32,.15),transparent 64%),
      radial-gradient(38% 50% at 18% 16%,rgba(255,75,62,.08),transparent 72%),
      linear-gradient(135deg,#080102,#140306 48%,#050102);
  }
  .aim-diagnostic::before{content:"";position:absolute;inset:0;opacity:.22;background-image:linear-gradient(rgba(255,75,62,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(209,24,32,.05) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(90deg,transparent,#000 55%,#000)}
  .aim-diagnostic[data-phase="flick"]{--ad-phase:var(--ad-ember);--ad-phase-rgb:255,75,62}.aim-diagnostic[data-phase="track"]{--ad-phase:var(--ad-track);--ad-phase-rgb:255,138,114}.aim-diagnostic[data-phase="switch"]{--ad-phase:var(--ad-switch);--ad-phase-rgb:209,24,32}
  .aim-diag__noise{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:.07;background:repeating-linear-gradient(0deg,#fff 0 1px,transparent 1px 4px)}
  .aim-diag__shell{position:relative;z-index:2;max-width:1380px;margin:0 auto;padding:clamp(76px,9vh,106px) clamp(20px,4vw,54px) 58px}
  .aim-diag__back{display:inline-flex;align-items:center;gap:7px;margin-bottom:32px;color:var(--color-muted);font:600 11px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;transition:color .2s}.aim-diag__back:hover{color:var(--ad-cream)}.aim-diag__back svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.4}
  .aim-diag__grid{display:grid;grid-template-columns:minmax(360px,.8fr) minmax(610px,1.25fr);align-items:center;gap:clamp(46px,6vw,88px)}
  .aim-diag__copy{position:relative}.aim-diag__brand{display:flex;align-items:center;gap:9px;margin-bottom:31px;color:var(--color-text-mid);font:650 9px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__brand img{width:34px;height:34px;border-radius:8px}.aim-diag__brand i{margin-left:auto;padding:6px 8px;border:1px solid rgba(209,24,32,.3);border-radius:4px;color:var(--ad-ember);font-style:normal;font-size:8px}
  .aim-diag__eyebrow{display:flex;align-items:center;gap:9px;margin:0 0 18px;color:var(--ad-ember);font:650 10px/1 var(--font-mono),monospace;letter-spacing:.15em;text-transform:uppercase}.aim-diag__eyebrow span{width:7px;height:7px;border:1px solid var(--ad-ember);border-radius:50%;box-shadow:0 0 13px var(--ad-ember);animation:ad-ready 1.5s ease-in-out infinite}@keyframes ad-ready{50%{background:var(--ad-ember);box-shadow:0 0 4px var(--ad-ember)}}
  .aim-diag__copy h1{max-width:630px;margin:0;font-size:clamp(54px,5.6vw,88px);font-weight:780;line-height:.9;letter-spacing:-.06em}.aim-diag__copy h1 em{color:var(--ad-ember);font-style:normal;text-shadow:0 0 35px rgba(255,75,62,.17)}
  .aim-diag__lede{max-width:540px;margin:27px 0 0;color:var(--color-text-mid);font-size:clamp(15px,1.15vw,18px);line-height:1.62}.aim-diag__method{max-width:540px;margin:13px 0 0;color:var(--color-muted);font:650 8px/1.5 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}.aim-diag__actions{display:flex;flex-wrap:wrap;align-items:center;gap:11px;margin-top:30px}
  .aim-diag__eyebrow b{margin-left:2px;color:var(--color-text);font-size:8px;letter-spacing:.1em}.aim-diag__skill-key{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:540px;margin-top:23px;border:1px solid var(--color-line-strong);background:rgba(12,4,6,.68)}.aim-diag__skill-key span{display:grid;grid-template-columns:auto 1fr;column-gap:7px;align-items:center;padding:9px 10px;border-left:2px solid var(--skill-color)}.aim-diag__skill-key span:first-child{border-left:0}.aim-diag__skill-key [data-skill-key="flick"]{--skill-color:var(--ad-ember)}.aim-diag__skill-key [data-skill-key="track"]{--skill-color:var(--ad-track)}.aim-diag__skill-key [data-skill-key="switch"]{--skill-color:var(--ad-switch)}.aim-diag__skill-key i{grid-row:span 2;width:6px;height:6px;border:1px solid var(--skill-color);border-radius:50%;box-shadow:0 0 9px color-mix(in srgb,var(--skill-color) 55%,transparent)}.aim-diag__skill-key b{color:var(--color-text-mid);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.12em;text-transform:uppercase}.aim-diag__skill-key small{color:var(--color-muted);font:7px/1 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}
  .aim-diag__start,.aim-diag__notify{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:49px;padding:0 20px;border-radius:6px;font-size:12px;font-weight:800;text-decoration:none;cursor:pointer}.aim-diag__start{border:1px solid var(--ad-ember);background:var(--ad-ember);color:#1c0305;box-shadow:0 14px 35px rgba(255,75,62,.2);transition:transform .2s,box-shadow .2s}.aim-diag__start:hover{transform:translateY(-2px);box-shadow:0 18px 42px rgba(255,75,62,.34)}.aim-diag__start svg{width:14px;fill:none;stroke:currentColor;stroke-width:2.5}.aim-diag__notify{border:1px solid var(--color-line-strong);background:var(--color-bg);color:var(--color-text-mid);transition:border-color .2s,color .2s}.aim-diag__notify:hover{border-color:var(--ad-ember);color:var(--color-text)}
  .aim-diag__proof{display:grid;grid-template-columns:repeat(3,1fr);max-width:470px;margin-top:36px;border-top:1px solid var(--color-line-strong)}.aim-diag__proof span{padding:15px 14px 0 0;color:var(--color-muted);font:9px/1 var(--font-mono),monospace;letter-spacing:.1em;text-transform:uppercase}.aim-diag__proof span+span{padding-left:17px;border-left:1px solid var(--color-line-strong)}.aim-diag__proof b{display:block;margin-bottom:7px;color:var(--color-text);font:700 23px/1 var(--font-display),sans-serif}

  .aim-diag__machine{position:relative;min-width:0;border:1px solid var(--color-line-strong);border-radius:13px;overflow:hidden;background:#0c0406;box-shadow:0 35px 90px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.025) inset,0 0 75px rgba(209,24,32,.1)}
  .aim-diag__exit{display:none;align-items:center;gap:9px;padding:8px 11px;border:1px solid #5a0b10;border-radius:6px;background:rgba(12,4,6,.88);color:var(--color-text-mid);font:700 9px var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.aim-diag__exit:hover{border-color:var(--ad-ember);color:var(--color-text)}.aim-diag__exit kbd{padding:3px 5px;border:1px solid #7e0a10;border-radius:3px;color:var(--ad-ember);font:700 8px var(--font-mono),monospace}
  .aim-diag__machine::after{content:"";position:absolute;inset:0;z-index:20;pointer-events:none;box-shadow:inset 0 0 28px rgba(0,0,0,.58)}
  .aim-diag__machine-top,.aim-diag__machine-bottom{display:flex;align-items:center;justify-content:space-between;height:39px;padding:0 13px;background:linear-gradient(180deg,#2a080c,#0c0406);color:var(--color-muted);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.11em}.aim-diag__machine-top>span,.aim-diag__machine-bottom>span{display:flex;align-items:center;gap:6px}.aim-diag__machine-top i,.aim-diag__machine-bottom i{width:5px;height:5px;border-radius:50%;background:var(--ad-phase);box-shadow:0 0 8px var(--ad-phase)}.aim-diag__machine-label small{padding-left:6px;color:var(--ad-phase);font-size:7px;letter-spacing:.1em}
  .aim-diag__selectors{display:flex;align-items:center;gap:9px}.aim-diag__machine-top label{display:flex;align-items:center;gap:7px}.aim-diag__machine-top select{height:25px;max-width:138px;padding:0 23px 0 8px;border:1px solid #5a0b10;border-radius:4px;outline:none;background:var(--ad-panel);color:var(--color-text-mid);font:700 8px var(--font-mono),monospace;text-transform:uppercase;cursor:pointer}.aim-diag__loadout{display:flex;align-items:center;justify-content:space-between;gap:14px;min-height:27px;padding:0 13px;border-bottom:1px solid #3c060a;background:#140306;color:var(--color-muted);font:700 7px/1 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}.aim-diag__loadout span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.aim-diag__loadout span:last-child{flex-shrink:0;color:var(--ad-ember)}
  .aim-diag__arena{position:relative;aspect-ratio:16/9;overflow:hidden;touch-action:none;cursor:crosshair;background:
    radial-gradient(circle at 50% 48%,rgba(var(--ad-phase-rgb),.09),transparent 34%),
    linear-gradient(180deg,#26080d,#0c0406 72%)}
  [data-phase="switch"] .aim-diag__arena{background:radial-gradient(circle at 50% 50%,rgba(209,24,32,.16),transparent 30%),linear-gradient(135deg,#2a080d 0 21%,#110205 21% 52%,#26080d 52% 76%,#0c0406 76%)}
  .aim-diag__arena::before{content:"";position:absolute;left:50%;bottom:0;width:68%;height:65%;transform:translateX(-50%);clip-path:polygon(34% 0,66% 0,100% 100%,0 100%);opacity:.35;background:repeating-linear-gradient(90deg,transparent 0 11.5%,rgba(var(--ad-phase-rgb),.12) 12%,transparent 12.5%),repeating-linear-gradient(0deg,transparent 0 15.5%,rgba(var(--ad-phase-rgb),.12) 16%,transparent 16.5%)}
  .aim-diag__gridlines{position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.8%,rgba(var(--ad-phase-rgb),.1) 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,rgba(var(--ad-phase-rgb),.08) 50%,transparent 50.2%)}
  .aim-diag__range-mark{position:absolute;inset:0;pointer-events:none}.aim-diag__range-mark i{position:absolute;left:50%;top:50%;border:1px solid rgba(var(--ad-phase-rgb),.09);border-radius:50%;transform:translate(-50%,-50%)}.aim-diag__range-mark i:nth-child(1){width:24%;aspect-ratio:1}.aim-diag__range-mark i:nth-child(2){width:48%;aspect-ratio:1}.aim-diag__range-mark i:nth-child(3){width:76%;aspect-ratio:1}
  .aim-diag__hud{position:absolute;z-index:8;left:12px;right:12px;top:10px;display:flex;justify-content:space-between;color:var(--color-text-mid);font:700 8px/1 var(--font-mono),monospace;letter-spacing:.13em}.aim-diag__hud span{padding:5px 7px;border-left:2px solid var(--ad-phase);background:rgba(12,4,6,.72)}.aim-diag__hud b{color:var(--ad-phase);font-size:12px}
  .aim-diag__course{position:absolute;z-index:8;right:12px;bottom:12px;display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid rgba(255,75,62,.18);background:rgba(12,4,6,.72);color:var(--color-muted);font:700 7px/1 var(--font-mono),monospace;letter-spacing:.1em}.aim-diag__course>b{color:var(--ad-cream);font-size:6px}.aim-diag__course>span{color:var(--ad-phase)}.aim-diag__course>div{display:flex;gap:3px}.aim-diag__course i{width:5px;height:5px;border:1px solid var(--ad-red);border-radius:50%;background:transparent}.aim-diag__course i[data-state="done"]{border-color:var(--ad-ember);background:var(--ad-ember)}.aim-diag__course i[data-state="current"]{border-color:var(--ad-cream);background:var(--ad-switch);box-shadow:0 0 8px var(--ad-switch)}
  .aim-diag__target{position:absolute;z-index:6;left:50%;top:50%;display:grid;place-items:center;width:var(--ad-target-size,58px);height:var(--ad-target-size,58px);margin:0;padding:0;border:2px solid color-mix(in srgb,var(--ad-phase) 85%,var(--ad-red));border-radius:50%;background:radial-gradient(circle,#fff4f2 0 10%,var(--ad-switch) 11% 25%,#0c0406 26% 43%,var(--ad-ember) 44% 57%,#0c0406 58%);box-shadow:0 0 0 5px rgba(var(--ad-phase-rgb),.1),0 0 24px rgba(255,75,62,.28);cursor:crosshair;transform:translate(-50%,-50%);transition:left .12s ease,top .12s ease,transform .12s}.aim-diag__target::before,.aim-diag__target::after{content:"";position:absolute;background:rgba(255,244,242,.55)}.aim-diag__target::before{left:-8px;right:-8px;top:50%;height:1px}.aim-diag__target::after{top:-8px;bottom:-8px;left:50%;width:1px}.aim-diag__target i{width:7px;height:7px;border:1px solid #fff;border-radius:50%}.aim-diag__target span{position:absolute;color:#fff4f2;font:800 8px/1 var(--font-mono),monospace;letter-spacing:.04em;text-shadow:0 1px 4px #0c0406}.aim-diag__target--b{display:none}[data-state="running"] .aim-diag__target{transition:none}[data-state="calibration"] .aim-diag__target--a{animation:ad-calibrate 1.25s ease-in-out infinite}@keyframes ad-calibrate{50%{box-shadow:0 0 0 12px rgba(var(--ad-phase-rgb),.05),0 0 32px rgba(255,75,62,.44);transform:translate(-50%,-50%) scale(1.06)}}
  .aim-diag__crosshair{position:absolute;z-index:7;left:50%;top:50%;width:34px;height:34px;margin:-17px;pointer-events:none}.aim-diag__crosshair::before,.aim-diag__crosshair::after,.aim-diag__crosshair i::before,.aim-diag__crosshair i::after{content:"";position:absolute;background:#fff;box-shadow:0 0 4px #000}.aim-diag__crosshair::before{left:0;top:16px;width:11px;height:2px}.aim-diag__crosshair::after{right:0;top:16px;width:11px;height:2px}.aim-diag__crosshair i::before{left:16px;top:0;width:2px;height:11px}.aim-diag__crosshair i::after{left:16px;bottom:0;width:2px;height:11px}
  [data-state="idle"] .aim-diag__target--a{animation:ad-target-demo 6s cubic-bezier(.4,0,.2,1) infinite}[data-state="idle"] .aim-diag__crosshair{animation:ad-cross-demo 6s cubic-bezier(.2,.8,.2,1) infinite}
  @keyframes ad-target-demo{0%,12%{left:26%;top:33%}25%,38%{left:72%;top:62%}50%,63%{left:62%;top:27%}75%,88%{left:34%;top:69%}100%{left:26%;top:33%}}
  @keyframes ad-cross-demo{0%,8%{left:50%;top:50%}16%,23%{left:26%;top:33%}31%,46%{left:72%;top:62%}54%,69%{left:62%;top:27%}77%,94%{left:34%;top:69%}100%{left:50%;top:50%}}
  .aim-diag__instruction{position:absolute;z-index:8;left:50%;bottom:13px;margin:0;transform:translateX(-50%);color:var(--color-muted);font:650 7px/1 var(--font-mono),monospace;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
