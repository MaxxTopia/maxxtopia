    const retestButton = root.querySelector<HTMLButtonElement>('[data-aim-retest]')!;
    const courseGates = Array.from(root.querySelectorAll<HTMLElement>('[data-switch-gate]'));
    const switchStepEl = root.querySelector<HTMLElement>('[data-aim-switch-step]')!;
    const switchStateEl = root.querySelector<HTMLElement>('[data-aim-switch-state]')!;
    const scoreEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-score="${k}"]`)!])) as Record<SkillKey, HTMLElement>;
    const fillEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-fill="${k}"]`)!])) as Record<SkillKey, HTMLElement>;
    const detailEls = Object.fromEntries(keys.map(k => [k, root.querySelector<HTMLElement>(`[data-aim-detail="${k}"]`)!])) as Record<SkillKey, HTMLElement>;

    const hardened = { flickSize: 42, trackSize: 36 } as const;
    const readPlan = {
      scanTotalMs: 32000,
      flickEndsAt: 8500,
      trackEndsAt: 21000,
      minFlickHits: 7,
      minSwitchHits: 8,
      minTrackMs: 9000,
      confirmMs: 10000,
      minConfirmFlickHits: 4,
      minConfirmSwitchHits: 5,
      minConfirmTrackMs: 7000,
    } as const;
    const scoring = {
      flickHit: 100,
      switchHit: 125,
      flickMiss: 35,
      switchMiss: 45,
      trackHit: 8,
      trackMiss: 3,
      trackCadenceMs: 700,
      trackFeedbackMs: 1400,
    } as const;
    const flickLayouts = [
      { x: 16, y: 24 }, { x: 50, y: 20 }, { x: 84, y: 28 }, { x: 27, y: 43 },
      { x: 73, y: 40 }, { x: 42, y: 60 }, { x: 87, y: 63 }, { x: 14, y: 72 },
      { x: 58, y: 34 }, { x: 34, y: 77 }, { x: 68, y: 78 }, { x: 51, y: 52 },
      { x: 20, y: 54 }, { x: 80, y: 51 }, { x: 38, y: 29 }, { x: 63, y: 68 },
    ] as const;
    const switchField: Record<TargetKey, { x: number; y: number; size: number }> = {
      a: { x: 18, y: 25, size: 38 },
      b: { x: 82, y: 24, size: 36 },
      c: { x: 22, y: 76, size: 35 },
      d: { x: 79, y: 73, size: 33 },
    };
    const switchSequence: TargetKey[] = ['a', 'c', 'b', 'd', 'b', 'a', 'd', 'c', 'a', 'd', 'b', 'c'];
    let frame = 0, started = 0, phaseStarted = 0, lastSpawn = 0, lastFrame = 0, active: TargetKey = 'a';
    let stage: RunStage = 'scan';
    let confirmSkill: SkillKey | null = null;
    let scanSnapshot: ReadSnapshot | null = null;
    let scanDecision: FocusDecision | null = null;
    let patternOffset = 0;
    let flickStep = 0;
    let switchStep = 0;
    let confirmFlickStep = 0;
    let confirmSwitchStep = 0;
    let pointerX = -999, pointerY = -999, pointerFrame = 0;
    let flickMisses = 0, switchMisses = 0;
    let trackTotalMs = 0, trackInsideMs = 0, trackErrorPxMs = 0, trackClosenessMs = 0;
    let flickTimes: number[] = [], switchTimes: number[] = [];
    let confirmFlickTimes: number[] = [], confirmSwitchTimes: number[] = [];
    let confirmFlickMisses = 0, confirmSwitchMisses = 0;
    let confirmTrackTotalMs = 0, confirmTrackInsideMs = 0, confirmTrackErrorPxMs = 0, confirmTrackClosenessMs = 0;
    let immersive = false, previousFocus: HTMLElement | null = null, pauseStarted = 0, pausedMs = 0;
    let runScore = 0, combo = 0, maxCombo = 0;
    let lastTrackScoreAt = 0, lastTrackFeedbackAt = 0, lastTrackInside: boolean | null = null;

    const clamp = (n: number) => Math.max(0, Math.min(100, Math.round(n)));
    const clampScore = (n: number) => Math.max(0, Math.min(1000, Math.round(n)));
    const rankLadder = [
      { min: 0, title: 'NEEDS WORK' },
      { min: 180, title: 'APPRENTICE' },
      { min: 360, title: 'AMATEUR' },
      { min: 560, title: 'MASTER' },
      { min: 760, title: 'GOD AIMER' },
      { min: 920, title: 'AIMMAXXER' },
    ] as const;
    const rankFor = (score: number) => [...rankLadder].reverse().find(entry => score >= entry.min) || rankLadder[0];
    const median = (values: number[]) => {
      if (!values.length) return 999;
      const sorted = [...values].sort((a, b) => a - b);
      const mid = Math.floor(sorted.length / 2);
      return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
    };
    const accuracy = (hits: number, misses: number) => Math.round((hits / Math.max(1, hits + misses)) * 100);
    const formatSeconds = (milliseconds: number) => `${(milliseconds / 1000).toFixed(2)} sec`;
    const clickScore = (times: number[], misses: number, minSamples = readPlan.minSwitchHits) => {
      if (!times.length) return 0;
      const speed = clamp(100 - Math.max(0, median(times) - 180) / 5.2);
      const acc = accuracy(times.length, misses);
      const raw = clamp(speed * .72 + acc * .28);
      // A tiny sample should not be able to look like a perfect read. Once the
      // minimum sample is reached, the measured score is allowed through.
      const sampleWeight = Math.min(1, times.length / Math.max(1, minSamples));
      return clamp(50 + (raw - 50) * sampleWeight);
    };
    const setTargetSize = (target: HTMLElement, size: number) => {
      target.style.setProperty('--ad-target-size', `${size}px`);
    };
    const updateSelectionSummary = () => {
      const gameKey = game.value as keyof typeof gameNames;
      const goalKey = (goal.value || 'balanced') as TrainingGoal;
      gameNote.textContent = `${gameNames[gameKey] || 'Your game'} · ${gameNotes[gameKey] || 'mixed aim profile'}`;
      goalNote.textContent = goalNames[goalKey] || goalNames.balanced;
      goalNote.title = goalDescriptions[goalKey] || goalDescriptions.balanced;
      goalNote.setAttribute('aria-label', `${goalNote.textContent}. ${goalNote.title}`);
    };
    const place = (target: HTMLElement, size = hardened.flickSize, currentStage: RunStage = 'scan') => {
      const step = currentStage === 'confirm' ? confirmFlickStep++ : flickStep++;
      const layout = flickLayouts[(step + patternOffset + (currentStage === 'confirm' ? 3 : 0)) % flickLayouts.length];
      setTargetSize(target, size);
      target.style.left = `${layout.x}%`;
      target.style.top = `${layout.y}%`;
      lastSpawn = performance.now();
    };
    const activeSwitchAt = (step: number, offset = 0): TargetKey =>
      switchSequence[(step + offset) % switchSequence.length];
    const setActiveSwitchTarget = () => {
      root.dataset.activeTarget = active;
      targets.forEach(target => {
        const isActive = target.dataset.aimTarget === active;
        target.style.display = isActive ? 'grid' : 'none';
        target.tabIndex = isActive ? 0 : -1;
        target.setAttribute('aria-label', isActive ? 'Active switch target' : 'Inactive switch target');
        if (isActive) {
          target.removeAttribute('aria-hidden');
        } else {
          if (document.activeElement === target) target.blur();
          target.setAttribute('aria-hidden', 'true');
        }
      });
    };
    const applySwitchLayout = () => {
      targets.forEach(target => {
        const key = target.dataset.aimTarget as TargetKey;
        const layout = switchField[key];
        target.style.left = `${layout.x}%`;
        target.style.top = `${layout.y}%`;
        setTargetSize(target, layout.size + (key === active ? 4 : 0));
      });
      setActiveSwitchTarget();
    };
    const updateSwitchCourse = () => {
      const total = courseGates.length || switchSequence.length;
      const currentStep = stage === 'confirm' ? confirmSwitchStep : switchStep;
      const minimum = stage === 'confirm' ? readPlan.minConfirmSwitchHits : readPlan.minSwitchHits;
      const completed = Math.min(currentStep, total);
      const current = Math.min(currentStep, total - 1);
      switchStepEl.textContent = `${String(completed).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      if (root.dataset.state !== 'running' || root.dataset.phase !== 'switch') {
        switchStateEl.textContent = 'WARMING UP';
      } else if (currentStep >= total) {
        switchStateEl.textContent = 'KEEP GOING';
      } else if (currentStep >= minimum) {
        switchStateEl.textContent = 'ENOUGH · KEEP GOING';
      } else {
        switchStateEl.textContent = `${minimum - currentStep} MORE NEEDED`;
      }
      courseGates.forEach((gate, index) => {
        gate.dataset.state = index < currentStep ? 'done' : index === current && currentStep < total ? 'current' : 'upcoming';
      });
    };
    const setScore = (key: SkillKey, value: number) => {
      scoreEls[key].textContent = String(value);
      fillEls[key].style.width = `${value}%`;
    };
    const routineFor = (skill: SkillKey) =>
      weaknessRoutines[skill][game.value] || weaknessRoutines[skill].default;

    const routineAnchor = (routine: Routine) => {
      const card = Array.from(document.querySelectorAll<HTMLElement>('[data-aim-routine-code]'))
        .find((candidate) => candidate.dataset.aimRoutineCode === routine.code && candidate.dataset.aimRoutineName === routine.name)
        || Array.from(document.querySelectorAll<HTMLElement>('[data-aim-routine-code]'))
          .find((candidate) => candidate.dataset.aimRoutineCode === routine.code);
      return card?.id ? `#${card.id}` : '#aim-warmup-heading';
    };
    type StoredRead = { game?: string; skill?: SkillKey; score?: number; mode?: 'limiter' | 'balanced' };
    const readLastRun = () => {
      try {
        const raw = window.localStorage.getItem('aimmaxxer:last-read');
        return raw ? JSON.parse(raw) as StoredRead : null;
      } catch {
        return null;
      }
    };
    const rememberRun = (skill: SkillKey, score: number, mode: StoredRead['mode'] = 'limiter') => {
      try {
        window.localStorage.setItem('aimmaxxer:last-read', JSON.stringify({ game: game.value, skill, score, mode }));
      } catch {
        // Private browsing and blocked storage should not interrupt a read.
      }
    };
    const renderHistory = () => {
      const previous = readLastRun();
      if (!previous?.skill) {
        historyEl.textContent = 'First read on this browser. Retest after your warm-up to compare.';
        return;
      }
      const previousGame = gameNames[previous.game as keyof typeof gameNames] || 'Previous game';
      const previousSkill = previous.mode === 'balanced'
        ? 'Balanced starting point'
        : skillPlans[previous.skill as SkillKey]?.label || 'Previous limiter';
      historyEl.textContent = `Previous local read: ${previousGame} · ${previousSkill} ${previous.score ?? '--'}/100. Retest after your block to compare.`;
    };

    type PersonalRun = {
      id: string;
      score: number;
      game: string;
      hits: number;
      misses: number;
      accuracy: number;
      combo: number;
      createdAt: number;
    };
    const personalBoardKey = 'aimmaxxer:personal-board:v2';
    const formatScore = (value: number) => Math.max(0, Math.round(value)).toLocaleString('en-US');
    const provisionalRankScore = () => {
      const currentMinimums = stage === 'confirm'
        ? { flick: readPlan.minConfirmFlickHits, switch: readPlan.minConfirmSwitchHits }
        : { flick: readPlan.minFlickHits, switch: readPlan.minSwitchHits };
      const currentFlickTimes = stage === 'confirm' ? confirmFlickTimes : flickTimes;
      const currentFlickMisses = stage === 'confirm' ? confirmFlickMisses : flickMisses;
      const currentSwitchTimes = stage === 'confirm' ? confirmSwitchTimes : switchTimes;
      const currentSwitchMisses = stage === 'confirm' ? confirmSwitchMisses : switchMisses;
      const currentTrackTotalMs = stage === 'confirm' ? confirmTrackTotalMs : trackTotalMs;
      const currentTrackInsideMs = stage === 'confirm' ? confirmTrackInsideMs : trackInsideMs;
      const currentTrackClosenessMs = stage === 'confirm' ? confirmTrackClosenessMs : trackClosenessMs;
      const samples: number[] = [];
      if (currentFlickTimes.length || currentFlickMisses) {
        samples.push(clickScore(currentFlickTimes, currentFlickMisses, currentMinimums.flick));
      }
      if (currentTrackTotalMs > 0) {
        const contact = (currentTrackInsideMs / Math.max(1, currentTrackTotalMs)) * 100;
        const closeness = (currentTrackClosenessMs / Math.max(1, currentTrackTotalMs)) * 100;
        samples.push(clamp(contact * .62 + closeness * .38));
      }
      if (currentSwitchTimes.length || currentSwitchMisses) {
        samples.push(clickScore(currentSwitchTimes, currentSwitchMisses, currentMinimums.switch));
      }
      if (!samples.length) return 0;
      const coverage = samples.length / keys.length;
      const quality = samples.reduce((sum, value) => sum + value, 0) / samples.length;
      const comboBoost = Math.min(10, Math.round(maxCombo / 20 * 10));
      return clampScore(quality * 10 * coverage + comboBoost);
    };
    const updateRankMeter = (score = provisionalRankScore()) => {
      const safeScore = clampScore(score);
      const rank = rankFor(safeScore);
      const rankIndex = rankLadder.findIndex(entry => entry.title === rank.title);
      const nextRank = rankLadder[rankIndex + 1];
      liveRankEl.textContent = rank.title;
      liveRankScoreEl.textContent = `${formatScore(safeScore)} / 1000`;
      liveRankFill.style.width = `${safeScore / 10}%`;
      liveRankBar.setAttribute('aria-valuenow', String(safeScore));
      liveRankBar.setAttribute('aria-valuetext', `${rank.title}, ${safeScore} out of 1000`);
      liveRankNextEl.textContent = nextRank
        ? `Next: ${nextRank.title} at ${nextRank.min}`
        : 'MAX TIER · AIMMAXXER';
    };
    const updateRunScore = () => {
      liveScoreEl.textContent = formatScore(runScore);
      comboEl.textContent = `COMBO ${combo}`;
      updateRankMeter();
    };
    const showScorePop = (points: number, target: HTMLElement | null = null, kind: 'positive' | 'negative' | 'track' = 'positive') => {
      const arenaRect = arena.getBoundingClientRect();
      if (!arenaRect.width || !arenaRect.height) return;
      const targetRect = target?.getBoundingClientRect();
      const fallbackX = pointerX >= arenaRect.left && pointerX <= arenaRect.right ? pointerX : arenaRect.left + arenaRect.width / 2;
      const fallbackY = pointerY >= arenaRect.top && pointerY <= arenaRect.bottom ? pointerY : arenaRect.top + arenaRect.height / 2;
      const x = targetRect ? targetRect.left + targetRect.width / 2 : fallbackX;
      const y = targetRect ? targetRect.top + targetRect.height / 2 : fallbackY;
      const pop = document.createElement('span');
      pop.className = 'aim-diag__score-pop';
      pop.dataset.kind = kind === 'negative' ? 'negative' : kind === 'track' ? 'track' : combo >= 3 ? 'combo' : 'positive';
      pop.textContent = points >= 0 ? `+${points}` : `−${Math.abs(points)}`;
      pop.style.left = `${Math.max(12, Math.min(arenaRect.width - 12, x - arenaRect.left))}px`;
      pop.style.top = `${Math.max(20, Math.min(arenaRect.height - 12, y - arenaRect.top))}px`;
      pop.setAttribute('aria-hidden', 'true');
      arena.append(pop);
      window.setTimeout(() => pop.remove(), 820);
      if (kind !== 'track') {
        scoreAnnouncerEl.textContent = points >= 0
          ? `Plus ${points} points${combo > 1 ? `. Combo ${combo}.` : '.'}`
          : `Minus ${Math.abs(points)} points.`;
      }
    };
    const awardHit = (basePoints: number, target: HTMLElement) => {
      combo++;
      maxCombo = Math.max(maxCombo, combo);
      const multiplier = 1 + Math.min(.75, Math.max(0, combo - 1) * .05);
      const points = Math.round(basePoints * multiplier);
      runScore += points;
      updateRunScore();
      showScorePop(points, target);
    };
    const registerMiss = (penalty: number, target: HTMLElement | null = null) => {
      combo = 0;
      runScore = Math.max(0, runScore - penalty);
      updateRunScore();
      showScorePop(-penalty, target, 'negative');
    };
    const awardTrackTick = (inside: boolean, target: HTMLElement) => {
      const now = performance.now();
      if (now - lastTrackScoreAt < scoring.trackCadenceMs) return;
      lastTrackScoreAt = now;
      const points = inside ? scoring.trackHit : -scoring.trackMiss;
      runScore = Math.max(0, runScore + points);
      updateRunScore();
      if (lastTrackInside !== inside || now - lastTrackFeedbackAt >= scoring.trackFeedbackMs) {
        showScorePop(points, target, 'track');
        lastTrackFeedbackAt = now;
      }
      lastTrackInside = inside;
    };
    const isPersonalRun = (value: unknown): value is PersonalRun => {
      if (!value || typeof value !== 'object') return false;
      const entry = value as Record<string, unknown>;
      return typeof entry.id === 'string'
        && typeof entry.game === 'string'
        && typeof entry.score === 'number' && Number.isFinite(entry.score)
        && typeof entry.hits === 'number' && Number.isFinite(entry.hits)
        && typeof entry.misses === 'number' && Number.isFinite(entry.misses)
        && typeof entry.accuracy === 'number' && Number.isFinite(entry.accuracy)
        && typeof entry.combo === 'number' && Number.isFinite(entry.combo)
        && typeof entry.createdAt === 'number' && Number.isFinite(entry.createdAt);
    };
    const readPersonalBoard = (): PersonalRun[] => {
      try {
        const raw = window.localStorage.getItem(personalBoardKey);
        const parsed: unknown = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(parsed)) return [];
        return parsed.filter(isPersonalRun).sort((a, b) => b.score - a.score || b.createdAt - a.createdAt).slice(0, 5);
      } catch {
        return [];
      }
    };
    const savePersonalRun = (entry: PersonalRun) => {
      const board = [entry, ...readPersonalBoard()]
        .sort((a, b) => b.score - a.score || b.createdAt - a.createdAt)
        .slice(0, 5);
      try {
        window.localStorage.setItem(personalBoardKey, JSON.stringify(board));
      } catch {
        // Private browsing and blocked storage should not interrupt a read.
      }
      return board;
    };
    const renderPersonalBoard = (board: PersonalRun[] = readPersonalBoard()) => {
      personalListEl.replaceChildren();
      if (!board.length) {
        const empty = document.createElement('li');
        empty.className = 'is-empty';
        empty.textContent = 'Complete a full read to set your first score.';
        personalListEl.append(empty);
        return;
      }
      board.forEach((entry, index) => {
        const item = document.createElement('li');
        const rank = document.createElement('b');
        const score = document.createElement('strong');
        const meta = document.createElement('small');
        rank.textContent = `#${index + 1}`;
        score.textContent = `SCORE ${formatScore(entry.score)}`;
        const hitLabel = `${entry.hits} hit${entry.hits === 1 ? '' : 's'}`;
        const missLabel = `${entry.misses} miss${entry.misses === 1 ? '' : 'es'}`;
        meta.textContent = `${rankFor(entry.score).title} · ${gameNames[entry.game as keyof typeof gameNames] || entry.game} · ${hitLabel} · ${missLabel} · best combo ${entry.combo}x`;
        item.append(rank, score, meta);
        personalListEl.append(item);
      });
    };
    const updateRunSummary = (clickAccuracy: number, board: PersonalRun[], note: string) => {
      runSummaryEl.hidden = false;
      personalBoardEl.hidden = false;
      runScoreEl.textContent = formatScore(runScore);
      runAccuracyEl.textContent = `${clickAccuracy}%`;
      runBestEl.textContent = board[0] ? formatScore(board[0].score) : '--';
      runSummaryNoteEl.textContent = `${note} Run score is for comparing your own attempts, not an overall skill rating.`;
      renderPersonalBoard(board);
    };
    const resetRunScore = () => {
      runScore = 0;
      combo = 0;
      maxCombo = 0;
      lastTrackScoreAt = 0;
      lastTrackFeedbackAt = 0;
      lastTrackInside = null;
      updateRunScore();
      runSummaryEl.hidden = true;
      personalBoardEl.hidden = true;
      scoreAnnouncerEl.textContent = '';
      renderPersonalBoard();
      updateRankMeter(0);
    };

    const resetResultScroll = () => {
      arena.scrollTop = 0;
      resultPanel.scrollTop = 0;
    };

    const setResultAccessibility = (visible: boolean) => {
      resultPanel.setAttribute('aria-hidden', visible ? 'false' : 'true');
      resultPanel.toggleAttribute('inert', !visible);
    };

    const resetScores = () => {
      keys.forEach(key => {
        scoreEls[key].textContent = '--';
        fillEls[key].style.width = '0';
        detailEls[key].textContent = '--';
      });
    };

    const resetSurface = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      resetResultScroll();
      setResultAccessibility(false);
      pauseStarted = 0;
      pausedMs = 0;
      stage = 'scan';
      confirmSkill = null;
      scanSnapshot = null;
      scanDecision = null;
      confirmFlickTimes = [];
      confirmSwitchTimes = [];
      confirmFlickMisses = confirmSwitchMisses = 0;
      confirmTrackTotalMs = confirmTrackInsideMs = confirmTrackErrorPxMs = confirmTrackClosenessMs = 0;
      flickTimes = [];
      switchTimes = [];
      flickMisses = switchMisses = 0;
      trackTotalMs = trackInsideMs = trackErrorPxMs = trackClosenessMs = 0;
      root.dataset.state = 'idle';
      root.removeAttribute('data-phase');
      root.removeAttribute('data-active-target');
      rankMeter.hidden = true;
      flickStep = 0;
      switchStep = 0;
      confirmFlickStep = 0;
      confirmSwitchStep = 0;
      modeEl.textContent = 'SCAN';
      phaseEl.textContent = 'READY';
      timeEl.textContent = (readPlan.scanTotalMs / 1000).toFixed(1);
      instruction.textContent = 'Click Run the diagnostic, then the center target';
      startGuide.hidden = true;
      status.textContent = 'AUTO CALIBRATION';
      updateSwitchCourse();
      updateSelectionSummary();
      resetScores();
      resetRunScore();
      crosshair.dataset.pointer = 'preview';
      crosshair.classList.remove('is-pointer');
      crosshair.style.removeProperty('left');
      crosshair.style.removeProperty('top');
      resultKicker.textContent = 'AWAITING RUN';
      resultTitle.textContent = 'YOUR NEXT EDGE WILL LAND HERE';
      resultCopy.textContent = `Complete the ${readPlan.scanTotalMs / 1000}-second scan to get a first-pass read. The ${readPlan.confirmMs / 1000}-second confirmation is optional.`;
      starsEl.textContent = 'FOCUS PRIORITY · VERIFY';
      starsEl.setAttribute('aria-label', 'No result yet');
      priorityEl.textContent = 'NO RANK YET';
      planLabelEl.textContent = "RECOMMENDED KOVAAK'S BLOCK";
      planTitle.textContent = 'Finish the read to reveal your warm-up';
      planMeta.textContent = 'Your focused routine appears after enough confirmed input.';
      nextStepEl.textContent = 'Run the diagnostic, hit the center target, then follow each phase prompt.';
      resultWhy.textContent = 'Each phase measures a different aim skill so the recommendation is based on what you actually did.';
      confidenceEl.textContent = 'Your read appears after enough confirmed input.';
      inputNote.textContent = 'Local only · no data leaves this tab.';
      renderHistory();
      codeEl.textContent = 'Run the diagnostic first';
      copyButton.disabled = true;
      copyButton.textContent = 'Copy code';
      copyButton.classList.remove('is-copied');
      resultLink.textContent = 'Start this warm-up';
      resultLink.href = '#aim-warmup-heading';
      confirmButton.hidden = true;
      confirmButton.disabled = false;
      retestButton.disabled = false;
      targets.forEach(target => {
        target.style.display = '';
        target.style.opacity = '';
        target.style.transform = '';
        target.removeAttribute('aria-hidden');
        target.removeAttribute('tabindex');
        target.style.removeProperty('--ad-target-size');
        target.style.removeProperty('left');
        target.style.removeProperty('top');
      });
      targets[0].setAttribute('aria-label', 'Aim target');
      targets[1].setAttribute('aria-label', 'Second aim target');
    };

    const focusCalibrationTarget = () => {
      window.setTimeout(() => {
        if (root.dataset.state === 'calibration') targets[0].focus({ preventScroll: true });
      }, 0);
    };

    const exitImmersive = () => {
      if (!immersive && !root.classList.contains('is-immersive')) return;
      immersive = false;
      resetSurface();
      root.classList.remove('is-immersive');
      root.removeAttribute('role');
      root.removeAttribute('aria-modal');
      document.documentElement.classList.remove('aim-diagnostic-active');
      const focusTarget = previousFocus;
      previousFocus = null;
      focusTarget?.focus({ preventScroll: true });
    };

    const enterImmersive = () => {
      if (!immersive) {
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        immersive = true;
        root.classList.add('is-immersive');
        root.setAttribute('role', 'dialog');
        root.setAttribute('aria-modal', 'true');
        document.documentElement.classList.add('aim-diagnostic-active');
      }
    };

    const setPhaseInstruction = (phase: SkillKey) => {
      if (stage === 'confirm') {
        if (phase === 'flick') {
          instruction.textContent = confirmFlickTimes.length >= readPlan.minConfirmFlickHits
            ? 'Confirmation flicks locked · keep the clicks clean'
            : `Confirm the flick read · ${readPlan.minConfirmFlickHits - confirmFlickTimes.length} more clean hits needed`;
          return;
        }
        if (phase === 'track') {
          instruction.textContent = 'Confirm tracking · stay connected to the moving target · no click or hold';
          return;
        }
        instruction.textContent = confirmSwitchStep >= readPlan.minConfirmSwitchHits
          ? 'Confirmation transfers locked · keep the hand-offs clean'
          : `Confirm switching · ${readPlan.minConfirmSwitchHits - confirmSwitchStep} more transfers needed`;
        return;
      }
      instruction.textContent = phase === 'flick'
        ? flickTimes.length >= readPlan.minFlickHits
          ? 'Click each target once · sample met · keep going'
          : `Click each target once · ${readPlan.minFlickHits - flickTimes.length} more clean hits needed`
        : phase === 'track'
          ? 'Move the crosshair with the target · no click or hold needed'
          : switchStep >= readPlan.minSwitchHits
            ? 'Click the lit target, then find the next · sample met'
            : `Click the lit target, then find the next · ${readPlan.minSwitchHits - switchStep} more needed`;
    };

    const revealResult = (phase?: SkillKey, resultStage: 'first-pass' | 'scan' | 'final' | 'inconclusive' = 'final') => {
      resetResultScroll();
      setResultAccessibility(true);
      root.dataset.state = 'result';
      root.dataset.resultStage = resultStage;
      if (phase) root.dataset.phase = phase;
      else root.removeAttribute('data-phase');
      window.setTimeout(() => resultTitle.focus({ preventScroll: true }), 0);
    };

    const trackingFor = (currentStage: RunStage): TrackingStats =>
      currentStage === 'confirm'
        ? {
            totalMs: confirmTrackTotalMs,
            insideMs: confirmTrackInsideMs,
            errorPxMs: confirmTrackErrorPxMs,
            closenessMs: confirmTrackClosenessMs,
          }
        : {
            totalMs: trackTotalMs,
            insideMs: trackInsideMs,
            errorPxMs: trackErrorPxMs,
            closenessMs: trackClosenessMs,
          };

    const trackScore = (stats: TrackingStats) => {
      const contact = (stats.insideMs / Math.max(1, stats.totalMs)) * 100;
      const closeness = (stats.closenessMs / Math.max(1, stats.totalMs)) * 100;
      return clamp(contact * .62 + closeness * .38);
    };

    const snapshotFrom = (
      flickValues: number[],
      flickMissCount: number,
      switchValues: number[],
      switchMissCount: number,
      trackStats: TrackingStats,
      minimums: { flick: number; switch: number; track: number; required?: SkillKey },
    ): ReadSnapshot => {
      const flickMedian = Math.round(median(flickValues));
      const switchMedian = Math.round(median(switchValues));
      const flickAccuracy = accuracy(flickValues.length, flickMissCount);
      const switchAccuracy = accuracy(switchValues.length, switchMissCount);
      const trackContact = Math.round((trackStats.insideMs / Math.max(1, trackStats.totalMs)) * 100);
      const trackError = Math.round(trackStats.errorPxMs / Math.max(1, trackStats.totalMs));
      const trackCloseness = (trackStats.closenessMs / Math.max(1, trackStats.totalMs)) * 100;
      const clickHits = flickValues.length + switchValues.length;
      const clickMisses = flickMissCount + switchMissCount;
      const evidenceGaps: string[] = [];
      const requiredSkills: SkillKey[] = minimums.required ? [minimums.required] : keys;
      if (requiredSkills.includes('flick') && flickValues.length < minimums.flick) evidenceGaps.push(`${minimums.flick - flickValues.length} more flick hits`);
      if (requiredSkills.includes('switch') && switchValues.length < minimums.switch) evidenceGaps.push(`${minimums.switch - switchValues.length} more transfers`);
      if (requiredSkills.includes('track') && trackStats.totalMs < minimums.track) evidenceGaps.push(`${Math.ceil((minimums.track - trackStats.totalMs) / 1000)} more seconds tracking`);
      return {
        scores: {
          flick: clickScore(flickValues, flickMissCount, minimums.flick),
          track: trackScore(trackStats),
          switch: clickScore(switchValues, switchMissCount, minimums.switch),
        },
        flickTimes: [...flickValues],
        flickMisses: flickMissCount,
        switchTimes: [...switchValues],
        switchMisses: switchMissCount,
        track: { ...trackStats },
        flickMedian,
        switchMedian,
        flickAccuracy,
        switchAccuracy,
        trackContact,
        trackError,
        trackCloseness,
        trackSeconds: Math.round(trackStats.totalMs / 1000),
        clickHits,
        clickMisses,
        clickAccuracy: accuracy(clickHits, clickMisses),
        evidenceGaps,
        sufficient: evidenceGaps.length === 0,
      };
    };

    const buildSnapshot = (currentStage: RunStage): ReadSnapshot =>
      currentStage === 'confirm'
        ? snapshotFrom(
            confirmFlickTimes,
            confirmFlickMisses,
            confirmSwitchTimes,
            confirmSwitchMisses,
            trackingFor('confirm'),
            { flick: readPlan.minConfirmFlickHits, switch: readPlan.minConfirmSwitchHits, track: readPlan.minConfirmTrackMs, required: confirmSkill || 'track' },
          )
        : snapshotFrom(
            flickTimes,
            flickMisses,
            switchTimes,
            switchMisses,
            trackingFor('scan'),
            { flick: readPlan.minFlickHits, switch: readPlan.minSwitchHits, track: readPlan.minTrackMs },
          );

    const renderSnapshot = (snapshot: ReadSnapshot) => {
      keys.forEach(key => setScore(key, snapshot.scores[key]));
      detailEls.flick.textContent = `${snapshot.flickTimes.length ? formatSeconds(snapshot.flickMedian) : '--'} · ${snapshot.flickAccuracy}% accurate`;
      detailEls.track.textContent = `${snapshot.trackContact}% on target · about ${snapshot.trackError} px away`;
      detailEls.switch.textContent = `${snapshot.switchTimes.length ? formatSeconds(snapshot.switchMedian) : '--'} · ${snapshot.switchAccuracy}% accurate`;
    };

    const chooseFocus = (scores: Record<SkillKey, number>): FocusDecision => {
      const goalKey = (goal.value || 'balanced') as TrainingGoal;
      const tieOrder: SkillKey[] = goalKey === 'speed'
        ? ['switch', 'flick', 'track']
        : goalKey === 'control'
          ? ['track', 'flick', 'switch']
          : goalKey === 'consistency'
            ? ['flick', 'switch', 'track']
            : keys;
      const ordered = [...keys].sort((a, b) => {
        const difference = scores[a] - scores[b];
        return Math.abs(difference) <= 7 ? tieOrder.indexOf(a) - tieOrder.indexOf(b) : difference;
      });
      const weak = ordered[0] || 'track';
      const runnerUp = ordered[1] || weak;
      const gap = Math.max(0, scores[runnerUp] - scores[weak]);
      const balanced = gap <= 8;
      const balancedSkill: SkillKey = goalKey === 'speed'
        ? 'switch'
        : goalKey === 'control'
          ? 'track'
          : goalKey === 'consistency'
            ? 'flick'
            : weak;
      return { weak, runnerUp, gap, balanced, focusSkill: balanced ? balancedSkill : weak };
    };

    const mergeTracking = (first: TrackingStats, second: TrackingStats): TrackingStats => ({
      totalMs: first.totalMs + second.totalMs,
      insideMs: first.insideMs + second.insideMs,
      errorPxMs: first.errorPxMs + second.errorPxMs,
      closenessMs: first.closenessMs + second.closenessMs,
    });

    const buildFinalSnapshot = (confirmation: ReadSnapshot): ReadSnapshot => {
      if (!scanSnapshot || !confirmSkill) return confirmation;
      const merged = snapshotFrom(
        [...scanSnapshot.flickTimes, ...confirmation.flickTimes],
        scanSnapshot.flickMisses + confirmation.flickMisses,
        [...scanSnapshot.switchTimes, ...confirmation.switchTimes],
        scanSnapshot.switchMisses + confirmation.switchMisses,
        mergeTracking(scanSnapshot.track, confirmation.track),
        { flick: readPlan.minFlickHits, switch: readPlan.minSwitchHits, track: readPlan.minTrackMs },
      );
      const scores: Record<SkillKey, number> = { ...scanSnapshot.scores };
      scores[confirmSkill] = clamp(scanSnapshot.scores[confirmSkill] * .45 + confirmation.scores[confirmSkill] * .55);
      return { ...merged, scores };
    };

    const setNoRoutineAction = (message: string) => {
      codeEl.textContent = message;
      copyButton.disabled = true;
      copyButton.textContent = 'Copy code';
      copyButton.classList.remove('is-copied');
      resultLink.textContent = 'Browse routines';
      resultLink.href = '#aim-warmup-heading';
    };

    const showScanInconclusive = (snapshot: ReadSnapshot) => {
      const missing = snapshot.evidenceGaps.join(' · ');
      instruction.textContent = 'Not enough confirmed input — retest with the full scan';
      resultKicker.textContent = 'SCAN INCOMPLETE';
      resultTitle.textContent = 'FINISH THE FULL SCAN';
      resultCopy.textContent = 'This attempt stopped before we had enough clean evidence to score your aim. No rank or routine yet.';
      starsEl.textContent = 'NO SCORE YET';
      starsEl.setAttribute('aria-label', 'No score yet');
      priorityEl.textContent = 'FULL SCAN REQUIRED';
      planLabelEl.textContent = 'NO ROUTINE YET';
      planTitle.textContent = 'Finish the full scan';
      planMeta.textContent = missing ? `Still needed: ${missing}.` : 'Keep moving through every phase.';
      nextStepEl.textContent = missing
        ? `Still needed: ${missing}. Retest and complete every phase.`
        : 'Retest and complete every phase for a clean read.';
      resultWhy.textContent = 'A fair read needs a usable sample from flicking, tracking, and switching. Partial evidence stays inconclusive.';
      confidenceEl.textContent = `Evidence collected: ${snapshot.flickTimes.length} flicks · ${snapshot.switchTimes.length} transfers · ${snapshot.trackSeconds}s tracking. Missing: ${missing}.`;
      inputNote.textContent = 'Partial read · no routine selected and nothing uploaded.';
      historyEl.textContent = 'No local history saved from an inconclusive read. Complete the next run to compare later.';
      setNoRoutineAction('Run again to unlock a routine');
      confirmButton.hidden = true;
      confirmButton.disabled = false;
      resetRunScore();
      phaseEl.textContent = 'COMPLETE';
      timeEl.textContent = '0.0';
      status.textContent = 'MORE INPUT NEEDED';
      revealResult(undefined, 'inconclusive');
    };

    const finishResolvedRead = (
      finalSnapshot: ReadSnapshot,
      focusSkill: SkillKey,
      confirmedLimiter: boolean,
      firstPass: boolean,
      persist: boolean = true,
    ) => {
      renderSnapshot(finalSnapshot);
      const finalDecision = chooseFocus(finalSnapshot.scores);
      const evidenceDecision = scanDecision || finalDecision;
      const hasCandidate = !evidenceDecision.balanced;
      const selectedGame = gameNames[game.value as keyof typeof gameNames] || 'your game';
      const routine = routineFor(focusSkill);
      const plan = skillPlans[focusSkill];
      const focusLabel = plan.label;
      const runScoreValue = finalSnapshot.scores.flick * .34 + finalSnapshot.scores.track * .33 + finalSnapshot.scores.switch * .33;
      runScore = clampScore(runScoreValue * 10 + Math.min(10, Math.round(maxCombo / 20 * 10)));
      updateRunScore();
      const skillRank = rankFor(runScore);
      const titles: Record<SkillKey, string> = {
        flick: 'YOUR GAP: FLICKING',
        track: 'YOUR GAP: TRACKING',
        switch: 'YOUR GAP: SWITCHING',
      };
      const nextSteps: Record<SkillKey, string> = {
        flick: 'Run one focused block. Keep first clicks clean; add speed only when accuracy holds.',
        track: 'Run one smoothness block. Stay connected; add speed only when you can hold the target.',
        switch: 'Run one transfer block. Confirm each target, then add speed between clean hand-offs.',
      };
      const goalKey = (goal.value || 'balanced') as TrainingGoal;
      const goalAdvice: Record<TrainingGoal, string> = {
        balanced: 'Retest after the block to see if the gap closes.',
        speed: 'Add pace after the first clean set; speed without confirmation adds misses.',
        control: 'Protect smoothness before chasing a faster score.',
        consistency: 'Prioritize clean contacts and repeatable stops before increasing difficulty.',
      };
      const goalReason = evidenceDecision.balanced && goalKey !== 'balanced'
        ? `${goalNames[goalKey]} selected ${focusLabel.toLowerCase()} as the practice priority because the measured skills are close; it changes the training emphasis, not the raw score.`
        : `The measured scores selected ${focusLabel.toLowerCase()} as the current starting point; ${goalNames[goalKey].toLowerCase()} shapes the coaching around it.`;
      const metricWhy: Record<SkillKey, string> = {
        flick: `Your clicks averaged ${formatSeconds(finalSnapshot.flickMedian)} with ${finalSnapshot.flickAccuracy}% accuracy`,
        track: `You held the target for ${finalSnapshot.trackContact}% of the run and stayed about ${finalSnapshot.trackError}px away on average`,
        switch: `Your transfers averaged ${formatSeconds(finalSnapshot.switchMedian)} with ${finalSnapshot.switchAccuracy}% accuracy`,
      };
      const plainWhy: Record<SkillKey, string> = {
        flick: 'That points to first-click speed and micro-correction control.',
        track: 'That points to smoothness and keeping the crosshair connected.',
        switch: 'That points to transfer speed after the first target is confirmed.',
      };
      instruction.textContent = firstPass
        ? 'First pass complete — review the evidence and start the recommended warm-up'
        : 'Read complete — review the evidence and recommended warm-up below';
      resultKicker.textContent = firstPass
        ? hasCandidate ? 'FIRST PASS · CANDIDATE GAP' : 'FIRST PASS · BALANCED READ'
        : confirmedLimiter ? 'GAP FOUND · CONFIRMED TWICE' : 'BASELINE · NO SINGLE GAP';
      resultTitle.textContent = firstPass
        ? hasCandidate ? titles[focusSkill] : 'YOUR AIM PROFILE IS CLOSE'
        : confirmedLimiter ? titles[focusSkill] : 'YOUR AIM PROFILE IS BALANCED';
      resultCopy.textContent = firstPass
        ? hasCandidate
          ? `${focusLabel} is the clearest first-pass next win for ${selectedGame}. Start here now; the 10-second confirmation is optional. You already have a usable read.`
          : `Your first pass is close across all three skills for ${selectedGame}. Start with the balanced block; optional confirmation can check for a hidden limiter.`
        : confirmedLimiter
          ? `${focusLabel} is the clearest next win for ${selectedGame}. Here is the evidence and the first fix.`
          : `The scan and confirmation set a useful ${selectedGame} baseline, but no single weakness held up twice.`;
      starsEl.textContent = firstPass
        ? hasCandidate ? 'FOCUS PRIORITY · FIRST PASS' : 'BASELINE READ · FIRST PASS'
        : confirmedLimiter ? 'FOCUS PRIORITY · HIGH' : 'BASELINE · RETEST OPTIONAL';
      starsEl.setAttribute('aria-label', firstPass ? 'First-pass read' : confirmedLimiter ? 'Confirmed focus priority' : 'Baseline read, optional retest');
      priorityEl.textContent = skillRank.title;
      planLabelEl.textContent = firstPass
        ? `FIRST-PASS KOVAAK'S BLOCK`
        : confirmedLimiter ? `RECOMMENDED KOVAAK'S BLOCK` : `BASELINE KOVAAK'S BLOCK`;
      planTitle.textContent = routine.name;
      planMeta.textContent = `${plan.label} · ${plan.duration.replace(' min', ' minutes')} · ${plan.difficulty} · paste the code into KovaaK's`;
      nextStepEl.textContent = firstPass
        ? `${nextSteps[focusSkill]} ${goalAdvice[goalKey]}`
        : confirmedLimiter
          ? `${nextSteps[focusSkill]} ${goalAdvice[goalKey]}`
          : `Use one balanced block before changing settings. ${goalAdvice[goalKey]} Retest after the block to see whether the same pattern repeats.`;
      resultWhy.textContent = firstPass
        ? `${hasCandidate ? 'Why this block' : 'Why this baseline'}: ${plan.label} scored ${finalSnapshot.scores[focusSkill]}/100, ${evidenceDecision.gap} points behind ${skillPlans[evidenceDecision.runnerUp].label.toLowerCase()} at ${finalSnapshot.scores[evidenceDecision.runnerUp]}/100. ${metricWhy[focusSkill]}. ${plainWhy[focusSkill]} ${goalReason} This is a first-pass practice recommendation, not a permanent rating.`
        : confirmedLimiter
          ? `Why this block: ${plan.label} scored ${finalSnapshot.scores[focusSkill]}/100, ${scanDecision?.gap || 0} points behind ${skillPlans[scanDecision?.runnerUp || focusSkill].label.toLowerCase()} at ${finalSnapshot.scores[scanDecision?.runnerUp || focusSkill]}/100. ${metricWhy[focusSkill]}. ${plainWhy[focusSkill]} ${goalReason}`
          : `Why no limiter: flick ${finalSnapshot.scores.flick}, track ${finalSnapshot.scores.track}, switch ${finalSnapshot.scores.switch}. The candidate did not separate and hold through both stages, so this block is a baseline rather than a permanent diagnosis. ${goalReason}`;
      confidenceEl.textContent = firstPass
        ? `First-pass evidence: ${finalSnapshot.flickTimes.length} flicks · ${finalSnapshot.switchTimes.length} transfers · ${finalSnapshot.trackSeconds}s tracking. ${hasCandidate ? 'The lowest score is the current candidate gap.' : 'The scores are close, so no single gap stands out yet.'} Optional verification can test stability. Training priority: ${goalNames[goalKey]}. ${goalDescriptions[goalKey]} This is a practice recommendation, not a permanent rating.`
        : `Confirmed read: ${finalSnapshot.flickTimes.length} flicks · ${finalSnapshot.switchTimes.length} transfers · ${finalSnapshot.trackSeconds}s tracking. ${confirmedLimiter ? 'The candidate held across scan and confirmation.' : 'The two stages did not support a single stable limiter.'} Training priority: ${goalNames[goalKey]}. ${goalDescriptions[goalKey]} This is a practice recommendation, not a permanent rating.`;
      inputNote.textContent = matchMedia('(pointer: coarse)').matches
        ? 'Touch preview only · desktop mouse scores are not comparable.'
        : 'Measured on this mouse session · nothing is uploaded.';
      historyEl.textContent = firstPass
        ? 'Saved as a first-pass baseline locally. Verify or retest after the block to compare.'
        : 'Saved locally so you can compare future attempts on this browser.';
      codeEl.textContent = routine.code;
      codeEl.title = routine.code;
      copyButton.disabled = false;
      copyButton.textContent = 'Copy code';
      resultLink.textContent = 'Start this warm-up';
      resultLink.href = routineAnchor(routine);
      retestButton.disabled = false;
      if (persist) {
        rememberRun(focusSkill, finalSnapshot.scores[focusSkill], confirmedLimiter || hasCandidate ? 'limiter' : 'balanced');
        const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const previousBoard = readPersonalBoard();
        const board = savePersonalRun({
          id: runId,
          score: runScore,
          game: game.value,
          hits: finalSnapshot.clickHits,
          misses: finalSnapshot.clickMisses,
          accuracy: finalSnapshot.clickAccuracy,
          combo: maxCombo,
          createdAt: Date.now(),
        });
        const rank = board.findIndex((entry) => entry.id === runId) + 1;
        const summaryNote = firstPass
          ? `${skillRank.title} · FIRST-PASS BASELINE · optional verify available.`
          : previousBoard.length === 0
            ? `${skillRank.title} · FIRST SAVED RUN · use this as your baseline.`
            : rank === 1
              ? `${skillRank.title} · NEW PERSONAL BEST · saved to this browser.`
              : `${skillRank.title} · #${rank} THIS BROWSER · best combo ${maxCombo}x.`;
        updateRunSummary(finalSnapshot.clickAccuracy, board, summaryNote);
      }
      confirmButton.textContent = `Verify ${focusLabel} read`;
      confirmButton.hidden = !firstPass;
      confirmButton.disabled = false;
      phaseEl.textContent = 'COMPLETE';
      timeEl.textContent = '0.0';
      modeEl.textContent = firstPass ? 'SCAN COMPLETE' : 'COMPLETE';
      status.textContent = firstPass ? 'FIRST-PASS READ READY' : confirmedLimiter ? 'ROUTINE RESOLVED' : 'BASELINE SAVED';
      revealResult(focusSkill, firstPass ? 'first-pass' : 'final');
    };

    const finishScan = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      const snapshot = buildSnapshot('scan');
      scanSnapshot = snapshot;
      if (!snapshot.sufficient) {
        renderSnapshot(snapshot);
        showScanInconclusive(snapshot);
        return;
      }
      scanDecision = chooseFocus(snapshot.scores);
      confirmSkill = scanDecision.focusSkill;
      finishResolvedRead(snapshot, confirmSkill, false, true);
    };

    const showConfirmationInconclusive = (snapshot: ReadSnapshot) => {
      const scan = scanSnapshot || snapshot;
      const decision = scanDecision || chooseFocus(scan.scores);
      const focus = confirmSkill || decision.focusSkill;
      scanDecision = decision;
      confirmSkill = focus;
      finishResolvedRead(scan, focus, false, true, false);
      const focusLabel = skillPlans[focus].label;
      const confirmationEvidence = focus === 'flick'
        ? `${snapshot.flickTimes.length} flick hits`
        : focus === 'switch'
          ? `${snapshot.switchTimes.length} transfers`
          : `${snapshot.trackSeconds}s tracking`;
      instruction.textContent = 'Optional verification was incomplete — your first-pass read is still ready';
      resultKicker.textContent = 'FIRST PASS · VERIFY INCOMPLETE';
      resultCopy.textContent = `The first pass already gave you a usable ${focusLabel.toLowerCase()} read. The optional verification ended after ${confirmationEvidence}; use the routine now or retest when ready.`;
      starsEl.textContent = 'FIRST-PASS READ · READY';
      starsEl.setAttribute('aria-label', 'First-pass read ready; optional verification incomplete');
      planLabelEl.textContent = `FIRST-PASS KOVAAK'S BLOCK`;
      nextStepEl.textContent = `Start the ${focusLabel.toLowerCase()} block now. If you want more confidence later, run the optional verification again and complete it without leaving the arena.`;
      resultWhy.textContent = `The first pass identified ${focusLabel.toLowerCase()} as the clearest current gap. The optional verification did not collect enough input to confirm or overturn it, so your original routine remains available.`;
      confidenceEl.textContent = `First-pass evidence remains: ${scan.flickTimes.length} flicks · ${scan.switchTimes.length} transfers · ${scan.trackSeconds}s tracking. Optional verification collected ${confirmationEvidence} and was not used to replace the first read.`;
      inputNote.textContent = 'First-pass read saved locally · optional verification incomplete · nothing uploaded.';
      historyEl.textContent = 'First-pass baseline remains saved locally. Complete a later verification or retest to compare future attempts.';
      phaseEl.textContent = 'COMPLETE';
      timeEl.textContent = '0.0';
      status.textContent = 'FIRST-PASS READ READY';
      revealResult(focus, 'first-pass');
    };

    const finishConfirmation = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      if (!scanSnapshot || !confirmSkill) {
        finishScan();
        return;
      }
      const confirmation = buildSnapshot('confirm');
      if (!confirmation.sufficient) {
        showConfirmationInconclusive(confirmation);
        return;
      }
      const finalSnapshot = buildFinalSnapshot(confirmation);
      const finalDecision = chooseFocus(finalSnapshot.scores);
      const scanCandidate = confirmSkill;
      const stable = Math.abs(confirmation.scores[scanCandidate] - scanSnapshot.scores[scanCandidate]) <= 20;
      const confirmedLimiter = !scanDecision?.balanced
        && (scanDecision?.gap || 0) >= 12
        && finalDecision.focusSkill === scanCandidate
        && stable;
      const focusSkill = confirmedLimiter ? scanCandidate : finalDecision.focusSkill;
      finishResolvedRead(finalSnapshot, focusSkill, confirmedLimiter, false);
    };

    const trackingPoint = (elapsedMs: number, variant: number) => {
      const seconds = elapsedMs / 1000;
      const phase = variant * .45;
      return {
        x: 50 + Math.sin(seconds * 2.15 + phase) * 23 + Math.sin(seconds * 5.3 + .8 + phase) * 8 + Math.sin(seconds * .82) * 5,
        y: 50 + Math.sin(seconds * 1.52 + phase) * 16 + Math.cos(seconds * 4.35 + phase) * 7,
      };
    };

    const sampleTracking = (elapsedMs: number, dt: number, currentStage: RunStage) => {
      const point = trackingPoint(elapsedMs, currentStage === 'confirm' ? 1 : 0);
      targets[0].style.left = `${Math.max(14, Math.min(86, point.x))}%`;
      targets[0].style.top = `${Math.max(22, Math.min(78, point.y))}%`;
      const rect = targets[0].getBoundingClientRect();
      const distance = Math.hypot(pointerX - (rect.left + rect.width / 2), pointerY - (rect.top + rect.height / 2));
      const radius = rect.width / 2;
      const inside = distance <= radius;
      if (currentStage === 'confirm') {
        confirmTrackTotalMs += dt;
        if (inside) confirmTrackInsideMs += dt;
        confirmTrackErrorPxMs += Math.min(distance, radius * 4) * dt;
        confirmTrackClosenessMs += Math.max(0, 1 - distance / (radius * 2.5)) * dt;
      } else {
        trackTotalMs += dt;
        if (inside) trackInsideMs += dt;
        trackErrorPxMs += Math.min(distance, radius * 4) * dt;
        trackClosenessMs += Math.max(0, 1 - distance / (radius * 2.5)) * dt;
      }
      awardTrackTick(inside, targets[0]);
    };

    const configurePhase = (phase: SkillKey) => {
      if (phase !== 'switch') {
        targets.forEach((target, index) => {
          const primary = index === 0;
          if (!primary && document.activeElement === target) target.blur();
          target.style.display = primary ? 'grid' : 'none';
          target.tabIndex = primary ? 0 : -1;
          if (primary) target.removeAttribute('aria-hidden');
          else target.setAttribute('aria-hidden', 'true');
          target.style.opacity = '';
          target.style.transform = '';
          target.style.removeProperty('left');
          target.style.removeProperty('top');
        });
      }
      targets[0].style.display = 'grid';
      if (phase === 'flick') {
        targets[0].setAttribute('aria-label', stage === 'confirm' ? 'Confirmation flick target' : 'Flick target');
        place(targets[0], hardened.flickSize, stage);
        status.textContent = stage === 'confirm' ? 'CONFIRM FLICK' : 'FLICK PHASE';
        return;
      }
      if (phase === 'track') {
        setTargetSize(targets[0], hardened.trackSize);
        targets[0].setAttribute('aria-label', stage === 'confirm' ? 'Confirmation tracking target' : 'Tracking target');
        status.textContent = stage === 'confirm' ? 'CONFIRM TRACKING' : 'TRACKING SAMPLE';
        return;
      }
      confirmSwitchStep = 0;
      switchStep = 0;
      active = activeSwitchAt(0, patternOffset + (stage === 'confirm' ? 3 : 0));
      applySwitchLayout();
      updateSwitchCourse();
      lastSpawn = performance.now();
      status.textContent = stage === 'confirm' ? 'CONFIRM SWITCHING' : 'SWITCH PHASE';
    };

    const loop = (now: number) => {
      const elapsed = now - started - pausedMs;
      const dt = Math.min(50, Math.max(0, now - lastFrame));
      lastFrame = now;
      const currentPhase: SkillKey = stage === 'confirm'
        ? (confirmSkill || 'track')
        : elapsed < readPlan.flickEndsAt
          ? 'flick'
          : elapsed < readPlan.trackEndsAt
            ? 'track'
            : 'switch';
      const totalMs = stage === 'confirm' ? readPlan.confirmMs : readPlan.scanTotalMs;
      const phaseIndex = stage === 'confirm' ? 10 + keys.indexOf(currentPhase) : 1 + keys.indexOf(currentPhase);
      root.dataset.phase = currentPhase;
      modeEl.textContent = stage === 'confirm' ? `CONFIRM ${currentPhase.toUpperCase()}` : 'SCAN';
      phaseEl.textContent = currentPhase.toUpperCase();
      timeEl.textContent = Math.max(0, (totalMs - elapsed) / 1000).toFixed(1);
      setPhaseInstruction(currentPhase);
      if (phaseStarted !== phaseIndex) {
        phaseStarted = phaseIndex;
        configurePhase(currentPhase);
      }
      if (stage === 'scan' && currentPhase === 'flick' && flickTimes.length >= readPlan.minFlickHits) status.textContent = 'FLICK SAMPLE LOCKED';
      if (stage === 'scan' && currentPhase === 'switch' && switchStep >= readPlan.minSwitchHits) status.textContent = 'SAMPLE LOCKED · KEEP GOING';
      if (stage === 'confirm' && currentPhase === 'flick' && confirmFlickTimes.length >= readPlan.minConfirmFlickHits) status.textContent = 'CONFIRMATION SAMPLE LOCKED';
      if (stage === 'confirm' && currentPhase === 'switch' && confirmSwitchStep >= readPlan.minConfirmSwitchHits) status.textContent = 'CONFIRMATION LOCKED · KEEP GOING';
      if (currentPhase === 'track') sampleTracking(
        stage === 'confirm' ? elapsed : elapsed - readPlan.flickEndsAt,
        dt,
        stage,
      );
      updateRankMeter();
      if (elapsed >= totalMs) return stage === 'confirm' ? finishConfirmation() : finishScan();
      frame = requestAnimationFrame(loop);
    };

    const beginTest = () => {
      startGuide.hidden = true;
      root.dataset.state = 'running';
      root.dataset.phase = 'flick';
      root.dataset.activeTarget = 'a';
      modeEl.textContent = 'SCAN';
      phaseStarted = 0;
      active = activeSwitchAt(0, patternOffset);
      flickStep = 0;
      switchStep = 0;
      confirmFlickStep = 0;
      confirmSwitchStep = 0;
      updateSwitchCourse();
      pauseStarted = 0;
      pausedMs = 0;
      targets[1].style.display = 'none';
      targets[0].style.display = 'grid';
      targets[0].setAttribute('aria-label', 'Flick target');
      lastTrackScoreAt = 0;
      lastTrackFeedbackAt = 0;
      lastTrackInside = null;
      started = lastFrame = performance.now();
      status.textContent = stage === 'confirm' ? 'CONFIRMATION RUNNING' : 'TEST RUNNING';
      frame = requestAnimationFrame(loop);
    };

    const prepare = () => {
      resetSurface();
      patternOffset = Math.floor(Math.random() * flickLayouts.length);
      root.dataset.state = 'calibration';
      root.dataset.phase = 'calibration';
      root.dataset.activeTarget = 'a';
      stage = 'scan';
      confirmSkill = null;
      phaseStarted = 0;
      rankMeter.hidden = false;
      updateRankMeter(0);
      targets[1].style.display = 'none';
      targets[0].style.display = 'grid';
      targets[0].setAttribute('aria-label', 'Calibration target');
      targets[0].style.left = '50%';
      targets[0].style.top = '50%';
      phaseEl.textContent = 'CALIBRATE';
      modeEl.textContent = 'SCAN';
      timeEl.textContent = (readPlan.scanTotalMs / 1000).toFixed(1);
      startGuide.hidden = false;
      crosshair.dataset.pointer = 'hidden';
      crosshair.classList.remove('is-pointer');
      crosshair.style.removeProperty('left');
      crosshair.style.removeProperty('top');
      instruction.textContent = 'Click the center target when your pointer is ready';
      status.textContent = matchMedia('(pointer: coarse)').matches ? 'TOUCH PREVIEW' : 'MOUSE CALIBRATION';
      focusCalibrationTarget();
    };

    const renderPointer = () => {
      pointerFrame = 0;
      if (root.dataset.state !== 'calibration' && root.dataset.state !== 'running') return;
      const arenaRect = arena.getBoundingClientRect();
      if (!arenaRect.width || !arenaRect.height) return;
      crosshair.style.setProperty('--aim-pointer-x', `${pointerX - arenaRect.left}px`);
      crosshair.style.setProperty('--aim-pointer-y', `${pointerY - arenaRect.top}px`);
    };
    const updatePointer = (event: PointerEvent) => {
      const coalesced = event.getCoalescedEvents?.();
      const sample = coalesced?.[coalesced.length - 1] || event;
      pointerX = sample.clientX;
      pointerY = sample.clientY;
      if (root.dataset.state !== 'calibration' && root.dataset.state !== 'running') return;
      crosshair.dataset.pointer = 'visible';
      crosshair.classList.add('is-pointer');
      if (!pointerFrame) pointerFrame = requestAnimationFrame(renderPointer);
    };

    const startConfirmation = () => {
      if (!scanSnapshot || !confirmSkill) return;
      cancelAnimationFrame(frame);
      frame = 0;
      const scanBestCombo = maxCombo;
      stage = 'confirm';
      root.dataset.state = 'running';
      root.dataset.phase = confirmSkill;
      root.dataset.activeTarget = 'a';
      root.removeAttribute('data-result-stage');
      setResultAccessibility(false);
      rankMeter.hidden = false;
      updateRankMeter(0);
      startGuide.hidden = true;
      confirmButton.hidden = true;
      confirmButton.disabled = true;
      confirmFlickTimes = [];
      confirmSwitchTimes = [];
      confirmFlickMisses = confirmSwitchMisses = 0;
      confirmTrackTotalMs = confirmTrackInsideMs = confirmTrackErrorPxMs = confirmTrackClosenessMs = 0;
      confirmFlickStep = 0;
      confirmSwitchStep = 0;
      flickStep = 0;
      switchStep = 0;
      phaseStarted = 0;
      active = activeSwitchAt(0, patternOffset + 3);
      resetRunScore();
      maxCombo = scanBestCombo;
      lastTrackScoreAt = 0;
      lastTrackFeedbackAt = 0;
      lastTrackInside = null;
      pauseStarted = 0;
      pausedMs = 0;
      modeEl.textContent = `CONFIRM ${skillPlans[confirmSkill].label.toUpperCase()}`;
      phaseEl.textContent = confirmSkill.toUpperCase();
      timeEl.textContent = (readPlan.confirmMs / 1000).toFixed(1);
      instruction.textContent = `Confirm ${skillPlans[confirmSkill].label.toLowerCase()} with a clean, deliberate pass`;
      status.textContent = 'CONFIRMATION RUNNING';
      started = lastFrame = performance.now();
      frame = requestAnimationFrame(loop);
    };

    targets.forEach((target) => target.addEventListener('click', () => {
      if (root.dataset.state === 'calibration' && target.dataset.aimTarget === 'a') return beginTest();
      if (root.dataset.state !== 'running') return;
      const phase = root.dataset.phase as SkillKey;
      if (phase === 'flick' && target.dataset.aimTarget === 'a') {
        const elapsed = performance.now() - lastSpawn;
        if (stage === 'confirm') confirmFlickTimes.push(elapsed);
        else flickTimes.push(elapsed);
        awardHit(scoring.flickHit, target);
        place(target, hardened.flickSize, stage);
      } else if (phase === 'switch' && target.dataset.aimTarget === active) {
        const elapsed = performance.now() - lastSpawn;
        if (stage === 'confirm') confirmSwitchTimes.push(elapsed);
        else switchTimes.push(elapsed);
        awardHit(scoring.switchHit, target);
        if (stage === 'confirm') confirmSwitchStep++;
        else switchStep++;
        const step = stage === 'confirm' ? confirmSwitchStep : switchStep;
        active = activeSwitchAt(step, patternOffset + (stage === 'confirm' ? 3 : 0));
        applySwitchLayout();
        updateSwitchCourse();
        lastSpawn = performance.now();
      }
    }));
    arena.addEventListener('pointermove', updatePointer, { passive: true });
    arena.addEventListener('pointerrawupdate', updatePointer, { passive: true });
    arena.addEventListener('pointerdown', (event) => {
      updatePointer(event);
      if (root.dataset.state !== 'running') return;
      const clickedTarget = (event.target as HTMLElement).closest('[data-aim-target]') as HTMLElement | null;
      const phase = root.dataset.phase as SkillKey;
      if (clickedTarget) {
        if (phase === 'flick' && clickedTarget.dataset.aimTarget !== 'a') {
          if (stage === 'confirm') confirmFlickMisses++;
          else flickMisses++;
          registerMiss(scoring.flickMiss, clickedTarget);
        }
        if (phase === 'switch' && clickedTarget.dataset.aimTarget !== active) {
          if (stage === 'confirm') confirmSwitchMisses++;
          else switchMisses++;
          registerMiss(scoring.switchMiss, clickedTarget);
        }
        return;
      }
      if (phase === 'flick') {
        if (stage === 'confirm') confirmFlickMisses++;
        else flickMisses++;
        registerMiss(scoring.flickMiss);
      }
      if (phase === 'switch') {
        if (stage === 'confirm') confirmSwitchMisses++;
        else switchMisses++;
        registerMiss(scoring.switchMiss);
      }
    });
    arena.addEventListener('pointerleave', () => {
      pointerX = pointerY = -999;
      if (root.dataset.state === 'calibration' || root.dataset.state === 'running') {
        crosshair.dataset.pointer = 'hidden';
        crosshair.classList.remove('is-pointer');
        crosshair.style.removeProperty('--aim-pointer-x');
        crosshair.style.removeProperty('--aim-pointer-y');
      }
    });
    const onVisibilityChange = () => {
      if (!immersive || root.dataset.state !== 'running') return;
      if (document.hidden) {
        if (pauseStarted) return;
        pauseStarted = performance.now();
        cancelAnimationFrame(frame);
        frame = 0;
        phaseEl.textContent = 'PAUSED';
        status.textContent = 'RETURN TO RESUME';
        instruction.textContent = 'Return to this tab to continue the diagnostic';
        return;
      }
      if (!pauseStarted) return;
      pausedMs += performance.now() - pauseStarted;
      pauseStarted = 0;
      lastFrame = performance.now();
      phaseEl.textContent = (root.dataset.phase || 'flick').toUpperCase();
      status.textContent = stage === 'confirm' ? 'CONFIRMATION RUNNING' : 'TEST RUNNING';
      frame = requestAnimationFrame(loop);
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (!immersive || event.key !== 'Escape') return;
      event.preventDefault();
      exitImmersive();
    };
    exitButton.addEventListener('click', exitImmersive);
    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('keydown', onKeyDown);
    game.addEventListener('change', updateSelectionSummary);
    goal.addEventListener('change', updateSelectionSummary);
    startButtons.forEach(button => button.addEventListener('click', () => {
      if (root.dataset.state === 'running' || root.dataset.state === 'calibration') return;
      enterImmersive();
      prepare();
    }));
    retestButton.addEventListener('click', () => {
      enterImmersive();
      prepare();
    });
    confirmButton.addEventListener('click', startConfirmation);
    resultLink.addEventListener('click', (event) => {
      const href = resultLink.getAttribute('href');
      if (!href?.startsWith('#')) return;
      event.preventDefault();
      exitImmersive();
      window.setTimeout(() => {
        const target = document.querySelector<HTMLElement>(href);
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target?.classList.add('is-recommended');
        window.setTimeout(() => target?.classList.remove('is-recommended'), 2200);
      }, 0);
    });
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeEl.textContent || '');
      } catch {
        copyButton.textContent = 'Copy failed — select code';
        inputNote.textContent = "Clipboard access was blocked. Select the share code and copy it manually.";
        window.setTimeout(() => { copyButton.textContent = 'Copy code'; }, 2200);
        return;
      }
      copyButton.textContent = "Copied — paste in KovaaK's"; copyButton.classList.add('is-copied');
      inputNote.textContent = "Copied. Paste the share code into KovaaK's Online Playlists.";
      window.setTimeout(() => { copyButton.textContent = 'Copy code'; copyButton.classList.remove('is-copied'); }, 1800);
    });
    setResultAccessibility(false);
    updateSelectionSummary();
    updateSwitchCourse();
  });
</script>
