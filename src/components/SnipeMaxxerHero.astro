  @keyframes snx-bioscan-window{0%,9.2%{opacity:0}9.3%,16.7%{opacity:1}16.8%,100%{opacity:0}}@keyframes snx-compress{0%,9.2%{opacity:0;transform:scale(1.42)}9.3%{opacity:.9;transform:scale(1.42)}15.8%{opacity:1;transform:scale(.78)}16.8%,100%{opacity:0;transform:scale(.72)}}@keyframes snx-orbit{0%,9.2%{opacity:0;transform:scale(1.7)}9.8%{opacity:.9}15.8%{opacity:1;transform:scale(.82)}16.8%,100%{opacity:0;transform:scale(.78)}}@keyframes snx-sweep{0%,9.2%{opacity:0;transform:rotate(-90deg)}9.3%{opacity:1}16.2%{opacity:1;transform:rotate(270deg)}16.8%,100%{opacity:0;transform:rotate(290deg)}}@keyframes snx-rig{0%,9.3%{opacity:0}9.9%{opacity:.25}10.7%{opacity:.8}11.3%,16.2%{opacity:1}16.8%,100%{opacity:0}}
