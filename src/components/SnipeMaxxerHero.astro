<script>
  document.querySelectorAll<HTMLElement>('.snx-hero').forEach((hero) => {
    type Mode = 'fortnite' | 'valorant';
    const modeCopy = {
      fortnite: {
        headline: 'Play the points.',
        lede: 'The replay names the threats. The live leaderboard tells you what to do next.',
        timingValue: '~5 MIN',
