<script>
  document.querySelectorAll<HTMLElement>('.snx-hero').forEach((hero) => {
    type Mode = 'fortnite' | 'valorant';
    const modeCopy = {
      fortnite: {
        headline: 'Play the points.',
        lede: 'The replay names the threats. The live leaderboard tells you what to do next.',
        timingValue: '~5 MIN',
        timingLabel: 'Replay behind live · leaderboard live',
        scopeTop: 'Official tournament replay · resolving field',
        scopeBottom: 'Tracked tendency read · zero game memory access',
        lifeSign: 'Life sign confirmed · official replay path',
        identityLabel: 'Identity resolved',
        identityMain: 'falcon peterbotǃ',
        identityMeta: 'LEGEND · NA',
        identityFoot: '2024 FNCS GLOBAL CHAMPION · KNOWN PRO',
        keyableLabel: 'Tracked landing tendency',
        keyableMain: 'Sinister Strip',
        keyableScore: '10 / 10',
        keyableMeta: 'TEN TRACKED TOURNAMENT GAMES · SAME DROP EVERY GAME',
        pointsLabel: 'Tracked form · real replay history',
        stat1Value: '#1',
        stat1Label: 'Best finish',
        stat2Value: '13',
        stat2Label: 'Elims',
        stat3Value: '20.2K',
        stat3Label: 'Damage dealt',
        call: 'Threat read · +8,179 damage trade',
        leaderboardTitle: 'Points brain · live leaderboard',
        leaderboardText: 'Your points · rank · games left · qualify gap · placement or push call — no replay delay',
        stageLabel: 'Replay boundary',
        stageText: 'official server replay, usually ~5 min behind',
        replayClock: 'Fortnite · Epic replay + leaderboard',
      },
      valorant: {
        headline: 'Read the round.',
        lede: 'Rank, recent matches, live lobby context, and a round report — read-only and local.',
        timingValue: '10 MATCHES',
        timingLabel: 'Latest completed reports · Riot context read-only',
        scopeTop: 'Riot Client context · read-only link',
        scopeBottom: 'Match report read · no session token in renderer',
        lifeSign: 'Session confirmed · read-only client path',
        identityLabel: 'Match report surface',
        identityMain: 'Full lobby report',
        identityMeta: 'K/D/A · SCORE · HS%',
        identityFoot: 'AGENTS · ROUND SPINE · LATEST 10',
        keyableLabel: 'Riot Client context',
        keyableMain: 'Lobby + phase',
        keyableScore: 'READ-ONLY',
        keyableMeta: 'FRIENDS · STORE · WEAPON SKINS',
        pointsLabel: 'Session form · recent reports',
        stat1Value: '10',
        stat1Label: 'Recent matches',
        stat2Value: 'RR',
        stat2Label: 'Rank rating',
        stat3Value: 'HS%',
        stat3Label: 'Headshot rate',
        call: 'Report read · K/D/A + round spine',
        leaderboardTitle: 'Match brain · round reports',
        leaderboardText: 'Rank · RR · recent matches · live lobby phase · read-only Riot context · local crosshairs',
        stageLabel: 'Riot boundary',
        stageText: 'read-only client context, no login automation',
        replayClock: 'Valorant · HenrikDev + Riot Client',
      },
    } as const;

    const desk = hero.nextElementSibling as HTMLElement | null;
    const deskCopy = {
      fortnite: {
        deskIntro: 'Tournament standing first. Then the official replay turns a lobby into a plan.',
        deskModeLabel: 'FORTNITE / TOURNAMENT DESK',
        deskStatus: 'CURRENT APP SURFACES',
        deskKicker: 'CURRENT APP SURFACES',
        deskHeadline: 'Keep the race honest.',
        deskBody: 'The live Epic standing is the first read. Scout the official replay when it lands, then turn the lobby into your next decision.',
        deskChip1: 'STANDING / POINTS + CUTOFF',
        deskChip2: 'SCOUT / LOBBY + DROPS',
        deskChip3: 'STRATEGY LAB / ROUTES + DECISIONS',
        deskChip4: 'VOICE COACH / NEXT MOVE',
        deskBoundary: 'Epic standing is live; official replay data is commonly about five minutes behind.',
        deskMetric1Value: 'LIVE',
        deskMetric1Label: 'Epic standing',
        deskMetric2Value: '~5M',
        deskMetric2Label: 'Replay freshness',
        deskMetric3Value: 'SCOUT',
        deskMetric3Label: 'Lobby intelligence',
        deskProofLabel: 'REAL APP CAPTURES / FORTNITE',
        deskProofNote: 'The desk below is built from the surfaces the app actually uses.',
      },
      valorant: {
        deskIntro: 'Rank, recent reports, and read-only Riot Client context meet in one session desk.',
        deskModeLabel: 'VALORANT / SESSION INTELLIGENCE',
        deskStatus: 'CURRENT APP SURFACES',
        deskKicker: 'CURRENT APP SURFACES',
        deskHeadline: 'See the match. Own the next round.',
        deskBody: 'Read rank, RR, peak, completed-match history, full-lobby reports, teammate intel, skins, friends, store, alerts, crosshairs, and watchlists.',
        deskChip1: 'REPORTS / FULL LOBBY + K/D/A',
        deskChip2: 'RIOT CLIENT / PHASE + AGENT SELECT',
        deskChip3: 'TOOLKIT / CROSSHAIRS + ALERTS',
        deskChip4: 'LINK / SAME PC OR GAMING PC',
        deskBoundary: 'Read-only Riot Client context; HenrikDev history stays in encrypted local storage and never becomes a renderer session token.',
        deskMetric1Value: 'RR',
        deskMetric1Label: 'Rank surface',
        deskMetric2Value: '10',
        deskMetric2Label: 'Latest matches',
        deskMetric3Value: 'LOCAL',
        deskMetric3Label: 'Crosshairs + alerts',
        deskProofLabel: 'CURRENT APP VIEW / VALORANT',
        deskProofNote: 'Real current-app captures show the live session desk and the full-lobby report as they appear in the Windows app.',
      },
    } as const;

    const setMode = (mode: Mode, animate = true) => {
      hero.dataset.mode = mode;
      hero.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.modeTarget === mode));
      });
      hero.querySelectorAll<HTMLElement>('[data-mode-copy]').forEach((element) => {
        const key = element.dataset.modeCopy as keyof typeof modeCopy.fortnite;
        const value = modeCopy[mode][key];
        if (value !== undefined) element.textContent = value;
      });
      if (desk) {
        desk.dataset.mode = mode;
        desk.querySelectorAll<HTMLElement>('[data-desk-copy]').forEach((element) => {
          const key = element.dataset.deskCopy as keyof typeof deskCopy.fortnite;
          const value = deskCopy[mode][key];
          if (value !== undefined) element.textContent = value;
        });
        desk.querySelectorAll<HTMLElement>('[data-desk-mode]').forEach((element) => {
          element.hidden = element.dataset.deskMode !== mode;
        });
      }
      if (animate) {
        hero.classList.remove('snx-mode-changing');
        void hero.offsetWidth;
        hero.classList.add('snx-mode-changing');
        window.setTimeout(() => hero.classList.remove('snx-mode-changing'), 360);
      }
    };

    hero.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.modeTarget;
        if (target === 'fortnite' || target === 'valorant') setMode(target);
      });
    });

    setMode('fortnite', false);

    const red = Math.random() < 0.5;
    hero.style.setProperty('--scene', `url("${red ? '/screenshots/snipemaxxer/hero-red-tiger-v1.webp' : '/screenshots/snipemaxxer/hero-blue-tiger-v1.webp'}")`);
    hero.dataset.camo = red ? 'red' : 'blue';
  });
</script>
