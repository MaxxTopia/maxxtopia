      },
      valorant: {
        headline: 'Read the round.',
        lede: 'Rank, recent matches, live lobby context, and a round report — read-only and local.',
        timingValue: '10 MATCHES',
        timingLabel: 'Latest completed reports · Riot context read-only',
        scopeTop: 'Live lobby · Jett target resolving',
        scopeBottom: 'Instant Riot Client read · no session token in renderer',
        lifeSign: 'Agent resolved · read-only client path',
        identityLabel: 'Agent target · live lobby',
        identityMain: 'Jett / lobby read',
        identityMeta: 'BIND · READ-ONLY',
        identityFoot: 'AGENT · ROUND SPINE · LATEST 10',
        keyableLabel: 'Riot Client context',
        keyableMain: 'Lobby + phase',
        keyableScore: 'READ-ONLY',
        keyableMeta: 'FRIENDS · STORE · WEAPON SKINS',
        pointsLabel: 'Session form · recent reports',
        stat1Value: '10',
        stat1Label: 'Recent matches',
        stat2Value: 'RR',
        stat2Label: 'Rank rating',
        stat3Value: 'HS%',
        stat3Label: 'Headshot rate',
        call: 'Report read · K/D/A + round spine',
        leaderboardTitle: 'Match brain · round reports',
        leaderboardText: 'Rank · RR · recent matches · live lobby phase · read-only Riot context · local crosshairs',
        stageLabel: 'Riot boundary',
        stageText: 'read-only client context, no login automation',
      },
    } as const;

    const desk = hero.nextElementSibling as HTMLElement | null;
    const deskCopy = {
      fortnite: {
      deskIntro: 'Start with what is live. Add the official replay when it lands. Then turn evidence into your next drop call.',
        deskModeLabel: 'FORTNITE / TOURNAMENT DESK',
      deskStatus: 'LIVE STANDING / REPLAY NEXT',
      flow1Title: 'Live standing',
      flow1Text: 'Points + cutoff',
      flow2Title: 'Official replay',
      flow2Text: 'Lobby + drops',
      flow3Title: 'Next call',
      flow3Text: 'Routes + pressure',
      deskKicker: '01 / LIVE SIGNAL',
      deskSignal: 'EPIC STANDING',
      deskHeadline: 'Know the race before it closes.',
      deskBody: 'The live standing shows your points, rank, games left, and cutoff gap now. When the official replay lands, scout the lobby and choose the next drop with evidence.',
      deskChip1: 'LIVE / POINTS + CUTOFF',
      deskChip2: 'REPLAY / LOBBY + DROPS',
      deskChip3: 'LAB / ROUTES + DECISIONS',
      deskChip4: 'COACH / NEXT MOVE',
      deskBoundary: 'Standing data is live. Official Epic replay data commonly arrives about five minutes later.',
        deskMetric1Value: 'LIVE',
        deskMetric1Label: 'Epic standing',
        deskMetric2Value: '~5M',
        deskMetric2Label: 'Replay freshness',
        deskMetric3Value: 'SCOUT',
        deskMetric3Label: 'Lobby intelligence',
      deskProofLabel: 'PROOF FROM THE REAL APP / FORTNITE',
      deskProofNote: 'These are current app surfaces, not concept screens.',
      },
      valorant: {
      deskIntro: 'Start with live Riot context. Add the match report. Then turn the round into your next call.',
        deskModeLabel: 'VALORANT / SESSION INTELLIGENCE',
      deskStatus: 'LIVE CONTEXT / REPORT NEXT',
      flow1Title: 'Live context',
      flow1Text: 'Riot phase + lobby',
      flow2Title: 'Match report',
      flow2Text: 'Full lobby + K/D/A',
      flow3Title: 'Next round',
      flow3Text: 'Fix + toolkit',
      deskKicker: '01 / LIVE CONTEXT',
      deskSignal: 'RIOT CLIENT',
      deskHeadline: 'See the round before it starts.',
      deskBody: 'Read rank, RR, phase, lobby, teammates, and current Riot context. Then use match reports and the toolkit to decide what to fix next.',
      deskChip1: 'LIVE / PHASE + LOBBY',
      deskChip2: 'REPORTS / FULL LOBBY + K/D/A',
        deskChip3: 'TOOLKIT / CROSSHAIRS + ALERTS',
        deskChip4: 'LINK / SAME PC OR GAMING PC',
      deskBoundary: 'Riot context is read-only. Match history stays local; no login automation or session token in the renderer.',
        deskMetric1Value: 'RR',
        deskMetric1Label: 'Rank surface',
        deskMetric2Value: '10',
        deskMetric2Label: 'Latest matches',
        deskMetric3Value: 'LOCAL',
        deskMetric3Label: 'Crosshairs + alerts',
      deskProofLabel: 'PROOF FROM THE REAL APP / VALORANT',
      deskProofNote: 'Current app captures show the live session desk and full-lobby report as they appear in Windows.',
      },
    } as const;

    const setMode = (mode: Mode, animate = true) => {
      hero.dataset.mode = mode;
      hero.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.modeTarget === mode));
      });
      hero.querySelectorAll<HTMLElement>('[data-mode-copy]').forEach((element) => {
        const key = element.dataset.modeCopy as keyof typeof modeCopy.fortnite;
        const value = modeCopy[mode][key];
        if (value !== undefined) element.textContent = value;
      });
      if (desk) {
        desk.dataset.mode = mode;
        desk.querySelectorAll<HTMLElement>('[data-desk-copy]').forEach((element) => {
          const key = element.dataset.deskCopy as keyof typeof deskCopy.fortnite;
          const value = deskCopy[mode][key];
          if (value !== undefined) element.textContent = value;
        });
        desk.querySelectorAll<HTMLElement>('[data-desk-mode]').forEach((element) => {
          element.hidden = element.dataset.deskMode !== mode;
        });
      }
      if (animate) {
        hero.classList.remove('snx-mode-changing');
        void hero.offsetWidth;
        hero.classList.add('snx-mode-changing');
        window.setTimeout(() => hero.classList.remove('snx-mode-changing'), 360);
      }
    };

    hero.querySelectorAll<HTMLButtonElement>('[data-mode-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.modeTarget;
        if (target === 'fortnite' || target === 'valorant') setMode(target);
      });
    });

    setMode('fortnite', false);

  });
</script>
