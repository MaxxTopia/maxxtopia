---
import type { Product } from '../data/products';
type Props = { product: Product };
const { product } = Astro.props;
const primary = product.primaryCta;
const secondary = product.secondaryCta;
---

<section class="snx-hero" aria-label={`${product.name} replay intelligence hero`}>
  <div class="snx-scene" aria-hidden="true"></div>
  <div class="snx-atmosphere" aria-hidden="true"></div>
  <div class="snx-freeze" aria-hidden="true"></div>
  <div class="snx-grain" aria-hidden="true"></div>

  <div class="snx-copy">
    <a href="/#apps" class="snx-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>
    <p class="snx-eyebrow">Replay intelligence · beta {product.version}</p>
    <h1>Know the lobby.<br /><span>Play the points.</span></h1>
    <p class="snx-lede">The replay names the threats. The live leaderboard tells you what to do next.</p>
    <div class="snx-timing"><strong>~5 MIN</strong><i></i><span>Replay behind live · leaderboard live</span></div>
    <div class="snx-actions">
      <a class="snx-cta snx-primary" href={primary.href} target={primary.external ? '_blank' : undefined} rel={primary.external ? 'noopener' : undefined}>{primary.label}</a>
      {secondary && <a class="snx-cta" href={secondary.href} target={secondary.external ? '_blank' : undefined} rel={secondary.external ? 'noopener' : undefined}>{secondary.label}</a>}
    </div>
  </div>

  <div class="snx-scope" aria-hidden="true">
    <div class="snx-lens"></div>
    <p class="snx-scope-label snx-top">Official tournament replay · resolving account</p>
    <p class="snx-scope-label snx-bottom">Tracked tendency read · zero game memory access</p>
  </div>

  <div class="snx-bioscan" aria-hidden="true">
    <span class="snx-scan-halo"></span><span class="snx-scan-orbit"></span>
    <span class="snx-scan-orbit snx-second"></span><span class="snx-scan-sweep"></span>
    <svg class="snx-scan-rig" viewBox="0 0 190 286">
      <g class="snx-triangulation"><path d="M4 22 97 76 186 17M0 145 96 128 190 166M14 276 96 166 178 282"/><path d="M34 0 85 103M157 0 110 102M0 108 61 124M190 114 116 108"/></g>
      <path class="snx-body-outline" d="M98 63c-8-1-15 5-16 13-1 7 2 13 8 17l-5 8-12 5-10 9-22 8 4 9 22-4 16-10 3 31-5 20 5 13-8 31-10 48-12 7 2 8h21l7-11 7-37 4-25 7 25 3 40-5 7 4 7h22l2-8-9-8-4-49-7-33-2-28 8-29-5-28 8 9 4 18 9-1 1-23-9-20-14-8-5-9c7-2 12-9 12-17 0-8-6-15-14-16l-2-4-5 3-8-1Z"/>
      <g class="snx-bone"><circle cx="98" cy="78" r="11"/><path d="M97 90 96 128 96 166M85 103 96 108 110 102M85 103 74 115 61 124M110 102 117 118 123 135M96 166 84 210 72 258M96 166 108 211 113 257M84 139 108 138M86 160 105 160"/></g>
      <g class="snx-joint"><circle cx="97" cy="90" r="2.5"/><circle cx="85" cy="103" r="2.5"/><circle cx="110" cy="102" r="2.5"/><circle cx="74" cy="115" r="2.5"/><circle cx="61" cy="124" r="2.5"/><circle cx="117" cy="118" r="2.5"/><circle cx="123" cy="135" r="2.5"/><circle cx="96" cy="128" r="2.5"/><circle cx="96" cy="166" r="2.5"/><circle cx="84" cy="210" r="2.5"/><circle cx="108" cy="211" r="2.5"/><circle cx="72" cy="258" r="2.5"/><circle cx="113" cy="257" r="2.5"/></g>
      <circle class="snx-vitals" cx="96" cy="126" r="8"/>
    </svg>
    <span class="snx-life-sign">Life sign confirmed · account resolved</span>
  </div>
  <div class="snx-target-box" aria-hidden="true"></div>

  <article class="snx-card snx-identity">
    <div class="snx-data-label">Identity resolved</div>
    <div class="snx-data-main"><span>falcon peterbotǃ</span><em>LEGEND · NA</em></div>
    <div class="snx-data-meta">2024 FNCS GLOBAL CHAMPION · KNOWN PRO</div>
  </article>
  <article class="snx-card snx-keyable">
    <div class="snx-data-label">Tracked landing tendency</div>
    <div class="snx-data-main"><span>Sinister Strip</span><em>10 / 10</em></div>
    <div class="snx-data-meta">TEN TRACKED TOURNAMENT GAMES · SAME DROP EVERY GAME</div>
  </article>
  <article class="snx-card snx-points">
    <div class="snx-data-label">Tracked form · real replay history</div>
    <div class="snx-points-grid"><div><strong>#1</strong><span>Best finish</span></div><div><strong>13</strong><span>Elims</span></div><div><strong>20.2K</strong><span>Damage dealt</span></div></div>
    <div class="snx-call">Threat read · +8,179 damage trade</div>
  </article>
  <article class="snx-leaderboard">
    <strong>Points brain · live leaderboard</strong>
    <span>Your points · rank · games left · qualify gap · placement or push call — no replay delay</span>
  </article>
  <div class="snx-stage"><span>Replay fallback</span> · Overwolf live GEP access was not approved</div>
  <div class="snx-replay-clock">Reads Epic's replay · never your game</div>
</section>

<style is:global>
  .snx-hero{--red:#ff3b3b;--amber:#ffb547;--safe:#8af5b5;--steel:#8191a1;--cycle:12s;--scene:url("/screenshots/snipemaxxer/hero-red-tiger-v1.webp");position:relative;min-height:clamp(760px,calc(100svh - 66px),980px);isolation:isolate;overflow:hidden;background:#090a0d;color:#e7ecec;font-family:var(--font-sans),system-ui,sans-serif}
  .snx-hero *{box-sizing:border-box}.snx-scene{position:absolute;inset:0;z-index:-5;background:var(--scene) 50% 50%/cover no-repeat;transform:scale(1.025);filter:saturate(1.04) contrast(1.08) brightness(.79);animation:snx-scene var(--cycle) cubic-bezier(.2,.7,.2,1) infinite}
  .snx-scene::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,8,11,.88),rgba(7,8,11,.44) 29%,transparent 57%),linear-gradient(0deg,rgba(7,8,11,.7),transparent 36%),radial-gradient(circle at 50% 51%,transparent 9%,rgba(5,6,8,.12) 43%,rgba(5,6,8,.62))}
  .snx-atmosphere{position:absolute;z-index:-3;inset:0;pointer-events:none;opacity:.55;mix-blend-mode:screen;background:radial-gradient(circle at 12% 74%,rgba(255,132,48,.55) 0 1px,transparent 2px),radial-gradient(circle at 24% 28%,rgba(255,191,88,.48) 0 1px,transparent 2px),radial-gradient(circle at 45% 19%,rgba(255,87,38,.45) 0 1px,transparent 2px),radial-gradient(circle at 62% 31%,rgba(255,188,100,.42) 0 1px,transparent 2px),radial-gradient(circle at 78% 17%,rgba(255,86,42,.5) 0 1px,transparent 2px),radial-gradient(circle at 88% 63%,rgba(255,183,84,.44) 0 1px,transparent 2px);background-size:180px 210px,240px 190px,300px 240px,220px 270px,340px 230px,260px 180px;animation:snx-embers 9s linear infinite}
  .snx-grain{position:absolute;inset:0;z-index:20;pointer-events:none;opacity:.17;mix-blend-mode:soft-light;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E")}
  .snx-copy{position:absolute;z-index:12;left:clamp(28px,6vw,110px);top:9%;width:min(450px,37vw);pointer-events:none}.snx-back{pointer-events:auto;display:inline-flex;align-items:center;gap:7px;margin-bottom:clamp(36px,6vh,68px);color:rgba(231,236,236,.58);font:600 11px/1 var(--font-mono),monospace;letter-spacing:.08em;text-decoration:none;text-transform:uppercase;transition:color .2s}.snx-back:hover{color:#fff}
  .snx-eyebrow,.snx-timing,.snx-scope-label,.snx-data-label,.snx-stage,.snx-replay-clock{font-family:var(--font-mono),monospace;text-transform:uppercase;letter-spacing:.14em}.snx-eyebrow{color:var(--red);font-size:clamp(10px,.85vw,13px);margin:0 0 20px}.snx-copy h1{max-width:440px;margin:0;color:#e7ecec;font-size:clamp(58px,6.2vw,108px);font-weight:800;line-height:.82;letter-spacing:-.055em}.snx-copy h1 span{color:var(--red);text-shadow:0 0 40px rgba(255,59,59,.3)}.snx-lede{max-width:400px;margin:24px 0 0;color:rgba(231,236,236,.7);font-size:clamp(14px,1.1vw,18px);line-height:1.55}
  .snx-timing{display:flex;align-items:center;gap:13px;margin-top:28px;font-size:10px;color:var(--steel)}.snx-timing strong{color:var(--amber);font-size:15px}.snx-timing i{width:58px;height:1px;background:linear-gradient(90deg,var(--amber),transparent)}.snx-actions{display:flex;gap:12px;margin-top:32px;pointer-events:auto;opacity:0;transform:translateY(14px);animation:snx-actions var(--cycle) ease infinite}
  .snx-cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:1px solid rgba(255,255,255,.15);color:#fff;text-decoration:none;font-weight:700;font-size:13px;background:rgba(8,9,12,.7);backdrop-filter:blur(8px);transition:transform .2s,border-color .2s}.snx-cta:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.45)}.snx-cta.snx-primary{background:var(--red);border-color:var(--red);color:#160404;box-shadow:0 0 35px rgba(255,59,59,.2)}
  .snx-scope{position:absolute;z-index:6;left:50%;top:52%;width:min(72vw,820px);aspect-ratio:1;transform:translate(calc(-50% + 41vw),calc(-50% + 4vh)) scale(.16);border-radius:50%;opacity:0;background:radial-gradient(circle at 39% 31%,#252b2e,#131719 23%,#090b0c 60%,#030405);box-shadow:0 0 0 120vmax rgba(2,3,4,.965);animation:snx-scope-in var(--cycle) cubic-bezier(.24,.7,.24,1) infinite}
  .snx-scope::before{content:"";position:absolute;inset:0;border-radius:inherit;z-index:3;border:clamp(12px,1.6vw,22px) solid #050607;background:linear-gradient(145deg,rgba(255,255,255,.14),transparent 19%,transparent 72%,rgba(255,255,255,.035));-webkit-mask:radial-gradient(circle,transparent 0 92%,#000 92.4%);mask:radial-gradient(circle,transparent 0 92%,#000 92.4%);box-shadow:0 0 0 1px rgba(157,170,175,.22),0 0 0 5px rgba(0,0,0,.94),inset 0 0 42px 16px rgba(0,0,0,.88),0 0 90px rgba(0,0,0,.96)}
  .snx-scope::after{content:"";position:absolute;z-index:4;inset:10%;border-radius:50%;background:linear-gradient(#090807,#090807) 50% 82%/30% 1px no-repeat,linear-gradient(#090807,#090807) 50% 75%/25% 1px no-repeat,linear-gradient(#090807,#090807) 50% 68%/20% 1px no-repeat,linear-gradient(#090807,#090807) 50% 61%/14% 1px no-repeat,linear-gradient(90deg,#090807 0 35%,transparent 35% 65%,#090807 65%) center/100% 2px no-repeat,linear-gradient(#090807,#090807) center/1.5px 100% no-repeat;clip-path:circle(50%);filter:drop-shadow(0 1px .5px rgba(255,255,255,.28));opacity:0;animation:snx-reticle var(--cycle) steps(1) infinite}
  .snx-lens{position:absolute;z-index:1;inset:5.8%;overflow:hidden;border-radius:50%;background:linear-gradient(rgba(3,6,8,.16),rgba(3,6,8,.16)),url("/screenshots/snipemaxxer/hero-scope-view-v1.webp") 50% 49%/450% auto no-repeat;filter:saturate(.78) contrast(1.25) brightness(.86);box-shadow:inset 0 0 85px 26px rgba(0,0,0,.88),inset 0 0 0 2px rgba(154,171,178,.26);animation:snx-lens var(--cycle) ease infinite}.snx-lens::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 34% 28%,rgba(126,183,220,.12),transparent 22%),radial-gradient(circle,transparent 35%,rgba(0,0,0,.52) 73%,rgba(0,0,0,.92))}.snx-lens::before{content:"";position:absolute;z-index:2;inset:0;border-radius:inherit;background:radial-gradient(circle at 38% 30%,rgba(128,176,189,.22),transparent 17%),radial-gradient(circle at 50% 50%,rgba(16,24,27,.88),rgba(2,3,4,.98) 72%);box-shadow:inset 0 0 24px rgba(164,207,217,.14);animation:snx-glass var(--cycle) cubic-bezier(.4,0,.2,1) infinite}
  .snx-scope-label{position:absolute;z-index:5;left:50%;transform:translateX(-50%);margin:0;color:rgba(231,236,236,.56);font-size:9px;white-space:nowrap;opacity:0;animation:snx-reticle var(--cycle) steps(1) infinite}.snx-scope-label.snx-top{top:12%}.snx-scope-label.snx-bottom{bottom:12%;color:var(--amber)}.snx-freeze{position:absolute;z-index:11;inset:0;pointer-events:none;background:#fff;opacity:0;animation:snx-freeze var(--cycle) steps(1) infinite}
  .snx-bioscan{position:absolute;z-index:10;left:50%;top:54%;width:190px;height:286px;transform:translate(-50%,-50%);opacity:0;pointer-events:none;animation:snx-bioscan-window var(--cycle) linear infinite}.snx-scan-halo,.snx-scan-orbit,.snx-scan-sweep,.snx-scan-rig{position:absolute;inset:0}.snx-scan-halo{border:1px solid rgba(255,181,71,.58);border-radius:50%;background:radial-gradient(ellipse,rgba(255,76,49,.09),transparent 62%);box-shadow:0 0 34px rgba(255,93,47,.28),inset 0 0 28px rgba(255,181,71,.12);animation:snx-compress var(--cycle) cubic-bezier(.3,.7,.25,1) infinite}
  .snx-scan-orbit{inset:7% 10%;border:1px solid rgba(255,207,132,.52);border-radius:50%;animation:snx-orbit var(--cycle) ease-out infinite}.snx-scan-orbit.snx-second{inset:17% 20%;border-color:rgba(255,73,55,.7);animation-delay:.07s}.snx-scan-sweep{inset:-3%;border-radius:50%;background:conic-gradient(from -24deg,transparent 0 320deg,rgba(255,191,88,.04) 328deg,rgba(255,191,88,.72) 356deg,transparent);-webkit-mask:radial-gradient(ellipse,transparent 0 22%,#000 23% 70%,transparent 71%);mask:radial-gradient(ellipse,transparent 0 22%,#000 23% 70%,transparent 71%);animation:snx-sweep var(--cycle) linear infinite}
  .snx-scan-rig{width:100%;height:100%;opacity:0;filter:drop-shadow(0 0 7px rgba(255,82,50,.8));overflow:visible;animation:snx-rig var(--cycle) steps(5) infinite}.snx-triangulation{fill:none;stroke:rgba(255,181,71,.62);stroke-width:.75;stroke-dasharray:4 5;animation:snx-triangulate var(--cycle) linear infinite}.snx-body-outline{fill:rgba(255,63,48,.055);stroke:rgba(255,91,59,.9);stroke-width:1.1;stroke-dasharray:430;stroke-dashoffset:430;animation:snx-trace-body var(--cycle) cubic-bezier(.2,.75,.2,1) infinite}.snx-bone{fill:none;stroke:rgba(255,216,151,.8);stroke-width:1;stroke-dasharray:120;stroke-dashoffset:120;animation:snx-trace-bones var(--cycle) ease-out infinite}.snx-joint{fill:#ffd59b;stroke:rgba(255,69,46,.9);stroke-width:.8;transform-box:fill-box;transform-origin:center;animation:snx-joints var(--cycle) steps(1) infinite}.snx-vitals{fill:none;stroke:var(--safe);stroke-width:1.5;transform-box:fill-box;transform-origin:center;animation:snx-vital var(--cycle) ease-out infinite}
  .snx-life-sign{position:absolute;left:50%;bottom:-24px;transform:translateX(-50%);white-space:nowrap;color:var(--safe);font:600 8px/1 var(--font-mono),monospace;letter-spacing:.16em;text-transform:uppercase;text-shadow:0 0 12px rgba(138,245,181,.72);opacity:0;animation:snx-life var(--cycle) steps(1) infinite}.snx-target-box{position:absolute;z-index:10;left:calc(50% - 58px);top:calc(52% - 48px);width:116px;height:220px;opacity:0;border:1px solid var(--red);box-shadow:inset 0 0 30px rgba(255,59,59,.08),0 0 20px rgba(255,59,59,.15);animation:snx-lock var(--cycle) steps(1) infinite}
  .snx-target-box::before,.snx-target-box::after{content:"";position:absolute;width:8px;height:8px;border-color:#fff}.snx-target-box::before{left:-3px;top:-3px;border-left:2px solid;border-top:2px solid}.snx-target-box::after{right:-3px;bottom:-3px;border-right:2px solid;border-bottom:2px solid}
  .snx-card{position:absolute;z-index:13;width:230px;padding:13px 15px 14px;opacity:0;transform:translateY(10px);border:1px solid rgba(255,59,59,.28);background:rgba(7,8,11,.8);box-shadow:0 14px 45px rgba(0,0,0,.38),inset 3px 0 var(--red);backdrop-filter:blur(12px)}.snx-card.snx-identity{left:calc(50% + 86px);top:calc(52% - 145px);width:232px;animation:snx-card-a var(--cycle) ease infinite}.snx-card.snx-keyable{left:calc(50% + 92px);top:calc(52% + 18px);width:224px;animation:snx-card-b var(--cycle) ease infinite}
  .snx-identity::before,.snx-keyable::before{content:"";position:absolute;right:100%;top:50%;width:42px;height:1px;background:linear-gradient(90deg,var(--red),rgba(255,59,59,.3));transform-origin:right center}.snx-identity::before{width:96px;transform:rotate(-43deg)}.snx-identity::after{content:"";position:absolute;left:-72px;top:calc(50% + 63px);width:5px;height:5px;border-radius:50%;background:var(--red);box-shadow:0 0 10px var(--red)}.snx-keyable::before{transform:rotate(-9deg)}.snx-card.snx-points{right:3.5%;bottom:20%;width:300px;animation:snx-card-c var(--cycle) ease infinite}
  .snx-data-label{color:var(--steel);font-size:8px;margin-bottom:8px}.snx-data-main{display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-weight:700;font-size:15px}.snx-data-main em{color:var(--red);font-style:normal;font-family:var(--font-mono),monospace;font-size:10px}.snx-data-meta{margin-top:7px;color:rgba(231,236,236,.56);font-family:var(--font-mono),monospace;font-size:9px;line-height:1.5}.snx-points-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.snx-points-grid div{border-top:1px solid rgba(255,255,255,.12);padding-top:7px}.snx-points-grid strong{display:block;font-family:var(--font-display),sans-serif;font-size:26px;line-height:1}.snx-points-grid span{color:var(--steel);font-family:var(--font-mono),monospace;font-size:7px;letter-spacing:.1em;text-transform:uppercase}.snx-call{padding:8px 10px;background:var(--red);color:#170404;font-family:var(--font-mono),monospace;font-size:10px;font-weight:700;letter-spacing:.12em;text-align:center}
  .snx-leaderboard{position:absolute;z-index:13;left:50%;bottom:5.5%;width:390px;padding:11px 14px;opacity:0;transform:translate(-50%,10px);border:1px solid rgba(138,245,181,.28);background:rgba(7,8,11,.82);box-shadow:inset 3px 0 var(--safe),0 14px 45px rgba(0,0,0,.38);backdrop-filter:blur(12px);animation:snx-card-d var(--cycle) ease infinite}.snx-leaderboard strong{display:block;color:var(--safe);font-family:var(--font-mono),monospace;font-size:10px;letter-spacing:.13em;text-transform:uppercase}.snx-leaderboard span{display:block;margin-top:6px;color:rgba(231,236,236,.62);font-family:var(--font-mono),monospace;font-size:8px;letter-spacing:.07em;line-height:1.45;text-transform:uppercase}.snx-stage,.snx-replay-clock{position:absolute;z-index:14;bottom:22px;font-size:9px}.snx-stage{left:50%;transform:translateX(-50%);color:var(--steel)}.snx-stage span{color:var(--red)}.snx-replay-clock{right:clamp(22px,4vw,70px);color:var(--amber)}
  @keyframes snx-scene{0%,5%{transform:scale(1.025);filter:saturate(1.04) contrast(1.08) brightness(.79)}6.5%{transform:scale(1.07) translate3d(-1%,-.25%,0);filter:saturate(.92) contrast(1.13) brightness(.73)}7.5%,92%{transform:scale(1.09) translate3d(0,-.6%,0);filter:saturate(.76) contrast(1.16) brightness(.68)}100%{transform:scale(1.025);filter:saturate(1.04) contrast(1.08) brightness(.79)}}
  @keyframes snx-scope-in{0%,4.9%{opacity:0;transform:translate(calc(-50% + 41vw),calc(-50% + 4vh)) scale(.16);box-shadow:0 0 0 120vmax transparent}5%{opacity:1;transform:translate(calc(-50% + 41vw),calc(-50% + 4vh)) scale(.16);box-shadow:0 0 0 120vmax transparent}5.9%{opacity:1;transform:translate(calc(-50% + 25vw),calc(-50% + 2vh)) scale(.36) rotate(.18deg);box-shadow:0 0 0 120vmax rgba(2,3,4,.08)}6.8%{opacity:1;transform:translate(calc(-50% + 8vw),-50%) scale(.82) rotate(-.15deg);box-shadow:0 0 0 120vmax rgba(2,3,4,.64)}7.5%,92%{opacity:1;transform:translate(-50%,-50%) scale(1);box-shadow:0 0 0 120vmax rgba(2,3,4,.965)}97%,100%{opacity:0;transform:translate(-50%,-50%) scale(.72);box-shadow:0 0 0 120vmax rgba(2,3,4,.2)}}
