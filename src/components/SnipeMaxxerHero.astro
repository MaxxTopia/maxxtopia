---
import type { Product } from '../data/products';
type Props = { product: Product };
const { product } = Astro.props;
const primary = product.primaryCta;
const secondary = product.secondaryCta;
---

<section class="snx-hero" data-mode="fortnite" aria-label={`${product.name} match intelligence hero`}>
  <div class="snx-scene" aria-hidden="true"></div>
  <div class="snx-atmosphere" aria-hidden="true"></div>
  <div class="snx-freeze" aria-hidden="true"></div>
  <div class="snx-grain" aria-hidden="true"></div>

  <div class="snx-copy">
    <a href="/#apps" class="snx-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      All products
    </a>
    <p class="snx-eyebrow">Match intelligence · beta {product.version}</p>
    <h1>Know the lobby.<br /><span data-mode-copy="headline">Play the points.</span></h1>
    <p class="snx-lede" data-mode-copy="lede">The replay names the threats. The live leaderboard tells you what to do next.</p>
    <div class="snx-mode-switch" role="group" aria-label="Choose a game mode">
      <button type="button" class="snx-mode-button snx-mode-button-fortnite" data-mode-target="fortnite" aria-pressed="true"><span>FN</span><strong>Fortnite</strong><small>Tournament desk</small></button>
      <button type="button" class="snx-mode-button snx-mode-button-valorant" data-mode-target="valorant" aria-pressed="false"><span>V</span><strong>Valorant</strong><small>Session desk</small></button>
    </div>
    <div class="snx-timing"><strong data-mode-copy="timingValue">~5 MIN</strong><i></i><span data-mode-copy="timingLabel">Replay behind live · leaderboard live</span></div>
    <div class="snx-actions">
      <a class="snx-cta snx-primary" href={primary.href} target={primary.external ? '_blank' : undefined} rel={primary.external ? 'noopener' : undefined}>{primary.label}</a>
      {secondary && <a class="snx-cta" href={secondary.href} target={secondary.external ? '_blank' : undefined} rel={secondary.external ? 'noopener' : undefined}>{secondary.label}</a>}
    </div>
  </div>

  <div class="snx-scope" aria-hidden="true">
    <div class="snx-lens"></div>
    <p class="snx-scope-label snx-top" data-mode-copy="scopeTop">Official tournament replay · resolving field</p>
    <p class="snx-scope-label snx-bottom" data-mode-copy="scopeBottom">Tracked tendency read · zero game memory access</p>
  </div>

  <div class="snx-bioscan" aria-hidden="true">
    <span class="snx-scan-halo"></span><span class="snx-scan-orbit"></span>
    <span class="snx-scan-orbit snx-second"></span><span class="snx-scan-sweep"></span>
    <svg class="snx-scan-rig" viewBox="0 0 190 286">
      <g class="snx-triangulation"><path d="M4 22 97 76 186 17M0 145 96 128 190 166M14 276 96 166 178 282"/><path d="M34 0 85 103M157 0 110 102M0 108 61 124M190 114 116 108"/></g>
        <path class="snx-body-outline" d="M98 63c-8-1-15 5-16 13-1 7 2 13 8 17l-5 8-12 5-10 9-22 8 4 9 22-4 16-10 3 31-5 20 5 13-8 31-10 48-12 7 2 8h21l7-11 7-37 4-25 7 25 3 40-5 7 4 7h22l2-8-9-8-4-49-7-33-2-28 8-29-5-28 8 9 4 18 9-1 1-23-9-20-14-8-5-9c7-2 12-9 12-17 0-8-6-15-14-16l-2-4-5 3-8-1Z"/>
        <g class="snx-bone"><circle cx="98" cy="78" r="11"/><path d="M97 90 96 128 96 166M85 103 96 108 110 102M85 103 74 115 61 124M110 102 117 118 123 135M96 166 84 210 72 258M96 166 108 211 113 257M84 139 108 138M86 160 105 160"/></g>
      <g class="snx-joint"><circle cx="97" cy="90" r="2.5"/><circle cx="85" cy="103" r="2.5"/><circle cx="110" cy="102" r="2.5"/><circle cx="74" cy="115" r="2.5"/><circle cx="61" cy="124" r="2.5"/><circle cx="117" cy="118" r="2.5"/><circle cx="123" cy="135" r="2.5"/><circle cx="96" cy="128" r="2.5"/><circle cx="96" cy="166" r="2.5"/><circle cx="84" cy="210" r="2.5"/><circle cx="108" cy="211" r="2.5"/><circle cx="72" cy="258" r="2.5"/><circle cx="113" cy="257" r="2.5"/></g>
      <circle class="snx-vitals" cx="96" cy="126" r="8"/>
    </svg>
    <span class="snx-life-sign" data-mode-copy="lifeSign">Life sign confirmed · official replay path</span>
  </div>
  <div class="snx-target-box" aria-hidden="true"></div>

  <article class="snx-card snx-identity">
    <div class="snx-data-label" data-mode-copy="identityLabel">Identity resolved</div>
    <div class="snx-data-main"><span data-mode-copy="identityMain">falcon peterbotǃ</span><em data-mode-copy="identityMeta">LEGEND · NA</em></div>
    <div class="snx-data-meta" data-mode-copy="identityFoot">2024 FNCS GLOBAL CHAMPION · KNOWN PRO</div>
  </article>
  <article class="snx-card snx-keyable">
    <div class="snx-data-label" data-mode-copy="keyableLabel">Tracked landing tendency</div>
    <div class="snx-data-main"><span data-mode-copy="keyableMain">Sinister Strip</span><em data-mode-copy="keyableScore">10 / 10</em></div>
    <div class="snx-data-meta" data-mode-copy="keyableMeta">TEN TRACKED TOURNAMENT GAMES · SAME DROP EVERY GAME</div>
  </article>
  <article class="snx-card snx-points">
    <div class="snx-data-label" data-mode-copy="pointsLabel">Tracked form · real replay history</div>
    <div class="snx-points-grid">
      <div><strong data-mode-copy="stat1Value">#1</strong><span data-mode-copy="stat1Label">Best finish</span></div>
      <div><strong data-mode-copy="stat2Value">13</strong><span data-mode-copy="stat2Label">Elims</span></div>
      <div><strong data-mode-copy="stat3Value">20.2K</strong><span data-mode-copy="stat3Label">Damage dealt</span></div>
    </div>
    <div class="snx-call" data-mode-copy="call">Threat read · +8,179 damage trade</div>
  </article>
  <article class="snx-leaderboard">
    <strong data-mode-copy="leaderboardTitle">Points brain · live leaderboard</strong>
    <span data-mode-copy="leaderboardText">Your points · rank · games left · qualify gap · placement or push call — no replay delay</span>
  </article>
  <div class="snx-stage"><span data-mode-copy="stageLabel">Replay boundary</span><i aria-hidden="true"> · </i><b data-mode-copy="stageText">official server replay, usually ~5 min behind</b></div>
</section>

<section class="snx-desk" data-mode="fortnite" aria-labelledby="snx-desk-title" hidden aria-hidden="true">
  <div class="snx-desk-shell">
    <header class="snx-desk-header">
      <div>
        <p class="snx-desk-eyebrow">The desk · Snipemaxxer {product.version}</p>
        <h2 id="snx-desk-title">Read the signal.<br /><span>Make the next call.</span></h2>
        <p class="snx-desk-intro" data-desk-copy="deskIntro">Start with what is live. Add the official replay when it lands. Then turn evidence into your next drop call.</p>
      </div>
      <div class="snx-desk-status" aria-live="polite">
        <span data-desk-copy="deskModeLabel">FORTNITE / TOURNAMENT DESK</span>
        <strong data-desk-copy="deskStatus">LIVE STANDING / REPLAY NEXT</strong>
      </div>
    </header>

    <div class="snx-desk-flow" aria-label="How the desk turns game data into decisions">
      <div class="snx-desk-flow-step"><small>01</small><strong data-desk-copy="flow1Title">Live standing</strong><span data-desk-copy="flow1Text">Points + cutoff</span></div>
      <i aria-hidden="true"></i>
      <div class="snx-desk-flow-step"><small>02</small><strong data-desk-copy="flow2Title">Official replay</strong><span data-desk-copy="flow2Text">Lobby + drops</span></div>
      <i aria-hidden="true"></i>
      <div class="snx-desk-flow-step"><small>03</small><strong data-desk-copy="flow3Title">Next call</strong><span data-desk-copy="flow3Text">Routes + pressure</span></div>
    </div>

    <div class="snx-desk-summary">
      <div class="snx-desk-command">
        <div class="snx-desk-command-top"><span class="snx-desk-kicker" data-desk-copy="deskKicker">01 / LIVE SIGNAL</span><span class="snx-desk-signal" data-desk-copy="deskSignal">EPIC STANDING</span></div>
        <h3 data-desk-copy="deskHeadline">Know the race before it closes.</h3>
        <p data-desk-copy="deskBody">The live standing shows your points, rank, games left, and cutoff gap now. When the official replay lands, scout the lobby and choose the next drop with evidence.</p>
        <div class="snx-desk-tags">
          <span data-desk-copy="deskChip1">LIVE / POINTS + CUTOFF</span>
          <span data-desk-copy="deskChip2">REPLAY / LOBBY + DROPS</span>
          <span data-desk-copy="deskChip3">LAB / ROUTES + DECISIONS</span>
          <span data-desk-copy="deskChip4">COACH / NEXT MOVE</span>
        </div>
        <div class="snx-desk-boundary">
          <span>DATA BOUNDARY</span>
          <b data-desk-copy="deskBoundary">Standing data is live. Official Epic replay data commonly arrives about five minutes later.</b>
        </div>
      </div>
      <div class="snx-desk-metrics" aria-label="Current app signals">
        <div><small>01 / NOW</small><strong data-desk-copy="deskMetric1Value">LIVE</strong><span data-desk-copy="deskMetric1Label">Epic standing</span></div>
        <div><small>02 / WHEN IT LANDS</small><strong data-desk-copy="deskMetric2Value">~5M</strong><span data-desk-copy="deskMetric2Label">Replay freshness</span></div>
        <div><small>03 / NEXT</small><strong data-desk-copy="deskMetric3Value">SCOUT</strong><span data-desk-copy="deskMetric3Label">Lobby intelligence</span></div>
      </div>
    </div>

    <div class="snx-desk-proof">
      <div class="snx-desk-proof-heading">
        <span data-desk-copy="deskProofLabel">PROOF FROM THE REAL APP / FORTNITE</span>
        <i aria-hidden="true"></i>
        <b data-desk-copy="deskProofNote">These are current app surfaces, not concept screens.</b>
      </div>

      <div class="snx-desk-proof-grid">
        <figure class="snx-desk-shot" data-desk-mode="fortnite">
          <div class="snx-desk-shot-frame"><img src="/screenshots/snipemaxxer/fortnite-home.webp" alt="Snipemaxxer Fortnite tournament desk captured from the current app" loading="lazy" /></div>
          <figcaption><strong>Tournament desk</strong><span>Standing / cutoff / replay freshness</span></figcaption>
        </figure>
        <figure class="snx-desk-shot" data-desk-mode="fortnite">
          <div class="snx-desk-shot-frame"><img src="/screenshots/snipemaxxer/fortnite-scout.webp" alt="Snipemaxxer Fortnite Scout surface captured from the current app" loading="lazy" /></div>
          <figcaption><strong>Scout workspace</strong><span>Replay intake / lobby read</span></figcaption>
        </figure>

        <div class="snx-desk-valorant-preview" data-desk-mode="valorant" hidden>
          <div class="snx-desk-val-real-grid">
            <figure class="snx-desk-shot">
              <div class="snx-desk-shot-frame"><img src="/screenshots/snipemaxxer/valorant-home-live.webp" alt="Snipemaxxer Valorant Home with rank, RR, live phase, and Riot connection captured from the current app" loading="lazy" /></div>
              <figcaption><strong>Live session desk</strong><span>Rank / RR / phase / lobby</span></figcaption>
            </figure>
            <figure class="snx-desk-shot snx-desk-shot-report">
              <div class="snx-desk-shot-frame"><img src="/screenshots/snipemaxxer/valorant-live-report.webp" alt="Snipemaxxer Valorant full lobby report captured from the current app" loading="lazy" /></div>
              <figcaption><strong>Full lobby report</strong><span>Teams / rank / win rate / intel</span></figcaption>
            </figure>
          </div>
          <div class="snx-desk-val-top"><span>SNIPEMAXXER / VALORANT HOME</span><b>v{product.version}</b></div>
          <div class="snx-desk-val-nav"><span class="is-active">HOME</span><span>REPORTS</span><span>CROSSHAIRS</span><span>ALERTS</span></div>
          <div class="snx-desk-val-grid">
            <article><span>CURRENT RANK</span><strong>RANK / RR</strong><small>PEAK · LATEST 10</small></article>
            <article><span>RIGHT NOW</span><strong>RIOT CLIENT</strong><small>PHASE · LOBBY · READ-ONLY</small></article>
            <article><span>MATCH REPORTS</span><strong>FULL LOBBY</strong><small>K/D/A · SCORE · HS% · ROUND SPINE</small></article>
            <article><span>PERSONAL TOOLKIT</span><strong>CROSSHAIRS</strong><small>WATCHLISTS · STORE · SKINS · ALERTS</small></article>
          </div>
          <div class="snx-desk-val-foot"><span>UI PREVIEW</span><b>Current surfaces · live data fills this panel when linked</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .snx-hero{--red:#ff3b3b;--valorant:#ff6472;--fortnite-blue:#2b8ef3;--amber:#ffb547;--safe:#8af5b5;--steel:#8191a1;--scan-rgb:255,181,71;--scan-secondary-rgb:255,216,151;--cycle:12s;--scene:url("/screenshots/snipemaxxer/scout-map.webp");--scene-position:50% 47%;--scene-filter:saturate(1.08) contrast(1.04) brightness(.62);--scope-scene:url("/screenshots/snipemaxxer/scout-map.webp");--scene-overlay:radial-gradient(circle at 72% 26%,rgba(54,182,255,.24),transparent 28%),linear-gradient(135deg,rgba(28,105,180,.26),transparent 45%,rgba(255,59,59,.14));--scene-vignette:linear-gradient(90deg,rgba(7,8,11,.9),rgba(7,8,11,.52) 30%,rgba(7,8,11,.08) 66%),linear-gradient(0deg,rgba(7,8,11,.84),transparent 40%),radial-gradient(circle at 56% 48%,transparent 10%,rgba(5,6,8,.16) 44%,rgba(5,6,8,.7));position:relative;min-height:clamp(900px,calc(100svh + 96px),1120px);isolation:isolate;overflow:hidden;background:#090a0d;color:#e7ecec;font-family:var(--font-sans),system-ui,sans-serif}
  .snx-hero *{box-sizing:border-box}.snx-scene{position:absolute;inset:0;z-index:-5;background:var(--scene) var(--scene-position)/cover no-repeat;transform:scale(1.025);filter:var(--scene-filter);animation:snx-scene var(--cycle) cubic-bezier(.2,.7,.2,1) infinite}.snx-scene::before{content:"";position:absolute;inset:0;background:var(--scene-overlay);opacity:.9;mix-blend-mode:screen}.snx-scene::after{content:"";position:absolute;inset:0;background:var(--scene-vignette)}
  .snx-atmosphere{position:absolute;z-index:-3;inset:0;pointer-events:none;opacity:.55;mix-blend-mode:screen;background:radial-gradient(circle at 12% 74%,rgba(255,132,48,.55) 0 1px,transparent 2px),radial-gradient(circle at 24% 28%,rgba(255,191,88,.48) 0 1px,transparent 2px),radial-gradient(circle at 45% 19%,rgba(255,87,38,.45) 0 1px,transparent 2px),radial-gradient(circle at 62% 31%,rgba(255,188,100,.42) 0 1px,transparent 2px),radial-gradient(circle at 78% 17%,rgba(255,86,42,.5) 0 1px,transparent 2px),radial-gradient(circle at 88% 63%,rgba(255,183,84,.44) 0 1px,transparent 2px);background-size:180px 210px,240px 190px,300px 240px,220px 270px,340px 230px,260px 180px;animation:snx-embers 9s linear infinite}
  .snx-intervention{position:absolute;z-index:5;right:-6%;bottom:20%;width:min(62vw,860px);pointer-events:none;opacity:0;transform:translate(8%,12%) rotate(6deg);filter:drop-shadow(0 24px 26px rgba(0,0,0,.72));animation:snx-intervention-in var(--cycle) cubic-bezier(.2,.7,.2,1) infinite}.snx-intervention svg{display:block;width:100%;height:auto;overflow:visible}.snx-intervention-shadow{fill:rgba(0,0,0,.54);stroke:none}.snx-intervention-metal{fill:url(#snx-intervention-metal);stroke:#6d8791;stroke-width:2;stroke-linejoin:round}.snx-intervention-red{fill:url(#snx-intervention-red);stroke:#ff7a75;stroke-width:1.5;stroke-linejoin:round}.snx-intervention-glass{fill:url(#snx-intervention-glass);stroke:#9de7ef;stroke-width:2;stroke-linejoin:round}
  .snx-grain{position:absolute;inset:0;z-index:20;pointer-events:none;opacity:.17;mix-blend-mode:soft-light;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E")}
  .snx-copy{position:absolute;z-index:30;left:clamp(28px,6vw,110px);top:9%;width:min(450px,37vw);pointer-events:none}.snx-back{pointer-events:auto;display:inline-flex;align-items:center;gap:7px;margin-bottom:clamp(36px,6vh,68px);color:rgba(231,236,236,.58);font:600 11px/1 var(--font-mono),monospace;letter-spacing:.08em;text-decoration:none;text-transform:uppercase;transition:color .2s}.snx-back:hover{color:#fff}
  .snx-eyebrow,.snx-timing,.snx-scope-label,.snx-data-label,.snx-stage,.snx-replay-clock{font-family:var(--font-mono),monospace;text-transform:uppercase;letter-spacing:.14em}.snx-eyebrow{color:var(--red);font-size:clamp(10px,.85vw,13px);margin:0 0 20px}.snx-copy h1{max-width:440px;margin:0;overflow:visible;padding-bottom:.06em;color:#e7ecec;font-size:clamp(58px,6.2vw,108px);font-weight:800;line-height:.88;letter-spacing:-.055em}.snx-copy h1 span{display:inline-block;color:var(--red);text-shadow:0 0 40px rgba(255,59,59,.3)}.snx-lede{max-width:400px;margin:24px 0 0;color:rgba(231,236,236,.7);font-size:clamp(14px,1.1vw,18px);line-height:1.55}
  .snx-mode-switch{display:flex;gap:8px;margin-top:22px;pointer-events:auto}
  .snx-mode-button{display:grid;grid-template-columns:30px 1fr;grid-template-rows:1fr 1fr;column-gap:9px;min-width:152px;padding:8px 11px;border:1px solid rgba(255,255,255,.16);color:rgba(231,236,236,.72);background:rgba(8,9,12,.62);font:600 11px/1 var(--font-sans),system-ui,sans-serif;text-align:left;cursor:pointer;backdrop-filter:blur(8px);transition:transform .2s,border-color .2s,background .2s,color .2s}
  .snx-mode-button:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.42);color:#fff}
  .snx-mode-button>span{grid-row:1 / span 2;display:grid;place-items:center;width:30px;height:30px;color:#160404;font:800 10px/1 var(--font-mono),monospace}
  .snx-mode-button>strong{align-self:end;letter-spacing:.04em}
  .snx-mode-button>small{align-self:start;margin-top:3px;color:var(--steel);font:600 8px/1 var(--font-mono),monospace;letter-spacing:.08em;text-transform:uppercase}
  .snx-mode-button-fortnite>span{background:var(--fortnite-blue);color:#06111d}
  .snx-mode-button-valorant>span{background:var(--valorant);color:#21060a}
  .snx-mode-button-fortnite[aria-pressed="true"]{border-color:var(--fortnite-blue);background:rgba(43,142,243,.14);color:#fff;box-shadow:inset 3px 0 var(--fortnite-blue)}
  .snx-mode-button-valorant[aria-pressed="true"]{border-color:var(--valorant);background:rgba(255,100,114,.12);color:#fff;box-shadow:inset 3px 0 var(--valorant)}
  .snx-hero[data-mode="fortnite"]{--scope-scene:url("/screenshots/snipemaxxer/scout-map.webp");--scene-position:50% 47%;--scene-filter:saturate(1.08) contrast(1.04) brightness(.62);--scan-rgb:76,183,255;--scan-secondary-rgb:225,246,255}
  .snx-hero[data-mode="valorant"]{--red:var(--valorant);--scene:url("/screenshots/snipemaxxer/scout-map.webp");--scene-position:50% 50%;--scene-filter:saturate(.92) contrast(1.12) brightness(.64);--scope-scene:url("/screenshots/snipemaxxer/scout-map.webp");--scene-overlay:linear-gradient(135deg,rgba(255,100,114,.13),transparent 39%,rgba(36,216,255,.18)),radial-gradient(circle at 74% 28%,rgba(36,216,255,.2),transparent 32%);--scene-vignette:linear-gradient(90deg,rgba(7,8,11,.92),rgba(7,8,11,.54) 31%,rgba(7,8,11,.12) 70%),linear-gradient(0deg,rgba(7,8,11,.86),transparent 42%),radial-gradient(circle at 58% 45%,transparent 8%,rgba(5,6,8,.2) 45%,rgba(5,6,8,.76));--scan-rgb:255,100,114;--scan-secondary-rgb:112,235,229}
  .snx-hero[data-mode="valorant"] .snx-atmosphere{opacity:.34;background:radial-gradient(circle at 18% 28%,rgba(36,216,255,.45) 0 1px,transparent 2px),radial-gradient(circle at 74% 18%,rgba(255,100,114,.46) 0 1px,transparent 2px),radial-gradient(circle at 86% 69%,rgba(36,216,255,.4) 0 1px,transparent 2px);background-size:220px 180px,300px 230px,260px 190px}
  .snx-mode-guide{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;max-width:420px;margin-top:12px}.snx-mode-guide>div{display:grid;gap:4px;padding:8px 10px;border-left:2px solid var(--fortnite-blue);background:rgba(8,9,12,.48);backdrop-filter:blur(8px)}.snx-mode-guide>div:last-child{border-color:var(--valorant)}.snx-mode-guide strong{color:#fff;font-size:10px;line-height:1}.snx-mode-guide span{color:rgba(231,236,236,.62);font-size:9px;line-height:1.35}
  .snx-timing{display:flex;align-items:center;gap:13px;margin-top:28px;font-size:10px;color:var(--steel)}.snx-timing strong{color:var(--amber);font-size:15px}.snx-timing i{width:58px;height:1px;background:linear-gradient(90deg,var(--amber),transparent)}.snx-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:24px;position:relative;z-index:40;pointer-events:auto;opacity:1;transform:none;visibility:visible}
  .snx-cta{position:relative;z-index:41;display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 22px;border:1px solid rgba(255,255,255,.2);color:#fff;text-decoration:none;font-weight:700;font-size:13px;line-height:1;white-space:nowrap;background:rgba(8,9,12,.9);backdrop-filter:blur(8px);pointer-events:auto;touch-action:manipulation;visibility:visible;transition:transform .2s,border-color .2s}.snx-cta:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.55)}.snx-cta.snx-primary{background:var(--red);border-color:var(--red);color:#160404;box-shadow:0 0 35px rgba(255,59,59,.2)}
