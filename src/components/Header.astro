---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---

<style>
  /* Header discordmaxxer entry — subtle blurple ring on hover, scale,
     plus a magenta plasma halo to echo the Slice logo aesthetic. */
  /* Wordmark pill — secondary nav presence, doesn't compete with the
     primary CTA next to it. Subtle border + dim text, brightens on hover.
     Mark on the left, "Discordmaxxer" wordmark in Geist Mono. */
  .header-dm-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 14px 0 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.025);
    color: var(--color-text-dim, #a8acb8);
    font-family: var(--font-mono, ui-monospace), monospace;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 220ms ease, color 220ms ease,
                background 220ms ease, box-shadow 220ms ease;
  }
  .header-dm-btn:hover {
    transform: translateY(-1px);
    color: #fff;
    border-color: rgba(226, 91, 255, 0.35);
    background: rgba(226, 91, 255, 0.05);
    box-shadow: 0 0 18px rgba(226, 91, 255, 0.18);
  }
  .header-dm-btn .dm-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e25bff 0%, #4c51f7 100%);
    flex-shrink: 0;
  }
  .header-dm-btn .dm-mark img {
    width: 60%;
    height: 60%;
    object-fit: contain;
    pointer-events: none;
  }
</style>

<header class="sticky top-0 z-40 border-b border-[var(--color-line)]/80 bg-[rgba(10,6,18,0.85)] backdrop-blur-md">
  <div class="mx-auto flex h-15 max-w-7xl items-center justify-between px-5 sm:px-8 py-3">
    <div class="flex items-center gap-8">
      <Logo />
      <nav class="hidden md:flex items-center gap-6 text-[13.5px] text-[var(--color-muted)]">
        <a
          href="/#suite"
          class={`relative transition-colors hover:text-[var(--color-text)] ${path === '/' ? 'text-[var(--color-text)]' : ''}`}
        >Suite</a>
        <a
          href="/manifesto"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/manifesto') ? 'text-[var(--color-text)]' : ''}`}
        >Manifesto</a>
        <a
          href="/changelog"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/changelog') ? 'text-[var(--color-text)]' : ''}`}
        >Changelog</a>
      </nav>
    </div>
    <div class="flex items-center gap-2.5">
      <a
        href="/discordmaxxer"
        class="header-dm-btn hidden sm:inline-flex"
        aria-label="Discordmaxxer — Discord, optimized."
        title="Discordmaxxer"
      >
        <span class="dm-mark"><img src="/logos/discordmaxxer-icon.png" alt="" width="24" height="24" /></span>
        <span>Discordmaxxer</span>
      </a>
      <a href="/optimizationmaxxing" class="btn-primary !h-10 !px-4 !text-[13.5px]">
        Get the tuner
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>
