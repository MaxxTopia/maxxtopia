---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---

<style>
  /* Header discordmaxxer entry — subtle blurple ring on hover, scale,
     plus a magenta plasma halo to echo the Slice logo aesthetic. */
  .header-dm-btn {
    position: relative;
    border: 1px solid rgba(88, 101, 242, 0.45);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 220ms ease, box-shadow 220ms ease;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04) inset,
                0 0 12px rgba(88, 101, 242, 0.18);
  }
  .header-dm-btn:hover {
    transform: scale(1.06);
    border-color: rgba(255, 93, 255, 0.65);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 0 18px rgba(88, 101, 242, 0.45),
      0 0 32px rgba(226, 91, 255, 0.35);
  }
  .header-dm-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
</style>

<header class="sticky top-0 z-40 border-b border-[var(--color-line)]/80 bg-[rgba(10,6,18,0.85)] backdrop-blur-md">
  <div class="mx-auto flex h-15 max-w-7xl items-center justify-between px-5 sm:px-8 py-3">
    <div class="flex items-center gap-8">
      <Logo />
      <nav class="hidden md:flex items-center gap-6 text-[13.5px] text-[var(--color-muted)]">
        <a
          href="/#suite"
          class={`relative transition-colors hover:text-[var(--color-text)] ${path === '/' ? 'text-[var(--color-text)]' : ''}`}
        >Suite</a>
        <a
          href="/manifesto"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/manifesto') ? 'text-[var(--color-text)]' : ''}`}
        >Manifesto</a>
        <a
          href="/changelog"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/changelog') ? 'text-[var(--color-text)]' : ''}`}
        >Changelog</a>
      </nav>
    </div>
    <div class="flex items-center gap-2.5">
      <a
        href="/discordmaxxer"
        class="header-dm-btn hidden sm:inline-flex items-center justify-center w-10 h-10 rounded-full overflow-hidden"
        aria-label="Discordmaxxer — Discord, optimized."
        title="Discordmaxxer"
      >
        <img src="/logos/discordmaxxer.svg" alt="" width="40" height="40" />
      </a>
      <a href="/optimizationmaxxing" class="btn-primary !h-10 !px-4 !text-[13.5px]">
        Get the tuner
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</header>
