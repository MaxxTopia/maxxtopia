---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/');
---

<style>
  /* Per-product icon button — small circular brand shortcut. Energy
     matches `.btn-primary` (the "Get the tuner" CTA): magenta-to-blurple
     gradient base, glow shadow, scale-on-hover. As more products ship,
     each gets its own icon in this row. */
  .header-product-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 220ms ease, filter 220ms ease;
    will-change: transform;
  }
  .header-product-btn:hover {
    transform: translateY(-1px) scale(1.05);
    filter: brightness(1.1);
  }
  .header-product-btn img,
  .header-product-btn svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Discordmaxxer — naked logo, no circle, no background. The horror-Clyde
     mark carries its own identity (red eyes, devil horns, speech-tail), so
     wrapping it in a magenta-blurple gradient was redundant and shrank the
     glyph. Sized larger than its sibling buttons because it has no chrome
     to fill out the slot. */
  .header-dm-btn {
    width: 52px;
    height: 52px;
    border-radius: 0;
    overflow: visible;
    background: transparent;
    box-shadow: none;
    filter: drop-shadow(0 4px 12px rgba(226, 91, 255, 0.18));
  }
  .header-dm-btn img {
    object-fit: contain;
  }
  .header-dm-btn:hover {
    filter:
      drop-shadow(0 6px 18px rgba(226, 91, 255, 0.45))
      drop-shadow(0 0 28px rgba(0, 212, 255, 0.18))
      brightness(1.1);
  }

  /* Optimizationmaxxing — sits AFTER "Get the tuner →" so the arrow
     visually points at it. Uses the existing OM SVG which has its own
     dark base + bolt gradient, so we just add a glow ring on hover. */
  .header-om-btn {
    background: transparent;
    box-shadow:
      0 0 0 1px rgba(192, 132, 252, 0.25),
      0 8px 24px rgba(192, 132, 252, 0.15);
  }
  .header-om-btn:hover {
    box-shadow:
      0 0 0 1px rgba(192, 132, 252, 0.55),
      0 12px 36px rgba(192, 132, 252, 0.4),
      0 0 50px rgba(0, 212, 255, 0.18);
  }

  /* CTA button — neutral the bottom margin so the OM icon sits flush. */
  .header-cta {
    margin-right: 2px;
  }

  /* Discord nav link — Discord-blurple tint on hover so it reads as the
     "join community" action, not just another nav item. The icon picks
     up `currentColor` so the whole link tints together. */
  .header-discord-link:hover {
    color: #5865F2;
  }
  .header-discord-link svg {
    transition: transform 220ms ease;
  }
  .header-discord-link:hover svg {
    transform: translateY(-1px) scale(1.08);
  }
</style>

<header class="sticky top-0 z-40 border-b border-[var(--color-line)]/80 bg-[rgba(10,6,18,0.85)] backdrop-blur-md">
  <div class="mx-auto flex h-15 max-w-7xl items-center justify-between px-5 sm:px-8 py-3">
    <div class="flex items-center gap-8">
      <Logo />
      <nav class="hidden md:flex items-center gap-6 text-[13.5px] text-[var(--color-muted)]">
        <a
          href="/#apps"
          class={`relative transition-colors hover:text-[var(--color-text)] ${path === '/' ? 'text-[var(--color-text)]' : ''}`}
        >Apps</a>
        <a
          href="/play"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/play') ? 'text-[var(--color-text)]' : ''}`}
        >Arcade</a>
        <a
          href="/why"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/why') ? 'text-[var(--color-text)]' : ''}`}
        >Why</a>
        <a
          href="/updates"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/updates') ? 'text-[var(--color-text)]' : ''}`}
        >Updates</a>
        <a
          href="/guides"
          class={`relative transition-colors hover:text-[var(--color-text)] ${isActive('/guides') ? 'text-[var(--color-text)]' : ''}`}
        >Guides</a>
        <a
          href="https://discord.gg/S78eecbWdx"
          target="_blank"
          rel="noopener noreferrer"
          class="header-discord-link relative inline-flex items-center gap-1.5 transition-colors hover:text-[var(--color-text)]"
          aria-label="Join the Maxxtopia Discord (opens in new tab)"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09c-.01-.02-.04-.03-.07-.03c-1.5.26-2.93.71-4.27 1.33c-.01 0-.02.01-.03.02c-2.72 4.07-3.47 8.03-3.1 11.95c0 .02.01.04.03.05c1.8 1.32 3.53 2.12 5.24 2.65c.03.01.06 0 .07-.02c.4-.55.76-1.13 1.07-1.74c.02-.04 0-.08-.04-.09c-.57-.22-1.11-.48-1.64-.78c-.04-.02-.04-.08-.01-.11c.11-.08.22-.17.33-.25c.02-.02.05-.02.07-.01c3.44 1.57 7.15 1.57 10.55 0c.02-.01.05-.01.07.01c.11.09.22.17.33.26c.04.03.04.09-.01.11c-.52.31-1.07.56-1.64.78c-.04.01-.05.06-.04.09c.32.61.68 1.19 1.07 1.74c.03.01.06.02.09.01c1.72-.53 3.45-1.33 5.25-2.65c.02-.01.03-.03.03-.05c.44-4.53-.73-8.46-3.1-11.95c-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12c0 1.17-.83 2.12-1.89 2.12z"/>
          </svg>
          Discord
        </a>
      </nav>
    </div>
    <div class="flex items-center gap-2.5">
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-[var(--color-text)] border border-[var(--color-line)] bg-[rgba(255,255,255,0.03)]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="mobile-menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="mobile-menu-icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <a
        href="/discordmaxxer"
        class="header-product-btn header-dm-btn hidden sm:inline-flex"
        aria-label="Discordmaxxer — Discord, optimized."
        title="Discordmaxxer"
      >
        <img src="/logos/discordmaxxer.png" alt="" width="52" height="52" />
      </a>
      <a href="/optimizationmaxxing" class="btn-primary header-cta !h-10 !px-4 !text-[13.5px]">
        Get the tuner
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a
        href="/optimizationmaxxing"
        class="header-product-btn header-om-btn hidden sm:inline-flex"
        aria-label="Optimizationmaxxing — 100 sourced Windows tweaks."
        title="Optimizationmaxxing"
      >
        <img src="/logos/optimizationmaxxing.svg" alt="" width="40" height="40" />
      </a>
    </div>
  </div>

  <!-- Mobile dropdown — SEPARATE from the desktop nav above (which stays hidden md:flex,
       untouched). This is md:hidden, so it only exists below the desktop breakpoint. -->
  <nav id="mobile-menu" class="md:hidden hidden border-t border-[var(--color-line)] bg-[rgba(10,6,18,0.97)] px-5 pb-3 pt-1" aria-label="Mobile menu">
    <a href="/#apps" class="block py-2.5 text-[15px] text-[var(--color-text)]">Apps</a>
    <a href="/play" class="block py-2.5 text-[15px] text-[var(--color-text)]">Arcade</a>
    <a href="/why" class="block py-2.5 text-[15px] text-[var(--color-text)]">Why</a>
    <a href="/updates" class="block py-2.5 text-[15px] text-[var(--color-text)]">Updates</a>
    <a href="/guides" class="block py-2.5 text-[15px] text-[var(--color-text)]">Guides</a>
    <a href="https://discord.gg/S78eecbWdx" target="_blank" rel="noopener noreferrer" class="block py-2.5 text-[15px] text-[var(--color-text)]">Discord</a>
  </nav>
  <script is:inline>
    (() => {
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iOpen = document.getElementById('mobile-menu-icon-open');
      const iClose = document.getElementById('mobile-menu-icon-close');
      if (!btn || !menu) return;
      const setOpen = (open) => {
        menu.classList.toggle('hidden', !open);
        iOpen.classList.toggle('hidden', open);
        iClose.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    })();
  </script>
</header>
