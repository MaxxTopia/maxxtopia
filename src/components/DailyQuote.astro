---
/**
 * Daily Quote — rotates one curated quote per calendar day. Same quote
 * shown all day, fresh tomorrow. Date-seeded client-side so it works
 * with the static build.
 *
 * Curated from the user's list: Ayanokoji, anime/anonymous lines, Diggy
 * originals, Luke Belmar, Greg Plitt, Bill Beswick, Andrew Tate, Isagi.
 */

const quotes = [
  // ── Ayanokoji ──────────────────────────────────────────────
  {
    text: "The greater the ability, the humbler the person. The lower it is, the more arrogant he is.",
    author: 'Ayanokoji Kiyotaka',
    source: 'Classroom of the Elite',
  },
  {
    text: "All people are nothing but tools. It doesn't matter how it's done. It doesn't matter what needs to be sacrificed. In this world, winning is everything.",
    author: 'Ayanokoji Kiyotaka',
    source: 'Classroom of the Elite',
  },

  // ── Diggy originals ───────────────────────────────────────
  {
    text: "Everyone plays not to lose. You have to play to dominate.",
    author: 'Diggy',
    source: 'maxxtopia',
  },

  // ── Anime / anonymous lines from the brief ────────────────
  {
    text: "Show me results and I'll overlook your failure. If you're not a prodigy amongst prodigies, you're just wasting my time.",
    author: 'unknown',
  },
  {
    text: "See the enemy you should respect — not the enemy you despise.",
    author: 'unknown',
  },
  {
    text: "But don't the mediocre surpass naturals in the end?",
    author: 'unknown',
  },
  {
    text: "You talk a big game, but I know you don't wanna give up. Most people would've tossed it. You're still holding on.",
    author: 'unknown',
  },
  {
    text: "You can't know your strength until you know your weakness. Do with that what you will. Maybe I'll see you around. I would love to see you prove my point.",
    author: 'unknown',
  },
  {
    text: "If it ends here, that just means this is how far I was meant to go.",
    author: 'unknown',
  },

  // ── Luke Belmar ────────────────────────────────────────────
  {
    text: "Be obsessed with the path you've chosen. Not the outcome.",
    author: 'Luke Belmar',
  },
  {
    text: "Take massive action. The market doesn't care about your feelings.",
    author: 'Luke Belmar',
  },

  // ── Greg Plitt ─────────────────────────────────────────────
  {
    text: "Set the standard high. Then exceed it.",
    author: 'Greg Plitt',
  },
  {
    text: "Don't be the average person doing the average thing.",
    author: 'Greg Plitt',
  },

  // ── Bill Beswick ───────────────────────────────────────────
  {
    text: "How you think determines how you feel. How you feel determines how you act. How you act determines what happens.",
    author: 'Bill Beswick',
  },

  // ── Andrew Tate ────────────────────────────────────────────
  {
    text: "Stress is the gym for the mind.",
    author: 'Andrew Tate',
  },

  // ── Yoichi Isagi (Blue Lock) ───────────────────────────────
  {
    text: "I will become the world's number-one striker. I'll devour them all.",
    author: 'Yoichi Isagi',
    source: 'Blue Lock',
  },
];
---

<aside class="daily-quote" id="daily-quote" aria-label="Quote of the day">
  <!-- Hidden seed list — JS picks one based on the day. -->
  <ul class="daily-quote__source" hidden>
    {quotes.map((q) => (
      <li
        data-text={q.text}
        data-author={q.author}
        data-source={q.source ?? ''}
      ></li>
    ))}
  </ul>

  <!-- Collapsed pill — visible when widget is minimized. -->
  <button
    type="button"
    class="daily-quote__pill"
    id="daily-quote-pill"
    aria-label="Show quote of the day"
    aria-expanded="false"
    hidden
  >
    <span class="daily-quote__dot" aria-hidden="true"></span>
    <span class="daily-quote__pill-label">QOTD</span>
  </button>

  <!-- Expanded card -->
  <div class="daily-quote__card" id="daily-quote-card">
    <div class="daily-quote__topbar">
      <p class="daily-quote__eyebrow">
        <span class="daily-quote__dot" aria-hidden="true"></span>
        QUOTE OF THE DAY
      </p>
      <button
        type="button"
        class="daily-quote__close"
        id="daily-quote-close"
        aria-label="Minimize quote of the day"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/>
        </svg>
      </button>
    </div>
    <blockquote class="daily-quote__text" data-quote-text>
      {quotes[0].text}
    </blockquote>
    <footer class="daily-quote__cite">
      <span class="daily-quote__author" data-quote-author>{quotes[0].author}</span>
      <span class="daily-quote__source-name" data-quote-source>{quotes[0].source ?? ''}</span>
    </footer>
  </div>
</aside>

<script is:inline>
  (function () {
    const root = document.getElementById('daily-quote');
    if (!root) return;
    const items = root.querySelectorAll('.daily-quote__source li');
    if (items.length === 0) return;

    // Stable per-day index — same quote shown all day, rotates at midnight.
    const day = Math.floor(Date.now() / (1000 * 60 * 60 * 24));
    const idx = day % items.length;
    const pick = items[idx];

    const text   = pick.getAttribute('data-text')   || '';
    const author = pick.getAttribute('data-author') || '';
    const source = pick.getAttribute('data-source') || '';

    const $text   = root.querySelector('[data-quote-text]');
    const $author = root.querySelector('[data-quote-author]');
    const $source = root.querySelector('[data-quote-source]');

    if ($text)   $text.textContent   = text;
    if ($author) $author.textContent = author;
    if ($source) $source.textContent = source;
    if ($source && !source) $source.style.display = 'none';

    // ── Collapse / expand ────────────────────────────────────────
    const STORAGE_KEY = 'maxxtopia_qotd_collapsed';
    const card  = document.getElementById('daily-quote-card');
    const pill  = document.getElementById('daily-quote-pill');
    const close = document.getElementById('daily-quote-close');
    if (!card || !pill || !close) return;

    const setCollapsed = (collapsed) => {
      if (collapsed) {
        card.setAttribute('hidden', '');
        pill.removeAttribute('hidden');
        pill.setAttribute('aria-expanded', 'false');
      } else {
        card.removeAttribute('hidden');
        pill.setAttribute('hidden', '');
        pill.setAttribute('aria-expanded', 'true');
      }
      sessionStorage.setItem(STORAGE_KEY, collapsed ? '1' : '0');
    };

    setCollapsed(sessionStorage.getItem(STORAGE_KEY) === '1');

    close.addEventListener('click', () => setCollapsed(true));
    pill.addEventListener('click',  () => setCollapsed(false));
  })();
</script>

<style>
  /* ── Floating QOTD widget ─────────────────────────────────────────
     Fixed bottom-right, always visible across every page during
     scroll. Collapses to a small "QOTD" pill via the close button;
     pill expands back to the card on click. State persists in
     sessionStorage. ──────────────────────────────────────────────── */
  .daily-quote {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 50;
    pointer-events: none;
  }
  .daily-quote > * { pointer-events: auto; }

  /* Pill (collapsed state) */
  .daily-quote__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 30% 30%, rgba(226, 91, 255, 0.22), transparent 60%),
      linear-gradient(180deg, rgba(20, 12, 36, 0.92), rgba(10, 6, 18, 0.96));
    border: 1px solid rgba(226, 91, 255, 0.55);
    color: #fbe7ff;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 14px 40px rgba(0, 0, 0, 0.5),
      0 0 24px rgba(226, 91, 255, 0.25);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }
  .daily-quote__pill:hover {
    transform: translateY(-2px);
    border-color: #e25bff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 18px 50px rgba(0, 0, 0, 0.55),
      0 0 32px rgba(226, 91, 255, 0.45);
  }
  .daily-quote__pill-label {
    font-weight: 600;
  }
  .daily-quote__pill[hidden] { display: none !important; }

  /* Card (expanded state) */
  .daily-quote__card {
    position: relative;
    width: min(360px, calc(100vw - 40px));
    padding: 16px 18px 18px;
    border-radius: 16px;
    border: 1px solid var(--color-line-strong);
    background:
      radial-gradient(ellipse at 0% 0%, rgba(226, 91, 255, 0.14), transparent 55%),
      radial-gradient(ellipse at 100% 100%, rgba(76, 81, 247, 0.14), transparent 55%),
      linear-gradient(180deg, rgba(20, 12, 36, 0.94), rgba(10, 6, 18, 0.97));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 40px rgba(226, 91, 255, 0.10);
    overflow: hidden;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    animation: qotd-card-in 240ms ease-out;
  }
  .daily-quote__card[hidden] { display: none !important; }
  @keyframes qotd-card-in {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }
  /* Magenta accent edge on the left — quote-block bar */
  .daily-quote__card::before {
    content: '';
    position: absolute;
    left: 0; top: 12px; bottom: 12px;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, #e25bff 0%, #4c51f7 60%, #00d4ff 100%);
    box-shadow: 0 0 14px rgba(226, 91, 255, 0.5);
  }

  /* Top bar — eyebrow + close */
  .daily-quote__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .daily-quote__close {
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-muted);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .daily-quote__close:hover {
    background: rgba(226, 91, 255, 0.14);
    border-color: rgba(226, 91, 255, 0.55);
    color: var(--color-text);
  }

  /* Eyebrow */
  .daily-quote__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cyan);
    margin: 0;
  }
  .daily-quote__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #e25bff;
    box-shadow: 0 0 10px #e25bff;
    animation: quote-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes quote-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.6; transform: scale(0.85); }
  }

  /* Quote text — chunky italic Bowlby, sized for the floating widget. */
  .daily-quote__text {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: 14.5px;
    line-height: 1.28;
    letter-spacing: -0.012em;
    color: var(--color-text);
    margin: 0;
    padding-left: 10px;
    text-wrap: balance;
  }
  .daily-quote__text::before { content: '“'; opacity: 0.6; margin-right: 3px; color: var(--color-magenta); }
  .daily-quote__text::after  { content: '”'; opacity: 0.6; margin-left: 3px;  color: var(--color-cyan); }

  /* Citation */
  .daily-quote__cite {
    margin-top: 12px;
    padding-left: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .daily-quote__author::before { content: '— '; color: var(--color-subtle); }
  .daily-quote__author {
    color: var(--color-text);
    font-weight: 500;
  }
  .daily-quote__source-name {
    color: var(--color-subtle);
  }
  .daily-quote__source-name:not(:empty)::before { content: '· '; }

  /* Mobile — keep it visible but tuck slightly out of the way */
  @media (max-width: 640px) {
    .daily-quote {
      bottom: 14px;
      right: 14px;
    }
    .daily-quote__card {
      width: min(300px, calc(100vw - 28px));
      padding: 14px 14px 16px;
    }
    .daily-quote__text { font-size: 13.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .daily-quote__dot,
    .daily-quote__card { animation: none !important; }
  }
</style>
