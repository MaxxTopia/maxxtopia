---
/**
 * AdBlockDivide — the bespoke hero for AdBlock-Maxxer (/adblockmaxxer).
 *
 * "The Divide": the messy web on the LEFT (real ad archetypes people report on
 * Twitch/YouTube float in and DISINTEGRATE at the shield line), the CALM right
 * (your content plays clean — a muted looping gameplay feed), and the REAL
 * shield holding the seam down the middle.
 *
 * This REPLACES the shared product hero for ext only (see [slug].astro:
 * `{isExt && <AdBlockDivide .../>}` with the standard hero behind `{!isExt}`).
 * Palette is pulled from the shield's own navy + sky — its own identity, not
 * the raw suite cyan the page used to inherit.
 *
 * Ad names are near-brand LOOKALIKES (DRAFTQUEENS / PRIZE-PICS / BETTERHELPER /
 * TEAMU / RAID: SHADOW MONARCHS / SINGLES NEAR YOU / STEAK) — instantly
 * recognizable, trademark-safe, and consistent with the no-competitor-callouts
 * rule (these are third-party ad archetypes, not our rivals).
 *
 * Motion: pure DOM, no libraries, ~60fps; canvas-free shard burst on impact.
 * Respects prefers-reduced-motion with a strong STATIC frame (ads frozen
 * mid-approach, shield lit) so it still reads as intentional when frozen.
 */
import type { Product } from '../data/products';

type Props = {
  product: Product;
  /** Muted looping gameplay clip for the "clean feed" (served from /public). */
  clip?: string;
};

const { product, clip = '/screenshots/extensionmaxxing/feed-clip.mp4' } = Astro.props;
const shield = product.logo ?? '/logos/adblockmaxxer.png';
---

<section class="adblock-divide" aria-label={`${product.name} hero`}>
  <a href="/#apps" class="abx-back">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    All products
  </a>

  <div class="abx-split">
    <!-- CHAOS: ad archetypes are injected + animated by the script below -->
    <div class="abx-chaos" id="abx-chaos">
      <span class="abx-tag abx-tag--bad">The web without it</span>
    </div>

    <!-- CALM: the copy + a clean, uninterrupted gameplay feed -->
    <div class="abx-calm">
      <span class="abx-tag abx-tag--good">With {product.name}</span>

      <div class="abx-badge">
        <span class="abx-glyph"><img src={shield} alt="" width="30" height="30" /></span>
        <div>
          <p class="abx-cat">{product.category}{product.version && ` · v${product.version}`}</p>
          <h1 class="abx-name">AdBlock<span>-Maxxer</span></h1>
        </div>
      </div>

      {product.heroStat && (
        <div class="abx-stat">
          <span class="abx-stat__num">{product.heroStat.value}</span>
          <span class="abx-stat__lbl" set:html={product.heroStat.label.replace(' · ', '<br>')} />
        </div>
      )}

      <h2 class="abx-tagline">{product.tagline}</h2>
      <p class="abx-sub">{product.longDescription}</p>

      <div class="abx-cta-row">
        <a
          class="abx-btn"
          href={product.primaryCta.href}
          target={product.primaryCta.external ? '_blank' : undefined}
          rel={product.primaryCta.external ? 'noopener' : undefined}
        >
          {product.primaryCta.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        {product.secondaryCta && (
          <a
            class="abx-btn-ghost"
            href={product.secondaryCta.href}
            target={product.secondaryCta.external ? '_blank' : undefined}
            rel={product.secondaryCta.external ? 'noopener' : undefined}
          >
            {product.secondaryCta.label}
          </a>
        )}
      </div>

      <div class="abx-feed" aria-hidden="true">
        <div class="abx-feed__scr">
          <video class="abx-feed__vid" src={clip} autoplay muted loop playsinline preload="metadata"></video>
          <span class="abx-feed__live">&#9679; LIVE</span>
          <span class="abx-feed__views">4,182 watching</span>
        </div>
        <div class="abx-feed__bar"><i></i></div>
        <div class="abx-feed__cap">plays clean &middot; no ad breaks</div>
      </div>

      {product.tertiaryCta && (
        <p class="abx-tertiary">
          <a
            href={product.tertiaryCta.href}
            target={product.tertiaryCta.external ? '_blank' : undefined}
            rel={product.tertiaryCta.external ? 'noopener' : undefined}
          >{product.tertiaryCta.label} &rarr;</a>
          {product.tertiaryCta.note && <span class="abx-tertiary__note">{product.tertiaryCta.note}</span>}
        </p>
      )}
    </div>
  </div>

  <div class="abx-divide" aria-hidden="true"></div>
  <div class="abx-shield" aria-hidden="true">
    <span class="abx-ring"></span><span class="abx-ring abx-ring--2"></span>
    <img src={shield} alt="" />
    <span class="abx-shield__cap">the line holds</span>
  </div>
</section>

<!-- Styles are is:global (scoped under .adblock-divide) because the ad cards and
     shards are created at runtime by the script and would miss Astro's scoped
     data-attribute otherwise. The .adblock-divide prefix keeps them contained. -->
<style is:global>
  .adblock-divide {
    --abx-bg-chaos:#0b0a12; --abx-bg-calm:#071023;
    --abx-navy:#17457f; --abx-sky:#5b9fd8; --abx-sky-bright:#8ec6f2;
    --abx-line:#17325c; --abx-muted:#7387ad; --abx-text-mid:#b8c8e6;
    position:relative; overflow:hidden; isolation:isolate;
    min-height:clamp(600px, 82vh, 820px);
    background:var(--abx-bg-calm);
    border-bottom:1px solid var(--abx-line);
  }
  .adblock-divide .abx-back {
    position:absolute; top:88px; left:clamp(20px,4vw,44px); z-index:12;
    display:inline-flex; align-items:center; gap:6px;
    font-family:var(--font-mono); font-size:12.5px; color:var(--abx-muted);
    text-decoration:none; transition:color .2s ease;
  }
  .adblock-divide .abx-back:hover { color:var(--abx-text-mid); }

  .adblock-divide .abx-split { position:relative; min-height:clamp(600px, 82vh, 820px); display:grid; grid-template-columns:1fr 1fr; align-items:stretch; }

  /* ---- chaos (left) ---- */
  .adblock-divide .abx-chaos {
    position:relative; overflow:hidden;
    background:
      radial-gradient(120% 120% at 20% 30%, rgba(255,60,60,.10), transparent 60%),
      radial-gradient(100% 100% at 60% 80%, rgba(255,200,40,.08), transparent 55%),
      var(--abx-bg-chaos);
  }
  .adblock-divide .abx-chaos::before {
    content:''; position:absolute; inset:0; opacity:.5; pointer-events:none;
    background-image:repeating-linear-gradient(0deg, rgba(255,255,255,.015) 0 1px, transparent 1px 3px);
  }
  .adblock-divide .abx-tag {
    position:absolute; top:120px; font-family:var(--font-mono); font-size:11px;
    letter-spacing:.16em; text-transform:uppercase; z-index:5;
  }
  .adblock-divide .abx-tag--bad  { left:clamp(20px,4vw,44px); color:#ff6b6b; }
  .adblock-divide .abx-tag--good { right:clamp(20px,4vw,44px); color:var(--abx-sky-bright); text-align:right; }

  .adblock-divide .abx-adcard {
    position:absolute; left:0; border-radius:8px; overflow:hidden; font-family:var(--font-mono);
    color:#fff; box-shadow:0 8px 22px rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.08);
    will-change:transform; z-index:3;
  }
  .adblock-divide .abx-adcard .abx-b { padding:9px 11px; }
  .adblock-divide .abx-adcard .abx-t { position:absolute; top:4px; right:5px; font-size:7.5px; letter-spacing:.05em; color:rgba(255,255,255,.75); background:rgba(0,0,0,.35); padding:1px 4px; border-radius:3px; }
  .adblock-divide .abx-adcard .abx-brand { font-weight:800; letter-spacing:.02em; font-size:12px; line-height:1.1; }
  .adblock-divide .abx-adcard .abx-hook { font-size:9.5px; opacity:.92; margin-top:3px; line-height:1.25; }
  .adblock-divide .abx-adcard .abx-pill { display:inline-block; font-weight:800; font-size:10px; border-radius:5px; padding:3px 8px; margin-top:6px; }
  .adblock-divide .abx-adcard .abx-x { position:absolute; top:3px; right:5px; font-size:10px; color:rgba(255,255,255,.6); }
  .adblock-divide .t-sb    { background:linear-gradient(160deg,#0a0a0a,#1c1c1c); } .adblock-divide .t-sb .abx-brand{color:#53d337;} .adblock-divide .t-sb .abx-pill{background:#53d337;color:#03250a;}
  .adblock-divide .t-pp    { background:linear-gradient(160deg,#3b1a78,#5b21b6); } .adblock-divide .t-pp .abx-pill{background:#c4b5fd;color:#2a1065;}
  .adblock-divide .t-help  { background:linear-gradient(160deg,#0f766e,#0d9488); } .adblock-divide .t-help .abx-pill{background:#99f6e4;color:#053b34;}
  .adblock-divide .t-temu  { background:linear-gradient(160deg,#ff7a00,#ff4400); } .adblock-divide .t-temu .abx-pill{background:#fff2cc;color:#7a2e00;}
  .adblock-divide .t-raid  { background:linear-gradient(160deg,#181004,#3a2a0a); } .adblock-divide .t-raid .abx-brand{color:#e6b422;} .adblock-divide .t-raid .abx-pill{background:#e6b422;color:#241800;}
  .adblock-divide .t-date  { background:linear-gradient(160deg,#ff2d78,#c81d5e); } .adblock-divide .t-date .abx-pill{background:#ffd1e3;color:#7a0f38;}
  .adblock-divide .t-crypto{ background:linear-gradient(160deg,#0f1626,#1f2937); } .adblock-divide .t-crypto .abx-brand{color:#f7931a;} .adblock-divide .t-crypto .abx-pill{background:#f7931a;color:#241500;}

  .adblock-divide .abx-shard { position:absolute; z-index:4; border-radius:1px; pointer-events:none; transition:transform .7s cubic-bezier(.2,.6,.3,1), opacity .7s ease-out; }
  .adblock-divide .abx-seamflash {
    position:absolute; left:50%; width:130px; height:130px; z-index:8;
    transform:translate(-50%,-50%) scale(.3); pointer-events:none;
    background:radial-gradient(circle, color-mix(in oklab,var(--abx-sky-bright) 75%,transparent), transparent 65%);
    animation:abx-seamflash .5s ease-out forwards;
  }
  @keyframes abx-seamflash { to { transform:translate(-50%,-50%) scale(1.5); opacity:0; } }

  /* ---- calm (right) ---- */
  .adblock-divide .abx-calm {
    position:relative;
    background:
      radial-gradient(120% 90% at 70% 30%, color-mix(in oklab,var(--abx-sky) 12%,transparent), transparent 60%),
      var(--abx-bg-calm);
    display:flex; flex-direction:column; justify-content:center;
    padding:clamp(96px,12vh,140px) clamp(28px,5vw,76px) 48px clamp(56px,7vw,108px);
  }
  .adblock-divide .abx-calm::before {
    content:''; position:absolute; inset:0; opacity:.5; pointer-events:none;
    background:radial-gradient(60% 50% at 40% 50%, color-mix(in oklab,var(--abx-sky) 8%,transparent), transparent 70%);
    animation:abx-breathe 7s ease-in-out infinite;
  }
  @keyframes abx-breathe { 0%,100%{opacity:.35} 50%{opacity:.6} }

  .adblock-divide .abx-badge { position:relative; z-index:2; display:flex; align-items:center; gap:12px; margin-bottom:20px; }
  .adblock-divide .abx-glyph {
    width:44px; height:44px; border-radius:12px; display:grid; place-items:center; padding:4px;
    background:color-mix(in oklab,var(--abx-sky) 10%,var(--abx-bg-calm));
    border:1px solid color-mix(in oklab,var(--abx-sky) 40%,transparent);
    box-shadow:0 0 22px color-mix(in oklab,var(--abx-sky) 22%,transparent);
  }
  .adblock-divide .abx-glyph img { width:100%; height:auto; display:block; }
  .adblock-divide .abx-cat { font-family:var(--font-mono); font-size:10.5px; letter-spacing:.12em; text-transform:uppercase; color:var(--abx-muted); }
  .adblock-divide .abx-name { font-size:20px; font-weight:600; letter-spacing:-.01em; color:#eaf1ff; }
  .adblock-divide .abx-name span { color:var(--abx-sky-bright); }

  .adblock-divide .abx-stat { position:relative; z-index:2; display:flex; align-items:baseline; gap:15px; margin-bottom:6px; }
  .adblock-divide .abx-stat__num {
    font-family:var(--font-mono); font-weight:700; font-size:clamp(58px,8vw,112px); line-height:.82; letter-spacing:-.02em;
    background:linear-gradient(120deg,var(--abx-sky-bright),var(--abx-navy)); -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .adblock-divide .abx-stat__lbl { font-family:var(--font-mono); font-size:11.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--abx-muted); line-height:1.4; }
  .adblock-divide .abx-tagline {
    position:relative; z-index:2; font-size:clamp(30px,4.2vw,50px); font-weight:700; letter-spacing:-.03em; line-height:1.06; margin-top:12px;
    background:linear-gradient(180deg,#fff,#bcd8ff 130%); -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .adblock-divide .abx-sub { position:relative; z-index:2; margin-top:16px; font-size:15.5px; line-height:1.55; color:var(--abx-text-mid); max-width:30em; }
  .adblock-divide .abx-cta-row { position:relative; z-index:2; margin-top:26px; display:flex; gap:12px; align-items:center; flex-wrap:wrap; }

  .adblock-divide .abx-btn {
    position:relative; overflow:hidden; isolation:isolate; text-decoration:none;
    font-family:var(--font-mono); font-size:14px; font-weight:600; color:#05121f;
    padding:14px 22px; border-radius:12px;
    background:linear-gradient(120deg,var(--abx-sky-bright),var(--abx-sky) 55%,var(--abx-navy));
    display:inline-flex; align-items:center; gap:9px;
    box-shadow:0 8px 30px color-mix(in oklab,var(--abx-sky) 40%,transparent);
    transition:transform .18s ease, box-shadow .3s ease;
  }
  .adblock-divide .abx-btn:hover { transform:translateY(-2px); box-shadow:0 12px 40px color-mix(in oklab,var(--abx-sky) 55%,transparent); }
  .adblock-divide .abx-btn::after { content:''; position:absolute; inset:0; z-index:-1; background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent); transform:translateX(-120%); transition:transform .5s ease; }
  .adblock-divide .abx-btn:hover::after { transform:translateX(120%); }
  .adblock-divide .abx-btn-ghost {
    text-decoration:none; font-family:var(--font-mono); font-size:13px; color:var(--abx-text-mid);
    padding:13px 18px; border-radius:12px; background:transparent; border:1px solid var(--abx-line);
    transition:border-color .2s ease, color .2s ease;
  }
  .adblock-divide .abx-btn-ghost:hover { border-color:color-mix(in oklab,var(--abx-sky) 55%,transparent); color:#eaf1ff; }
  .adblock-divide .abx-tertiary { position:relative; z-index:2; margin-top:14px; font-size:13px; color:var(--abx-muted); max-width:34em; }
  .adblock-divide .abx-tertiary a { color:var(--abx-sky-bright); text-decoration:underline; text-decoration-style:dotted; text-underline-offset:2px; }
  .adblock-divide .abx-tertiary__note { display:block; margin-top:5px; color:var(--abx-muted); line-height:1.5; }

  /* clean feed */
  .adblock-divide .abx-feed {
    position:relative; z-index:2; margin:24px 0 0; width:214px; max-width:100%;
    border:1px solid color-mix(in oklab,var(--abx-sky) 30%,transparent); border-radius:12px; overflow:hidden;
    background:var(--abx-bg-calm); box-shadow:0 12px 34px rgba(0,0,0,.45);
  }
  .adblock-divide .abx-feed__scr { position:relative; height:118px; overflow:hidden; background:#0b2a4a; }
  .adblock-divide .abx-feed__vid { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:1; }
  .adblock-divide .abx-feed__live { position:absolute; top:8px; left:9px; z-index:2; font-family:var(--font-mono); font-size:9px; letter-spacing:.08em; color:#fff; background:rgba(206,20,44,.9); padding:2px 7px; border-radius:4px; }
  .adblock-divide .abx-feed__views { position:absolute; bottom:8px; left:9px; z-index:2; font-family:var(--font-mono); font-size:9px; color:rgba(255,255,255,.9); background:rgba(0,0,0,.4); padding:2px 6px; border-radius:4px; }
  .adblock-divide .abx-feed__bar { height:4px; background:rgba(255,255,255,.12); }
  .adblock-divide .abx-feed__bar i { display:block; height:100%; width:0; background:linear-gradient(90deg,var(--abx-sky-bright),var(--abx-sky)); animation:abx-feedplay 8s linear infinite; }
  @keyframes abx-feedplay { 0%{width:0} 100%{width:100%} }
  .adblock-divide .abx-feed__cap { font-family:var(--font-mono); font-size:9.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--abx-sky-bright); padding:7px 9px; text-align:center; }

  /* divide seam + shield */
  .adblock-divide .abx-divide {
    position:absolute; top:0; bottom:0; left:50%; width:2px; transform:translateX(-50%);
    background:linear-gradient(180deg,transparent,var(--abx-sky) 20%,var(--abx-sky-bright) 50%,var(--abx-sky) 80%,transparent);
    box-shadow:0 0 26px 2px color-mix(in oklab,var(--abx-sky) 70%,transparent); z-index:7;
  }
  .adblock-divide .abx-shield {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); z-index:9;
    width:clamp(140px,20vw,250px); display:grid; place-items:center;
  }
  .adblock-divide .abx-ring {
    position:absolute; inset:-14%; border-radius:50%;
    border:1.5px solid color-mix(in oklab,var(--abx-sky) 45%,transparent);
    box-shadow:0 0 40px color-mix(in oklab,var(--abx-sky) 35%,transparent), inset 0 0 30px color-mix(in oklab,var(--abx-sky) 18%,transparent);
    animation:abx-pulse 3.4s ease-in-out infinite;
  }
  .adblock-divide .abx-ring--2 { inset:-30%; opacity:.5; animation-delay:.6s; }
  @keyframes abx-pulse { 0%,100%{transform:scale(1); opacity:.8} 50%{transform:scale(1.06); opacity:.45} }
  .adblock-divide .abx-shield img {
    position:relative; z-index:2; width:100%; height:auto; display:block;
    filter:drop-shadow(0 0 26px color-mix(in oklab,var(--abx-sky) 55%,transparent)) drop-shadow(0 10px 30px rgba(0,0,0,.55));
  }
  .adblock-divide .abx-shield__cap { position:absolute; bottom:-32px; left:50%; transform:translateX(-50%); white-space:nowrap; font-family:var(--font-mono); font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--abx-sky-bright); }

  @media (max-width:900px) {
    /* Stack: chaos on top (fixed height), shield absolutely pinned on the
       seam BETWEEN the two halves, calm below with room to clear the shield. */
    .adblock-divide { min-height:0; }
    .adblock-divide .abx-split { position:relative; min-height:0; grid-template-columns:1fr; }
    .adblock-divide .abx-chaos { height:300px; }
    .adblock-divide .abx-tag { top:auto; bottom:14px; }
    .adblock-divide .abx-tag--good { top:100px; right:16px; bottom:auto; }
    .adblock-divide .abx-calm { padding:120px 22px 52px; }
    .adblock-divide .abx-divide { display:none; }
    .adblock-divide .abx-feed { width:100%; max-width:300px; margin-top:24px; }
    .adblock-divide .abx-shield {
      position:absolute; top:300px; left:50%; transform:translate(-50%,-50%);
      margin:0; width:clamp(120px,34vw,166px); z-index:9;
    }
    .adblock-divide .abx-shield__cap { display:none; }
    .adblock-divide .abx-back { top:70px; }
  }
</style>

<script>
  /* THE DIVIDE — ads float toward the shield seam and disintegrate into shards.
     Nothing crosses to the calm side. Pure DOM, no libraries. Showcase animation
     plays regardless of OS reduced-motion (gamers commonly disable OS animations for perf). */
  (function () {
    var root = document.querySelector('.adblock-divide');
    var chaos = document.getElementById('abx-chaos');
    if (!root || !chaos) return;

    var THEMES = [
      { b:'DRAFTQUEENS',           h:'Same-game parlay boost',       p:'$5 &rarr; $2,500', cls:'t-sb',    col:'#53d337', tag:'Ad' },
      { b:'PRIZE-PICS',            h:'More or Less? Turn',           p:'$10 into 25X',     cls:'t-pp',    col:'#8b5cf6', tag:'Ad' },
      { b:'BETTERHELPER',          h:'Feeling burnt out?',           p:'Talk today',       cls:'t-help',  col:'#2dd4bf', tag:'Ad' },
      { b:'TEAMU',                 h:'Shop like a billionaire',      p:'-90% TODAY',       cls:'t-temu',  col:'#ff7a00', tag:'Ad' },
      { b:'RAID: SHADOW MONARCHS', h:'This game is INSANE &#9654;',  p:'INSTALL FREE',     cls:'t-raid',  col:'#e6b422', tag:'Sponsored' },
      { b:'SINGLES NEAR YOU',      h:'3 people liked you',           p:'VIEW NOW',         cls:'t-date',  col:'#ff2d78', tag:'Ad' },
      { b:'STEAK',                 h:'Crypto casino &middot; bonus', p:'CLAIM BONUS',      cls:'t-crypto',col:'#f7931a', tag:'Ad' }
    ];

    var cards = [], ti = 0;

    function buildCard(t, w) {
      var el = document.createElement('div');
      el.className = 'abx-adcard ' + t.cls;
      el.style.width = w + 'px';
      el.innerHTML = '<span class="abx-t">' + t.tag + '</span><div class="abx-b"><div class="abx-brand">' +
        t.b + '</div><div class="abx-hook">' + t.h + '</div><span class="abx-pill">' + t.p +
        '</span></div><span class="abx-x">x</span>';
      return el;
    }

    function spawn(initial, idx) {
      var t = THEMES[(ti++) % THEMES.length];
      var w = 118 + Math.random() * 44;
      var el = buildCard(t, w);
      chaos.appendChild(el);
      var h = el.offsetHeight;
      var cw = chaos.clientWidth, ch = chaos.clientHeight;
      // Seed the 7 cards into vertical bands + staggered x so they enter as a
      // spread-out stream instead of a clump; recycled cards get random y.
      var bandH = Math.max(58, (ch - 120) / 7);
      var y = initial
        ? Math.min(ch - h - 20, 52 + idx * bandH + Math.random() * bandH * 0.35)
        : 54 + Math.random() * Math.max(40, ch - h - 96);
      var x = initial ? (-w * 0.35 + Math.random() * cw * 0.5) : -w - Math.random() * 90;
      el.style.top = y + 'px';
      el.style.transform = 'translateX(' + x + 'px)';
      cards.push({ el: el, x: x, y: y, w: w, h: h, col: t.col, v: (42 + Math.random() * 55) / 1000, dead: false });
    }

    function disintegrate(c) {
      if (c.dead) return; c.dead = true;
      var seamX = chaos.clientWidth;
      for (var i = 0; i < 14; i++) {
        var s = document.createElement('i');
        s.className = 'abx-shard';
        var sz = 4 + Math.random() * 6;
        s.style.width = sz + 'px'; s.style.height = sz + 'px'; s.style.background = c.col;
        s.style.left = (seamX - 8) + 'px'; s.style.top = (c.y + Math.random() * c.h) + 'px';
        chaos.appendChild(s);
        (function (sh) {
          var dx = -(20 + Math.random() * 130), dy = (Math.random() * 2 - 1) * 70 + 55, rot = Math.random() * 360;
          requestAnimationFrame(function () { requestAnimationFrame(function () {
            sh.style.transform = 'translate(' + dx + 'px,' + dy + 'px) rotate(' + rot + 'deg)';
            sh.style.opacity = '0';
          }); });
          setTimeout(function () { sh.remove(); }, 720);
        })(s);
      }
      var f = document.createElement('span');
      f.className = 'abx-seamflash';
      var chaosRect = chaos.getBoundingClientRect(), rootRect = root.getBoundingClientRect();
      f.style.top = (chaosRect.top - rootRect.top + c.y + c.h / 2) + 'px';
      root.appendChild(f);
      setTimeout(function () { f.remove(); }, 500);
      c.el.style.transition = 'transform .22s ease-in, opacity .22s ease-in, filter .12s';
      c.el.style.filter = 'brightness(1.8) saturate(1.6)';
      c.el.style.transform = 'translateX(' + (seamX - c.w) + 'px) scale(.06)';
      c.el.style.opacity = '0';
      setTimeout(function () { c.el.remove(); }, 240);
      setTimeout(spawn, 260 + Math.random() * 640);
    }

    for (var k = 0; k < 7; k++) spawn(true, k);

    var running = true, last = 0;
    function loop(ts) {
      if (!running) return;
      if (!last) last = ts;
      var dt = Math.min(ts - last, 40); last = ts;
      var cw = chaos.clientWidth;
      for (var i = cards.length - 1; i >= 0; i--) {
        var c = cards[i];
        if (c.dead) { cards.splice(i, 1); continue; }
        c.x += c.v * dt;
        if (c.x + c.w >= cw - 2) {
          c.x = cw - c.w; c.el.style.transform = 'translateX(' + c.x + 'px)';
          disintegrate(c); cards.splice(i, 1); continue;
        }
        c.el.style.transform = 'translateX(' + c.x + 'px)';
      }
      requestAnimationFrame(loop);
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) {
        if (e[0].isIntersecting) { if (!running) { running = true; last = 0; requestAnimationFrame(loop); } }
        else running = false;
      }, { threshold: 0 }).observe(root);
    }
    requestAnimationFrame(loop);
  })();
</script>
