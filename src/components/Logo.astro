---
type Props = {
  size?: number;
  showWord?: boolean;
};
const { size = 28, showWord = true } = Astro.props;
---

<a href="/" class="inline-flex items-center gap-2.5 group" aria-label="Maxxtopia home">
  <span
    class="relative flex items-center justify-center rounded-md bg-[var(--color-bg-card)] border border-[var(--color-line-strong)] transition-colors group-hover:border-[var(--color-accent)]"
    style={`width:${size}px;height:${size}px`}
  >
    <svg width={size * 0.6} height={size * 0.6} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M3 20 L8 4 L12 14 L16 4 L21 20"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-[var(--color-accent)]"
      />
    </svg>
  </span>
  {showWord && (
    <span class="text-[15px] font-semibold tracking-tight">
      Maxxtopia
    </span>
  )}
</a>
