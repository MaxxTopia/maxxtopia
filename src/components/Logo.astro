---
type Props = {
  size?: number;
  showWord?: boolean;
};
const { size = 30, showWord = true } = Astro.props;
---

<a href="/" class="inline-flex items-center gap-2.5 group" aria-label="Maxxtopia home">
  <span
    class="relative flex items-center justify-center rounded-lg bg-[var(--color-bg-card)] border border-[var(--color-line-strong)] transition-colors group-hover:border-[var(--color-magenta)]/60 overflow-hidden"
    style={`width:${size}px;height:${size}px`}
  >
    <span
      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity"
      style="background: radial-gradient(circle at center, rgba(226,91,255,0.3), transparent 70%)"
      aria-hidden="true"
    ></span>
    <svg width={size * 0.62} height={size * 0.62} viewBox="0 0 24 24" fill="none" aria-hidden="true" class="relative">
      <defs>
        <linearGradient id={`m-grad-${size}`} x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#e25bff"/>
          <stop offset="50%" stop-color="#c084fc"/>
          <stop offset="100%" stop-color="#00d4ff"/>
        </linearGradient>
      </defs>
      <path
        d="M3 20 L8 4 L12 14 L16 4 L21 20"
        stroke={`url(#m-grad-${size})`}
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
  {showWord && (
    <span class="text-[15.5px] font-semibold tracking-tight">
      <span class="text-[var(--color-text)]">maxx</span><span class="brand-shimmer">topia</span>
    </span>
  )}
</a>
