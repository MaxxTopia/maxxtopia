<script>
  (() => {
    const root = document.querySelector<HTMLElement>('.dropmaxxer-drop');
    const stage = root?.querySelector<HTMLElement>('[data-dmx-tilt]');
    if (!root || !stage) return;

    const resetTilt = () => {
      root.style.setProperty('--dmx-tilt-x', '54deg');
      root.style.setProperty('--dmx-tilt-y', '-8deg');
    };

    stage.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const rect = stage.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      root.style.setProperty('--dmx-tilt-x', `${54 - y * 5}deg`);
      root.style.setProperty('--dmx-tilt-y', `${-8 + x * 7}deg`);
    });
    stage.addEventListener('pointerleave', resetTilt);
    resetTilt();

    root.querySelectorAll<HTMLButtonElement>('[data-dmx-route]').forEach((button) => {
      button.addEventListener('click', () => {
        const route = button.dataset.dmxRoute;
        if (route !== 'fast' && route !== 'safe') return;
        root.dataset.route = route;
        root.querySelectorAll<HTMLButtonElement>('[data-dmx-route]').forEach((candidate) => {
          candidate.classList.toggle('is-active', candidate === button);
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
      });
    });
  })();
</script>
