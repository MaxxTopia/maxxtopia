---
/**
 * LiveEmbed — an in-page "try it right here" window for browser-based tools.
 *
 * Renders a browser-chrome frame (traffic dots + URL pill + open-in-new-tab
 * link). The screenshot poster shows first; clicking "Launch the live app"
 * swaps in a real, interactive <iframe> of the tool. Click-to-load keeps the
 * heavy app off the initial render (no LCP/TBT hit) and only spins it up when
 * the visitor actually wants to test it.
 *
 * Requires the target origin to be allowed by frame-src in public/_headers,
 * and the target must NOT send X-Frame-Options: DENY / frame-ancestors 'none'.
 */
type Props = {
  /** The live app URL to embed (must be https + framable). */
  url: string;
  /** Product name, for a11y labels. */
  title: string;
  /** Poster image shown until the visitor launches the app. */
  poster?: string;
  /** Accent hex for the glow + launch button. */
  accentHex: string;
  /** Host label shown in the fake address bar (defaults to the url host). */
  host?: string;
};
const { url, title, poster, accentHex, host } = Astro.props;
let displayHost = host;
if (!displayHost) {
  try {
    displayHost = new URL(url).host;
  } catch {
    displayHost = url;
  }
}
---

<figure
  class="live-embed"
  style={`--accent: ${accentHex};`}
>
  <div class="live-embed__chrome">
    <span class="live-embed__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="live-embed__url" aria-hidden="true">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {displayHost}
    </span>
    <a
      class="live-embed__pop"
      href={url}
      target="_blank"
      rel="noopener"
      aria-label={`Open ${title} in a new tab`}
    >
      Open full app
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
    </a>
  </div>

  <div
    class="live-embed__stage"
    data-embed-url={url}
    data-embed-title={title}
  >
    {poster && (
      <img
        class="live-embed__poster"
        src={poster}
        alt={`${title} preview`}
        loading="lazy"
        decoding="async"
      />
    )}
    <button type="button" class="live-embed__launch" aria-label={`Launch the live ${title} app and try it here`}>
      <span class="live-embed__launch-ring">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      </span>
      <span class="live-embed__launch-label">Launch the live app — try it right here</span>
      <span class="live-embed__launch-sub">Loads {displayHost} in this window. No install.</span>
    </button>
  </div>
</figure>

<script>
  // Click-to-load: replace the poster with a live iframe of the tool only when
  // the visitor asks for it. Keeps the app off the initial page load.
  document.querySelectorAll<HTMLElement>('.live-embed__stage').forEach((stage) => {
    const btn = stage.querySelector<HTMLButtonElement>('.live-embed__launch');
    const url = stage.dataset.embedUrl;
    const title = stage.dataset.embedTitle || 'app';
    if (!btn || !url) return;
    btn.addEventListener('click', () => {
      if (stage.querySelector('iframe')) return; // already launched
      const frame = document.createElement('iframe');
      frame.className = 'live-embed__frame';
      frame.src = url;
      frame.title = title + ' — live app';
      frame.loading = 'eager';
      frame.setAttribute('allow', 'clipboard-write; fullscreen; pointer-lock');
      frame.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
      stage.appendChild(frame);
      stage.classList.add('is-live');
    });
  });
</script>

<style>
  .live-embed {
    position: relative;
    margin: 48px 0 0;
    padding: 0;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-line-strong);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 32px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px color-mix(in srgb, var(--accent) 22%, transparent),
      0 0 80px color-mix(in srgb, var(--accent) 12%, transparent);
    transition: box-shadow 600ms ease;
  }
  .live-embed:hover {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 40px 100px rgba(0, 0, 0, 0.6),
      0 0 0 1px color-mix(in srgb, var(--accent) 34%, transparent),
      0 0 100px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  /* Browser chrome bar */
  .live-embed__chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--color-line);
  }
  .live-embed__dots {
    display: inline-flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .live-embed__dots span {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
  }
  .live-embed__dots span:nth-child(1) { background: #ff5f57; }
  .live-embed__dots span:nth-child(2) { background: #febc2e; }
  .live-embed__dots span:nth-child(3) { background: #28c840; }
  .live-embed__url {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 0;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .live-embed__url svg { color: #28c840; flex-shrink: 0; }
  .live-embed__pop {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--color-text);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: border-color 200ms ease, background 200ms ease, transform 200ms ease;
  }
  .live-embed__pop:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    transform: translateY(-1px);
  }
  .live-embed__pop:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }

  /* The stage: poster + launch overlay, replaced by the iframe on click */
  .live-embed__stage {
    position: relative;
    width: 100%;
    height: clamp(440px, 62vh, 660px);
    background: var(--color-bg);
    overflow: hidden;
  }
  .live-embed__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .live-embed__launch {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    border: 0;
    cursor: pointer;
    color: var(--color-text);
    text-align: center;
    padding: 24px;
    background: radial-gradient(ellipse at center, rgba(10, 6, 18, 0.42) 0%, rgba(10, 6, 18, 0.66) 100%);
    transition: opacity 300ms ease, visibility 300ms ease;
  }
  .live-embed__launch-ring {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    border-radius: 999px;
    color: #fff;
    padding-left: 5px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 92%, white 4%), color-mix(in srgb, var(--accent) 70%, black 24%));
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 0 0 8px color-mix(in srgb, var(--accent) 14%, transparent),
      0 10px 34px color-mix(in srgb, var(--accent) 40%, transparent),
      0 4px 14px rgba(0, 0, 0, 0.45);
    animation: live-embed-pulse 2.6s ease-in-out infinite;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .live-embed__launch:hover .live-embed__launch-ring,
  .live-embed__launch:focus-visible .live-embed__launch-ring {
    transform: scale(1.08);
  }
  .live-embed__launch-label {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(8, 8, 12, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .live-embed__launch-sub {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: 0.02em;
  }
  .live-embed__launch:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: -4px;
  }
  @keyframes live-embed-pulse {
    0%, 100% { box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 14%, transparent), 0 10px 34px color-mix(in srgb, var(--accent) 40%, transparent), 0 4px 14px rgba(0, 0, 0, 0.45); }
    50%      { box-shadow: 0 0 0 14px color-mix(in srgb, var(--accent) 5%, transparent), 0 10px 38px color-mix(in srgb, var(--accent) 50%, transparent), 0 4px 14px rgba(0, 0, 0, 0.45); }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-embed__launch-ring { animation: none; }
  }

  /* Once launched: hide the poster + overlay, show the live iframe */
  .live-embed__stage.is-live .live-embed__poster,
  .live-embed__stage.is-live .live-embed__launch {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .live-embed :global(.live-embed__frame) {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--color-bg);
  }
</style>
