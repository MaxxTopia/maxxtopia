---
/**
 * Starfield — a real animated cosmic backdrop for the bespoke hero backgrounds
 * (sits behind the aurora). Canvas-based so stars are randomly placed (no tiling
 * seam), each twinkles on its own phase, the whole field drifts with parallax,
 * and a shooting star streaks past every few seconds. Tinted subtly per page via
 * the `accent` prop. Pauses when scrolled out of view. Pointer-inert, aria-hidden.
 */
type Props = { accent?: string };
const { accent = '#9fb4ff' } = Astro.props;
---
<canvas class="sf-canvas" data-accent={accent} aria-hidden="true"></canvas>

<style>
  .sf-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block; }
</style>

<script>
  (function () {
    function hexToRgb(h) {
      h = (h || '').replace('#', '');
      if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
      var n = parseInt(h, 16);
      return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
    }

    function init(canvas) {
      var ctx = canvas.getContext('2d');
      if (!ctx) return;
      var acc = hexToRgb(canvas.getAttribute('data-accent') || '#9fb4ff');
      var dpr = 1; // stars are tiny dots — 1x is plenty and far cheaper to redraw
      var W = 0, H = 0, stars = [], shooter = null, nextShot = 0, t = 0, raf = null, running = false, last = 0;

      function rand(a, b) { return a + Math.random() * (b - a); }

      function resize() {
        var rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        W = canvas.width = Math.round(rect.width * dpr);
        H = canvas.height = Math.round(rect.height * dpr);
        var count = Math.min(55, Math.round((rect.width * rect.height) / 17000));
        stars = [];
        for (var i = 0; i < count; i++) {
          var depth = Math.random();               // 0 far … 1 near
          stars.push({
            x: Math.random() * W,
            y: Math.random() * H,
            r: (0.5 + depth * 1.3) * dpr,
            base: 0.28 + depth * 0.55,
            tw: rand(0.006, 0.02),
            ph: Math.random() * Math.PI * 2,
            vx: rand(-0.06, 0.02) * dpr * (0.4 + depth),
            vy: rand(-0.02, 0.05) * dpr * (0.4 + depth),
            tint: Math.random() < 0.22               // a few stars carry the accent tint
          });
        }
        nextShot = t + rand(120, 320);
      }

      function spawnShooter() {
        var fromLeft = Math.random() < 0.5;
        var sx = fromLeft ? rand(0, W * 0.4) : rand(W * 0.6, W);
        shooter = {
          x: sx, y: rand(0, H * 0.5),
          vx: (fromLeft ? 1 : -1) * rand(6, 9) * dpr,
          vy: rand(2.4, 4) * dpr,
          len: rand(90, 170) * dpr,
          life: 0, max: rand(38, 58)
        };
      }

      function frame() {
        if (!running) return;
        // full 60fps (throttling looked choppy); kept cheap via 1x pixels + a light star count
        t++;
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          s.ph += s.tw;
          s.x += s.vx; s.y += s.vy;
          if (s.x < 0) s.x += W; else if (s.x > W) s.x -= W;
          if (s.y < 0) s.y += H; else if (s.y > H) s.y -= H;
          var a = s.base * (0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.ph)));
          if (s.tint) ctx.fillStyle = 'rgba(' + acc.r + ',' + acc.g + ',' + acc.b + ',' + a.toFixed(3) + ')';
          else ctx.fillStyle = 'rgba(255,255,255,' + a.toFixed(3) + ')';
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, 6.2832);
          ctx.fill();
        }
        // shooting star
        if (!shooter && t > nextShot) spawnShooter();
        if (shooter) {
          shooter.life++;
          shooter.x += shooter.vx; shooter.y += shooter.vy;
          var k = 1 - shooter.life / shooter.max;             // fade over life
          if (k > 0) {
            var tx = shooter.x - shooter.vx / Math.hypot(shooter.vx, shooter.vy) * shooter.len;
            var ty = shooter.y - shooter.vy / Math.hypot(shooter.vx, shooter.vy) * shooter.len;
            var grad = ctx.createLinearGradient(shooter.x, shooter.y, tx, ty);
            grad.addColorStop(0, 'rgba(255,255,255,' + (0.9 * k).toFixed(3) + ')');
            grad.addColorStop(0.35, 'rgba(' + acc.r + ',' + acc.g + ',' + acc.b + ',' + (0.5 * k).toFixed(3) + ')');
            grad.addColorStop(1, 'rgba(255,255,255,0)');
            ctx.strokeStyle = grad;
            ctx.lineWidth = 1.6 * dpr;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(shooter.x, shooter.y);
            ctx.lineTo(tx, ty);
            ctx.stroke();
          }
          if (shooter.life >= shooter.max || shooter.x < -200 || shooter.x > W + 200 || shooter.y > H + 200) {
            shooter = null;
            nextShot = t + rand(180, 460);
          }
        }
        raf = requestAnimationFrame(frame);
      }

      function start() { if (!running) { running = true; raf = requestAnimationFrame(frame); } }
      function stop() { running = false; if (raf) cancelAnimationFrame(raf); raf = null; }

      var ro = ('ResizeObserver' in window) ? new ResizeObserver(resize) : null;
      if (ro) ro.observe(canvas); else window.addEventListener('resize', resize);
      resize();

      var onScreen = true;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (e) { onScreen = e[0].isIntersecting; onScreen && !document.hidden ? start() : stop(); }, { threshold: 0.02 }).observe(canvas);
      } else { start(); }
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : (onScreen && start()); });
    }

    function boot() {
      var list = document.querySelectorAll('canvas.sf-canvas');
      for (var i = 0; i < list.length; i++) { if (!list[i].__sf) { list[i].__sf = 1; init(list[i]); } }
    }
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>
