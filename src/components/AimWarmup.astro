---
/**
 * AimWarmup — aimmaxxer's interim resource section. Until the real trainer (v2)
 * ships, the page earns its keep: the community's best KovaaK's warm-up routines,
 * each as a one-click-copy SHARE CODE you paste into KovaaK's to import. Sorted by
 * the game (and the aim each game demands — clicking / tracking / mixed), plus a
 * "drill one skill" library, an honest mouse-skate note, and the v2 teaser.
 *
 * The original game/skill entries were resolved live against the official
 * kovaaks.com backend on 2026-06-28. The expanded focus catalog was checked
 * against the current official playlist directory on 2026-11-15. Each
 * `playlistCode` matched exactly, so these are real, currently-importable tokens,
 * not guesses. Subscriber counts are directory popularity signals, not quality
 * scores or pro endorsements. These are curated community routines, not official
 * Voltaic benchmarks — labelled as such on purpose. Nothing here is fabricated.
 */
type Props = { accentHex: string };
const { accentHex } = Astro.props;

const fmtSubs = (n: number): string =>
  n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);

const routineAnchorId = (code: string, index: number, group: 'game' | 'skill' | 'course'): string =>
  `aim-routine-${code.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${group}-${index}`;

type Routine = { name: string; code: string; subs: number };

type Game = {
  game: string;
  style: 'Clicking' | 'Tracking' | 'Mixed';
  why: string;
  routine: Routine;
};

