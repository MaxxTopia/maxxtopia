---
import { AIMMAXXER_V2_CHANNEL_URL } from '../data/products';

/**
 * AimWarmup — aimmaxxer's interim resource section. Until the real trainer (v2)
 * ships, the page earns its keep: the community's best KovaaK's warm-up routines,
 * each as a one-click-copy SHARE CODE you paste into KovaaK's to import. Sorted by
 * the game (and the aim each game demands — clicking / tracking / mixed), plus a
 * "drill one skill" library, an honest mouse-skate note, and the v2 teaser.
 *
 * Every share code below was resolved live against the official kovaaks.com
 * backend (2026-06-28) — each `playlistCode` matched exactly, so these are real,
 * currently-importable tokens, not guesses. Sub counts are the real subscriber
 * counts from that API. These are *curated community routines* (individual
 * creators: COLD, Shah, m0narcS, higheuphoria, AveryPvP), not official Voltaic
 * benchmarks — labelled as such on purpose. Nothing here is fabricated.
 */
type Props = { accentHex: string };
const { accentHex } = Astro.props;

const fmtSubs = (n: number): string =>
  n >= 1000 ? (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : String(n);

type Routine = { name: string; code: string; subs: number };
type RoutineStyle = 'Clicking' | 'Tracking' | 'Mixed' | 'Switching';

const routineMeta: Record<RoutineStyle, { duration: string; difficulty: string; skill: string }> = {
  Clicking: { duration: '10 min', difficulty: 'Precision', skill: 'Click control' },
  Tracking: { duration: '10 min', difficulty: 'Steady', skill: 'Target contact' },
  Mixed: { duration: '10 min', difficulty: 'Balanced', skill: 'Flick + transfer' },
  Switching: { duration: '10 min', difficulty: 'Demanding', skill: 'Target acquisition' },
};

const routineMetaFor = (style: RoutineStyle) => routineMeta[style];

type Game = {
  game: string;
  style: 'Clicking' | 'Tracking' | 'Mixed';
  bestFor: string;
  why: string;
  routine: Routine;
};

// One import per game — the community routine that warms the aim that game leans on.
const games: Game[] = [
  {
    game: 'Fortnite',
    style: 'Mixed',
    bestFor: 'Shotgun flicks + close target transfers',
    why: 'Box-fight shotgun flicks, 180s, and air tracking.',
    routine: { name: 'COLD SHOTGUN GOD', code: 'KovaaKsPullingChestnutMap', subs: 70 },
  },
  {
    game: 'Valorant',
    style: 'Clicking',
    bestFor: 'First-shot accuracy + clean stops',
    why: 'One-taps, micro-adjust, crosshair placement.',
    routine: { name: 'Shah · RADIANT Warm Up', code: 'KovaaKsBuyingStaticInitiator', subs: 522 },
  },
  {
    game: 'CS2',
    style: 'Clicking',
    bestFor: 'Static precision + wide-peek control',
    why: 'Static precision and wide peek flicks.',
    routine: { name: 'm0narcS · TacFPS Euphoria', code: 'KovaaKsBouncingFedSuper', subs: 1474 },
  },
  {
    game: 'Apex Legends',
    style: 'Tracking',
    bestFor: 'Beam control + movement tracking',
    why: 'Hold the beam — long and mid-air tracking.',
    routine: { name: 'higheuphoria · air', code: 'KovaaKsBloomingFastPerk', subs: 191 },
  },
  {
    game: 'Overwatch 2',
    style: 'Tracking',
    bestFor: 'Close hitscan + fast direction changes',
    why: 'Close hitscan tracking and flanker duels.',
    routine: { name: 'higheuphoria · control', code: 'KovaaKsBlinkingFastAce', subs: 228 },
  },
  {
    game: 'Call of Duty',
    style: 'Mixed',
    bestFor: 'Close beams + quick snap recovery',
    why: 'Close beams and quick flicks — an all-round daily.',
    routine: { name: 'Andrew · Daily Mix', code: 'KovaaKsPeekingFastQuaker', subs: 370 },
  },
];

type Skill = { name: string; trains: string; tag: 'Clicking' | 'Tracking' | 'Mixed' | 'Switching'; routine: Routine };

// The rest of the verified library — isolate one skill instead of a game mix.
const skillRoutines: Skill[] = [
  {
    name: "('C_C) · Lite",
    trains: 'A full clicking day — static, micro, flick, cluster.',
    tag: 'Clicking',
    routine: { name: "('C_C) · Lite", code: 'KovaaKsParachutingFarIdentity', subs: 975 },
  },
  {
    name: 'higheuphoria · dynamic',
    trains: 'Dynamic clicking — Pasu, Bounce 180, Popcorn.',
    tag: 'Clicking',
    routine: { name: 'higheuphoria · dynamic', code: 'KovaaKsBombingRoyalpurpleSniper', subs: 201 },
  },
  {
    name: 'higheuphoria · static',
    trains: 'Static clicking — 1wXtX, reload, multiclick.',
    tag: 'Clicking',
    routine: { name: 'higheuphoria · static', code: 'KovaaKsBoomstickingSalmonInventory', subs: 201 },
  },
  {
    name: 'Switching Fundamentals',
    trains: 'Pure target switching — the skill nobody drills.',
    tag: 'Switching',
    routine: { name: 'm0narcS · Switching Fundamentals', code: 'KovaaKsLosingCornflowerGod', subs: 495 },
  },
  {
    name: 'Shah · Microtech 2026',
    trains: 'Micro-tracking and micro-clicking precision.',
    tag: 'Mixed',
    routine: { name: 'Shah · Microtech 2026', code: 'KovaaKsRevolvingGoodFlashbang', subs: 959 },
  },
  {
    name: 'FN Shotty Routine',
    trains: 'Fortnite shotgun warmup — SYW, micro-dash, pasu.',
    tag: 'Mixed',
    routine: { name: 'FN Shotty Routine', code: 'KovaaKsRevolvingScaredReset', subs: 1106 },
  },
];

const importSteps = [
  { n: '01', t: 'Copy the code', d: 'Hit copy on any routine above.' },
  { n: '02', t: 'Open ONLINE PLAYLISTS', d: "In KovaaK's, open the Online Playlists tab." },
  { n: '03', t: 'ENTER SHARECODE', d: 'Paste, subscribe, play. Ten minutes, then queue.' },
];

const skates = [
  { name: 'X-Raypad Jade', kind: 'PTFE · speed', best: 'The cloth speed pick. Fastest PTFE on an Artisan pad — boardzy & Mighty’s cloth favorite. Near-zero brake, so it’s pure glide.' },
  { name: 'Tiger Ice V2', kind: 'PTFE · balanced', best: 'Same top tier as Jade but more controlled — the flick-and-stop middle for build/edit. (Magic Ice is the same class.)' },
  { name: 'Tiger Arc', kind: 'PTFE · universal', best: 'The 2026 "fits almost every mouse" pick — controlled PTFE in the Corepad class with a huge cut catalog. The safe default if you don’t want to overthink it.' },
  { name: 'Corepad Skatez', kind: 'PTFE · control', best: 'More braking, the most durable soft PTFE. The control end of the cloth range.' },
  { name: 'X-Raypad Obsidian', kind: 'glass-first', best: 'Hardened PTFE built for glass / hard pads. On cloth the reviewers say it adds tug or nothing — skip it unless you switch to glass.' },
];
---

<section class="aim-warmup" style={`--aim-accent: ${accentHex}; --aim-click: #ff4b3e; --aim-track: #ff8a72; --aim-switch: #d11820;`} aria-labelledby="aim-warmup-heading">
  <div class="aim-warmup__inner">
    <header class="aim-warmup__header reveal-on-scroll">
      <p class="aim-warmup__eyebrow">Warm up right</p>
      <h2 id="aim-warmup-heading" class="aim-warmup__heading">
        Find your next <span class="aim-warmup__accent">ten minutes.</span>
      </h2>
      <p class="aim-warmup__sub">
        Run the browser read above and start with the routine it points to. Already know what
        needs work? Pick your game below, copy the real KovaaK's share code, and start a focused
        ten-minute block — no scenario hunting.
      </p>
      <div class="aim-warmup__quick-actions" aria-label="Aimmaxxer next steps">
        <a href="#aim-diagnostic">Run the diagnostic</a>
        <a href="#aim-game-routines">Browse by game</a>
      </div>
      <div class="aim-warmup__header-meta" aria-label="Routine library overview">
        <span><b>{String(games.length).padStart(2, '0')}</b> game lanes</span>
        <span><b>{String(skillRoutines.length).padStart(2, '0')}</b> skill blocks</span>
        <span><b>10m</b> focused sessions</span>
      </div>
    </header>

    <div class="aim-warmup__map reveal-on-scroll" aria-label="What the diagnostic measures">
      <div class="aim-warmup__map-head">
        <span>What the read measures</span>
        <small>Three skills · one next step</small>
      </div>
      <div class="aim-warmup__map-grid">
        <div class="aim-warmup__map-item aim-warmup__map-item--clicking">
          <i></i><strong>Click</strong><span>Flick + confirm</span>
        </div>
        <div class="aim-warmup__map-item aim-warmup__map-item--tracking">
          <i></i><strong>Track</strong><span>Hold the line</span>
        </div>
        <div class="aim-warmup__map-item aim-warmup__map-item--switching">
          <i></i><strong>Switch</strong><span>Acquire the next</span>
        </div>
      </div>
    </div>

    <div class="aim-warmup__grid" id="aim-game-routines">
      {games.map((g) => (
        <article
          id={`aim-game-routine-${g.game.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          data-aim-routine-code={g.routine.code}
          class:list={['aim-warmup__card', `aim-warmup__card--${g.style.toLowerCase()}`]}
        >
          <div class="aim-warmup__card-head">
            <h3 class="aim-warmup__game">{g.game}</h3>
            <span class:list={['aim-warmup__tag', `aim-warmup__tag--${g.style.toLowerCase()}`]}>{g.style}</span>
          </div>
          <div class="aim-warmup__best"><span>WHEN TO USE</span><strong>{g.bestFor}</strong></div>
          <p class="aim-warmup__why"><strong>Why it helps:</strong> {g.why}</p>

          <div class="aim-warmup__routine">
            <div class="aim-warmup__routine-head">
              <span class="aim-warmup__routine-label">Run</span>
              <span class="aim-warmup__routine-name">{g.routine.name}</span>
              <span class="aim-warmup__subs">{fmtSubs(g.routine.subs)} subs</span>
            </div>
            <div class="aim-warmup__routine-meta" aria-label={`${g.game} routine details`}>
              <span>{routineMetaFor(g.style).duration}</span>
              <span>{routineMetaFor(g.style).difficulty}</span>
              <span>{routineMetaFor(g.style).skill}</span>
            </div>
            <div class="aim-warmup__code">
              <code class="aim-warmup__code-text">{g.routine.code}</code>
              <button
                type="button"
                class="aim-warmup__copy"
                data-copy={g.routine.code}
                aria-label={`Copy the ${g.routine.name} KovaaK's share code`}
              >
                <svg class="aim-warmup__copy-ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                <span class="aim-warmup__copy-label">Copy</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- How to import — the copy/paste/play loop -->
    <div class="aim-warmup__import reveal-on-scroll">
      <div class="aim-warmup__import-head">
        <p class="aim-warmup__eyebrow">How to import</p>
        <h3 class="aim-warmup__import-title">Copy. Paste. Play.</h3>
      </div>
      <ol class="aim-warmup__steps">
        {importSteps.map((s) => (
          <li class="aim-warmup__step">
            <span class="aim-warmup__step-num">{s.n}</span>
            <div class="aim-warmup__step-body">
              <p class="aim-warmup__step-t">{s.t}</p>
              <p class="aim-warmup__step-d">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="aim-warmup__import-foot">
        Don't see it in-game? Paste the code at
        <a href="https://kovaaks.com/kovaaks/playlists" target="_blank" rel="noopener">kovaaks.com/playlists</a>,
        read the routine's name, then search that name under Online Playlists.
      </p>
    </div>

    <!-- Skill library — drill one thing -->
    <div class="aim-warmup__skill">
      <header class="aim-warmup__skill-header reveal-on-scroll">
        <p class="aim-warmup__eyebrow">Train one skill</p>
        <h3 class="aim-warmup__skill-title">Or drill what's <span class="aim-warmup__accent">actually broken.</span></h3>
        <p class="aim-warmup__skill-sub">
          If the diagnostic points to a single limiter, start here. Each routine isolates a
          useful skill so you can train with intent instead of cycling through random scenarios.
        </p>
      </header>
      <div class="aim-warmup__grid aim-warmup__grid--skill">
        {skillRoutines.map((s) => (
          <article
            id={`aim-skill-routine-${s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
            data-aim-routine-code={s.routine.code}
            class:list={['aim-warmup__card', `aim-warmup__card--${s.tag.toLowerCase()}`]}
          >
            <div class="aim-warmup__card-head">
              <h4 class="aim-warmup__routine-name aim-warmup__routine-name--lg">{s.name}</h4>
              <span class:list={['aim-warmup__tag', `aim-warmup__tag--${s.tag.toLowerCase()}`]}>{s.tag}</span>
            </div>
            <p class="aim-warmup__why"><strong>Use it when:</strong> {s.trains}</p>
            <div class="aim-warmup__routine-meta" aria-label={`${s.name} routine details`}>
              <span>{routineMetaFor(s.tag).duration}</span>
              <span>{routineMetaFor(s.tag).difficulty}</span>
              <span>{routineMetaFor(s.tag).skill}</span>
            </div>
            <div class="aim-warmup__code">
              <code class="aim-warmup__code-text">{s.routine.code}</code>
              <button
                type="button"
                class="aim-warmup__copy"
                data-copy={s.routine.code}
                aria-label={`Copy the ${s.routine.name} KovaaK's share code`}
              >
                <svg class="aim-warmup__copy-ico" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                <span class="aim-warmup__copy-label">Copy</span>
              </button>
            </div>
            <p class="aim-warmup__subs aim-warmup__subs--foot">{fmtSubs(s.routine.subs)} subs</p>
          </article>
        ))}
      </div>
    </div>

    <p class="aim-warmup__system reveal-on-scroll">
      Want one system, not a pick-list? Run the <strong>Voltaic Daily Improvement Method (VDIM)</strong> —
      clicking-weighted for tac-shooters, tracking-weighted for Apex / Overwatch. Benchmark, drill your
      worst skill, repeat. The routines above are curated community picks, not the official Voltaic benchmark.
    </p>

    <!-- Brief gear note: mouse skates -->
    <details class="aim-warmup__skates reveal-on-scroll">
      <summary class="aim-warmup__secondary-summary">
        <span>Setup note</span>
        <strong>Mouse skates: glide vs brake</strong>
        <b aria-hidden="true">+</b>
      </summary>
      <div class="aim-warmup__skates-body">
        <div class="aim-warmup__skates-head">
          <p class="aim-warmup__eyebrow">While you're at it · the glide</p>
          <h3 class="aim-warmup__skates-title">On cloth it's glide vs brake — and both are PTFE.</h3>
          <p class="aim-warmup__skates-tradeoff">
            On an <strong>Artisan</strong> cloth pad you want <strong>PTFE</strong>; the real choice is speed
            vs control. <strong>Jade</strong> is the fastest (almost no stopping power); <strong>Tiger Ice V2</strong>,
            <strong>Tiger Arc</strong> and <strong>Corepad</strong> add the brake a build-and-edit flicker needs.
            The glass-first skates — <strong>Obsidian</strong>, Pulsar Superglide — belong on hard / glass pads, not cloth.
          </p>
        </div>
        <div class="aim-warmup__skates-grid">
          {skates.map((s) => (
            <div class="aim-warmup__skate">
              <div class="aim-warmup__skate-top">
                <span class="aim-warmup__skate-name">{s.name}</span>
                <span class="aim-warmup__skate-kind">{s.kind}</span>
              </div>
              <p class="aim-warmup__skate-best">{s.best}</p>
            </div>
          ))}
        </div>
        <p class="aim-warmup__skates-tip">
          The hype, corrected: Jade and Obsidian are both X-Raypad flagships, but opposites — Jade is fast PTFE
          built for cloth; Obsidian is a hardened control skate built for glass. On your Artisan cloth, run Jade
          for glide, Tiger Ice V2 / Tiger Arc for control. Grab the Superstrike / Superlight 2 cut (sold for both)
          or universal dots; for the Finalmouse ULX Prophecy use universal dots (S12 / UL2 / ULX). No pro publishes
          their feet — this is reviewer + community consensus (boardzy, Mighty, r/MouseReview), not a "pro uses X" claim.
        </p>
      </div>
    </details>

    <!-- v2 teaser — Dante red, paid, Discord-to-purchase -->
    <div class="aim-warmup__v2 reveal-on-scroll" style="--aim-accent: #e11d2b;">
      <p class="aim-warmup__v2-eyebrow">What's coming</p>
      <h3 class="aim-warmup__v2-title">Aimmaxxer <span class="aim-warmup__accent">v2.</span> The real deal.</h3>
      <p class="aim-warmup__v2-body">Real training happens in the lab. Use the routines above to improve — that's V1. Only go to V2 if you want an AI that drills the aim that's actually holding you back.</p>
      <a class="aim-warmup__v2-cta" href={AIMMAXXER_V2_CHANNEL_URL} target="_blank" rel="noopener">
        Join the Discord to purchase
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  (() => {
    if ((window as any).__aimCopy) return;
    (window as any).__aimCopy = true;
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-copy]') as HTMLButtonElement | null;
      if (!btn) return;
      const code = btn.getAttribute('data-copy');
      if (!code) return;
      const label = btn.querySelector('.aim-warmup__copy-label');
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const t = document.createElement('textarea');
        t.value = code; t.style.position = 'fixed'; t.style.opacity = '0';
        document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } catch {}
        t.remove();
      }
      btn.classList.add('is-copied');
      if (label) label.textContent = 'Copied!';
      window.clearTimeout((btn as any)._t);
      (btn as any)._t = window.setTimeout(() => {
        btn.classList.remove('is-copied');
        if (label) label.textContent = 'Copy';
      }, 1600);
    });
  })();
</script>

<style>
  .aim-warmup {
    --aim-click: #ff4b3e;
    --aim-track: #ff8a72;
    --aim-switch: #d11820;
    position: relative;
    padding: 88px 0 32px;
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, color-mix(in srgb, var(--aim-accent) 4%, transparent), transparent 240px);
  }
  .aim-warmup__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }
  @media (min-width: 640px) {
    .aim-warmup__inner { padding: 0 32px; }
  }

  .aim-warmup__header {
    max-width: 680px;
    margin: 0 0 26px;
  }
  .aim-warmup__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aim-accent, #d11820);
    margin: 0 0 14px;
  }
  .aim-warmup__heading {
    font-family: var(--font-sans);
    font-size: clamp(30px, 4.5vw, 48px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 16px;
  }
  .aim-warmup__accent { color: var(--aim-accent, #d11820); }
  .aim-warmup__sub {
    color: var(--color-text-mid);
    font-size: 16px;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }
  .aim-warmup__quick-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
  }
  .aim-warmup__quick-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid color-mix(in srgb, var(--aim-accent) 50%, transparent);
    border-radius: 999px;
    color: var(--color-text);
    background: color-mix(in srgb, var(--aim-accent) 9%, transparent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .aim-warmup__quick-actions a:first-child { color: #fff; background: var(--aim-accent); border-color: var(--aim-accent); }
  .aim-warmup__quick-actions a:hover { border-color: var(--aim-accent); background: color-mix(in srgb, var(--aim-accent) 18%, transparent); transform: translateY(-1px); }
  .aim-warmup__quick-actions a:first-child:hover { background: color-mix(in srgb, var(--aim-accent) 86%, white); }

  /* The routine deck is the second act of the page: a deeper, editorial lab
     surface rather than a continuation of the generic site background. */
  .aim-warmup {
    overflow: hidden;
    background:
      radial-gradient(44% 22% at 82% 8%, color-mix(in srgb, var(--aim-accent) 13%, transparent), transparent 72%),
      radial-gradient(34% 24% at 8% 45%, color-mix(in srgb, var(--aim-track) 7%, transparent), transparent 74%),
      linear-gradient(180deg, #0a0103 0%, color-mix(in srgb, var(--color-bg) 94%, var(--aim-accent)) 22%, var(--color-bg) 66%);
  }
  .aim-warmup::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .3;
    background-image:
      linear-gradient(rgba(255, 75, 62, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 75, 62, .028) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(180deg, #000, transparent 84%);
  }
  .aim-warmup::after {
    content: '';
    position: absolute;
    top: 18%;
    right: -18%;
    width: min(760px, 72vw);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--aim-accent) 11%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 34px color-mix(in srgb, var(--aim-accent) 3%, transparent), 0 0 0 70px color-mix(in srgb, var(--aim-accent) 2%, transparent);
    transform: rotate(-18deg);
    pointer-events: none;
  }
  .aim-warmup__inner { position: relative; z-index: 1; max-width: 1200px; }
  .aim-warmup__header {
    max-width: 820px;
    padding-left: 20px;
    border-left: 2px solid var(--aim-accent);
  }
  .aim-warmup__header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 27px;
    color: var(--color-muted);
    font: 700 9px/1 var(--font-mono), monospace;
    letter-spacing: .11em;
