---
type DemoVariant = {
  /** 1080p mp4 (highest quality). */
  src: string;
  /** Optional 720p mp4 served first to mobile / slow connections via media query. */
  src720?: string;
  /** Poster frame shown until the video starts playing. */
  poster: string;
};
type Props = {
  src: string;
  alt: string;
  /** Multiple screenshots → grid layout. */
  extras?: string[];
  /** Optional demo video. Single object renders that video.
   *  Array enables per-visit random variant selection (one is picked
   *  client-side on each page load and swapped into the <video> element). */
  video?: DemoVariant | DemoVariant[];
};
const { src, alt, extras = [], video } = Astro.props;
const all = [src, ...extras];
const variants: DemoVariant[] = video ? (Array.isArray(video) ? video : [video]) : [];
const initialVideo: DemoVariant | undefined = variants[0];
const variantsJson = variants.length > 1 ? JSON.stringify(variants) : '';
const isGrid = all.length > 1 && !initialVideo;
---

<figure class={`product-screenshot ${isGrid ? 'product-screenshot--grid' : ''}`}>
  {initialVideo && (
    <div class="product-screenshot__unmute-banner" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 5 6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
      </svg>
      <span>Tap the speaker icon to unmute</span>
    </div>
  )}
  <div class="product-screenshot__frame">
    {initialVideo ? (
      <video
        class="product-screenshot__img product-screenshot__video"
        poster={initialVideo.poster}
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={alt}
        data-variants={variantsJson}
      >
        {initialVideo.src720 && <source src={initialVideo.src720} type="video/mp4" media="(max-width: 768px)" />}
        <source src={initialVideo.src} type="video/mp4" />
        <img src={initialVideo.poster} alt={alt} class="product-screenshot__img" />
      </video>
    ) : !isGrid ? (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="product-screenshot__img"
      />
    ) : (
      <div class="product-screenshot__grid">
        {all.map((s, i) => (
          <img
            src={s}
            alt={`${alt} ${i + 1}`}
            loading="lazy"
            decoding="async"
            class="product-screenshot__img"
          />
        ))}
      </div>
    )}
    <div class="product-screenshot__shimmer" aria-hidden="true"></div>
    {initialVideo && (
      <div class="product-screenshot__sound-wrap">
        <input
          type="range"
          class="product-screenshot__volume"
          min="0"
          max="100"
          value="25"
          step="1"
          aria-label="Volume"
        />
        <button
          type="button"
          class="product-screenshot__sound"
          aria-label="Toggle sound"
          data-state="muted"
        >
          <svg class="icon-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 5 6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
          <svg class="icon-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
          </svg>
        </button>
      </div>
    )}
  </div>
</figure>

{initialVideo && (
  <script>
    // Per-visit random variant selection: if the video has data-variants
    // populated (multi-edit demoVideo), pick one at random and swap
    // sources before the IntersectionObserver / sound-toggle logic binds.
    document.querySelectorAll<HTMLVideoElement>('.product-screenshot__video[data-variants]').forEach((v) => {
      const raw = v.dataset.variants;
      if (!raw) return;
      try {
        const variants = JSON.parse(raw) as Array<{src: string; src720?: string; poster: string}>;
        if (!Array.isArray(variants) || variants.length <= 1) return;
        const pick = variants[Math.floor(Math.random() * variants.length)];
        // Strip existing <source> + <img> children (img is inside video as fallback).
        const kids = Array.from(v.children);
        for (const k of kids) {
          if (k.tagName === 'SOURCE' || k.tagName === 'IMG') v.removeChild(k);
        }
        v.poster = pick.poster;
        if (pick.src720) {
          const s720 = document.createElement('source');
          s720.src = pick.src720;
          s720.type = 'video/mp4';
          s720.media = '(max-width: 768px)';
          v.appendChild(s720);
        }
        const s1080 = document.createElement('source');
        s1080.src = pick.src;
        s1080.type = 'video/mp4';
        v.appendChild(s1080);
        const fallback = document.createElement('img');
        fallback.src = pick.poster;
        fallback.alt = v.getAttribute('aria-label') || '';
        fallback.className = 'product-screenshot__img';
        v.appendChild(fallback);
        v.load();
        v.play().catch(() => {});
      } catch (_e) {
        // Bad JSON — leave server-rendered first variant in place.
      }
    });

    // Pause demo video when scrolled offscreen (saves CPU + battery).
    // Also: never let a muted video play (Diggy rule) — only play when audible.
    // Honors prefers-reduced-motion by pausing entirely + showing poster.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('.product-screenshot__video').forEach((v) => {
      if (reduceMotion) {
        v.pause();
        v.controls = true;
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const el = e.target as HTMLVideoElement;
            if (e.isIntersecting && !el.muted) el.play().catch(() => {});
            else el.pause();
          }
        },
        { threshold: 0.25 }
      );
      io.observe(v);
    });

    // Sound toggle + volume slider: pairs button + slider with the nearest video.
    // Rules: slider default 25%; mute-button unmute caps at 75%; muted = paused.
    document.querySelectorAll<HTMLDivElement>('.product-screenshot__sound-wrap').forEach((wrap) => {
      const frame = wrap.closest('.product-screenshot__frame');
      const v = frame?.querySelector<HTMLVideoElement>('.product-screenshot__video');
      const btn = wrap.querySelector<HTMLButtonElement>('.product-screenshot__sound');
      const slider = wrap.querySelector<HTMLInputElement>('.product-screenshot__volume');
      if (!v || !btn || !slider) return;
      const UNMUTE_CAP = 0.75;       // mute-button unmute volume ceiling
      const DEFAULT_VOL = 0.25;       // slider rest position
      let lastVolume = DEFAULT_VOL;   // restored when un-muting via button
      const paint = (pct: number) => slider.style.setProperty('--vol', pct + '%');
      paint(Number(slider.value));    // matches the server-rendered value="25"
      slider.addEventListener('input', () => {
        const pct = Number(slider.value);
        v.volume = pct / 100;
        if (pct > 0) {
          if (v.muted) v.muted = false;
          btn.dataset.state = 'on';
          lastVolume = pct / 100;
          v.play().catch(() => {});
        } else {
          v.muted = true;
          btn.dataset.state = 'muted';
          v.pause();
        }
        paint(pct);
      });
      btn.addEventListener('click', () => {
        if (v.muted || v.volume === 0) {
          // Un-muting: cap at 75% (Diggy rule).
          const target = Math.min(UNMUTE_CAP, lastVolume > 0 ? lastVolume : DEFAULT_VOL);
          v.muted = false;
          v.volume = target;
          btn.dataset.state = 'on';
          slider.value = String(Math.round(target * 100));
          paint(Number(slider.value));
          v.play().catch(() => {});
          // User got the hint — kill the unmute banner instantly so it
          // doesn't sit there mocking them.
          const fig = frame?.closest('.product-screenshot');
          fig?.querySelector('.product-screenshot__unmute-banner')?.remove();
        } else {
          v.muted = true;
          btn.dataset.state = 'muted';
          slider.value = '0';
          paint(0);
          v.pause();
        }
      });
    });
  </script>
)}

<style>
  .product-screenshot {
    position: relative;
    margin: 48px 0 0;
    padding: 0;
  }
  /* "Tap the speaker icon to unmute" header — sits above the video frame
     so first-time visitors know there's audio. Auto-fades out 8s after
     load (browser autoplay-policy means demo videos must start muted, so
     without a hint people just watch silently and bounce). */
  .product-screenshot__unmute-banner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    margin: 0 auto 10px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(226, 91, 255, 0.16), rgba(226, 91, 255, 0.06));
    border: 1px solid rgba(226, 91, 255, 0.45);
    color: var(--color-text);
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    width: fit-content;
    box-shadow: 0 0 18px rgba(226, 91, 255, 0.25);
    animation: unmute-banner-pulse 2.4s ease-in-out 0s 2 alternate, unmute-banner-fade 1.2s ease 8s forwards;
  }
  .product-screenshot__unmute-banner svg { opacity: 0.9; }
  /* Center the banner in the figure by promoting figure to flex column. */
  .product-screenshot:has(.product-screenshot__unmute-banner) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .product-screenshot:has(.product-screenshot__unmute-banner) .product-screenshot__frame {
    width: 100%;
  }
  @keyframes unmute-banner-pulse {
    from { box-shadow: 0 0 14px rgba(226, 91, 255, 0.18); }
    to   { box-shadow: 0 0 26px rgba(226, 91, 255, 0.42); }
  }
  @keyframes unmute-banner-fade {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(-6px); pointer-events: none; }
  }
  .product-screenshot__frame {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-line-strong);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 32px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(226, 91, 255, 0.18),
      0 0 80px rgba(226, 91, 255, 0.12);
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 600ms ease;
  }
  .product-screenshot__frame:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 40px 100px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(226, 91, 255, 0.32),
      0 0 100px rgba(226, 91, 255, 0.22);
  }
  .product-screenshot__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .product-screenshot__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
  }
  .product-screenshot__grid .product-screenshot__img {
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--color-bg);
  }

  .product-screenshot__shimmer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.08) 50%, transparent 70%);
    opacity: 0;
    transition: opacity 400ms ease, transform 800ms ease;
  }
  .product-screenshot__frame:hover .product-screenshot__shimmer {
    opacity: 1;
    transform: translateX(20%);
  }

  @media (max-width: 768px) {
    .product-screenshot__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-screenshot__sound-wrap {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* Hover catch beyond the visible bounds so the slider doesn't snap shut
       when the cursor moves through the gap between slider and button. */
    padding: 0;
  }

  .product-screenshot__sound {
    position: relative;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(8, 8, 8, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    transition: opacity 200ms ease, transform 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .product-screenshot__frame:hover .product-screenshot__sound {
    opacity: 1;
  }
  .product-screenshot__sound:hover {
    border-color: rgba(226, 91, 255, 0.55);
    color: #e25bff;
    transform: scale(1.06);
  }
  .product-screenshot__sound .icon-on { display: none; }
  .product-screenshot__sound[data-state="on"] .icon-muted { display: none; }
  .product-screenshot__sound[data-state="on"] .icon-on { display: inline-block; }
  .product-screenshot__sound[data-state="on"] {
    color: #e25bff;
    border-color: rgba(226, 91, 255, 0.45);
    opacity: 1;
  }

  /* Volume slider — collapsed by default, expands left from the button on hover. */
  .product-screenshot__volume {
    --vol: 0%;
    -webkit-appearance: none;
    appearance: none;
    width: 0;
    opacity: 0;
    height: 36px;
    margin: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    pointer-events: none;
    transform-origin: right center;
    transition:
      width 240ms cubic-bezier(0.16, 1, 0.3, 1),
      padding 240ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 200ms ease,
      border-color 200ms ease;
  }
  .product-screenshot__sound-wrap:hover .product-screenshot__volume,
  .product-screenshot__sound-wrap:focus-within .product-screenshot__volume {
    width: 110px;
    padding: 0 12px;
    opacity: 1;
    pointer-events: auto;
    border-color: rgba(255, 255, 255, 0.16);
  }
  /* WebKit track + thumb */
  .product-screenshot__volume::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      #e25bff 0%,
      #e25bff var(--vol),
      rgba(255, 255, 255, 0.22) var(--vol),
      rgba(255, 255, 255, 0.22) 100%
    );
  }
  .product-screenshot__volume::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    margin-top: -4.5px;
    border-radius: 999px;
    background: #fff;
    border: 2px solid #e25bff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    transition: transform 160ms ease;
  }
  .product-screenshot__volume::-webkit-slider-thumb:hover,
  .product-screenshot__volume:focus-visible::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  /* Firefox track + thumb */
  .product-screenshot__volume::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
  }
  .product-screenshot__volume::-moz-range-progress {
    height: 3px;
    border-radius: 999px;
    background: #e25bff;
  }
  .product-screenshot__volume::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: #fff;
    border: 2px solid #e25bff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    cursor: pointer;
  }
  .product-screenshot__volume:focus-visible {
    outline: none;
  }
</style>
