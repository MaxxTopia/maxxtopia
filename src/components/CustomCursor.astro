---
// Custom cursor — accent dot + ring. Skipped on touch / coarse pointer.
// Only animates while the mouse is actually moving (idle frames are paused).
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="custom-cursor__ring"></div>
  <div class="custom-cursor__dot"></div>
</div>

<script is:inline>
  (() => {
    const cursor = document.getElementById('custom-cursor');
    if (!cursor) return;

    const isCoarse =
      window.matchMedia('(pointer: coarse)').matches ||
      window.matchMedia('(hover: none)').matches;
    if (isCoarse) {
      cursor.style.display = 'none';
      return;
    }

    // Only hide native cursor once we've confirmed we have a fine pointer
    // and the custom cursor is mounted. Avoids "no cursor at all" on no-JS.
    document.documentElement.style.cursor = 'none';

    const dot = cursor.querySelector('.custom-cursor__dot');
    const ring = cursor.querySelector('.custom-cursor__ring');
    if (!dot || !ring) return;

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let dx = mx, dy = my;
    let rx = mx, ry = my;
    let raf = 0;

    const tick = () => {
      // Lerp the ring; dot follows the cursor 1:1 with no smoothing
      rx += (mx - rx) * 0.22;
      ry += (my - ry) * 0.22;
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate(-50%, -50%)`;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%)`;

      // Stop the loop once the ring has caught up — restart on next move
      const dxr = Math.abs(mx - rx);
      const dyr = Math.abs(my - ry);
      if (dxr < 0.4 && dyr < 0.4) {
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const start = () => { if (!raf) raf = requestAnimationFrame(tick); };

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      start();
    }, { passive: true });

    // Hover state
    const isInteractive = (el) =>
      el && (el.tagName === 'A' || el.tagName === 'BUTTON' ||
             el.closest('a, button, [role="button"], .card, [data-cursor="hover"]'));

    document.addEventListener('mouseover', (e) => {
      if (isInteractive(e.target)) cursor.classList.add('is-over-link');
    });
    document.addEventListener('mouseout', (e) => {
      if (isInteractive(e.target)) cursor.classList.remove('is-over-link');
    });

    // Hide on blur / when mouse leaves window
    window.addEventListener('blur', () => cursor.style.opacity = '0');
    window.addEventListener('focus', () => cursor.style.opacity = '1');
    document.addEventListener('mouseleave', () => cursor.style.opacity = '0');
    document.addEventListener('mouseenter', () => cursor.style.opacity = '1');
  })();
</script>
