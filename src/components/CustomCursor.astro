---
// Custom cursor — accent dot + ring. Skipped on touch / coarse pointer.
// Only animates while the mouse is actually moving (idle frames are paused).
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="custom-cursor__ring"></div>
  <div class="custom-cursor__dot"></div>
</div>

<script is:inline>
  (() => {
    const cursor = document.getElementById('custom-cursor');
    if (!cursor) return;

    const isCoarse =
      window.matchMedia('(pointer: coarse)').matches ||
      window.matchMedia('(hover: none)').matches;
    if (isCoarse) {
      cursor.style.display = 'none';
      return;
    }

    // Only hide native cursor once we've confirmed we have a fine pointer
    // and the custom cursor is mounted. Avoids "no cursor at all" on no-JS.
    document.documentElement.style.cursor = 'none';

    const dot = cursor.querySelector('.custom-cursor__dot');
    const ring = cursor.querySelector('.custom-cursor__ring');
    if (!dot || !ring) return;

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx, ry = my;
    let lastTickAt = 0;
    let raf = 0;

    // Position goes on the `translate` property, NOT `transform`. The hover grow uses
    // the `scale` property, and `scale` composes OUTSIDE `transform` — so if position
    // lived in transform, scaling would multiply the coordinates and fling the cursor
    // toward the corner on every link/button. `translate` and `scale` compose in the
    // right order (scale about the element's own centre), so the grow never moves it.
    // Centring is handled by the left/top offsets in CSS, not translate(-50%,-50%).

    // The ring trails the cursor with a short, bounded ease — that trailing is the
    // effect. The dot does NOT go through here: it is pinned to the true cursor in
    // the mousemove handler below, so it can never lag behind a busy frame the way
    // a rAF-driven dot does on a page carrying dozens of animations.
    const tick = (now) => {
      const dt = lastTickAt ? Math.min(50, Math.max(1, now - lastTickAt)) : 16;
      lastTickAt = now;

      const dx = mx - rx;
      const dy = my - ry;
      const distance = Math.hypot(dx, dy);
      if (distance > 0.01) {
        // Use time-based easing so the feel stays consistent across refresh rates.
        // Larger gaps get a catch-up boost, but the ring keeps a small visible
        // offset instead of teleporting onto the dot.
        const baseFollow = 1 - Math.exp(-dt / 52);
        const urgency = Math.min(1, Math.max(0, (distance - 10) / 32));
        const follow = baseFollow + (0.82 - baseFollow) * urgency;
        rx += dx * follow;
        ry += dy * follow;

        // Bound the spatial trail so a fast sweep never turns into a long lag line.
        const remainingX = mx - rx;
        const remainingY = my - ry;
        const remaining = Math.hypot(remainingX, remainingY);
        const maxTrail = 22;
        if (remaining > maxTrail) {
          const keep = maxTrail / remaining;
          rx = mx - remainingX * keep;
          ry = my - remainingY * keep;
        }
      }
      ring.style.translate = `${rx}px ${ry}px`;

      // Stop once the ring has caught up — restart on next move
      if (Math.abs(mx - rx) < 0.4 && Math.abs(my - ry) < 0.4) { raf = 0; return; }
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (!raf) {
        lastTickAt = 0;
        raf = requestAnimationFrame(tick);
      }
    };

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      // Move the dot NOW, on the input event itself — instant, no frame wait.
      dot.style.translate = `${mx}px ${my}px`;
      start();
    }, { passive: true });

    // Hover state. Pointerover/out bubble through labels, SVGs, and spans inside
    // a control; compare the closest interactive ancestor so those child hops
    // cannot flicker the cursor scale while the pointer remains on one control.
    const interactiveSelector = 'a, button, [role="button"], .card, [data-cursor="hover"]';
    const interactiveFrom = (node) =>
      node instanceof Element ? node.closest(interactiveSelector) : null;
    let activeInteractive = null;
    const setInteractive = (next) => {
      if (next === activeInteractive) return;
      activeInteractive = next;
      cursor.classList.toggle('is-over-link', Boolean(next));
    };

    document.addEventListener('pointerover', (e) => {
      setInteractive(interactiveFrom(e.target));
    }, { passive: true });
    document.addEventListener('pointerout', (e) => {
      setInteractive(interactiveFrom(e.relatedTarget));
    }, { passive: true });

    // Hide on blur / when mouse leaves window
    window.addEventListener('blur', () => { cursor.style.opacity = '0'; setInteractive(null); });
    window.addEventListener('focus', () => cursor.style.opacity = '1');
    document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; setInteractive(null); });
    document.addEventListener('mouseenter', () => cursor.style.opacity = '1');
  })();
</script>
