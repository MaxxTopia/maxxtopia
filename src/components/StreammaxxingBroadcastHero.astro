<script>
  const setups = {
    follow: {
      source: 'TWITCH EVENTSUB',
      glyph: '❤',
      name: 'orbitalsam',
      copy: ' just followed!',
      message: '',
      toast: 'FOLLOW RECEIVED · FIRED LOCALLY',
      engine: 'ALERT QUEUE · CLEAR',
      goalLabel: 'FOLLOWER GOAL',
      goalCurrent: '848',
      goalTarget: '1,000',
      goalPct: '85%',
      goalWidth: '85%',
    },
    donation: {
      source: 'STREAM ELEMENTS · TIP',
      glyph: '💰',
      name: 'midnightace',
      copy: ' tipped $25!',
      message: '“that clutch was unreal”',
      toast: 'TIP RECEIVED · CLONED VOICE READING',
      engine: 'TTS · READING CLONED VOICE',
      goalLabel: 'TIP GOAL',
      goalCurrent: '$742',
      goalTarget: '$1,000',
      goalPct: '74%',
      goalWidth: '74%',
    },
    chat: {
      source: '4 CHAT CONNECTIONS',
      glyph: '❤',
      name: 'four platforms',
      copy: ' one widget',
      message: '',
      toast: 'MESSAGE RECEIVED · MODERATION PASSED',
      engine: 'CHAT · 4 CONNECTED',
      goalLabel: 'FOLLOWER GOAL',
      goalCurrent: '848',
      goalTarget: '1,000',
      goalPct: '85%',
      goalWidth: '85%',
    },
    scene: {
      source: 'STREAM DECK · SCENE',
      glyph: '◆',
      name: 'Starting Soon',
      copy: ' sent to OBS',
      message: '',
      toast: 'SCENE CHANGED · OBS CONFIRMED',
      engine: 'OBS · SCENE CONFIRMED',
      goalLabel: 'FOLLOWER GOAL',
      goalCurrent: '848',
      goalTarget: '1,000',
      goalPct: '85%',
      goalWidth: '85%',
    },
    music: {
      source: 'PLAYLISTMAXXING',
      glyph: '♫',
      name: 'Every platform',
      copy: ' one turning page',
      message: '',
      toast: 'TRACK CHANGED · OVERLAY UPDATED',
      engine: 'NOW PLAYING · SPOTIFY',
      goalLabel: 'FOLLOWER GOAL',
      goalCurrent: '848',
      goalTarget: '1,000',
      goalPct: '85%',
      goalWidth: '85%',
    },
  } as const;

  document.querySelectorAll<HTMLElement>('[data-smx-rig]').forEach((rig) => {
    const buttons = Array.from(rig.querySelectorAll<HTMLButtonElement>('[data-smx-action]'));
    const source = rig.querySelector<HTMLElement>('[data-smx-source]');
    const glyph = rig.querySelector<HTMLElement>('[data-smx-alert-glyph]');
    const name = rig.querySelector<HTMLElement>('[data-smx-alert-name]');
    const copy = rig.querySelector<HTMLElement>('[data-smx-alert-copy]');
    const message = rig.querySelector<HTMLElement>('[data-smx-alert-message]');
    const toast = rig.querySelector<HTMLElement>('[data-smx-toast]');
    const engine = rig.querySelector<HTMLElement>('[data-smx-engine-status]');
    const goalLabel = rig.querySelector<HTMLElement>('[data-smx-goal-label]');
    const goalCurrent = rig.querySelector<HTMLElement>('[data-smx-goal-current]');
    const goalTarget = rig.querySelector<HTMLElement>('[data-smx-goal-target]');
    const goalPct = rig.querySelector<HTMLElement>('[data-smx-goal-pct]');
    const goalFill = rig.querySelector<HTMLElement>('[data-smx-goal-fill]');
    const order = ['follow', 'donation', 'chat', 'scene', 'music'] as const;
    let index = 0;
    let timer = 0;

    const fire = (mode: keyof typeof setups, fromUser = false) => {
      const setup = setups[mode];
      rig.dataset.mode = mode;
      source && (source.textContent = setup.source);
      glyph && (glyph.textContent = setup.glyph);
      name && (name.textContent = setup.name);
      copy && (copy.textContent = setup.copy);
      message && (message.textContent = setup.message);
      toast && (toast.textContent = setup.toast);
      engine && (engine.textContent = setup.engine);
      goalLabel && (goalLabel.textContent = setup.goalLabel);
      goalCurrent && (goalCurrent.textContent = setup.goalCurrent);
      goalTarget && (goalTarget.textContent = setup.goalTarget);
      goalPct && (goalPct.textContent = setup.goalPct);
      goalFill && (goalFill.style.width = setup.goalWidth);
      buttons.forEach((button) => button.classList.toggle('is-active', button.dataset.smxAction === mode));
      rig.classList.remove('smx-firing');
      void rig.offsetWidth;
      rig.classList.add('smx-firing');
      index = order.indexOf(mode);
      if (fromUser) {
        window.clearInterval(timer);
        timer = window.setInterval(next, 7000);
      }
    };

    const next = () => fire(order[(index + 1) % order.length]);
    buttons.forEach((button) => button.addEventListener('click', () => fire(button.dataset.smxAction as keyof typeof setups, true)));
    fire('follow');
    timer = window.setInterval(next, 4300);
  });
</script>
