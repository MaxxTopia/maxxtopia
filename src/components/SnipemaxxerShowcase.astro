  .smx-tour-rail p { color: rgba(27, 31, 40, .62); }
  .smx-tour-rail .smx-tour-proof { border: 0; border-top: 2px solid var(--smx-oxide); background: transparent; }
  .smx-tour-media :global(.product-screenshot) { margin: 0; }
  .smx-tour-media :global(.product-screenshot__frame) { border: 1px solid var(--smx-ink-line) !important; border-radius: 0 !important; background: #151922 !important; box-shadow: 16px 16px 0 rgba(27, 31, 40, .11) !important; }
  .smx-tour-media :global(.product-screenshot__shimmer) { display: none; }
  .smx-tour-media :global(.product-screenshot__playcta-ring) { border-color: var(--smx-oxide) !important; box-shadow: none !important; }
  .smx-tour-media :global(.product-screenshot__playcta-label) { color: var(--smx-paper) !important; }

  .smx-playbook { padding: clamp(88px, 11vw, 148px) 0; background: #171c25; border-top-color: var(--smx-line); }
  .smx-playbook--valorant { background: #1a202a; }
  .smx-playbook--fortnite .smx-eyebrow,
  .smx-playbook--fortnite .smx-step-label { color: var(--smx-oxide); }
  .smx-playbook--valorant .smx-eyebrow,
  .smx-playbook--valorant .smx-step-label { color: var(--smx-steel); }
  .smx-playbook--valorant .smx-section-heading h2 em { color: var(--smx-steel); }
  .smx-step-list { position: relative; gap: 0; margin-top: 70px; border-top: 0; }
  .smx-step-list::before { content: ''; position: absolute; top: 0; bottom: 0; left: 17px; width: 1px; background: var(--smx-line); }
  .smx-step { position: relative; grid-template-columns: minmax(240px, .78fr) minmax(0, 1.22fr); gap: clamp(30px, 6vw, 90px); padding: 52px 0 52px 72px; border-bottom-color: var(--smx-line); }
  .smx-step::before { content: ''; position: absolute; top: 68px; left: 8px; width: 18px; height: 18px; border: 1px solid var(--smx-oxide); background: var(--smx-bg); transform: rotate(45deg); }
  .smx-playbook--valorant .smx-step::before { border-color: var(--smx-steel); background: #1a202a; }
  .smx-step-index { color: var(--smx-subtle); font: 600 11px/1 var(--font-mono), monospace; letter-spacing: .08em; }
  .smx-playbook--valorant .smx-step-index { color: var(--smx-subtle); }
  .smx-step-label { margin-top: 18px; }
  .smx-step h3 { max-width: 420px; margin: 12px 0 0; color: var(--smx-text); font-family: var(--font-display), sans-serif; font-size: clamp(34px, 4vw, 54px); font-weight: 400; line-height: .93; letter-spacing: -.015em; }
  .smx-step-body { max-width: 470px; margin-top: 17px; color: var(--smx-muted); font-size: 14px; line-height: 1.72; }
  .smx-step-tags { gap: 0 13px; margin-top: 23px; }
  .smx-step-shot { min-width: 0; }
  .smx-shot-frame { display: block; width: 100%; padding: 0; position: relative; overflow: hidden; aspect-ratio: 16 / 10; border: 1px solid var(--smx-line); border-radius: 0; background: #0f131a; box-shadow: 15px 15px 0 rgba(0, 0, 0, .13); color: inherit; cursor: zoom-in; font: inherit; text-align: left; }
  .smx-shot-frame::after { display: none; }
  .smx-shot-frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; filter: saturate(.88) contrast(1.04); transition: transform .4s ease, filter .4s ease; }
  .smx-shot-frame--contain img { object-fit: contain; object-position: center; background: #11161e; }
  .smx-step-shot:hover img { transform: none; }
  .smx-shot-frame:hover img,
  .smx-shot-frame:focus-visible img { transform: scale(1.015); filter: saturate(.98) contrast(1.04); }
  .smx-shot-frame:focus-visible { outline: 2px solid var(--smx-oxide); outline-offset: 4px; }
  .smx-zoom-hint { position: absolute; right: 12px; bottom: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border: 1px solid rgba(244, 240, 232, .28); background: rgba(21, 25, 34, .88); color: var(--smx-text); font: 500 10px/1 var(--font-mono), monospace; letter-spacing: .02em; }
  .smx-step-shot figcaption { padding-top: 13px; }
