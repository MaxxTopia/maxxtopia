  .smx-step-shot figcaption span { color: var(--smx-subtle); font: 500 10px/1 var(--font-mono), monospace; letter-spacing: .03em; text-transform: none; }

  .smx-step--report { margin: 26px 0; margin-left: -72px; padding-right: clamp(22px, 4vw, 52px); padding-left: 72px; background: var(--smx-paper); color: var(--smx-paper-ink); border-bottom: 0; }
  .smx-step--report::before { background: var(--smx-paper); border-color: var(--smx-oxide); }
  .smx-step--report .smx-step-index,
  .smx-step--report .smx-step-label { color: var(--smx-oxide); }
  .smx-step--report h3 { color: var(--smx-paper-ink); }
  .smx-step--report .smx-step-body { color: rgba(27, 31, 40, .7); }
  .smx-step--report .smx-step-tags span { color: rgba(27, 31, 40, .62); }
  .smx-step--report .smx-step-shot figcaption strong { color: var(--smx-paper-ink); }
  .smx-step--report .smx-step-shot figcaption span { color: rgba(27, 31, 40, .55); }
  .smx-step--report .smx-shot-frame { border-color: var(--smx-ink-line); box-shadow: 15px 15px 0 rgba(27, 31, 40, .12); }
  .smx-step--report .smx-zoom-hint { border-color: rgba(238, 233, 223, .24); background: var(--smx-paper-ink); color: var(--smx-paper); }

  .smx-transition { padding: 27px 0; background: var(--smx-oxide); border: 0; color: var(--smx-paper-ink); }
  .smx-transition .smx-shell { grid-template-columns: 1fr 2fr 1fr; gap: 20px; }
  .smx-transition span,
  .smx-transition small { color: rgba(27, 31, 40, .72); font: 600 10px/1.35 var(--font-mono), monospace; letter-spacing: .05em; text-transform: none; }
  .smx-transition strong { color: var(--smx-paper-ink); font-size: 19px; font-weight: 650; }
  .smx-transition small { text-align: right; }

  .smx-companion-wrap { background: var(--smx-paper); }
  .smx-companion-wrap :global(#mobile-companion) { border-top: 0; border-bottom: 0; background: var(--smx-paper) !important; color: var(--smx-paper-ink); }
  .smx-companion-wrap :global(#mobile-companion > div) { padding-top: 86px; padding-bottom: 86px; }
  .smx-companion-wrap :global(#mobile-companion > div > div) { border-radius: 0 !important; border-color: var(--smx-oxide) !important; background: var(--smx-bg) !important; box-shadow: none !important; }
  .smx-companion-wrap :global(#mobile-companion > div > div > div:first-child) { display: none !important; }

  .smx-boundaries { padding: clamp(84px, 10vw, 132px) 0; background: var(--smx-paper); color: var(--smx-paper-ink); border-top-color: var(--smx-ink-line); }
  .smx-boundaries .smx-eyebrow { color: var(--smx-oxide); }
  .smx-boundaries .smx-section-heading h2 { color: var(--smx-paper-ink); }
  .smx-boundaries .smx-section-heading h2 em { color: var(--smx-oxide); }
  .smx-boundaries .smx-section-heading > p:last-child { color: rgba(27, 31, 40, .68); }
  .smx-boundary-grid { grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 58px; border: 0; border-top: 1px solid var(--smx-ink-line); border-bottom: 1px solid var(--smx-ink-line); background: transparent; }
  .smx-boundary-grid article { min-height: 216px; padding: 25px 25px 25px 0; background: transparent; }
  .smx-boundary-grid article + article { padding-left: 25px; border-left: 1px solid var(--smx-ink-line); }
  .smx-state { display: inline-flex; padding: 0 0 10px; border: 0; border-bottom: 2px solid currentColor; color: var(--smx-oxide); font: 600 10px/1.3 var(--font-mono), monospace; letter-spacing: .06em; text-transform: none; }
  .smx-state--live { color: #648864; }
  .smx-state--delayed { color: var(--smx-oxide); }
  .smx-state--local { color: var(--smx-steel); }
  .smx-boundary-grid h3 { margin: 35px 0 0; color: var(--smx-paper-ink); font-family: var(--font-display), sans-serif; font-size: 31px; font-weight: 400; letter-spacing: -.015em; }
  .smx-boundary-grid p { margin-top: 11px; color: rgba(27, 31, 40, .68); font-size: 13px; line-height: 1.68; }
  .smx-trust-line { grid-template-columns: 150px 1fr; gap: 24px; margin-top: 19px; padding: 17px 0; border: 0; border-bottom: 1px solid var(--smx-ink-line); background: transparent; }
  .smx-trust-line span { color: var(--smx-oxide); font: 600 10px/1.3 var(--font-mono), monospace; letter-spacing: .06em; }
  .smx-trust-line strong { color: rgba(27, 31, 40, .72); font-size: 13px; font-weight: 500; line-height: 1.5; }

  .smx-finish { padding: clamp(90px, 11vw, 144px) 0 126px; background: var(--smx-bg); border-top-color: var(--smx-line); }
  .smx-cta-card .smx-eyebrow { color: var(--smx-oxide); }
  .smx-cta-card h2 { font-size: clamp(58px, 7.2vw, 96px); }
  .smx-cta-card h2 em { color: var(--smx-oxide); }
  .smx-cta-card > p:not(.smx-eyebrow) { color: var(--smx-muted); }
  .smx-cta-meta { color: var(--smx-subtle); }
  .smx-cta-primary,
  .smx-cta-secondary { border-radius: 0; font: 600 11px/1 var(--font-mono), monospace; letter-spacing: .04em; text-transform: none; }
  .smx-cta-primary { border-color: var(--smx-oxide); background: var(--smx-oxide); color: var(--smx-paper-ink); }
  .smx-cta-secondary { border-color: var(--smx-line); color: var(--smx-text); }
  .smx-cta-primary:hover,
  .smx-cta-secondary:hover,
  .smx-cta-primary:focus-visible,
  .smx-cta-secondary:focus-visible { transform: translateY(-2px); border-color: var(--smx-text); }
  .smx-faq-list { border-top-color: var(--smx-line); }
  .smx-faq-kicker { color: var(--smx-subtle); }
  .smx-faq-list details { border-top-color: var(--smx-line); }
  .smx-faq-list summary { color: var(--smx-text); font-weight: 600; }
  .smx-faq-list summary span { color: var(--smx-oxide); }
  .smx-faq-list details p { color: var(--smx-muted); }

  .smx-lightbox { position: fixed; inset: 0; z-index: 220; display: none; align-items: center; justify-content: center; padding: 30px; background: rgba(10, 13, 18, .95); cursor: zoom-out; overflow: auto; }
  .smx-lightbox.is-open { display: flex; }
  .smx-lightbox__stage { max-width: min(94vw, 1440px); text-align: center; }
  .smx-lightbox__stage img { display: block; max-width: 94vw; max-height: 88vh; width: auto; height: auto; border: 1px solid rgba(244, 240, 232, .2); box-shadow: 18px 18px 0 rgba(0, 0, 0, .2); cursor: zoom-in; }
  .smx-lightbox__stage img.is-zoomed { max-width: none; max-height: none; cursor: zoom-out; }
  .smx-lightbox__stage p { margin: 13px 0 0; color: rgba(244, 240, 232, .55); font: 500 10px/1.3 var(--font-mono), monospace; letter-spacing: .04em; }
  .smx-lightbox__close { position: fixed; top: 22px; right: 24px; padding: 9px 10px; border: 1px solid rgba(244, 240, 232, .28); background: transparent; color: var(--smx-text); cursor: pointer; font: 600 10px/1 var(--font-mono), monospace; letter-spacing: .05em; }
  .smx-lightbox__close:hover,
  .smx-lightbox__close:focus-visible { border-color: var(--smx-oxide); color: var(--smx-oxide); }

  /* Hero identity pass: keep the lower page in Snipemaxer's black, red, and white world. */
  .smx-lower {
    --smx-bg: #06070a;
    --smx-bg-raised: #0b0d10;
    --smx-panel: #0e1014;
    --smx-panel-2: #07080b;
    --smx-text: #f3f4f4;
    --smx-muted: rgba(243, 244, 244, .72);
    --smx-subtle: rgba(243, 244, 244, .46);
    --smx-line: rgba(243, 244, 244, .13);
    --smx-paper: #f2f1ed;
    --smx-paper-ink: #0b0c0e;
    --smx-ink-line: rgba(11, 12, 14, .19);
    --smx-oxide: #ff3b3b;
    --smx-steel: rgba(243, 244, 244, .76);
    --smx-live: #ff3b3b;
  }

  .smx-overview,
  .smx-valorant-route,
  .smx-tour,
  .smx-playbook,
  .smx-boundaries,
  .smx-finish { overflow: hidden; }

  .smx-overview::before { display: block; inset: 18px 0 auto; height: 1px; opacity: .8; background: linear-gradient(90deg, var(--smx-oxide) 0 13%, transparent 13% 87%, rgba(243,244,244,.24) 87% 92%, transparent 92%); }
  .smx-overview { background: var(--smx-bg); }
  .smx-overview-heading h2 em,
  .smx-section-heading h2 em,
  .smx-cta-card h2 em,
  .smx-route-heading h2 em { color: var(--smx-oxide); }
  .smx-eyebrow,
  .smx-anchor-nav a span,
  .smx-stat-strip strong { color: var(--smx-oxide); }
  .smx-anchor-nav a:hover,
