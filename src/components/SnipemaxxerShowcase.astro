  .smx-mode-card-top b { display: inline; width: auto; height: auto; border: 0; font-size: 11px; }
  .smx-mode-card-top i { font-size: 17px; }
  .smx-mode-card h3 { margin: 45px 0 14px; color: var(--smx-text); font-family: var(--font-display), sans-serif; font-size: clamp(44px, 5.3vw, 72px); font-weight: 400; line-height: .9; letter-spacing: -.02em; }
  .smx-mode-card > p { max-width: 470px; color: var(--smx-muted); font-size: 14px; line-height: 1.7; }
