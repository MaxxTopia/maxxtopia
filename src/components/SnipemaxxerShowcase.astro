  .smx-valorant-route { padding: clamp(76px, 9vw, 122px) 0; background: var(--smx-bg-raised); border-top: 1px solid var(--smx-line); }
  .smx-route-heading { display: grid; grid-template-columns: minmax(0, .9fr) minmax(300px, 1.1fr); gap: 20px clamp(34px, 7vw, 100px); align-items: end; }
