  .smx-mode-grid { gap: clamp(34px, 6vw, 86px); margin-top: 72px; }
  .smx-mode-card { min-height: 0; padding: 27px 0 25px; border: 0; border-top: 2px solid var(--mode-accent); border-bottom: 1px solid var(--smx-line); border-radius: 0; background: transparent; }
