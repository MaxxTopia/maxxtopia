  .smx-route-heading > p:last-child { max-width: 520px; margin: 0 0 4px; color: var(--smx-muted); font-size: 15px; line-height: 1.75; }
  .smx-route-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 62px; border-top: 1px solid var(--smx-line); border-bottom: 1px solid var(--smx-line); }
  .smx-route-card { min-height: 255px; padding: 25px 25px 28px 0; border-right: 1px solid var(--smx-line); }
  .smx-route-card + .smx-route-card { padding-left: 25px; }
  .smx-route-card:last-child { border-right: 0; }
