  .smx-route-card strong,
  .smx-route-card a { display: block; margin-top: 21px; color: var(--smx-oxide); font: 600 11px/1.35 var(--font-mono), monospace; letter-spacing: .03em; text-decoration: none; }
  .smx-route-card a span { margin-left: 8px; font-size: 14px; }
  .smx-route-card a:hover { color: var(--smx-text); }
  .smx-route-note { display: grid; grid-template-columns: 180px 1fr; gap: 28px; align-items: baseline; margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--smx-line); }
  .smx-route-note strong { color: var(--smx-text); font: 600 10px/1.35 var(--font-mono), monospace; letter-spacing: .07em; }
  .smx-route-note span { color: var(--smx-subtle); font-size: 13px; line-height: 1.5; }

  .smx-tour { padding: clamp(82px, 10vw, 132px) 0; background: var(--smx-paper); color: var(--smx-paper-ink); border-top-color: var(--smx-ink-line); }
  .smx-tour .smx-eyebrow { color: var(--smx-oxide); }
  .smx-tour .smx-section-heading h2 { color: var(--smx-paper-ink); }
  .smx-tour .smx-section-heading h2 em { color: var(--smx-oxide); }
  .smx-tour .smx-section-heading > p:last-child { color: rgba(27, 31, 40, .7); }
  .smx-tour-layout { grid-template-columns: 210px minmax(0, 1fr); gap: clamp(32px, 6vw, 76px); margin-top: 56px; }
  .smx-tour-rail { border-left-color: var(--smx-ink-line); }
