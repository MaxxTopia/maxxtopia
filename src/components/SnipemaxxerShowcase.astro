---
import type { Product } from '../data/products';
import ProductScreenshot from './ProductScreenshot.astro';
import SnipemaxxerCompanion from './SnipemaxxerCompanion.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const version = product.version ?? '0.3.10';
const oxide = '#ff3b3b';
const demo = product.demoVideo
  ? (Array.isArray(product.demoVideo) ? product.demoVideo[0] : product.demoVideo)
  : undefined;

const modeCards = [
  {
    number: '01',
    theme: 'fortnite',
    label: 'Fortnite / tournament desk',
    headline: 'Play the points.',
    body: 'Live standing tells you where you are now. Fortnite replay data is about five minutes delayed because it comes from the official replay; once it lands, Scout shows who is in the lobby and what the next drop demands.',
    proof: {
      src: '/screenshots/snipemaxxer/right-now.webp',
      alt: 'Snipemaxxer Fortnite Scout showing keyable targets and threats still in the lobby.',
      caption: 'Replay data / about 5 min delayed',
    },
    rows: [
      ['Live standing', 'Points · rank · cutoff · games left'],
      ['Replay scout', 'Field · drops · threats · survivors'],
      ['Strategy lab', 'Routes · team shape · next call'],
    ],
    tags: ['Live now', 'Replay when it lands', 'Voice coach'],
  },
  {
    number: '02',
    theme: 'valorant',
    label: 'Valorant / session desk',
    headline: 'Read the round.',
    body: 'Instant lobby intel from a connected Riot Client: rank, RR, phase, full lobby, and teammates in one read-only view. Match reports and a personal toolkit turn that read into a better next round.',
    proof: {
      src: '/screenshots/snipemaxxer/valorant-live-report.webp',
      alt: 'Snipemaxxer Valorant report showing the connected team lobby and player performance.',
      caption: 'Instant / connected lobby intel',
    },
    rows: [
      ['Live context', 'Rank · RR · phase · full lobby'],
      ['Match reports', 'Map · agent · K/D/A · round spine'],
      ['Personal toolkit', 'Crosshairs · watchlists · alerts'],
    ],
    tags: ['Read-only', 'Reports in one window', 'Local tools'],
  },
];

const playbooks = [
  {
    id: 'fortnite-playbook',
    theme: 'fortnite',
    eyebrow: '03 / Fortnite / tournament desk',
    headline: 'Turn the bracket into your next drop.',
    intro: 'Standing is live. Replay is delayed. Snipemaxxer keeps those reads separate so you know what is current, what is scouting, and what to do next.',
    steps: [
      {
        label: 'Standing',
        title: 'Know your place now.',
        body: 'See points, rank, games left, cutoff, event timing, freshness, and the placement-versus-push call before you queue again.',
        tags: ['Points', 'Cutoff', 'Placement or push'],
        src: '/screenshots/snipemaxxer/overlay-hud.webp',
        alt: 'Snipemaxxer Fortnite points, cutoff, games-left, and placement-versus-push decision card.',
        caption: 'Points brain / cutoff + placement call',
      },
      {
        label: 'Scout',
        title: 'See the lobby when it lands.',
        body: 'Use Epic\'s official server replay to name the field, map drops, flag pros and live streamers, and surface keyable targets, threats, survivors, and loadout reads.',
        tags: ['Official replay', 'Drops', 'Threats + survivors'],
        src: '/screenshots/snipemaxxer/right-now.webp',
        alt: 'Snipemaxxer Fortnite Scout read showing keyable targets and threats still in the lobby.',
        caption: 'Right Now / keyable targets + threats',
        fit: 'contain',
      },
      {
        label: 'Strategy Lab + coach',
        title: 'Study the decision, not just the clip.',
        body: 'Scrub landings, observed movement and loot paths, route timing, team shape, killfeed moments, captured zone rings, and endgame position. Reports and the voice coach turn the evidence into the next move.',
        tags: ['Map scrub', 'Routes', 'Endgame + coach'],
        src: '/screenshots/snipemaxxer/fortnite-strategy-lab.webp',
        alt: 'Snipemaxxer Strategy Lab map replay comparison surface.',
        caption: 'Strategy Lab / facts, inference, next call',
      },
    ],
  },
  {
    id: 'valorant-playbook',
    theme: 'valorant',
    eyebrow: '04 / Valorant / session desk',
    headline: 'Turn the last round into the next one.',
    intro: 'Snipemaxxer reads the session, not your credentials. Live Riot context is read-only; reports and the personal toolkit stay in the same Windows app.',
    steps: [
      {
        label: 'Live context',
        title: 'See the round before it starts.',
        body: 'Read rank, RR, peak, current phase, full lobby split, teammates, friends, personal offers, and teammate skins when Riot returns them.',
        tags: ['Rank + RR', 'Phase + lobby', 'Read-only Riot'],
        src: '/screenshots/snipemaxxer/valorant-home-live.webp',
        alt: 'Snipemaxxer Valorant Home showing rank, RR, live phase, and Riot connection.',
        caption: 'Live context / rank + phase + lobby',
      },
      {
        label: 'Match reports',
        title: 'Review the round with receipts.',
        body: 'Completed-match reports carry map, agent, K/D/A, score, headshots, and the full lobby. The round spine adds KAST, trades, first deaths, clutches, and economy when the provider supplies those fields.',
        tags: ['Map + agent', 'K/D/A + score', 'Round spine when available'],
        src: '/screenshots/snipemaxxer/valorant-live-report.webp',
        alt: 'Snipemaxxer Valorant full lobby report showing match performance details.',
        caption: 'Reports / full lobby + performance read',
      },
      {
        label: 'Personal toolkit',
        title: 'Keep your answers close.',
        body: 'Store local crosshairs, keep persistent watchlists, and get alerts for friends, players, matches, and skins without leaving the desk.',
        tags: ['Crosshair vault', 'Watchlists', 'Friends + match alerts'],
        src: '/screenshots/snipemaxxer/valorant-teammate-intel.webp',
        alt: 'Snipemaxxer Valorant teammate intelligence surface.',
        caption: 'Toolkit / teammate intel + alerts',
      },
    ],
  },
];

const faqs = [
  {
    q: 'Does it read game memory or automate Riot login?',
    a: "No. Fortnite scouting uses Epic's official server replay and leaderboard path without memory reading, injection, or a game-hooked overlay. Valorant uses a read-only attachment to an already-running Riot Client on the same PC or through the optional gaming-PC link. Snipemaxxer never asks for a Riot password, automates login, or exposes session tokens to the renderer.",
  },
  {
    q: 'Why is a panel delayed or unavailable?',
    a: 'The app keeps data speeds separate. Fortnite tournament standing can be current, while its official server replay normally trails the match by roughly five minutes. Valorant match history needs a HenrikDev key; live Riot panels need Riot Client or the one-time gaming-PC relay. Cached, offline, and missing provider fields stay labeled instead of being passed off as live.',
  },
  {
    q: 'What does each game actually cover?',
    a: 'Fortnite is the tournament desk: standing, qualify math, replay scouting, landing and player reads, Strategy Lab, Reports, and the voice coach. Valorant is the session desk: rank, RR, completed-match history, live lobby and phase, friends, personal offers, teammate skins, watchlists, alerts, and a local crosshair vault. Both feed the same in-window Reports workbench.',
  },
];
---

<div class="smx-lower">
  <section class="smx-overview" aria-labelledby="smx-overview-title">
    <div class="smx-shell">
      <div class="smx-overview-top">
        <p class="smx-eyebrow"><span>The desk</span><i aria-hidden="true"></i><span>Snipemaxxer {version}</span></p>
        <p class="smx-overview-note">Current Windows build / two data paths</p>
      </div>

      <div class="smx-overview-heading">
        <div>
          <h2 id="smx-overview-title">One app.<br /><em>Two competitive reads.</em></h2>
        </div>
        <p>Fortnite pairs a live standing with official replay scouting that is about five minutes delayed. Valorant gives you instant lobby intel from a connected Riot Client, then keeps the completed round in reports. Same focused Windows app. Different data paths. No pretend-live data.</p>
      </div>

      <div class="smx-overview-proof-strip" aria-label="Live and replay proof">
        <figure class="smx-overview-proof-card smx-overview-proof-card--valorant">
          <div class="smx-overview-proof-label">
            <span>Valorant</span>
            <strong>Instant lobby intel</strong>
          </div>
          <button class="smx-shot-frame smx-overview-proof-shot smx-shot-frame--contain" type="button" data-zoom="/screenshots/snipemaxxer/valorant-live-report.webp" aria-label="Enlarge: Snipemaxxer Valorant report showing the connected team lobby and player performance.">
            <img src="/screenshots/snipemaxxer/valorant-live-report.webp" alt="Snipemaxxer Valorant report showing the connected team lobby and player performance." loading="lazy" decoding="async" />
            <span class="smx-zoom-hint" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
              <span>Click to enlarge</span>
            </span>
          </button>
          <figcaption>Connected Riot Client / live, read-only context</figcaption>
        </figure>

        <figure class="smx-overview-proof-card smx-overview-proof-card--fortnite">
          <div class="smx-overview-proof-label">
            <span>Fortnite</span>
            <strong>Replay scouting</strong>
          </div>
          <button class="smx-shot-frame smx-overview-proof-shot smx-shot-frame--contain" type="button" data-zoom="/screenshots/snipemaxxer/right-now.webp" aria-label="Enlarge: Snipemaxxer Fortnite Scout showing keyable targets and threats still in the lobby.">
            <img src="/screenshots/snipemaxxer/right-now.webp" alt="Snipemaxxer Fortnite Scout showing keyable targets and threats still in the lobby." loading="lazy" decoding="async" />
            <span class="smx-zoom-hint" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
              <span>Click to enlarge</span>
            </span>
          </button>
          <figcaption>Official replay / about 5 min delayed</figcaption>
        </figure>
      </div>

      <nav class="smx-anchor-nav" aria-label="Snipemaxxer sections">
        <a href="#fortnite-playbook">Fortnite <span aria-hidden="true">↘</span></a>
        <a href="#valorant-playbook">Valorant <span aria-hidden="true">↘</span></a>
        <a href="#smx-product-tour">Product tour <span aria-hidden="true">↘</span></a>
        <a href="#valorant-setup">Valorant setup <span aria-hidden="true">↘</span></a>
        <a href="#mobile-companion">Phone companion <span aria-hidden="true">↘</span></a>
        <a href="#smx-faq">FAQ <span aria-hidden="true">↘</span></a>
      </nav>

      {product.stats && (
        <div class="smx-stat-strip" aria-label="Snipemaxxer product facts">
          {product.stats.map((stat) => (
            <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
          ))}
        </div>
      )}

      <div class="smx-mode-grid">
        {modeCards.map((mode) => (
          <article class={`smx-mode-card smx-mode-card--${mode.theme}`}>
            <div class="smx-mode-card-top"><b>{mode.number}</b><span>{mode.label}</span><i aria-hidden="true">↗</i></div>
            <div class="smx-mode-intro">
              <div class="smx-mode-copy">
                <h3>{mode.headline}</h3>
                <p>{mode.body}</p>
              </div>
              <figure class="smx-mode-proof">
                <button class="smx-shot-frame smx-mode-shot smx-shot-frame--contain" type="button" data-zoom={mode.proof.src} aria-label={`Enlarge: ${mode.proof.alt}`}>
                  <img src={mode.proof.src} alt={mode.proof.alt} loading="lazy" decoding="async" />
                  <span class="smx-zoom-hint" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
                    <span>Click to enlarge</span>
                  </span>
                </button>
                <figcaption>{mode.proof.caption}</figcaption>
              </figure>
            </div>
            <div class="smx-mode-rows">
              {mode.rows.map(([label, text]) => (
                <div><span>{label}</span><b>{text}</b></div>
              ))}
            </div>
            <div class="smx-mode-tags">
              {mode.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {demo && (
    <section id="smx-product-tour" class="smx-tour" aria-labelledby="smx-tour-title">
      <div class="smx-shell">
        <div class="smx-section-heading smx-section-heading--tour">
          <p class="smx-eyebrow"><span>02 / Current Windows build</span><i aria-hidden="true"></i><span>Product tour</span></p>
          <h2 id="smx-tour-title">See the whole read <em>in motion.</em></h2>
          <p>Watch the actual app move from Valorant live context and reports to Fortnite standing, Scout, Strategy Lab, Coach, and settings. The capture is intentionally silent so the interface stays unobstructed.</p>
        </div>
        <div class="smx-tour-layout">
          <aside class="smx-tour-rail" aria-label="Product tour highlights">
            <div><span>01</span><b>Live context</b><p>Start with what the connected game can prove now.</p></div>
            <div><span>02</span><b>Reports</b><p>Keep the full lobby and round read in the same window.</p></div>
            <div><span>03</span><b>Next call</b><p>Turn the evidence into a route, a drop, or a fix.</p></div>
            <div class="smx-tour-proof"><span>Proof</span><p>Current app capture<br />{demo?.hasAudio === false ? 'silent interface tour' : 'product tour'}</p></div>
          </aside>
          <div class="smx-tour-media">
            <ProductScreenshot
              src={demo.poster}
              alt="Snipemaxxer current Windows app product tour"
              extras={[]}
              video={product.demoVideo}
            />
          </div>
        </div>
      </div>
    </section>
  )}

  <section id="valorant-setup" class="smx-valorant-route" aria-labelledby="valorant-setup-title">
    <div class="smx-shell">
      <div class="smx-route-heading">
        <p class="smx-eyebrow"><span>Valorant / choose your setup</span><i aria-hidden="true"></i><span>Three connection paths</span></p>
        <h2 id="valorant-setup-title">Play on the setup<br /><em>you already have.</em></h2>
        <p>Valorant stays read-only, but Snipemaxxer does not force one desk arrangement. Run the full app beside Riot Client, keep the game on another PC, or check the companion view from a mobile browser.</p>
      </div>

      <div class="smx-route-schematic" aria-label="Valorant connection path from Riot Client to Snipemaxxer and your chosen screen">
        <div class="smx-route-node"><span>Source</span><strong>Riot Client</strong></div>
        <div class="smx-route-connector"><i aria-hidden="true"></i><span>read-only session context</span></div>
        <div class="smx-route-node smx-route-node--desk"><span>Desk</span><strong>Snipemaxxer</strong></div>
        <div class="smx-route-connector"><i aria-hidden="true"></i><span>choose your screen</span></div>
        <div class="smx-route-node"><span>Output</span><strong>Your setup</strong></div>
      </div>

      <div class="smx-route-grid">
        <article class="smx-route-card">
          <span class="smx-route-number">01</span>
          <h3>Same PC</h3>
          <p>Riot Client and Snipemaxxer run together. The app reads the current phase, lobby, ranks, friends, offers, and teammate skins from the local client path when Riot returns them.</p>
          <strong>Best for the full desk</strong>
        </article>
        <article class="smx-route-card">
          <span class="smx-route-number">02</span>
          <h3>Two PCs</h3>
          <p>Keep Valorant and Riot Client on the gaming PC. Use the one-time gaming-PC link so Snipemaxxer on the other PC can receive the same read-only session context.</p>
          <strong>Best when your work screen is separate</strong>
        </article>
        <article class="smx-route-card smx-route-card--mobile">
          <span class="smx-route-number">03</span>
          <h3>Mobile browser</h3>
          <p>Install the Maxxtopia Companion on the PC where Riot Client is running, then open the phone view it creates. It is a quick lobby check, not a replacement for the full Windows reports desk.</p>
          <a href="#mobile-companion">See the phone companion <span aria-hidden="true">↘</span></a>
        </article>
      </div>

      <div class="smx-route-note"><strong>The boundary stays the same.</strong><span>No Riot password, no login automation, and no session token exposed to the renderer.</span></div>
    </div>
  </section>

  {playbooks.map((playbook) => (
    <section id={playbook.id} class={`smx-playbook smx-playbook--${playbook.theme}`} aria-labelledby={`${playbook.id}-title`}>
      <div class="smx-shell">
        <div class="smx-section-heading">
          <p class="smx-eyebrow"><span>{playbook.eyebrow}</span><i aria-hidden="true"></i><span>THE WORKFLOW</span></p>
          <h2 id={`${playbook.id}-title`}>{playbook.headline}</h2>
          <p>{playbook.intro}</p>
        </div>

        <div class="smx-step-list">
          {playbook.steps.map((step, index) => (
              <article class:list={['smx-step', playbook.id === 'valorant-playbook' && index === 1 && 'smx-step--report']}>
              <div class="smx-step-copy">
                <div class="smx-step-index">0{index + 1}</div>
                <p class="smx-step-label">{step.label}</p>
                <h3>{step.title}</h3>
                <p class="smx-step-body">{step.body}</p>
                <div class="smx-step-tags">
                  {step.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
              <figure class="smx-step-shot">
                <button class={`smx-shot-frame smx-shot-frame--${step.fit ?? 'cover'}`} type="button" data-zoom={step.src} aria-label={`Enlarge: ${step.alt}`}>
                  <img src={step.src} alt={step.alt} loading="lazy" decoding="async" />
                  <span class="smx-zoom-hint" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
                    <span>Click to enlarge</span>
                  </span>
                </button>
                <figcaption><strong>{step.caption}</strong><span>Current app surface</span></figcaption>
              </figure>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <div class="smx-transition" aria-label="Snipemaxxer product principle">
    <div class="smx-shell">
      <span>Freshness is a feature</span>
      <strong>Every game gets the right read — never a fake one.</strong>
      <small>Fortnite / official replay · Valorant / read-only Riot</small>
    </div>
  </div>

  {product.mobileCompanion && (
    <div class="smx-companion-wrap">
      <SnipemaxxerCompanion
        installerUrl={product.mobileCompanion.installerUrl}
        mobileUrl={product.mobileCompanion.mobileUrl}
        accentHex={oxide}
      />
    </div>
  )}

  <section class="smx-boundaries" aria-labelledby="smx-boundaries-title">
    <div class="smx-shell">
      <div class="smx-section-heading">
        <p class="smx-eyebrow"><span>06 / Data boundaries</span><i aria-hidden="true"></i><span>Honest by design</span></p>
        <h2 id="smx-boundaries-title">Every panel tells you <em>where it came from.</em></h2>
        <p>Snipemaxxer is useful because it separates live signals, delayed evidence, and local tools. You always know what the app can prove right now.</p>
      </div>

      <div class="smx-boundary-grid">
        <article><span class="smx-state smx-state--live">Live</span><h3>Current signals</h3><p>Epic tournament standing and live Riot context when the correct client path is connected.</p></article>
        <article><span class="smx-state smx-state--delayed">Delayed</span><h3>Replay evidence</h3><p>Fortnite's official server replay normally lands around five minutes behind the live standing.</p></article>
        <article><span class="smx-state smx-state--local">Local / read-only</span><h3>Connected tools</h3><p>Valorant history needs a HenrikDev key. Live Riot panels need Riot Client or the one-time gaming-PC relay. Cached, offline, and unavailable fields stay labeled.</p></article>
      </div>

      <div class="smx-trust-line"><span>Safe by design</span><strong>No game-memory reading. No Riot password. No login automation. No session token in the renderer.</strong></div>
    </div>
  </section>

  <section id="smx-faq" class="smx-finish" aria-labelledby="smx-finish-title">
    <div class="smx-shell">
      <div class="smx-finish-grid">
        <div class="smx-cta-card">
          <p class="smx-eyebrow"><span>07 / Ready when you are</span><i aria-hidden="true"></i><span>Beta / Windows</span></p>
          <h2 id="smx-finish-title">Two games.<br /><em>One better read.</em></h2>
          <p>Choose the desk you actually play, then keep the signal and the evidence in one focused window.</p>
          <div class="smx-cta-meta"><span>Version {version}</span><span>Fortnite + Valorant</span></div>
          <div class="smx-cta-actions">
            <a class="smx-cta-primary" href={product.primaryCta.href} target={product.primaryCta.external ? '_blank' : undefined} rel={product.primaryCta.external ? 'noopener' : undefined}>
              {product.primaryCta.label}<span aria-hidden="true">↗</span>
            </a>
            {product.secondaryCta && (
              <a class="smx-cta-secondary" href={product.secondaryCta.href} target={product.secondaryCta.external ? '_blank' : undefined} rel={product.secondaryCta.external ? 'noopener' : undefined}>
                {product.secondaryCta.label}<span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        <div class="smx-faq-list">
          <p class="smx-faq-kicker">The questions that matter</p>
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}<span aria-hidden="true">+</span></summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<div class="smx-lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Enlarged app capture">
  <button class="smx-lightbox__close" type="button" aria-label="Close enlarged image">Close</button>
  <div class="smx-lightbox__stage">
    <img alt="" />
    <p>Click the image to zoom · press Escape to close</p>
  </div>
</div>

<script>
  (() => {
    if ((window as any).__fzLightbox || (window as any).__smxLightbox) return;
    (window as any).__smxLightbox = true;
    const lightbox = document.querySelector('.smx-lightbox') as HTMLElement | null;
    const image = lightbox?.querySelector('img') as HTMLImageElement | null;
    const closeButton = lightbox?.querySelector('.smx-lightbox__close') as HTMLButtonElement | null;
    if (!lightbox || !image || !closeButton) return;
    let returnTarget: HTMLElement | null = null;
    let previousOverflow = '';
    const close = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      image.classList.remove('is-zoomed');
      document.body.style.overflow = previousOverflow;
      returnTarget?.focus();
      returnTarget = null;
    };
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox || (event.target as HTMLElement).closest('.smx-lightbox__close')) close();
    });
    image.addEventListener('click', (event) => {
      event.stopPropagation();
      image.classList.toggle('is-zoomed');
    });
    closeButton.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && lightbox.classList.contains('is-open')) close();
    });
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest('[data-zoom]') as HTMLElement | null;
      if (!trigger) return;
      const src = trigger.getAttribute('data-zoom');
      if (!src) return;
      const sourceImage = trigger.querySelector('img') as HTMLImageElement | null;
      returnTarget = trigger;
      previousOverflow = document.body.style.overflow;
      image.src = src;
      image.alt = sourceImage?.alt ?? '';
