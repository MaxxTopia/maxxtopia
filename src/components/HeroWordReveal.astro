---
type Props = {
  /** Words to cycle through before locking. */
  rotation?: string[];
  /** Final word that locks into place with a flash + sound. */
  lockWord?: string;
  /** ms between word swaps during the rotation. */
  interval?: number;
};

const {
  rotation = ['peak', 'cook', 'lock in', 'elevate', 'prosper', 'arise'],
  lockWord = 'maxx',
  interval = 900,
} = Astro.props;

// Per-word visual treatment slug — drives the CSS class applied to the
// current word so each one gets its own unique effect while displayed.
// "arise" gets the Solo-Leveling shadow-rise treatment.
const slug = (w: string) => w.toLowerCase().replace(/[^a-z]/g, '-');

const allWords = [...rotation, lockWord];
const longest = allWords.reduce((a, b) => (b.length > a.length ? b : a), '');
---

<span
  class="hero-word"
  data-rotation={JSON.stringify(rotation)}
  data-lock={lockWord}
  data-interval={interval}
  aria-label={`go to ${lockWord}`}
>
  <!-- Width-locking ghost (visibility:hidden, position:absolute, takes up width but invisible) -->
  <span class="hero-word__measure" aria-hidden="true">{longest}</span>

  <!-- Live slot -->
  <span class="hero-word__slot">
    <span class={`hero-word__current is-word-${slug(rotation[0])}`} data-word={rotation[0]}>{rotation[0]}</span>
    <span class="hero-word__pulse" aria-hidden="true"></span>
    <!-- Solo-Leveling shadow particles — only become visible when "arise" is the
         active word (controlled in CSS via .is-word-arise on the current span). -->
    <span class="hero-word__sl-particles" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </span>
  </span>
</span>

<style>
  .hero-word {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
  }
  .hero-word__measure {
    visibility: hidden;
    position: absolute;
    pointer-events: none;
    user-select: none;
    /* This element only exists to lock the width to the longest word. */
  }
  .hero-word__slot {
    position: relative;
    display: inline-block;
  }
  .hero-word__current {
    display: inline-block;
    background: linear-gradient(120deg, #e25bff 0%, #c084fc 30%, #00d4ff 75%, #4c51f7 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-word-shimmer 6s ease-in-out infinite;
    transition: opacity 320ms cubic-bezier(0.5, 0, 0.5, 1),
                transform 320ms cubic-bezier(0.5, 0, 0.5, 1),
                filter 320ms ease;
  }
  .hero-word__current.is-leaving {
    opacity: 0;
    transform: translateY(-12%) skewY(-2deg);
    filter: blur(6px);
  }
  .hero-word__current.is-entering {
    opacity: 0;
    transform: translateY(20%) skewY(2deg);
    filter: blur(10px);
  }
  /* Lock state — when the final word lands */
  .hero-word__current.is-locked {
    animation: hero-word-shimmer 4s ease-in-out infinite, hero-word-lock 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow:
      0 0 24px rgba(226, 91, 255, 0.5),
      0 0 64px rgba(0, 212, 255, 0.3);
  }
  /* Chromatic aberration RGB-split flash on lock */
  .hero-word__current.is-flashing::before,
  .hero-word__current.is-flashing::after {
    content: attr(data-text);
    position: absolute;
    left: 0; top: 0;
    background: inherit;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
    animation: chromatic-flash 280ms ease-out forwards;
  }
  .hero-word__current.is-flashing::before {
    color: #ff3d8b;
    transform: translateX(-3px);
    mix-blend-mode: screen;
  }
  .hero-word__current.is-flashing::after {
    color: #00ffea;
    transform: translateX(3px);
    mix-blend-mode: screen;
  }
  @keyframes chromatic-flash {
    0% { opacity: 0.9; }
    100% { opacity: 0; transform: translateX(0); }
  }

  /* Radial pulse ring expanding from behind the word on lock */
  .hero-word__pulse {
    position: absolute;
    left: 50%; top: 50%;
    width: 12px; height: 12px;
    border-radius: 999px;
    border: 2px solid rgba(226, 91, 255, 0.7);
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    z-index: -1;
    opacity: 0;
  }
  .hero-word__pulse.is-firing {
    animation: hero-word-pulse 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-word-pulse {
    0%   { transform: translate(-50%, -50%) scale(0);  opacity: 1; border-color: rgba(226, 91, 255, 0.9); }
    60%  { transform: translate(-50%, -50%) scale(14); opacity: 0.5; border-color: rgba(0, 212, 255, 0.5); }
    100% { transform: translate(-50%, -50%) scale(22); opacity: 0; border-color: rgba(0, 212, 255, 0); }
  }

  @keyframes hero-word-lock {
    0% { transform: scale(0.92); }
    35% { transform: scale(1.06); }
    70% { transform: scale(0.99); }
    100% { transform: scale(1); }
  }
  @keyframes hero-word-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* ── Per-word effect treatments ───────────────────────────────────
     Each rotating word gets a unique visual signature while displayed.
     Transitions remain shared (leave/enter); only the IDLE state changes. */

  /* peak — sharp white edge highlight, mountain-top feel */
  .hero-word__current.is-word-peak {
    text-shadow:
      0 0 0 transparent,
      0 -2px 0 rgba(255, 255, 255, 0.45);
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.18));
  }

  /* cook — warm flicker, fire orange overlay */
  .hero-word__current.is-word-cook {
    background: linear-gradient(135deg, #ff9d3a 0%, #ff5722 35%, #ffa726 70%, #ffd54f 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-word-shimmer 1.4s ease-in-out infinite, cook-flicker 1.8s ease-in-out infinite;
    filter: drop-shadow(0 0 14px rgba(255, 87, 34, 0.55));
  }
  @keyframes cook-flicker {
    0%, 100% { opacity: 1; }
    47%      { opacity: 0.92; }
    50%      { opacity: 1; }
    53%      { opacity: 0.95; }
  }

  /* lock in — cyan laser focus, sharp horizontal underline glow */
  .hero-word__current.is-word-lock-in {
    background: linear-gradient(135deg, #00ffe0 0%, #00d4ff 50%, #00b3ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 4px 0 rgba(0, 212, 255, 0.35);
    filter: drop-shadow(0 0 18px rgba(0, 212, 255, 0.55));
  }

  /* elevate — vertical lift, upward motion shadow */
  .hero-word__current.is-word-elevate {
    background: linear-gradient(180deg, #ffffff 0%, #c7d2fe 65%, #818cf8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: elevate-lift 2.2s ease-in-out infinite;
    filter: drop-shadow(0 -4px 14px rgba(199, 210, 254, 0.5));
  }
  @keyframes elevate-lift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }

  /* prosper — gold shimmer, wealth coding */
  .hero-word__current.is-word-prosper {
    background: linear-gradient(120deg, #fff7c2 0%, #fbbf24 25%, #fde68a 50%, #f59e0b 75%, #fff7c2 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-word-shimmer 2.4s ease-in-out infinite;
    filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.6));
  }

  /* arise — Solo Leveling shadow-monarch effect.
     Deep purple/blue gradient, the word rises up through a shadow halo,
     particle dots float upward behind it. Inheritance check active. */
  .hero-word__current.is-word-arise {
    background: linear-gradient(180deg, #c4b5fd 0%, #7c3aed 35%, #4338ca 75%, #1e1b4b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: arise-rise 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow:
      0 0 24px rgba(139, 92, 246, 0.7),
      0 4px 0 rgba(76, 29, 149, 0.4),
      0 8px 28px rgba(76, 29, 149, 0.5);
    filter: drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.55));
  }
  @keyframes arise-rise {
    0%   { transform: translateY(18%); opacity: 0; filter: blur(8px) drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.55)); }
    60%  { transform: translateY(-2%); opacity: 1; filter: blur(0) drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.55)); }
    100% { transform: translateY(0);   opacity: 1; }
  }
  /* Solo-Leveling particle layer — only fires when "arise" is active. */
  .hero-word__sl-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .hero-word__current.is-word-arise ~ .hero-word__sl-particles {
    opacity: 1;
  }
  .hero-word__sl-particles span {
    position: absolute;
    bottom: -10%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: radial-gradient(circle, #c4b5fd 0%, #7c3aed 60%, transparent 80%);
    opacity: 0;
    box-shadow: 0 0 8px #7c3aed;
    animation: sl-rise 2.4s ease-out infinite;
  }
  .hero-word__sl-particles span:nth-child(1) { left: 8%;  animation-delay: 0.0s; }
  .hero-word__sl-particles span:nth-child(2) { left: 24%; animation-delay: 0.4s; }
  .hero-word__sl-particles span:nth-child(3) { left: 42%; animation-delay: 0.8s; width: 4px; height: 4px; }
  .hero-word__sl-particles span:nth-child(4) { left: 58%; animation-delay: 0.2s; width: 5px; height: 5px; }
  .hero-word__sl-particles span:nth-child(5) { left: 76%; animation-delay: 0.6s; }
  .hero-word__sl-particles span:nth-child(6) { left: 92%; animation-delay: 1.0s; width: 4px; height: 4px; }
  @keyframes sl-rise {
    0%   { transform: translateY(0)     scale(0.6); opacity: 0;    }
    20%  { opacity: 1; }
    80%  { opacity: 0.8; }
    100% { transform: translateY(-180%) scale(0.4); opacity: 0;    }
  }

  /* maxx (lock word) — keep the existing chromatic flash + ring pulse;
     it's the standout because it's the brand. No per-word override. */

  @media (prefers-reduced-motion: reduce) {
    .hero-word__current,
    .hero-word__current.is-leaving,
    .hero-word__current.is-entering,
    .hero-word__current.is-locked {
      animation: none !important;
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
    .hero-word__pulse,
    .hero-word__sl-particles { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.hero-word');
    if (!root) return;

    const rotation = JSON.parse(root.getAttribute('data-rotation') || '[]');
    const lockWord = root.getAttribute('data-lock') || 'maxx';
    const interval = parseInt(root.getAttribute('data-interval') || '900', 10);
    const current = root.querySelector('.hero-word__current');
    const pulse = root.querySelector('.hero-word__pulse');
    if (!current || !pulse) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STORAGE_KEY = 'maxxtopia_hero_played';
    const sessionPlayed = sessionStorage.getItem(STORAGE_KEY) === '1';

    // ── Web Audio synth tone on lock ────────────────────────────────
    let audioCtx = null;
    let userInteracted = false;
    const armAudio = () => { userInteracted = true; };
    window.addEventListener('pointerdown', armAudio, { once: true, passive: true });
    window.addEventListener('keydown', armAudio, { once: true });
    window.addEventListener('touchstart', armAudio, { once: true, passive: true });

    const playLockTone = () => {
      if (reduced) return;
      if (!userInteracted) return;
      if (sessionPlayed) return;
      try {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        if (!audioCtx) audioCtx = new Ctx();
        const t0 = audioCtx.currentTime;

        // Master bus
        const master = audioCtx.createGain();
        master.gain.value = 0.55;
        master.connect(audioCtx.destination);

        // Apex/Halo-style achievement chime — 3-note ascending arpeggio
        // E5 → A5 → E6: perfect-4th then octave, the "you earned it" shape.
        // Each note is a detuned sine pair for a clean bell timbre with
        // micro-beating shimmer; attacks snap, tails ring out for ~0.5s.
        const notes = [
          { freq: 659.25,  t: 0.00, dur: 0.55, peak: 0.20 }, // E5
          { freq: 880.00,  t: 0.07, dur: 0.60, peak: 0.22 }, // A5
          { freq: 1318.51, t: 0.14, dur: 0.70, peak: 0.26 }, // E6
        ];
        notes.forEach(({ freq, t, dur, peak }) => {
          const start = t0 + t;
          const oscA = audioCtx.createOscillator();
          const oscB = audioCtx.createOscillator();
          oscA.type = 'sine';
          oscB.type = 'sine';
          oscA.frequency.value = freq;
          oscB.frequency.value = freq * 1.005; // 5-cent detune for shimmer
          const g = audioCtx.createGain();
          g.gain.setValueAtTime(0.0001, start);
          g.gain.exponentialRampToValueAtTime(peak, start + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          oscA.connect(g);
          oscB.connect(g);
          g.connect(master);
          oscA.start(start);
          oscB.start(start);
          oscA.stop(start + dur + 0.05);
          oscB.stop(start + dur + 0.05);
        });

        // High-octave sparkle layer — adds the "earned a tier" brightness
        const sparkle = audioCtx.createOscillator();
        sparkle.type = 'sine';
        sparkle.frequency.value = 2637.02; // E7
        const sg = audioCtx.createGain();
        sg.gain.setValueAtTime(0.0001, t0 + 0.10);
        sg.gain.exponentialRampToValueAtTime(0.07, t0 + 0.14);
        sg.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.62);
        sparkle.connect(sg).connect(master);
        sparkle.start(t0 + 0.10);
        sparkle.stop(t0 + 0.70);

        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch (_) { /* no-op */ }
    };

    // Per-word slug helper — strips a word down to "is-word-<slug>" class.
    const slugify = (s) => s.toLowerCase().replace(/[^a-z]/g, '-');
    const wordEffectClass = (s) => 'is-word-' + slugify(s);

    // ── Word swap ────────────────────────────────────────────────────
    const swap = (next, opts = {}) => new Promise((resolve) => {
      current.classList.add('is-leaving');
      setTimeout(() => {
        // Strip any previous per-word effect class so a fresh one applies.
        Array.from(current.classList)
          .filter((c) => c.startsWith('is-word-'))
          .forEach((c) => current.classList.remove(c));
        current.textContent = next;
        current.setAttribute('data-text', next);
        current.setAttribute('data-word', next);
        current.classList.add(wordEffectClass(next));
        current.classList.remove('is-leaving');
        current.classList.add('is-entering');
        // Force reflow
        // eslint-disable-next-line no-unused-expressions
        current.offsetWidth;
        current.classList.remove('is-entering');
        if (opts.lock) {
          current.classList.add('is-locked', 'is-flashing');
          pulse.classList.add('is-firing');
          playLockTone();
          setTimeout(() => current.classList.remove('is-flashing'), 320);
        }
        resolve();
      }, 320);
    });

    // ── Sequence ─────────────────────────────────────────────────────
    let i = 0;
    const tick = async () => {
      i++;
      if (i < rotation.length) {
        await swap(rotation[i]);
        setTimeout(tick, interval);
      } else {
        // Final lock on the maxx word
        await swap(lockWord, { lock: true });
      }
    };

    if (reduced) {
      // Reduced motion: jump straight to the lock word, no animation
      current.textContent = lockWord;
      current.setAttribute('data-text', lockWord);
      current.classList.add('is-locked');
      return;
    }

    setTimeout(tick, interval);
  })();
</script>
