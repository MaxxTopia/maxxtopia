---
type Props = {
  /** Words to cycle through before locking. */
  rotation?: string[];
  /** Final word that locks into place with a flash + sound. */
  lockWord?: string;
  /** ms between word swaps during the rotation. */
  interval?: number;
};

const {
  rotation = ['peak', 'cook', 'lock in', 'elevate', 'prosper', 'arise'],
  lockWord = 'maxx',
  interval = 900,
} = Astro.props;

// Per-word visual treatment slug — drives the CSS class applied to the
// current word so each one gets its own unique effect while displayed.
// "arise" gets the Solo-Leveling shadow-rise treatment.
const slug = (w: string) => w.toLowerCase().replace(/[^a-z]/g, '-');

const allWords = [...rotation, lockWord];
const longest = allWords.reduce((a, b) => (b.length > a.length ? b : a), '');
---

<span
  class="hero-word"
  data-rotation={JSON.stringify(rotation)}
  data-lock={lockWord}
  data-interval={interval}
  aria-label={`go to ${lockWord}`}
>
  <!-- Width-locking ghost (visibility:hidden, position:absolute, takes up width but invisible) -->
  <span class="hero-word__measure" aria-hidden="true">{longest}</span>

  <!-- Live slot -->
  <span class="hero-word__slot">
    <span class={`hero-word__current is-word-${slug(rotation[0])}`} data-word={rotation[0]}>{rotation[0]}</span>
    <span class="hero-word__pulse" aria-hidden="true"></span>
    <!-- Solo-Leveling shadow particles — only become visible when "arise" is the
         active word (controlled in CSS via .is-word-arise on the current span). -->
    <span class="hero-word__sl-particles" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
    </span>
    <!-- Solo-Leveling tendrils — two upward streaks that grow from below. -->
    <span class="hero-word__sl-tendrils" aria-hidden="true">
      <span></span><span></span>
    </span>
    <!-- Solo-Leveling aura ring — expanding shadow halo at the moment of rise. -->
    <span class="hero-word__sl-aura" aria-hidden="true"></span>
    <!-- Black Clover "Luck" lightning — bolts crackling around the lock word.
         Fires when "maxx" lands; ambient flicker between strikes. -->
    <span class="hero-word__bolts" aria-hidden="true">
      <svg viewBox="0 0 24 100" preserveAspectRatio="none"><path d="M 14 0 L 7 36 L 16 40 L 4 100" /></svg>
      <svg viewBox="0 0 24 100" preserveAspectRatio="none"><path d="M 10 0 L 16 30 L 6 34 L 18 100" /></svg>
      <svg viewBox="0 0 24 100" preserveAspectRatio="none"><path d="M 12 0 L 4 28 L 14 32 L 6 100" /></svg>
      <svg viewBox="0 0 24 100" preserveAspectRatio="none"><path d="M 8  0 L 14 38 L 4  42 L 16 100" /></svg>
      <svg viewBox="0 0 24 100" preserveAspectRatio="none"><path d="M 14 0 L 8  44 L 18 48 L 10 100" /></svg>
    </span>
  </span>
</span>

<style>
  .hero-word {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
  }
  .hero-word__measure {
    visibility: hidden;
    position: absolute;
    pointer-events: none;
    user-select: none;
    /* This element only exists to lock the width to the longest word. */
  }
  .hero-word__slot {
    position: relative;
    display: inline-block;
  }
  .hero-word__current {
    display: inline-block;
    background: linear-gradient(120deg, #e25bff 0%, #c084fc 30%, #00d4ff 75%, #4c51f7 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-word-shimmer 6s ease-in-out infinite;
    transition: opacity 320ms cubic-bezier(0.5, 0, 0.5, 1),
                transform 320ms cubic-bezier(0.5, 0, 0.5, 1),
                filter 320ms ease;
  }
  .hero-word__current.is-leaving {
    opacity: 0;
    transform: translateY(-12%) skewY(-2deg);
    filter: blur(6px);
  }
  .hero-word__current.is-entering {
    opacity: 0;
    transform: translateY(20%) skewY(2deg);
    filter: blur(10px);
  }
  /* Lock state — when the final word lands */
  .hero-word__current.is-locked {
    animation: hero-word-shimmer 4s ease-in-out infinite, hero-word-lock 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow:
      0 0 24px rgba(226, 91, 255, 0.5),
      0 0 64px rgba(0, 212, 255, 0.3);
  }
  /* Chromatic aberration RGB-split flash on lock */
  .hero-word__current.is-flashing::before,
  .hero-word__current.is-flashing::after {
    content: attr(data-text);
    position: absolute;
    left: 0; top: 0;
    background: inherit;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
    animation: chromatic-flash 280ms ease-out forwards;
  }
  .hero-word__current.is-flashing::before {
    color: #ff3d8b;
    transform: translateX(-3px);
    mix-blend-mode: screen;
  }
  .hero-word__current.is-flashing::after {
    color: #00ffea;
    transform: translateX(3px);
    mix-blend-mode: screen;
  }
  @keyframes chromatic-flash {
    0% { opacity: 0.9; }
    100% { opacity: 0; transform: translateX(0); }
  }

  /* Radial pulse ring expanding from behind the word on lock */
  .hero-word__pulse {
    position: absolute;
    left: 50%; top: 50%;
    width: 12px; height: 12px;
    border-radius: 999px;
    border: 2px solid rgba(226, 91, 255, 0.7);
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    z-index: -1;
    opacity: 0;
  }
  .hero-word__pulse.is-firing {
    animation: hero-word-pulse 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes hero-word-pulse {
    0%   { transform: translate(-50%, -50%) scale(0);  opacity: 1; border-color: rgba(226, 91, 255, 0.9); }
    60%  { transform: translate(-50%, -50%) scale(14); opacity: 0.5; border-color: rgba(0, 212, 255, 0.5); }
    100% { transform: translate(-50%, -50%) scale(22); opacity: 0; border-color: rgba(0, 212, 255, 0); }
  }

  @keyframes hero-word-lock {
    0% { transform: scale(0.92); }
    35% { transform: scale(1.06); }
    70% { transform: scale(0.99); }
    100% { transform: scale(1); }
  }
  @keyframes hero-word-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  /* ── Per-word effect treatments ───────────────────────────────────
     Each rotating word gets a unique visual signature while displayed.
     Transitions remain shared (leave/enter); only the IDLE state changes. */

  /* peak — sharp white edge highlight, mountain-top feel */
  .hero-word__current.is-word-peak {
    text-shadow:
      0 0 0 transparent,
      0 -2px 0 rgba(255, 255, 255, 0.45);
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.18));
  }

  /* cook — magenta-cyan heat-trail. Site palette, not orange flame.
     Motion-blur ghost trail behind the word reads as "in motion / hot." */
  .hero-word__current.is-word-cook {
    background: linear-gradient(120deg, #ff5dff 0%, #e25bff 28%, #c084fc 52%, #00d4ff 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: hero-word-shimmer 1.1s ease-in-out infinite, cook-pulse 0.9s ease-in-out infinite;
    filter: drop-shadow(0 0 16px rgba(226, 91, 255, 0.55))
            drop-shadow(0 0 28px rgba(0, 212, 255, 0.35));
    text-shadow:
      -2px 0 0 rgba(226, 91, 255, 0.45),
       2px 0 0 rgba(0, 212, 255, 0.45);
  }
  @keyframes cook-pulse {
    0%, 100% { transform: translateX(0)    scaleX(1);    filter: brightness(1); }
    50%      { transform: translateX(1px)  scaleX(1.015); filter: brightness(1.18); }
  }

  /* lock in — cyan laser focus, sharp horizontal underline glow */
  .hero-word__current.is-word-lock-in {
    background: linear-gradient(135deg, #00ffe0 0%, #00d4ff 50%, #00b3ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 4px 0 rgba(0, 212, 255, 0.35);
    filter: drop-shadow(0 0 18px rgba(0, 212, 255, 0.55));
  }

  /* elevate — vertical lift, upward motion shadow */
  .hero-word__current.is-word-elevate {
    background: linear-gradient(180deg, #ffffff 0%, #c7d2fe 65%, #818cf8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: elevate-lift 2.2s ease-in-out infinite;
    filter: drop-shadow(0 -4px 14px rgba(199, 210, 254, 0.5));
  }
  @keyframes elevate-lift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }

  /* prosper — iridescent suite-shimmer (cyan→magenta→blurple oil-slick).
     The maxxer brand-shimmer used everywhere else, dialed up. Reads as
     "iridescent wealth" without the corny gold-foil cliché. */
  .hero-word__current.is-word-prosper {
    background: linear-gradient(
      120deg,
      #00d4ff 0%,
      #c084fc 22%,
      #e25bff 44%,
      #ff86ff 60%,
      #4c51f7 80%,
      #00d4ff 100%
    );
    background-size: 280% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: prosper-shimmer 3s linear infinite, prosper-bloom 2.2s ease-in-out infinite;
    filter:
      drop-shadow(0 0 14px rgba(226, 91, 255, 0.55))
      drop-shadow(0 0 28px rgba(0, 212, 255, 0.35));
  }
  @keyframes prosper-shimmer {
    0%   { background-position: 0% 50%; }
    100% { background-position: 280% 50%; }
  }
  @keyframes prosper-bloom {
    0%, 100% { transform: scale(1);    filter: drop-shadow(0 0 14px rgba(226, 91, 255, 0.55)) drop-shadow(0 0 28px rgba(0, 212, 255, 0.35)); }
    50%      { transform: scale(1.02); filter: drop-shadow(0 0 22px rgba(226, 91, 255, 0.75)) drop-shadow(0 0 44px rgba(0, 212, 255, 0.55)); }
  }

  /* arise — Solo-Leveling shadow-monarch effect, dialed up.
     Deeper black-violet base with magenta-plasma plasma rim. Longer rise.
     Twelve particles in three sizes. Two upward shadow tendrils. An
     expanding aura ring fires once at the moment of arrival. */
  .hero-word__current.is-word-arise {
    background: linear-gradient(180deg, #c4b5fd 0%, #8b5cf6 25%, #4c1d95 60%, #0a0612 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: arise-rise 1.7s cubic-bezier(0.16, 1, 0.3, 1);
    text-shadow:
      0 0 28px rgba(139, 92, 246, 0.85),
      0 0 56px rgba(124, 58, 237, 0.65),
      0 4px 0 rgba(46, 16, 101, 0.55),
      0 12px 36px rgba(76, 29, 149, 0.6);
    filter:
      drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.6))
      drop-shadow(0 0 40px rgba(255, 93, 255, 0.35));
  }
  @keyframes arise-rise {
    0%   { transform: translateY(28%) scale(0.92); opacity: 0; filter: blur(14px) drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.6)) drop-shadow(0 0 40px rgba(255, 93, 255, 0.35)); }
    35%  { transform: translateY(8%)  scale(0.97); opacity: 1; filter: blur(4px)  drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.6)) drop-shadow(0 0 40px rgba(255, 93, 255, 0.35)); }
    60%  { transform: translateY(-3%) scale(1.04); opacity: 1; filter: blur(0)    drop-shadow(0 -8px 22px rgba(139, 92, 246, 0.6)) drop-shadow(0 0 40px rgba(255, 93, 255, 0.35)); }
    78%  { transform: translateY(-1%) scale(1);    opacity: 1; }
    100% { transform: translateY(0)   scale(1);    opacity: 1; }
  }

  /* Solo-Leveling particle layer — twelve particles, three sizes. */
  .hero-word__sl-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
    z-index: -1;
  }
  .hero-word__current.is-word-arise ~ .hero-word__sl-particles { opacity: 1; }
  .hero-word__sl-particles span {
    position: absolute;
    bottom: -16%;
    border-radius: 999px;
    background: radial-gradient(circle, #ddd6fe 0%, #8b5cf6 55%, #4c1d95 85%, transparent 100%);
    opacity: 0;
    box-shadow: 0 0 12px #8b5cf6, 0 0 24px rgba(255, 93, 255, 0.4);
    animation: sl-rise 2.6s ease-out infinite;
  }
  /* Big particles */
  .hero-word__sl-particles span:nth-child(1)  { left: 6%;  width: 9px; height: 9px; animation-delay: 0.0s; }
  .hero-word__sl-particles span:nth-child(2)  { left: 24%; width: 8px; height: 8px; animation-delay: 0.5s; }
  .hero-word__sl-particles span:nth-child(3)  { left: 78%; width: 9px; height: 9px; animation-delay: 0.3s; }
  /* Medium */
  .hero-word__sl-particles span:nth-child(4)  { left: 14%; width: 5px; height: 5px; animation-delay: 0.8s; }
  .hero-word__sl-particles span:nth-child(5)  { left: 38%; width: 6px; height: 6px; animation-delay: 0.2s; }
  .hero-word__sl-particles span:nth-child(6)  { left: 62%; width: 5px; height: 5px; animation-delay: 1.1s; }
  .hero-word__sl-particles span:nth-child(7)  { left: 90%; width: 6px; height: 6px; animation-delay: 0.6s; }
  /* Sparkles */
  .hero-word__sl-particles span:nth-child(8)  { left: 18%; width: 3px; height: 3px; animation-delay: 1.4s; animation-duration: 2s; }
  .hero-word__sl-particles span:nth-child(9)  { left: 46%; width: 3px; height: 3px; animation-delay: 0.9s; animation-duration: 2.1s; }
  .hero-word__sl-particles span:nth-child(10) { left: 54%; width: 4px; height: 4px; animation-delay: 1.7s; animation-duration: 2.3s; }
  .hero-word__sl-particles span:nth-child(11) { left: 70%; width: 3px; height: 3px; animation-delay: 0.4s; animation-duration: 1.9s; }
  .hero-word__sl-particles span:nth-child(12) { left: 84%; width: 4px; height: 4px; animation-delay: 1.2s; animation-duration: 2.4s; }

  @keyframes sl-rise {
    0%   { transform: translateY(0)     scale(0.4) translateX(0);    opacity: 0;    }
    12%  { transform: translateY(-30%)  scale(1)   translateX(-2px); opacity: 1;    }
    50%  { transform: translateY(-110%) scale(0.85) translateX(2px); opacity: 0.85; }
    80%  { transform: translateY(-180%) scale(0.5) translateX(-3px); opacity: 0.4;  }
    100% { transform: translateY(-230%) scale(0.3) translateX(0);    opacity: 0;    }
  }

  /* Two upward tendrils — thin lines that grow from below the word.
     Read as shadow-energy spilling up from the ground at arrival. */
  .hero-word__sl-tendrils {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
    z-index: -1;
  }
  .hero-word__current.is-word-arise ~ .hero-word__sl-tendrils { opacity: 1; }
  .hero-word__sl-tendrils span {
    position: absolute;
    bottom: -10%;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent 0%, #c4b5fd 30%, #8b5cf6 70%, #4c1d95 100%);
    box-shadow: 0 0 8px #8b5cf6, 0 0 18px rgba(196, 181, 253, 0.4);
    animation: sl-tendril 1.8s ease-out infinite;
  }
  .hero-word__sl-tendrils span:nth-child(1) { left: 28%; animation-delay: 0.1s; }
  .hero-word__sl-tendrils span:nth-child(2) { left: 72%; animation-delay: 0.5s; }
  @keyframes sl-tendril {
    0%   { height: 0;    opacity: 0;    transform: translateY(0); }
    20%  { opacity: 1; }
    65%  { height: 110%; opacity: 0.85; transform: translateY(-20%); }
    100% { height: 130%; opacity: 0;    transform: translateY(-50%); }
  }

  /* Aura ring — single expanding shadow halo at the moment of arrival. */
  .hero-word__sl-aura {
    position: absolute;
    left: 50%; top: 50%;
    width: 16px; height: 16px;
    border-radius: 999px;
    border: 2px solid rgba(139, 92, 246, 0.85);
    box-shadow: 0 0 24px rgba(139, 92, 246, 0.7), inset 0 0 12px rgba(255, 93, 255, 0.4);
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    opacity: 0;
    z-index: -1;
  }
  .hero-word__current.is-word-arise ~ .hero-word__sl-aura {
    animation: sl-aura 1.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes sl-aura {
    0%   { transform: translate(-50%, -50%) scale(0);  opacity: 0;    border-color: rgba(255, 93, 255, 0.95); }
    20%  { transform: translate(-50%, -50%) scale(2);  opacity: 1;    border-color: rgba(139, 92, 246, 0.85); }
    60%  { transform: translate(-50%, -50%) scale(14); opacity: 0.5;  border-color: rgba(76, 29, 149, 0.6); }
    100% { transform: translate(-50%, -50%) scale(22); opacity: 0;    border-color: rgba(76, 29, 149, 0); }
  }

  /* maxx (lock word) — Black Clover "Luck" lightning treatment.
     Adds an electric-mint/cyan glow on top of the chromatic flash + ring pulse.
     Bolts crackle in once on lock, then ambient-flicker between strikes. */
  .hero-word__current.is-word-maxx- {
    /* the slug for "maxx." -> "maxx-" (period stripped); both forms covered */
  }
  .hero-word__current.is-word-maxx,
  .hero-word__current.is-word-maxx- {
    text-shadow:
      0 0 18px rgba(0, 255, 163, 0.7),
      0 0 44px rgba(0, 212, 255, 0.45),
      0 0 80px rgba(226, 91, 255, 0.25);
    filter:
      drop-shadow(0 0 14px rgba(0, 255, 163, 0.55))
      drop-shadow(0 0 28px rgba(0, 212, 255, 0.35));
  }

  /* Bolt layer — five jagged SVG strikes around the lock word. */
  .hero-word__bolts {
    position: absolute;
    inset: -30% -10%;
    pointer-events: none;
    opacity: 0;
    z-index: 0;
    transition: opacity 180ms ease;
  }
  .hero-word__current.is-word-maxx ~ .hero-word__bolts,
  .hero-word__current.is-word-maxx- ~ .hero-word__bolts {
    opacity: 1;
  }
  .hero-word__bolts svg {
    position: absolute;
    width: 6%;
    height: 100%;
    overflow: visible;
    opacity: 0;
    mix-blend-mode: screen;
    filter:
      drop-shadow(0 0 6px rgba(0, 255, 163, 0.95))
      drop-shadow(0 0 14px rgba(0, 212, 255, 0.75))
      drop-shadow(0 0 28px rgba(255, 255, 255, 0.4));
  }
  .hero-word__bolts svg path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: miter;
  }
  /* Five bolts staggered around the word — different x-positions, angles, timings.
     --rot is the per-bolt rotation; used in both the static transform and the
     animated keyframes so per-bolt angles survive across animations. */
  .hero-word__bolts svg:nth-child(1) { left:  4%; --rot: -12deg; }
  .hero-word__bolts svg:nth-child(2) { left: 24%; --rot:  18deg; }
  .hero-word__bolts svg:nth-child(3) { left: 50%; --rot: -22deg; }
  .hero-word__bolts svg:nth-child(4) { left: 70%; --rot:  10deg; }
  .hero-word__bolts svg:nth-child(5) { left: 88%; --rot: -8deg;  }
  .hero-word__bolts svg { transform: rotate(var(--rot, 0deg)); }

  /* On lock: opening barrage (5 strikes), then ambient flicker loop. */
  .hero-word__current.is-word-maxx ~ .hero-word__bolts svg,
  .hero-word__current.is-word-maxx- ~ .hero-word__bolts svg {
    animation: bolt-strike 240ms ease-out 1 forwards, bolt-flicker 4.4s ease-in-out 0.7s infinite;
  }
  .hero-word__bolts svg:nth-child(1) { animation-delay: 0.00s, 0.7s; }
  .hero-word__bolts svg:nth-child(2) { animation-delay: 0.07s, 1.5s; }
  .hero-word__bolts svg:nth-child(3) { animation-delay: 0.14s, 2.3s; }
  .hero-word__bolts svg:nth-child(4) { animation-delay: 0.21s, 3.1s; }
  .hero-word__bolts svg:nth-child(5) { animation-delay: 0.28s, 3.9s; }

  @keyframes bolt-strike {
    0%   { opacity: 0;   transform: rotate(var(--rot, 0deg)) scaleY(0.7); }
    18%  { opacity: 1; }
    35%  { opacity: 0.9; transform: rotate(var(--rot, 0deg)) scaleY(1.04); }
    100% { opacity: 0;   transform: rotate(var(--rot, 0deg)) scaleY(1); }
  }
  @keyframes bolt-flicker {
    0%, 88%, 100% { opacity: 0; }
    90%           { opacity: 0.95; }
    91%           { opacity: 0.2; }
    92%           { opacity: 0.85; }
    94%           { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word__current,
    .hero-word__current.is-leaving,
    .hero-word__current.is-entering,
    .hero-word__current.is-locked {
      animation: none !important;
      transform: none !important;
      filter: none !important;
      opacity: 1 !important;
    }
    .hero-word__pulse,
    .hero-word__sl-particles,
    .hero-word__bolts { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.hero-word');
    if (!root) return;

    const rotation = JSON.parse(root.getAttribute('data-rotation') || '[]');
    const lockWord = root.getAttribute('data-lock') || 'maxx';
    const interval = parseInt(root.getAttribute('data-interval') || '900', 10);
    const current = root.querySelector('.hero-word__current');
    const pulse = root.querySelector('.hero-word__pulse');
    if (!current || !pulse) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STORAGE_KEY = 'maxxtopia_hero_played';
    const sessionPlayed = sessionStorage.getItem(STORAGE_KEY) === '1';

    // ── Web Audio synth tone on lock ────────────────────────────────
    let audioCtx = null;
    let userInteracted = false;
    const armAudio = () => { userInteracted = true; };
    window.addEventListener('pointerdown', armAudio, { once: true, passive: true });
    window.addEventListener('keydown', armAudio, { once: true });
    window.addEventListener('touchstart', armAudio, { once: true, passive: true });

    const playLockTone = () => {
      if (reduced) return;
      if (!userInteracted) return;
      if (sessionPlayed) return;
      try {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return;
        if (!audioCtx) audioCtx = new Ctx();
        const t0 = audioCtx.currentTime;

        // Master bus
        const master = audioCtx.createGain();
        master.gain.value = 0.55;
        master.connect(audioCtx.destination);

        // Apex/Halo-style achievement chime — 3-note ascending arpeggio
        // E5 → A5 → E6: perfect-4th then octave, the "you earned it" shape.
        // Each note is a detuned sine pair for a clean bell timbre with
        // micro-beating shimmer; attacks snap, tails ring out for ~0.5s.
        const notes = [
          { freq: 659.25,  t: 0.00, dur: 0.55, peak: 0.20 }, // E5
          { freq: 880.00,  t: 0.07, dur: 0.60, peak: 0.22 }, // A5
          { freq: 1318.51, t: 0.14, dur: 0.70, peak: 0.26 }, // E6
        ];
        notes.forEach(({ freq, t, dur, peak }) => {
          const start = t0 + t;
          const oscA = audioCtx.createOscillator();
          const oscB = audioCtx.createOscillator();
          oscA.type = 'sine';
          oscB.type = 'sine';
          oscA.frequency.value = freq;
          oscB.frequency.value = freq * 1.005; // 5-cent detune for shimmer
          const g = audioCtx.createGain();
          g.gain.setValueAtTime(0.0001, start);
          g.gain.exponentialRampToValueAtTime(peak, start + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          oscA.connect(g);
          oscB.connect(g);
          g.connect(master);
          oscA.start(start);
          oscB.start(start);
          oscA.stop(start + dur + 0.05);
          oscB.stop(start + dur + 0.05);
        });

        // High-octave sparkle layer — adds the "earned a tier" brightness
        const sparkle = audioCtx.createOscillator();
        sparkle.type = 'sine';
        sparkle.frequency.value = 2637.02; // E7
        const sg = audioCtx.createGain();
        sg.gain.setValueAtTime(0.0001, t0 + 0.10);
        sg.gain.exponentialRampToValueAtTime(0.07, t0 + 0.14);
        sg.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.62);
        sparkle.connect(sg).connect(master);
        sparkle.start(t0 + 0.10);
        sparkle.stop(t0 + 0.70);

        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch (_) { /* no-op */ }
    };

    // Per-word slug helper — strips a word down to "is-word-<slug>" class.
    const slugify = (s) => s.toLowerCase().replace(/[^a-z]/g, '-');
    const wordEffectClass = (s) => 'is-word-' + slugify(s);

    // ── Word swap ────────────────────────────────────────────────────
    const swap = (next, opts = {}) => new Promise((resolve) => {
      current.classList.add('is-leaving');
      setTimeout(() => {
        // Strip any previous per-word effect class so a fresh one applies.
        Array.from(current.classList)
          .filter((c) => c.startsWith('is-word-'))
          .forEach((c) => current.classList.remove(c));
        current.textContent = next;
        current.setAttribute('data-text', next);
        current.setAttribute('data-word', next);
        current.classList.add(wordEffectClass(next));
        current.classList.remove('is-leaving');
        current.classList.add('is-entering');
        // Force reflow
        // eslint-disable-next-line no-unused-expressions
        current.offsetWidth;
        current.classList.remove('is-entering');
        if (opts.lock) {
          current.classList.add('is-locked', 'is-flashing');
          pulse.classList.add('is-firing');
          playLockTone();
          setTimeout(() => current.classList.remove('is-flashing'), 320);
        }
        resolve();
      }, 320);
    });

    // ── Sequence ─────────────────────────────────────────────────────
    let i = 0;
    const tick = async () => {
      i++;
      if (i < rotation.length) {
        await swap(rotation[i]);
        setTimeout(tick, interval);
      } else {
        // Final lock on the maxx word
        await swap(lockWord, { lock: true });
      }
    };

    if (reduced) {
      // Reduced motion: jump straight to the lock word, no animation
      current.textContent = lockWord;
      current.setAttribute('data-text', lockWord);
      current.classList.add('is-locked');
      return;
    }

    setTimeout(tick, interval);
  })();
</script>
