  <script is:inline>
    (() => {
      const frame = document.getElementById('sc-frame');
      const btn = document.getElementById('sc-fs-btn');
      const label = document.getElementById('sc-fs-label');
      if (!frame || !btn || !label) return;

      const isFs = () => document.fullscreenElement || document.webkitFullscreenElement;

      // Fullscreen the iframe element itself — not the cabinet wrapper — so the
      // game fills the screen natively instead of rendering black.
      const enter = () => {
        if (frame.requestFullscreen) return frame.requestFullscreen();
        if (frame.webkitRequestFullscreen) return frame.webkitRequestFullscreen();
      };
      const exit = () => {
        if (document.exitFullscreen) return document.exitFullscreen();
        if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
      };

      btn.addEventListener('click', () => {
        try { isFs() ? exit() : enter(); } catch (e) {}
      });

      const sync = () => { label.textContent = isFs() ? 'Exit fullscreen' : 'Fullscreen'; };
      document.addEventListener('fullscreenchange', sync);
      document.addEventListener('webkitfullscreenchange', sync);
    })();
  </script>

  <!-- Cursor / focus recovery: the embedded game can leave the page feeling
       "stuck" — keyboard focus parked in the iframe, or (after fullscreen) the
       OS cursor auto-hidden. Reassert control whenever the pointer leaves the
       cabinet or fullscreen toggles, so the page cursor always comes back. -->
  <script is:inline>
    (() => {
      const cab = document.getElementById('sc-cabinet');
      const frame = document.getElementById('sc-frame');
      if (!cab) return;
      const reclaim = () => {
        try { document.documentElement.style.cursor = ''; document.body.style.cursor = ''; } catch (e) {}
        // Never yank focus out of the game while it's the fullscreen element —
        // you're playing it. Only reclaim focus when it's the boxed embed.
        const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
        try { if (frame && document.activeElement === frame && fsEl !== frame) { frame.blur(); window.focus(); } } catch (e) {}
      };
      cab.addEventListener('mouseleave', reclaim);
      cab.addEventListener('pointerleave', reclaim);
      document.addEventListener('fullscreenchange', reclaim);
      document.addEventListener('webkitfullscreenchange', reclaim);
      // Belt-and-suspenders: if the page cursor ever got hidden, the first real
      // pointer move over the page restores it.
      document.addEventListener('pointermove', () => {
        if (getComputedStyle(document.body).cursor === 'none') document.body.style.cursor = 'auto';
      }, { passive: true });
    })();
  </script>

  <!-- Prestige leaderboard "The Climb" — throne + tiers + your standing,
       polling the same Cloudflare worker the game submits to + local best. -->
  <script is:inline>
    (() => {
      const LB = 'https://spritecannon-lb.maxxtopia.workers.dev';
      const list = document.getElementById('sc-lb');
      const throneEl = document.getElementById('sc-throne');
      const ladderEl = document.getElementById('sc-ladder');
      const youEl = document.getElementById('sc-you');
      if (!list) return;

      // The prestige ladder — distance (m) -> named rank, escalating colour/flair.
      const TIERS = [
        { name: 'Recruit',     min: 0,     c: '#9a90b8' },
        { name: 'Amateur',     min: 2500,  c: '#4ade80' },
        { name: 'Veteran',     min: 5000,  c: '#00d4ff' },
        { name: 'Elite',       min: 9000,  c: '#4c51f7' },
        { name: 'Master',      min: 14000, c: '#e25bff' },
        { name: 'Legend',      min: 20000, c: '#ffb23e' },
        { name: 'Mythic',      min: 28000, c: '#b06bff' },
        { name: 'Champion',    min: 38000, c: '#ffd76a' },
        { name: 'Grandmaster', min: 50000, c: '#22e6ff' },
        { name: 'Ascendant',   min: 64000, c: '#7dffd0' },
        { name: 'Celestial',   min: 78000, c: '#ff5fc8' },
        { name: 'Godlike',     min: 95000, c: '#ff2d4f' },
      ];
      const tierOf = (d) => { let t = TIERS[0]; for (const x of TIERS) if (d >= x.min) t = x; return t; };
      const nextOf = (d) => TIERS.find((x) => x.min > d) || null;
      const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const fmt = (d) => Math.max(0, Math.round(+d || 0)).toLocaleString('en-US');
      const medal = ['\u{1F451}', '\u{1F948}', '\u{1F949}']; // crown(unused in rows), silver, bronze

      let myName = ''; try { myName = (localStorage.getItem('sm.spritecannon.name') || '').trim(); } catch (e) {}
      let myBest = 0; try { const s = JSON.parse(localStorage.getItem('sm.spritecannon') || '{}'); myBest = Math.max(0, +(s && s.best) || 0); } catch (e) {}
      const meLc = myName.toLowerCase();

      // tier ladder — built once
      if (ladderEl) ladderEl.innerHTML = TIERS.map((t) =>
        '<span class="sc-ladder__step" style="--sc:' + t.c + '"><span class="sc-ladder__dot"></span>' + t.name +
        (t.min > 0 ? ' <span class="sc-ladder__min">' + fmt(t.min) + '</span>' : '') + '</span>').join('');

      const msg = (t) => { list.innerHTML = '<li class="sc-lb-msg">' + esc(t) + '</li>'; };

      function renderThrone(top) {
        if (!throneEl) return;
        if (!top.length) {
          throneEl.className = 'sc-throne'; throneEl.style.setProperty('--tc', '#9a90b8');
          throneEl.innerHTML = '<div class="sc-throne__label">The throne is empty</div><div class="sc-throne__name">Be the first.</div><a class="sc-throne__cta" href="#play">Take the throne &#8594;</a>';
          return;
        }
        const e = top[0], t = tierOf(e.dist), you = meLc && (e.name || '').trim().toLowerCase() === meLc;
        throneEl.className = 'sc-throne'; throneEl.style.setProperty('--tc', t.c);
        throneEl.innerHTML =
          '<div class="sc-throne__crown">\u{1F451}</div>' +
          '<div class="sc-throne__label">' + (you ? 'You reign' : 'Reigning champion') + '</div>' +
          '<div class="sc-throne__name">' + esc(e.name || 'anon') + '</div>' +
          '<div class="sc-throne__meta"><span class="sc-throne__tier">' + t.name + '</span> &middot; <span class="sc-throne__dist">' + fmt(e.dist) + 'm</span></div>' +
          '<a class="sc-throne__cta" href="#play">' + (you ? 'Defend your throne' : 'Dethrone them') + ' &#8594;</a>';
      }

      function renderYou(top) {
        if (!youEl) return;
        if (!(myBest > 0)) {
          youEl.innerHTML = '<div class="sc-you" style="--sc:#00d4ff"><div class="sc-you__top"><span class="sc-you__id">Your standing</span></div><div class="sc-you__togo">No run yet — <a class="sc-you__cta" href="#play">set a score in the cabinet</a> and claim your rank.</div></div>';
          return;
        }
        const t = tierOf(myBest), nx = nextOf(myBest);
        let rank = 0; if (meLc) { const idx = top.findIndex((e) => (e.name || '').trim().toLowerCase() === meLc); if (idx >= 0) rank = idx + 1; }
        let bar, togo;
        if (nx) {
          const prog = Math.max(0, Math.min(1, (myBest - t.min) / (nx.min - t.min)));
          bar = '<div class="sc-you__bar"><span class="sc-you__fill" style="width:' + (prog * 100).toFixed(1) + '%"></span></div>';
          togo = '<div class="sc-you__togo"><b>' + fmt(nx.min - myBest) + 'm</b> to ' + nx.name + '</div>';
        } else {
          bar = '<div class="sc-you__bar"><span class="sc-you__fill" style="width:100%"></span></div>';
          togo = '<div class="sc-you__togo">Top tier reached — now take the throne.</div>';
        }
        youEl.innerHTML = '<div class="sc-you" style="--sc:' + t.c + ';--scn:' + (nx ? nx.c : t.c) + '">' +
          '<div class="sc-you__top"><span class="sc-you__id">You &middot; <span class="sc-you__tier">' + t.name + '</span>' + (rank ? ' &middot; #' + rank + ' worldwide' : '') + '</span>' +
          '<span class="sc-you__best">' + fmt(myBest) + '<span class="sc-lb-u">m</span></span></div>' + bar + togo + '</div>';
      }

      function renderRows(top) {
        const rest = top.slice(1, 10);
        if (!rest.length) { msg(top.length ? 'No challengers yet — the throne stands unchallenged.' : 'No scores yet — be the first to claim the top spot.'); return; }
        list.innerHTML = rest.map((e, i) => {
          const pos = i + 2, t = tierOf(e.dist), you = meLc && (e.name || '').trim().toLowerCase() === meLc;
          const rank = pos <= 3 ? '<span class="m">' + medal[pos - 1] + '</span>' : pos;
          return '<li class="sc-lb-row' + (you ? ' is-you' : '') + '" style="--rc:' + t.c + '">' +
            '<span class="sc-lb-rank">' + rank + '</span>' +
            '<span class="sc-lb-tier">' + t.name + '</span>' +
            '<span class="sc-lb-name">' + esc(e.name || 'anon') + (you ? '<span class="sc-lb-you">YOU</span>' : '') + '</span>' +
            '<span><span class="sc-lb-dist">' + fmt(e.dist) + '</span><span class="sc-lb-u">m</span></span>' +
            '</li>';
        }).join('');
      }

      const render = (top) => { top = top || []; renderThrone(top); renderYou(top); renderRows(top); };
      const load = () => {
        fetch(LB + '/top?scope=global', { cache: 'no-store' })
          .then((r) => r.json())
          .then((d) => render(d.top || []))
          .catch(() => { if (!list.querySelector('.sc-lb-row')) msg('Leaderboard offline — back shortly.'); });
      };
      load();
      setInterval(load, 30000);
    })();
  </script>
</Layout>
