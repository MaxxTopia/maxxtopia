---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';

// Bridge the player back into the suite — the game is the cheapest possible
// proof of the thing every maxxer tool claims: indie people who ship real things.
const apps = [
  { name: 'Optimizationmaxxing', slug: 'optimizationmaxxing', blurb: 'PC tuner · 100 audited tweaks' },
  { name: 'AdBlock-Maxxer', slug: 'extensionmaxxing', blurb: "the ad blocker they couldn't ban" },
  { name: 'Streammaxxing', slug: 'streammaxxing', blurb: 'instant local stream alerts' },
  { name: 'Discordmaxxer', slug: 'discordmaxxer', blurb: 'Discord at a third the RAM' },
];

const stats = [
  { value: '50+', label: 'Skins' },
  { value: '20+', label: 'Abilities' },
  { value: '30+', label: 'Worlds' },
  { value: '$0', label: 'Forever' },
];
---

<Layout
  title="Sprite Cannon — free browser game · Maxxtopia Arcade"
  description="Play Sprite Cannon free in your browser — no install, no signup. 50+ skins, 20+ abilities, 30+ hand-built worlds, and a global leaderboard. An original game built by Maxxtopia."
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <Aurora intensity="high" />
    <div class="absolute inset-0 bg-grid opacity-60"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-16 sm:pt-20 pb-10">
      <div class="reveal reveal-1 mb-7 inline-flex items-center gap-2 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] px-3.5 py-1.5">
        <span class="flex h-2 w-2 rounded-full bg-[var(--color-magenta)]" style="box-shadow: 0 0 12px var(--color-magenta); animation: pulse 2s ease-in-out infinite"></span>
        <span class="font-mono text-[12.5px] text-[var(--color-muted)]">Maxxtopia Arcade · free · no signup</span>
      </div>

      <h1 class="reveal reveal-2 text-[46px] sm:text-[76px] md:text-[92px] font-semibold tracking-[-0.04em] leading-[0.95]">
        <span class="gradient-text">Sprite Cannon</span>
      </h1>

      <p class="reveal reveal-3 mt-6 max-w-xl text-[18px] sm:text-[21px] leading-[1.4] text-[var(--color-text-mid)]">
        Launch the cat. Fly forever. 50+ skins, 20+ abilities, 30+ hand-built worlds — running in the tab you already have open. No install. No account. <span class="font-semibold text-[var(--color-text)]">Just a high score to beat.</span>
      </p>

      <div class="reveal reveal-4 mt-8 flex flex-wrap items-center gap-3">
        <a href="#play" class="btn-primary">&#9654; Play now</a>
        <a href="/play/spritecannon/" target="_blank" rel="noopener" class="btn-secondary">Open fullscreen &#8599;</a>
      </div>

      <div class="reveal reveal-5 mt-14 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] max-w-3xl">
        {stats.map((s) => (
          <div class="bg-[var(--color-bg-card)] px-5 py-6">
            <p class="font-display text-[44px] sm:text-[52px] gradient-suite leading-none">{s.value}</p>
            <p class="mt-2 text-[11px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE CABINET: instant play, embedded -->
  <section id="play" class="relative scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 pb-16">
      <div class="reveal-on-scroll relative overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] shadow-[0_24px_70px_-24px_rgba(226,91,255,0.32)]">
        <iframe
          src="/play/spritecannon/"
          title="Sprite Cannon — play"
          class="block w-full h-[62vh] min-h-[440px] max-h-[780px] border-0"
          loading="lazy"
          allow="fullscreen; autoplay"
        ></iframe>
      </div>
      <p class="mt-3 text-center text-[13px] text-[var(--color-subtle)]">
        Tip: <a href="/play/spritecannon/" target="_blank" rel="noopener" class="text-[var(--color-cyan)] hover:underline">open fullscreen &#8599;</a> for the best run · also playable over any Twitch stream with <a href="/extensionmaxxing" class="text-[var(--color-cyan)] hover:underline">AdBlock-Maxxer</a>.
      </p>
    </div>
  </section>

  <!-- BRIDGE: funnel the player into the suite + Discord -->
  <section class="relative border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 sm:py-20">
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-cyan)]">&#9670; Made by Maxxtopia</p>
      <h2 class="mt-3 text-[30px] sm:text-[46px] font-semibold tracking-[-0.025em] leading-[1.04]">
        <span class="gradient-text">Built by the people</span> <span class="serif-accent gradient-suite">who build your tools.</span>
      </h2>
      <p class="mt-4 max-w-2xl text-[15.5px] leading-relaxed text-[var(--color-text-mid)]">
        Same hands as the 3.6 MB PC tuner and the ad blocker they couldn't ban. We just wanted to see if we could make a browser game worth your lunch break — turns out we could.
      </p>

      <div class="mt-9 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {apps.map((a) => (
          <a href={`/${a.slug}`} class="group bg-[var(--color-bg-card)] p-5 transition-colors hover:bg-[var(--color-bg-card-hover)]">
            <p class="font-semibold tracking-tight transition-colors group-hover:text-[var(--color-cyan)]">{a.name}</p>
            <p class="mt-1 text-[13px] text-[var(--color-muted)]">{a.blurb}</p>
          </a>
        ))}
      </div>

      <div class="mt-9 rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg-card)] p-6 sm:p-7">
        <p class="text-[15.5px] text-[var(--color-text-mid)] leading-relaxed">
          <span class="font-semibold text-[var(--color-text)]">A global leaderboard, coin codes, and everyone else chasing the top spot</span> — all in the Discord. Drop your high score, grab a code, see what's shipping next.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/#apps" class="btn-primary">See the full suite &#8594;</a>
          <a href="https://discord.gg/S78eecbWdx" target="_blank" rel="noopener" class="btn-secondary">Join the Discord</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
