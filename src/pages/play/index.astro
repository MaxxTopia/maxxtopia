---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';
import CountUp from '../../components/CountUp.astro';

// ── Sibling apps — funnel the player back into the suite. The game is the
// cheapest possible proof of the thing every maxxer tool claims: indie people
// who ship real, fast, free things.
const apps = [
  { name: 'Optimizationmaxxing', slug: 'optimizationmaxxing', glyph: '⚡', blurb: 'PC tuner · 100 audited tweaks', accent: '#e25bff' },
  { name: 'AdBlock-Maxxer',      slug: 'extensionmaxxing',    glyph: '⛔', blurb: "the ad blocker they couldn't ban", accent: '#00d4ff' },
  { name: 'Streammaxxing',       slug: 'streammaxxing',       glyph: '◉', blurb: 'instant local stream alerts', accent: '#4c51f7' },
  { name: 'Discordmaxxer',       slug: 'discordmaxxer',       glyph: '▸', blurb: 'Discord at a third the RAM', accent: '#ffb23e' },
];

// Hero + highlight stat tiles — only the real facts.
const heroStats = [
  { value: 50, suffix: '+', label: 'Skins' },
  { value: 20, suffix: '+', label: 'Abilities' },
  { value: 30, suffix: '+', label: 'Worlds' },
  { value: 0,  prefix: '$', label: 'Forever' },
];

// Hand-built parallax worlds — cat-pun display names for the arcade marquee,
// then an honest tail (35+ worlds in-game; "Downpurr" / "Dante's Infurno" are
// the real names, the rest are meowified flavor of real biomes).
const worlds = ['Downpurr', 'Sunspurr', 'Cosmic Mewbula', "Dante's Infurno", 'Clawckwork City', 'Candyland', 'Neon Cyber-Catty', '+ 28 more worlds'];

// Skin/ability showcase — real art + real data straight from the game's
// abilities.json (54 skins, served under /play/spritecannon/...). Nothing here
// is fabricated: names, rarities and ability text are the in-game values.
const skinBase = '/play/spritecannon/imported/spritecannon/skins';
const rarity: Record<string, { c: string; label: string }> = {
  common:    { c: '#9a90b8', label: 'Common' },
  rare:      { c: '#00d4ff', label: 'Rare' },
  epic:      { c: '#e25bff', label: 'Epic' },
  legendary: { c: '#ffb23e', label: 'Legendary' },
  mythic:    { c: '#ff6b8b', label: 'Mythic' },
};
const rarityOrder = ['common', 'rare', 'epic', 'legendary', 'mythic'];

// Curated gallery — every rarity represented, the flashy ones up front.
const skins: { k: string; n: string; r: string }[] = [
  { k: 'greedy', n: 'Queen', r: 'legendary' },
  { k: 'fastboi', n: 'Fastboi', r: 'mythic' },
  { k: 'dragon', n: 'Dragon', r: 'epic' },
  { k: 'chrome', n: 'Chrome', r: 'legendary' },
  { k: 'inferno', n: 'Inferno', r: 'legendary' },
  { k: 'lightning', n: 'Lightning', r: 'legendary' },
  { k: 'crashout', n: 'Nitro', r: 'legendary' },
  { k: 'magnet', n: 'Magnet', r: 'legendary' },
  { k: 'zeropoint', n: 'Zero Point', r: 'legendary' },
  { k: 'purpdrank', n: 'Purpdrank', r: 'legendary' },
  { k: 'bananna', n: 'Peely', r: 'legendary' },
  { k: 'turtle', n: 'Turtle', r: 'legendary' },
  { k: 'bartholomew', n: 'Bartholomew', r: 'mythic' },
  { k: 'superbob', n: 'Superbob', r: 'mythic' },
  { k: 'secretskin', n: 'The Stranger', r: 'mythic' },
  { k: 'pepper', n: 'Pepper', r: 'epic' },
  { k: 'boba', n: 'Boba', r: 'epic' },
  { k: 'raptor_sprite', n: 'Raptor', r: 'epic' },
  { k: 'tscott', n: 'Tscott', r: 'epic' },
  { k: 'shark', n: 'Shark', r: 'rare' },
  { k: 'klombo', n: 'Klombo', r: 'rare' },
  { k: 'snowman', n: 'Snowy', r: 'rare' },
  { k: 'foxspirit', n: 'Fox Spirit', r: 'common' },
  { k: 'cute', n: 'Cute', r: 'common' },
];

// Signature abilities — each card is a real skin + its real in-game ability text.
const sigAbilities: { k: string; skin: string; label: string; r: string; desc: string }[] = [
  { k: 'fastboi', skin: 'Fastboi', label: 'GodSpeed', r: 'mythic', desc: 'Transform for ~4s: invincible, max speed, free flight — the sprite even swaps to its Super Sonic form.' },
  { k: 'purpdrank', skin: 'Purpdrank', label: 'Slow-Mo', r: 'legendary', desc: 'Take a sip and the whole world slows to ~40% with a woozy purple wobble.' },
  { k: 'donlad', skin: 'Donlad', label: 'Build Wall', r: 'legendary', desc: 'Deploy a golden wall that plows straight through the hazards ahead.' },
  { k: 'tscott', skin: 'Tscott', label: 'The Drop', r: 'epic', desc: 'Bass-drop: launch up and forward as a shockwave clears the hazards near you.' },
  { k: 'pepper', skin: 'Pepper', label: 'Spicy Speed', r: 'epic', desc: 'A quick movement boost on tap — five spicy dashes every match.' },
  { k: 'bartholomew', skin: 'Bartholomew', label: 'Bartman', r: 'mythic', desc: 'Caped glider: permanent slow-fall plus two bonus flaps, the whole run.' },
];

// "What's in the cannon" — four pillars, each a real claim.
const pillars = [
  {
    n: '01',
    num: 50, suffix: '+',
    title: 'Skins to unlock',
    body: 'A full rarity shop of cats to launch — from the everyday to the showcase-rare Queen. Spend coins, dress the cannon.',
  },
  {
    n: '02',
    num: 20, suffix: '+',
    title: 'Abilities in flight',
    body: 'Slow-Mo the world, GodSpeed past hazards, Nitro smash-and-go, build a golden wall. Each skin flies its own way — then the rare Super Star tips the run.',
  },
  {
    n: '03',
    num: 30, suffix: '+',
    title: 'Hand-built worlds',
    body: 'Every backdrop is its own parallax scene. Downpurr, Sunspurr, Cosmic Mewbula, Dante\'s Infurno — the run never looks the same twice.',
  },
  {
    n: '04',
    num: null, big: 'LIVE',
    title: 'Global leaderboard',
    body: 'A live Cloudflare-backed board — global and per-stream. Climb it, redeem coin codes, watch the top spot get hunted in real time.',
  },
];

// How it plays — three slaps.
const steps = [
  { k: 'Launch', v: 'Fire the cat out of the cannon. One button. That’s the whole control scheme.' },
  { k: 'Dodge',  v: 'Thread the gaps, ride the parallax, trigger your ability at the right beat.' },
  { k: 'Climb',  v: 'Bank the distance, grab the Super Star, and stamp your name on the board.' },
];
---

<Layout
  title="Sprite Cannon — free browser game · Maxxtopia Arcade"
  description="Play Sprite Cannon free in your browser — no install, no signup. Launch the cat through 30+ hand-built worlds with 50+ skins, 20+ abilities, a rare Super Star, and a live global leaderboard. An original game built by Maxxtopia."
>
  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="relative overflow-hidden">
    <Aurora intensity="high" />
    <div class="absolute inset-0 bg-grid opacity-60"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-16 sm:pt-20 pb-12">
      <div class="reveal reveal-1 mb-7 flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] px-3.5 py-1.5">
          <span class="flex h-2 w-2 rounded-full bg-[var(--color-magenta)]" style="box-shadow: 0 0 12px var(--color-magenta); animation: pulse 2s ease-in-out infinite"></span>
          <span class="font-mono text-[12.5px] text-[var(--color-muted)]">Maxxtopia Arcade</span>
        </div>
        <span class="pill">No install</span>
        <span class="pill">No signup</span>
        <span class="pill">Free forever</span>
      </div>

      <h1 class="reveal reveal-2 text-[48px] sm:text-[80px] md:text-[104px] font-semibold tracking-[-0.04em] leading-[0.92]">
        <span class="block gradient-text">Sprite</span>
        <span class="block gradient-suite">Cannon.</span>
      </h1>

      <p class="reveal reveal-3 mt-7 max-w-xl text-[18px] sm:text-[22px] leading-[1.4] text-[var(--color-text-mid)]">
        Launch the cat. Fly forever. An original arcade game running in the tab you already have open — <span class="serif-accent gradient-suite">one button. one more run.</span> <span class="font-semibold text-[var(--color-text)]">Just a high score to beat — and skins to unlock.</span>
      </p>

      <div class="reveal reveal-4 mt-9 flex flex-wrap items-center gap-3">
        <a href="#play" class="btn-primary">
          &#9654;&#65038; Play now
        </a>
        <a href="/play/spritecannon/" target="_blank" rel="noopener" class="btn-secondary">
          Open in new tab &#8599;
        </a>
      </div>

      <!-- Stat grid — display font, animated counters. -->
      <div class="reveal reveal-5 mt-16 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] max-w-3xl">
        {heroStats.map((s) => (
          <div class="bg-[var(--color-bg-card)] px-5 py-6">
            <p class="font-display text-[44px] sm:text-[54px] gradient-suite leading-none">
              <CountUp value={s.value} prefix={s.prefix ?? ''} suffix={s.suffix ?? ''} />
            </p>
            <p class="mt-2 text-[11px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- World marquee — endless scroll of the hand-built parallax scenes. -->
    <div class="reveal reveal-6 relative border-y border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-bg-card)_55%,transparent)] py-3.5">
      <div class="marquee">
        <div class="marquee-track">
          {[...worlds, ...worlds, ...worlds].map((w) => (
            <span class="inline-flex items-center gap-3 px-6 font-display text-[20px] sm:text-[24px] tracking-[0.04em] text-[var(--color-text-mid)] whitespace-nowrap">
              {w}
              <span class="text-[var(--color-magenta)] opacity-70">&#10022;</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────── THE CABINET (embed) ─────────────────── -->
  <section id="play" class="relative scroll-mt-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 pt-14 sm:pt-16 pb-12">
      <div class="reveal-on-scroll mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-cyan)]">&#9670; The cabinet</p>
          <h2 class="mt-2 text-[26px] sm:text-[38px] font-semibold tracking-[-0.025em] leading-[1.04]">
            <span class="gradient-text">Drop a coin.</span> <span class="serif-accent gradient-suite">It’s already running.</span>
          </h2>
        </div>
        <p class="font-mono text-[12px] text-[var(--color-subtle)] max-w-xs">
          Live, in-page, no install. Click <span class="text-[var(--color-cyan)]">Fullscreen</span> for the real run.
        </p>
      </div>

      <!-- Arcade-cabinet frame: glowing bezel + control bar + live iframe. -->
      <div
        id="sc-cabinet"
        class="reveal-on-scroll group relative overflow-hidden rounded-[22px] border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] shadow-[0_30px_90px_-30px_rgba(226,91,255,0.4)]"
      >
        <!-- top control bar -->
        <div class="flex items-center gap-3 border-b border-[var(--color-line)] bg-[color-mix(in_srgb,var(--color-bg)_60%,transparent)] px-4 py-2.5">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full" style="background:#ff6b8b"></span>
            <span class="h-2.5 w-2.5 rounded-full" style="background:#ffb23e"></span>
            <span class="h-2.5 w-2.5 rounded-full" style="background:#4ade80"></span>
          </span>
          <span class="font-mono text-[12px] tracking-[0.1em] text-[var(--color-muted)]">
            SPRITE&nbsp;CANNON <span class="text-[var(--color-subtle)]">/ maxxtopia.com/play</span>
          </span>
          <div class="ml-auto flex items-center gap-2">
            <button
              id="sc-fs-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line-strong)] bg-[rgba(226,91,255,0.06)] px-3 py-1.5 font-mono text-[11.5px] tracking-[0.04em] text-[var(--color-text)] transition-colors hover:border-[rgba(226,91,255,0.5)] hover:bg-[rgba(226,91,255,0.12)]"
              aria-label="Toggle fullscreen"
            >
              <svg id="sc-fs-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/>
              </svg>
              <span id="sc-fs-label">Fullscreen</span>
            </button>
            <a
              href="/play/spritecannon/"
              target="_blank"
              rel="noopener"
              class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line-strong)] px-3 py-1.5 font-mono text-[11.5px] tracking-[0.04em] text-[var(--color-muted)] transition-colors hover:border-[rgba(0,212,255,0.5)] hover:text-[var(--color-cyan)]"
            >
              New tab &#8599;
            </a>
          </div>
        </div>

        <!-- the game -->
        <iframe
          id="sc-frame"
          src="/play/spritecannon/"
          title="Sprite Cannon"
          class="block w-full h-[64vh] min-h-[460px] max-h-[800px] border-0 bg-[var(--color-bg)]"
          loading="lazy"
          allow="fullscreen; autoplay"
        ></iframe>
      </div>

      <p class="mt-4 text-center text-[13px] text-[var(--color-subtle)]">
        Also playable over any Twitch stream with <a href="/extensionmaxxing" class="text-[var(--color-cyan)] hover:underline">AdBlock-Maxxer</a>, and built into the <a href="/extensionmaxxing" class="text-[var(--color-cyan)] hover:underline">extension</a> itself — the same game, everywhere you already are.
      </p>
    </div>
  </section>

  <!-- ─────────────── WHAT'S IN THE CANNON (pillars) ─────────────── -->
  <section class="relative border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-20 sm:py-24">
      <div class="reveal-on-scroll mb-12">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-magenta)]">&#9670; What’s in the cannon</p>
        <h2 class="mt-3 text-[32px] sm:text-[46px] font-semibold tracking-[-0.025em] leading-[1.04]">
          <span class="gradient-text">Way more game</span> <span class="serif-accent gradient-suite">than a browser tab has any right to be.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {pillars.map((p, i) => (
          <div class={`reveal-on-scroll reveal-delay-${(i % 4) + 1} group bg-[var(--color-bg-card)] p-7 transition-colors hover:bg-[var(--color-bg-card-hover)]`}>
            <p class="font-mono text-[12px] text-[var(--color-magenta)] transition-colors group-hover:text-[var(--color-cyan)]">{p.n}</p>
            <p class="mt-4 font-display text-[56px] sm:text-[64px] gradient-suite leading-[0.85]">
              {p.num !== null ? <CountUp value={p.num} suffix={p.suffix ?? ''} /> : <span class="brand-shimmer">{p.big}</span>}
            </p>
            <h3 class="mt-3 text-[17px] font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-[var(--color-text-mid)]">{p.body}</p>
          </div>
        ))}
      </div>

      <!-- ── The skin gallery — real art, not a chip list ── -->
      <div class="reveal-on-scroll mt-14">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
          <h3 class="text-[22px] sm:text-[30px] font-semibold tracking-[-0.02em] leading-[1.05]">
            <span class="gradient-text">50+ skins.</span> <span class="serif-accent gradient-suite">Real cats to launch.</span>
          </h3>
          <div class="flex flex-wrap gap-x-4 gap-y-1.5 font-mono text-[11px]">
            {rarityOrder.map((r) => (
              <span class="inline-flex items-center gap-1.5 text-[var(--color-subtle)]">
                <span class="h-2 w-2 rounded-full" style={`background:${rarity[r].c}`}></span>{rarity[r].label}
              </span>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-8 gap-2.5 sm:gap-3">
          {skins.map((s) => (
            <div
              class="group flex flex-col items-center rounded-xl border bg-[var(--color-bg-card)] p-2.5 transition-transform hover:-translate-y-0.5"
              style={`border-color:${rarity[s.r].c}33`}
              title={`${s.n} · ${rarity[s.r].label}`}
            >
              <img
                src={`${skinBase}/${s.k}.png`}
                alt={`${s.n} skin`}
                width="56" height="56" loading="lazy" decoding="async"
                class="h-14 w-14 object-contain transition-transform duration-300 group-hover:scale-110"
              />
              <p class="mt-1.5 w-full truncate text-center text-[11px] font-medium text-[var(--color-text-mid)]">{s.n}</p>
              <span class="mt-1 h-1 w-6 rounded-full" style={`background:${rarity[s.r].c}`}></span>
            </div>
          ))}
          <a
            href="/play/spritecannon/" target="_blank" rel="noopener"
            class="flex flex-col items-center justify-center rounded-xl border border-[var(--color-line)] bg-[var(--color-bg-card)] p-2.5 text-center transition-colors hover:bg-[var(--color-bg-card-hover)]"
          >
            <span class="font-display text-[26px] gradient-suite leading-none">+30</span>
            <span class="mt-1 text-[10px] font-mono uppercase tracking-[0.08em] text-[var(--color-subtle)]">more skins</span>
          </a>
        </div>
      </div>

      <!-- ── Signature abilities — shown, not just named ── -->
      <div class="reveal-on-scroll mt-14">
        <div class="mb-6">
          <h3 class="text-[22px] sm:text-[30px] font-semibold tracking-[-0.02em] leading-[1.05]">
            <span class="gradient-text">Every skin</span> <span class="serif-accent gradient-suite">flies its own way.</span>
          </h3>
          <p class="mt-2 max-w-2xl text-[14.5px] leading-relaxed text-[var(--color-text-mid)]">
            20+ abilities, each tied to a skin. A few of the loud ones — the rest you unlock in the cannon.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
          {sigAbilities.map((a) => (
            <div class="flex items-start gap-4 bg-[var(--color-bg-card)] p-5 sm:p-6 transition-colors hover:bg-[var(--color-bg-card-hover)]">
              <img
                src={`${skinBase}/${a.k}.png`}
                alt={`${a.skin} skin`}
                width="64" height="64" loading="lazy" decoding="async"
                class="h-16 w-16 shrink-0 object-contain"
              />
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="text-[16px] font-semibold tracking-tight">{a.label}</h4>
                  <span
                    class="rounded-full px-2 py-0.5 text-[10px] font-mono uppercase tracking-[0.06em]"
                    style={`color:${rarity[a.r].c};border:1px solid ${rarity[a.r].c}55;background:${rarity[a.r].c}14`}
                  >{rarity[a.r].label}</span>
                </div>
                <p class="mt-0.5 text-[11.5px] font-mono text-[var(--color-subtle)]">{a.skin}</p>
                <p class="mt-2 text-[13.5px] leading-relaxed text-[var(--color-text-mid)]">{a.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Super Star — the rare in-flight power-up -->
        <div class="reveal-on-scroll mt-5 flex flex-col gap-3 rounded-2xl border border-[rgba(255,178,62,0.4)] bg-[color-mix(in_srgb,var(--color-warm)_8%,var(--color-bg-card))] p-6 sm:p-7 sm:flex-row sm:items-center">
          <p class="font-display text-[34px] sm:text-[40px] leading-none text-[var(--color-warm)] whitespace-nowrap">&#9733; Super Star</p>
          <p class="text-[14px] leading-relaxed text-[var(--color-text-mid)]">
            The rare power-up everyone chases. Snag it mid-flight and the run tilts in your favor — the difference between a good score and a board-topper.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────── HOW IT PLAYS ─────────────────── -->
  <section class="relative border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 sm:py-20">
      <div class="reveal-on-scroll mb-9">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-cyan)]">&#9670; How it plays</p>
        <h2 class="mt-3 text-[28px] sm:text-[40px] font-semibold tracking-[-0.025em] leading-[1.04]">
          <span class="gradient-text">One button.</span> <span class="serif-accent gradient-suite">Thirty seconds to learn, forever to beat.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {steps.map((s, i) => (
          <div class={`reveal-on-scroll reveal-delay-${i + 1} bg-[var(--color-bg-card)] p-7`}>
            <p class="font-display text-[28px] gradient-suite leading-none">{String(i + 1).padStart(2, '0')} &middot; {s.k}</p>
            <p class="mt-3 text-[14.5px] leading-relaxed text-[var(--color-text-mid)]">{s.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── BRIDGE: into the suite + Discord ─────────────── -->
  <section class="relative border-t border-[var(--color-line)]">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-20 sm:py-24">
      <div class="reveal-on-scroll">
        <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--color-cyan)]">&#9670; Made by Maxxtopia</p>
        <h2 class="mt-3 text-[30px] sm:text-[48px] font-semibold tracking-[-0.025em] leading-[1.04]">
          <span class="gradient-text">Built by the people</span> <span class="serif-accent gradient-suite">who build your tools.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-[15.5px] leading-relaxed text-[var(--color-text-mid)]">
          Same hands as the 3.6&nbsp;MB PC tuner and the ad blocker they couldn’t ban. We wanted to see if we could make a browser game worth your lunch break — turns out we could. If the game is this good free, picture what the rest of the suite does.
        </p>
      </div>

      <div class="reveal-on-scroll mt-9 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {apps.map((a) => (
          <a href={`/${a.slug}`} class="group bg-[var(--color-bg-card)] p-6 transition-colors hover:bg-[var(--color-bg-card-hover)]" style={`--accent:${a.accent}`}>
            <span class="glyph-badge" aria-hidden="true">{a.glyph}</span>
            <p class="mt-4 font-semibold tracking-tight transition-colors group-hover:text-[var(--color-cyan)]">{a.name}</p>
            <p class="mt-1 text-[13px] text-[var(--color-muted)]">{a.blurb}</p>
          </a>
        ))}
      </div>

      <!-- Discord / leaderboard loop -->
      <div class="reveal-on-scroll mt-9 relative overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] p-7 sm:p-9">
        <div class="absolute inset-0 opacity-50 bg-grid pointer-events-none"></div>
        <div class="relative">
          <p class="font-display text-[30px] sm:text-[40px] leading-[0.95]">
            <span class="gradient-suite">Global leaderboard.</span> <span class="text-[var(--color-text)]">Coin codes.</span> <span class="brand-shimmer">Everyone chasing the top spot.</span>
          </p>
          <p class="mt-4 max-w-2xl text-[15.5px] leading-relaxed text-[var(--color-text-mid)]">
            It’s all in the Discord — drop your high score, grab a redeemable coin code, and see what’s shipping next across the whole arcade and tool suite.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="https://discord.gg/S78eecbWdx" target="_blank" rel="noopener" class="btn-primary">
              Join the Discord
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/#apps" class="btn-secondary">See the full suite</a>
            <a href="#play" class="btn-secondary">Back to the cabinet &#9650;</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fullscreen state: make the iframe fill the screen when the cabinet
       is fullscreened (hides the control bar's height constraint). -->
  <style is:global>
    #sc-cabinet:fullscreen,
    #sc-cabinet:-webkit-full-screen {
      width: 100vw;
      height: 100vh;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      background: var(--color-bg);
    }
    #sc-cabinet:fullscreen #sc-frame,
    #sc-cabinet:-webkit-full-screen #sc-frame {
      flex: 1 1 auto;
      height: auto;
      max-height: none;
    }
  </style>

  <script is:inline>
    (() => {
      const cab = document.getElementById('sc-cabinet');
      const btn = document.getElementById('sc-fs-btn');
      const label = document.getElementById('sc-fs-label');
      if (!cab || !btn || !label) return;

      const isFs = () => document.fullscreenElement || document.webkitFullscreenElement;

      const enter = () => {
        if (cab.requestFullscreen) return cab.requestFullscreen();
        if (cab.webkitRequestFullscreen) return cab.webkitRequestFullscreen();
      };
      const exit = () => {
        if (document.exitFullscreen) return document.exitFullscreen();
        if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
      };

      btn.addEventListener('click', () => {
        try { isFs() ? exit() : enter(); } catch (e) {}
      });

      const sync = () => { label.textContent = isFs() ? 'Exit fullscreen' : 'Fullscreen'; };
      document.addEventListener('fullscreenchange', sync);
      document.addEventListener('webkitfullscreenchange', sync);
    })();
  </script>
</Layout>
