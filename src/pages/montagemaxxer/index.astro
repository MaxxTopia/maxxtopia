  .mmx-media-overlay { position: absolute; z-index: 2; left: 16px; right: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; pointer-events: none; color: rgba(248,244,235,.84); font: 8px var(--font-mono); letter-spacing: .14em; text-shadow: 0 2px 10px rgba(0,0,0,.8); }
