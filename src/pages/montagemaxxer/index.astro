---
import Layout from '../../layouts/Layout.astro';

const downloadUrl = 'https://dl.maxxtopia.com/montagemaxxer/MontageMaxxer-Local-Windows-v3.zip?v=2026-10-20';
const showcaseVideo = '/screenshots/montagemaxxer/redrum-showcase.mp4';
const showcasePoster = '/screenshots/montagemaxxer/redrum-showcase-poster.webp';
const pageTitle = 'MontageMaxxer — Free Local Windows Beta';
const pageDescription =
  'A free local Windows editor for turning Fortnite and Valorant clips into finished gaming montages. Tune titles, songs, clip volume, pacing, and the final render on your own PC.';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MontageMaxxer',
  alternateName: 'montagemaxxer',
  description: pageDescription,
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: 'Video editing',
  operatingSystem: 'Windows',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Maxxtopia', url: 'https://maxxtopia.com' },
  url: 'https://maxxtopia.com/montagemaxxer/',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maxxtopia.com/' },
    { '@type': 'ListItem', position: 2, name: 'MontageMaxxer', item: 'https://maxxtopia.com/montagemaxxer/' },
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="mmx-page">
    <section class="mmx-hero">
      <div class="mmx-wrap mmx-hero-grid">
        <div class="mmx-copy">
          <a href="/#apps" class="mmx-back">&larr; All products</a>
          <p class="mmx-eyebrow"><span class="mmx-live-dot"></span> Free local Windows beta &middot; Fortnite first &middot; Valorant supported</p>
          <h1>Your montage.<br /><em>Your timing.</em></h1>
          <p class="mmx-lead">
            Turn your own Fortnite or Valorant clips into a finished montage. Tune the title, outro,
            exact song, clip mix, and pacing — then render it on your own machine.
          </p>
          <div class="mmx-actions">
            <a href={downloadUrl} class="mmx-button mmx-button--primary">
              Download the free Windows beta
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
            <a href="/montagemaxxer/preview/" class="mmx-button mmx-button--ghost">See the controls</a>
          </div>
          <p class="mmx-note">Free ZIP download &middot; extract it, run the included launcher, and edit locally</p>
          <p class="mmx-note mmx-note--subtle">No account required &middot; your clips stay on this Windows PC by default</p>
        </div>

        <div class="mmx-stage mmx-showcase" aria-label="A real MontageMaxxer export showcase">
          <div class="mmx-stage-glow" aria-hidden="true"></div>
          <div class="mmx-showcase-kicker" aria-hidden="true"><span class="mmx-live-dot"></span><b>REAL EXPORT / PLAYBACK</b><i></i><span>01 / 01</span></div>

          <figure class="mmx-showcase-window">
            <div class="mmx-window-bar">
              <span class="mmx-window-brand"><i></i> MONTAGEMAXXER</span>
              <span class="mmx-window-mode">FINAL CUT / PROOF</span>
              <span class="mmx-window-dots" aria-hidden="true"><b></b><b></b><b></b></span>
            </div>
            <div class="mmx-showcase-media">
              <video class="mmx-showcase-video" poster={showcasePoster} autoplay muted loop playsinline controls preload="metadata" aria-label="A real Fortnite montage rendered with MontageMaxxer">
                <source src={showcaseVideo} type="video/mp4" />
              </video>
              <div class="mmx-media-overlay mmx-media-overlay--top" aria-hidden="true"><span>REAL EXPORT</span><span>CLICK SOUND ON</span></div>
              <div class="mmx-media-overlay mmx-media-overlay--bottom" aria-hidden="true"><span>REDRUM / FINAL PLAY</span><span>MADE ON LOCAL MACHINE</span></div>
            </div>
            <figcaption class="mmx-showcase-caption">
              <div><span class="mmx-showcase-label">MADE WITH MONTAGEMAXXER</span><strong>REDRUM / FINAL PLAY</strong></div>
              <div class="mmx-showcase-spec"><b>720P</b><span>30 FPS</span></div>
            </figcaption>
          </figure>

          <div class="mmx-showcase-float mmx-showcase-float--left" aria-hidden="true"><span>THE INPUT</span><b>YOUR FOOTAGE</b><i>stays local</i></div>
          <div class="mmx-showcase-float mmx-showcase-float--right" aria-hidden="true"><span>THE RESULT</span><b>REAL FINAL CUT</b><i>title + mix + outro</i></div>
          <div class="mmx-showcase-trace" aria-hidden="true"><span>01 SOURCE</span><i></i><span>02 EDIT</span><i></i><b>03 EXPORT</b></div>
          <p class="mmx-stage-a11y">This is a real Fortnite montage rendered with MontageMaxxer. It autoplays muted; use the video controls to turn sound on.</p>
        </div>
      </div>
    </section>

    <section class="mmx-receipts" aria-label="MontageMaxxer highlights">
      <div class="mmx-wrap mmx-receipts-grid">
        <div><span class="mmx-receipt-value">01</span><span class="mmx-receipt-label">drag the title</span></div>
        <div><span class="mmx-receipt-value">02</span><span class="mmx-receipt-label">hear the exact song</span></div>
        <div><span class="mmx-receipt-value">03</span><span class="mmx-receipt-label">render the final cut</span></div>
      </div>
    </section>

    <section class="mmx-section" id="controls">
      <div class="mmx-wrap">
        <p class="mmx-tag">01 &middot; The controls</p>
        <div class="mmx-section-heading">
          <h2>Every part that changes<br /><em>the feel of a montage.</em></h2>
          <p>Good pacing is not a preset you accept blindly. It is a series of small decisions you can see, hear, and change before the render costs you time.</p>
        </div>

        <div class="mmx-control-grid">
          <article class="mmx-control-card mmx-control-card--paper">
            <div class="mmx-card-number">01</div>
            <div class="mmx-card-icon">T</div>
            <h3>Titles that land where you put them.</h3>
            <p>Open the editor, drag intro or outro text in the preview, zoom the canvas, then save the style by name. Font, size, color, outline, shadow, and motion stay editable.</p>
            <div class="mmx-card-foot"><span>INTRO + OUTRO</span><b>drag / save / reuse</b></div>
          </article>
          <article class="mmx-control-card mmx-control-card--song">
            <div class="mmx-card-number">02</div>
            <div class="mmx-card-icon">♫</div>
            <h3>Song identity that does not drift.</h3>
            <p>Preview a real track before you commit. The selected song carries through beat mapping and render, so a near-match cannot quietly replace the song you chose.</p>
            <div class="mmx-card-foot"><span>PREVIEW</span><b>exact pick / exact render</b></div>
          </article>
          <article class="mmx-control-card mmx-control-card--mix">
            <div class="mmx-card-number">03</div>
            <div class="mmx-card-icon">↗</div>
            <h3>Shape the mix in groups.</h3>
            <p>Ctrl-click the clips that need the same treatment and raise or lower them together. Fine-tune one clip when it deserves its own move.</p>
            <div class="mmx-card-foot"><span>MULTI-SELECT</span><b>one change / many clips</b></div>
          </article>
        </div>
      </div>
    </section>

    <section class="mmx-section mmx-section--dark">
      <div class="mmx-wrap mmx-build-grid">
        <div>
          <p class="mmx-tag">02 &middot; The workflow</p>
          <h2>From raw clips<br /><em>to your signature.</em></h2>
          <p class="mmx-body">Add clips, preview the song and look, shape titles, outro, and clip mix, then review the settings before you render. The editor keeps those decisions visible instead of burying them in a wall of controls.</p>
          <a href={downloadUrl} class="mmx-inline-link">Download the free local beta <span>&rarr;</span></a>
        </div>
        <ol class="mmx-steps">
          <li><span>01</span><div><b>Load your clips</b><p>See the whole timeline before committing to the order.</p></div></li>
          <li><span>02</span><div><b>Choose a song + look</b><p>Preview the exact track and match the style and pacing to the footage.</p></div></li>
          <li><span>03</span><div><b>Shape the edit</b><p>Place titles and outro, adjust group volume, and fine-tune the pacing.</p></div></li>
          <li><span>04</span><div><b>Render and review</b><p>Check the selected song and final settings, then export on your own PC.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="mmx-final">
      <div class="mmx-wrap mmx-final-inner">
        <p class="mmx-tag">03 &middot; Your cut</p>
        <h2>Make the edit feel<br /><em>like you.</em></h2>
        <p>MontageMaxxer is for players who want to make the edit themselves — with repeatable title, song, mix, and outro controls instead of a one-click preset.</p>
        <div class="mmx-actions">
          <a href={downloadUrl} class="mmx-button mmx-button--primary">Download the free Windows beta <span>&rarr;</span></a>
          <a href="/montagemaxxer/apply/" class="mmx-button mmx-button--ghost">Want us to build your montage?</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .mmx-page { --mmx-ink: #f6f1e8; --mmx-muted: #a7a1b2; --mmx-paper: #f2c45b; --mmx-cyan: #27d9c3; --mmx-red: #db5948; --mmx-line: rgba(255,255,255,.12); background: #08090e; color: var(--mmx-ink); overflow: hidden; }
  .mmx-wrap { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  .mmx-hero { position: relative; min-height: min(850px, calc(100vh - 56px)); display: grid; align-items: center; isolation: isolate; background: radial-gradient(circle at 82% 48%, rgba(39,217,195,.12), transparent 24%), radial-gradient(circle at 17% 18%, rgba(219,89,72,.13), transparent 26%), #08090e; }
  .mmx-hero-grid { display: grid; grid-template-columns: minmax(0, .92fr) minmax(480px, 1.08fr); align-items: center; gap: clamp(32px, 6vw, 90px); padding: 78px 0 88px; }
  .mmx-back { display: inline-flex; margin-bottom: 34px; color: var(--mmx-muted); font: 12px var(--font-mono); letter-spacing: .07em; text-decoration: none; transition: color .2s ease; }
  .mmx-back:hover { color: var(--mmx-cyan); }
  .mmx-eyebrow, .mmx-tag { color: var(--mmx-cyan); font: 11px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .mmx-eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 20px; }
  .mmx-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--mmx-cyan); box-shadow: 0 0 15px var(--mmx-cyan); }
  .mmx-copy h1, .mmx-section h2, .mmx-final h2 { margin: 0; font: 400 clamp(66px, 8.2vw, 118px)/.85 var(--font-display); letter-spacing: .012em; text-transform: uppercase; }
  .mmx-copy h1 em, .mmx-section h2 em, .mmx-final h2 em { color: var(--mmx-paper); font-style: normal; }
  .mmx-lead { max-width: 32rem; margin: 30px 0 0; color: #cec7d6; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; }
  .mmx-actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 30px; }
  .mmx-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 50px; padding: 0 20px; border-radius: 999px; font: 600 13px var(--font-mono); text-decoration: none; transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease; }
  .mmx-button:hover { transform: translateY(-2px); }
  .mmx-button--primary { color: #081313; background: var(--mmx-cyan); box-shadow: 0 12px 35px rgba(39,217,195,.24); }
  .mmx-button--primary:hover { box-shadow: 0 15px 45px rgba(39,217,195,.38); }
  .mmx-button--ghost { color: var(--mmx-ink); border: 1px solid var(--mmx-line); background: rgba(255,255,255,.03); }
  .mmx-button--ghost:hover { border-color: rgba(242,196,91,.55); background: rgba(242,196,91,.07); }
  .mmx-note { margin: 18px 0 0; color: #827b8b; font: 11px var(--font-mono); letter-spacing: .03em; }
  .mmx-note--subtle { margin-top: 8px; color: #6c6675; }

  .mmx-stage { --mmx-loop-duration: 8.8s; --mmx-drift-duration: 7s; --mmx-wave-duration: 1.1s; position: relative; min-height: 640px; display: grid; place-items: center; perspective: 1400px; }
  .mmx-stage-glow { position: absolute; width: 80%; height: 70%; border-radius: 50%; background: rgba(39,217,195,.12); filter: blur(70px); animation: mmx-glow-breathe var(--mmx-drift-duration) ease-in-out infinite; }
  @keyframes mmx-glow-breathe { 0%,100% { opacity: .55; transform: scale(.92); } 50% { opacity: 1; transform: scale(1.08); } }
  .mmx-stage-kicker { position: absolute; left: 1%; top: 3%; z-index: 5; display: flex; align-items: center; gap: 9px; color: rgba(242,238,231,.6); font: 9px var(--font-mono); letter-spacing: .14em; }
  .mmx-stage-kicker b { color: #d5d9e0; font-weight: 400; }
  .mmx-stage-kicker > i { width: 18px; height: 1px; background: rgba(255,255,255,.2); }
  .mmx-stage-kicker > span:last-child { color: var(--mmx-paper); }
  .mmx-stage-kicker .mmx-live-dot { width: 7px; height: 7px; flex: 0 0 auto; animation: mmx-signal-pulse 1.8s ease-in-out infinite; }
  @keyframes mmx-signal-pulse { 0%,100% { opacity: .52; } 50% { opacity: 1; } }
  .mmx-stage-state { position: relative; display: inline-grid; min-width: 78px; height: 11px; color: var(--mmx-paper); }
  .mmx-stage-state__item { grid-area: 1 / 1; color: inherit; font-style: normal; opacity: 0; white-space: nowrap; }
  .mmx-stage-state__item--source { animation: mmx-stage-state-source var(--mmx-loop-duration) linear infinite; }
  .mmx-stage-state__item--cut { animation: mmx-stage-state-cut var(--mmx-loop-duration) linear infinite; }
  .mmx-stage-state__item--render { animation: mmx-stage-state-render var(--mmx-loop-duration) linear infinite; }
  @keyframes mmx-stage-state-source { 0%,20% { opacity: 1; } 28%,100% { opacity: 0; } }
  @keyframes mmx-stage-state-cut { 0%,24% { opacity: 0; } 32%,62% { opacity: 1; } 70%,100% { opacity: 0; } }
  @keyframes mmx-stage-state-render { 0%,64% { opacity: 0; } 72%,94% { opacity: 1; } 100% { opacity: 0; } }
  .mmx-source-stack { position: absolute; left: -3%; bottom: 8%; z-index: 1; width: 152px; height: 106px; transform: rotate(-8deg); }
  .mmx-source-card { position: absolute; display: grid; gap: 4px; width: 138px; padding: 12px 13px; border: 1px solid rgba(255,255,255,.16); border-radius: 7px; background: #11151d; box-shadow: 0 18px 34px rgba(0,0,0,.38); font-family: var(--font-mono); }
  .mmx-source-card span { color: #6f7886; font-size: 8px; letter-spacing: .12em; }
  .mmx-source-card b { color: #edf0f2; font-size: 11px; font-weight: 500; }
  .mmx-source-card i { color: var(--mmx-cyan); font-size: 9px; font-style: normal; }
  .mmx-source-card--raw { left: 0; top: 18px; transform: rotate(-4deg); animation: mmx-source-float var(--mmx-drift-duration) ease-in-out infinite; }
  .mmx-source-card--selected { left: 17px; top: 0; z-index: 1; border-color: rgba(242,196,91,.34); transform: rotate(3deg); animation: mmx-source-selected var(--mmx-loop-duration) ease-in-out infinite; }
  @keyframes mmx-source-float { 0%,100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-6px) rotate(-2deg); } }
  @keyframes mmx-source-selected { 0%,14%,100% { transform: translateY(0) rotate(3deg); box-shadow: 0 18px 34px rgba(0,0,0,.38); } 24%,58% { transform: translateY(-8px) rotate(1deg); box-shadow: 0 24px 42px rgba(0,0,0,.48), 0 0 22px rgba(242,196,91,.12); } 70% { transform: translateY(0) rotate(3deg); } }
  .mmx-window { position: relative; z-index: 2; width: min(630px, 100%); padding: 10px; border: 1px solid rgba(255,255,255,.17); border-radius: 16px; background: linear-gradient(145deg, #1b1e25, #0c0e13 55%); box-shadow: 0 40px 100px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.04) inset, 0 0 80px rgba(39,217,195,.13); transform-origin: 50% 54%; animation: mmx-window-drift var(--mmx-drift-duration) ease-in-out infinite; }
  @keyframes mmx-window-drift { 0%,100% { transform: translate3d(0,0,0) rotate(1.8deg); } 50% { transform: translate3d(0,-7px,0) rotate(1.1deg); } }
  .mmx-window-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 33px; padding: 0 8px 0 5px; color: #a6acb8; font: 9px var(--font-mono); letter-spacing: .08em; }
  .mmx-window-brand { display: flex; gap: 7px; align-items: center; color: #e5e7eb; }
  .mmx-window-brand i { display: block; width: 8px; height: 8px; border-radius: 2px; background: var(--mmx-cyan); box-shadow: 0 0 9px var(--mmx-cyan); animation: mmx-signal-pulse 1.8s ease-in-out infinite; }
  .mmx-window-mode { color: #7b8491; }
  .mmx-window-dots { display: flex; justify-content: flex-end; gap: 5px; }
  .mmx-window-dots b { width: 6px; height: 6px; border: 1px solid #737987; border-radius: 50%; }
  .mmx-preview { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: linear-gradient(145deg, #20283b, #0d1019 52%, #291b24); }
  .mmx-preview::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 72% 37%, rgba(39,217,195,.32), transparent 18%), linear-gradient(115deg, transparent 46%, rgba(255,255,255,.1) 46.5%, transparent 48%); animation: mmx-preview-breathe var(--mmx-drift-duration) ease-in-out infinite; }
  .mmx-preview::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(110deg, transparent 0 45%, rgba(255,255,255,.08) 47%, transparent 49% 100%); opacity: .56; }
  @keyframes mmx-preview-breathe { 0%,100% { opacity: .7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.04); } }
  .mmx-preview-grid { position: absolute; inset: 0; opacity: .3; background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); background-size: 30px 30px; mask-image: linear-gradient(140deg, black 8%, transparent 74%); }
  .mmx-preview-scan { position: absolute; left: -10%; right: -10%; top: -2px; z-index: 4; height: 2px; background: linear-gradient(90deg, transparent, var(--mmx-cyan), transparent); box-shadow: 0 0 16px var(--mmx-cyan); opacity: .65; animation: mmx-preview-scan var(--mmx-loop-duration) linear infinite; }
  @keyframes mmx-preview-scan { 0% { top: -2px; opacity: 0; } 10%,82% { opacity: .65; } 92%,100% { top: calc(100% + 2px); opacity: 0; } }
  .mmx-preview-kicker { position: absolute; left: 7%; top: 9%; z-index: 2; color: #a5f6eb; font: 9px var(--font-mono); letter-spacing: .13em; }
  .mmx-preview-signal { position: absolute; right: 6%; bottom: 8%; z-index: 2; display: flex; align-items: center; gap: 6px; color: rgba(247,242,232,.62); font: 8px var(--font-mono); letter-spacing: .1em; }
  .mmx-preview-signal span, .mmx-preview-cut span { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--mmx-cyan); box-shadow: 0 0 10px var(--mmx-cyan); }
  .mmx-preview-title { position: absolute; left: 7%; top: 25%; z-index: 2; color: #f7f2e8; font: 400 clamp(48px, 8vw, 86px)/.78 var(--font-display); letter-spacing: .025em; text-shadow: 5px 6px 0 rgba(219,89,72,.85); }
  .mmx-preview-title span { color: var(--mmx-paper); }
  .mmx-preview-title--a { animation: mmx-title-card-a var(--mmx-loop-duration) ease-in-out infinite; }
  .mmx-preview-title--b { opacity: 0; transform: translateY(8px) scale(.97); animation: mmx-title-card-b var(--mmx-loop-duration) ease-in-out infinite; }
  @keyframes mmx-title-card-a { 0%,8% { opacity: 1; transform: translateY(0) scale(1); } 16%,43% { opacity: 1; transform: translateY(0) scale(1); } 51%,100% { opacity: 0; transform: translateY(-8px) scale(1.03); } }
  @keyframes mmx-title-card-b { 0%,48% { opacity: 0; transform: translateY(8px) scale(.97); } 57%,84% { opacity: 1; transform: translateY(0) scale(1); } 93%,100% { opacity: 0; transform: translateY(-8px) scale(1.03); } }
  .mmx-paper-strip { position: absolute; right: 6%; bottom: 18%; z-index: 2; padding: 9px 13px 8px; background: #f2eee4; color: #12141a; transform: rotate(-5deg); box-shadow: 5px 6px 0 rgba(219,89,72,.8); animation: mmx-paper-lift var(--mmx-drift-duration) ease-in-out infinite; }
  .mmx-paper-strip span { font: 10px var(--font-mono); letter-spacing: .09em; }
  @keyframes mmx-paper-lift { 0%,100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-5px) rotate(-3deg); } }
  .mmx-preview-cut { position: absolute; left: 7%; bottom: 9%; z-index: 2; display: flex; align-items: center; gap: 6px; color: var(--mmx-paper); font: 8px var(--font-mono); letter-spacing: .08em; animation: mmx-cut-breathe var(--mmx-loop-duration) ease-in-out infinite; }
  @keyframes mmx-cut-breathe { 0%,38%,100% { opacity: .3; } 45%,65% { opacity: 1; } 72% { opacity: .42; } }
  .mmx-preview-hud { position: absolute; right: 5%; top: 9%; z-index: 2; display: flex; gap: 10px; color: rgba(247,242,232,.72); font: 9px var(--font-mono); }
  .mmx-timecode { position: relative; display: inline-grid; min-width: 43px; height: 10px; }
  .mmx-timecode__item { grid-area: 1 / 1; font-style: normal; opacity: 0; white-space: nowrap; }
  .mmx-timecode__item--source { animation: mmx-timecode-source var(--mmx-loop-duration) linear infinite; }
  .mmx-timecode__item--cut { animation: mmx-timecode-cut var(--mmx-loop-duration) linear infinite; }
  .mmx-timecode__item--render { animation: mmx-timecode-render var(--mmx-loop-duration) linear infinite; }
  @keyframes mmx-timecode-source { 0%,20% { opacity: 1; } 28%,100% { opacity: 0; } }
  @keyframes mmx-timecode-cut { 0%,24% { opacity: 0; } 32%,62% { opacity: 1; } 70%,100% { opacity: 0; } }
  @keyframes mmx-timecode-render { 0%,64% { opacity: 0; } 72%,94% { opacity: 1; } 100% { opacity: 0; } }
  .mmx-timeline { position: relative; padding: 10px 10px 8px; background: #11141b; border-top: 1px solid rgba(255,255,255,.08); }
