} .mmx-receipts-grid { grid-template-columns: 1fr; } .mmx-receipts-grid > div, .mmx-receipts-grid > div:first-child { min-height: auto; padding: 20px 0; border-right: 0; border-bottom: 1px solid var(--mmx-line); } .mmx-receipts-grid > div:last-child { border-bottom: 0; } .mmx-receipt-value { font-size: 32px; } .mmx-section { padding: 85px 0 95px; } .mmx-control-grid { grid-template-columns: 1fr; } .mmx-control-card { min-height: 320px; } .mmx-steps li { grid-template-columns: 42px 1fr; gap: 14px; } .mmx-steps b { font-size: 24px; } .mmx-final { padding: 95px 0 115px; } }
  /* The hero proof is a real export, framed like a finished editor deliverable. */
  .mmx-showcase { --mmx-drift-duration: 8s; min-height: 630px; overflow: visible; isolation: isolate; transform: none; }
  .mmx-showcase::before,
  .mmx-showcase .mmx-stage-glow { display: none; }
  .mmx-showcase-kicker { position: absolute; left: 1%; top: 1%; z-index: 5; display: flex; align-items: center; gap: 9px; color: rgba(242,238,231,.62); font: 9px var(--font-mono); letter-spacing: .14em; }
  .mmx-showcase-kicker b { color: #d5d9e0; font-weight: 400; }
