  .mmx-showcase-kicker > span:last-child { color: var(--mmx-paper); }
  .mmx-showcase-kicker .mmx-live-dot { width: 7px; height: 7px; flex: 0 0 auto; animation: mmx-signal-pulse 1.8s ease-in-out infinite; }
  .mmx-showcase-window { position: relative; z-index: 2; width: min(700px, calc(100% - 26px)); margin: 27px 0 13px; padding: 10px; border: 1px solid rgba(255,255,255,.18); border-radius: 16px; background: linear-gradient(145deg, #1b1e25, #0b0d12 58%); box-shadow: 0 40px 100px rgba(0,0,0,.68), 0 0 0 1px rgba(255,255,255,.04) inset, 0 0 90px rgba(39,217,195,.14); transform-origin: 50% 54%; animation: mmx-showcase-drift var(--mmx-drift-duration) ease-in-out infinite; }
  @keyframes mmx-showcase-drift { 0%,100% { transform: translate3d(0,0,0) rotate(1.2deg); } 50% { transform: translate3d(0,-7px,0) rotate(.45deg); } }
  .mmx-showcase-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #050609; }
  .mmx-showcase-media::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(4,7,11,.38), transparent 22%, transparent 70%, rgba(4,7,11,.55)); }
  .mmx-showcase-media::after { content: ''; position: absolute; left: -12%; right: -12%; top: -2px; z-index: 3; height: 2px; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(39,217,195,.78), transparent); box-shadow: 0 0 17px rgba(39,217,195,.8); opacity: 0; animation: mmx-showcase-scan 9s linear infinite; }
  @keyframes mmx-showcase-scan { 0%,7% { top: -2px; opacity: 0; } 15%,82% { opacity: .62; } 93%,100% { top: calc(100% + 2px); opacity: 0; } }
