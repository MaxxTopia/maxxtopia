---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import { changelog, changelogEntryId, getChangelogAccentHex } from '../data/changelog';

// The first entry for each project is its current release because changelog.ts
// sorts the feed newest-first. Current releases get the active aura, even when
// their note is intentionally just a maintenance release.
const latestEntryByProject = new Map();
for (const entry of changelog) {
  const projectKey = entry.productSlug ?? entry.product;
  if (!latestEntryByProject.has(projectKey)) latestEntryByProject.set(projectKey, entry);
}
const newestEntry = changelog[0];
---

<Layout title="Updates — Maxxtopia" description="What we've shipped across the maxxer apps — releases, features, and the little quality-of-life fixes.">
  <article class="relative" data-motion-preview>
    <Aurora intensity="low" />
    <div class="absolute inset-0 bg-grid opacity-30"></div>

    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pt-20 pb-12">
      <p class="reveal reveal-1 text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
        Updates · maxxer-wide
      </p>
      <h1 class="reveal reveal-2 mt-3 text-[44px] sm:text-[64px] font-semibold tracking-[-0.03em] leading-[1.12]">
        <span class="gradient-text">Everything we've</span> <span class="serif-accent gradient-suite">shipped.</span>
      </h1>
      <p class="reveal reveal-3 mt-5 max-w-xl text-[15.5px] text-[var(--color-text-mid)] leading-relaxed">
        One page across every app in the suite. Big releases and the little quality-of-life
        fixes alike. Newest first.
      </p>
    </div>

    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pb-32">
      <div class="upd-list">
        {changelog.map((entry) => {
          const accent = getChangelogAccentHex(entry);
          const isCurrent = latestEntryByProject.get(entry.productSlug ?? entry.product) === entry;
          const isFeatured = entry === newestEntry;
          const updateClasses = [
            'upd',
            'reveal-on-scroll',
            isCurrent ? 'upd--current' : '',
            isFeatured ? 'upd--featured' : '',
          ].filter(Boolean).join(' ');
          return (
            <article id={changelogEntryId(entry)} class={updateClasses} style={accent ? `--upd-accent: ${accent}` : ''}>
              {isCurrent && (
                <span class="upd__drip" aria-hidden="true">
                  <span class="upd__drip-bead"></span>
                </span>
              )}
              <div class="upd__meta">
                <time class="upd__date">{entry.date}</time>
                {entry.version && <span class="upd__ver">{entry.version}</span>}
              </div>

              <div class="upd__content">
                {entry.productSlug ? (
                  <a href={`/${entry.productSlug}`} class="upd__product">{entry.product}</a>
                ) : (
                  <span class="upd__product upd__product--plain">{entry.product}</span>
                )}
                <h2 class="upd__title">{entry.title}</h2>
                {entry.body && <p class="upd__text">{entry.body}</p>}
                {entry.items && entry.items.length > 0 && (
                  <ul class="upd__list">
                    {entry.items.map((it) => <li class="upd__item">{it}</li>)}
                  </ul>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="reveal-on-scroll mt-14 pt-10 border-t border-[var(--color-line)]">
        <a href="/#apps" class="btn-primary">
          Browse the apps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </article>
</Layout>

<script is:inline>
  if (new URLSearchParams(window.location.search).get('motion') === 'on') {
    document.querySelector('[data-motion-preview]')?.setAttribute('data-motion-preview', 'on');
  }
</script>

<style>
  .upd-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .upd {
    --upd-accent: var(--color-magenta);
    position: relative;
    isolation: isolate;
    overflow: visible;
    display: grid;
    grid-template-columns: 124px 1fr;
    gap: 22px;
    padding: 20px 22px 20px 20px;
    border: 1px solid var(--color-line);
    border-left: 2px solid color-mix(in srgb, var(--upd-accent) 70%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg-card) 70%, transparent);
    transition: border-color 200ms ease, background 200ms ease;
  }
  .upd::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: -76px;
    left: -92px;
    width: 250px;
    height: 190px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--upd-accent) 17%, transparent) 0%,
      color-mix(in srgb, var(--upd-accent) 8%, transparent) 36%,
      transparent 74%
    );
    filter: blur(20px);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 0, 0) scale(0.92);
    transition: opacity 240ms ease;
  }
  .upd > * {
    position: relative;
    z-index: 1;
  }
  .upd__drip {
    position: absolute !important;
    z-index: 2 !important;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 3px;
    pointer-events: none;
  }
  .upd__drip::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--upd-accent);
    border-radius: 999px;
    opacity: 0;
  }
  .upd__drip-bead {
    content: "";
    position: absolute;
    z-index: 3;
    left: -4px;
    top: -14px;
    width: 10px;
    height: 15px;
    clip-path: polygon(50% 0%, 78% 34%, 94% 60%, 88% 82%, 68% 96%, 50% 100%, 32% 96%, 12% 82%, 6% 60%, 22% 34%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--upd-accent) 52%, white),
      var(--upd-accent) 48%,
      color-mix(in srgb, var(--upd-accent) 68%, black)
    );
    box-shadow: 0 0 14px color-mix(in srgb, var(--upd-accent) 58%, transparent);
    opacity: 0;
    transform: translateY(0) scale(0.2);
    transform-origin: 50% 0;
    filter: blur(1.5px);
    animation: upd-rail-bead 7.2s cubic-bezier(0.7, 0.05, 0.3, 1) infinite;
  }
  .upd__drip-bead::before {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 3px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, white 70%, var(--upd-accent));
    opacity: 0.68;
  }
  .upd--current::before {
    opacity: 0.52;
  }
  .upd--featured::before {
    opacity: 0.82;
    animation: upd-ooze 9s ease-in-out infinite alternate;
  }
  .upd:not(.upd--current):hover::before,
  .upd:not(.upd--current):focus-within::before {
    opacity: 0.24;
  }
  .upd--current:hover::before,
  .upd--current:focus-within::before {
    opacity: 0.66;
  }
  .upd:hover {
    border-color: var(--color-line-strong);
    border-left-color: var(--upd-accent);
    background: var(--color-bg-card);
  }

  /* Meta column — date stacked over the version pill. */
  .upd__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    padding-top: 2px;
  }
  .upd__date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-subtle);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .upd__ver {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--upd-accent);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--upd-accent) 35%, transparent);
    background: color-mix(in srgb, var(--upd-accent) 10%, transparent);
  }
  .upd--current .upd__ver {
    position: relative;
    isolation: isolate;
    overflow: visible;
  }
  .upd--current .upd__ver::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: auto;
    bottom: -5px;
    left: 25%;
    width: 4px;
    height: 10px;
    border-radius: 0 0 60% 60%;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--upd-accent) 38%, white),
      var(--upd-accent) 44%,
      color-mix(in srgb, var(--upd-accent) 72%, black)
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--upd-accent) 42%, transparent);
    pointer-events: none;
    transform: scaleY(0.35);
    transform-origin: 50% 0;
    animation: upd-chip-blood-stem 6.6s ease-in-out infinite;
  }
  .upd--current .upd__ver::after {
    content: "";
    position: absolute;
    z-index: 0;
    left: calc(25% - 2px);
    bottom: -14px;
    width: 8px;
    height: 11px;
    clip-path: polygon(50% 0%, 78% 30%, 94% 58%, 86% 82%, 66% 96%, 50% 100%, 34% 96%, 14% 82%, 6% 58%, 22% 30%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--upd-accent) 40%, white),
      var(--upd-accent) 46%,
      color-mix(in srgb, var(--upd-accent) 76%, black)
    );
    box-shadow: 0 0 10px color-mix(in srgb, var(--upd-accent) 48%, transparent);
    opacity: 0;
    transform: translateY(-2px) scale(0.22, 0.35);
    transform-origin: 50% 0;
    pointer-events: none;
    animation: upd-chip-blood-drop 6.6s cubic-bezier(0.7, 0.05, 0.3, 1) infinite -2.2s;
  }

  .upd__product {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--upd-accent);
    text-decoration: none;
    transition: opacity 160ms ease;
  }
  a.upd__product:hover { opacity: 0.7; }
  .upd__product--plain { color: var(--color-muted); }

  .upd__title {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }
  .upd__text {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-mid);
  }

  .upd__list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .upd__item {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-mid);
  }
  .upd__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--upd-accent);
    transform: rotate(45deg);
  }

  @keyframes upd-ooze {
    from { transform: translate3d(0, 0, 0) scale(0.94); }
    to { transform: translate3d(48px, 18px, 0) scale(1.12); }
  }

  @keyframes upd-rail-bead {
    0% { top: -14px; opacity: 0; transform: scale(0.2); filter: blur(1.5px); }
    10% { top: -10px; opacity: 0.42; transform: scale(0.28); filter: blur(1px); }
    24% { top: 8%; opacity: 0.82; transform: scale(0.46); filter: blur(0.45px); }
    48% { top: 38%; opacity: 0.96; transform: scale(0.72); filter: blur(0); }
    70% { top: 70%; opacity: 1; transform: scale(1); filter: blur(0); }
    83% { top: calc(100% - 10px); opacity: 1; transform: scale(1.34, 1.48); filter: blur(0); }
    89% { top: calc(100% + 5px); opacity: 0.92; transform: scale(1.42, 1.62); filter: blur(0.15px); }
    95%, 100% { top: calc(100% + 38px); opacity: 0; transform: scale(0.3, 0.44); filter: blur(4px); }
  }

  @keyframes upd-chip-blood-stem {
    0%, 42% { opacity: 0.18; transform: scaleY(0.28); }
    56% { opacity: 0.98; transform: scaleY(1); }
    72% { opacity: 0.8; transform: scaleY(0.78); }
    100% { opacity: 0.18; transform: scaleY(0.32); }
  }

  @keyframes upd-chip-blood-drop {
    0%, 46% { opacity: 0; transform: translateY(-2px) scale(0.22, 0.35); filter: blur(1px); }
    56% { opacity: 0.96; transform: translateY(0) scale(0.74, 0.92); filter: blur(0); }
    65% { opacity: 1; transform: translateY(2px) scale(1, 1.16); filter: blur(0); }
    78% { opacity: 0.78; transform: translateY(9px) scale(0.82, 0.92); filter: blur(0.35px); }
    92%, 100% { opacity: 0; transform: translateY(18px) scale(0.3, 0.48); filter: blur(2px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .upd,
    .upd__ver,
    .upd::before {
      transition: none;
    }
    .upd--featured::before {
      animation: none;
    }
    .upd__drip::before,
    .upd__drip-bead {
      animation: none;
    }
    .upd__drip-bead {
      top: calc(100% - 10px);
      opacity: 0.96;
      transform: scale(0.92);
      filter: none;
    }
    .upd--current .upd__ver::before,
    .upd--current .upd__ver::after {
      animation: none;
    }
    .upd--current .upd__ver::before {
      opacity: 0.82;
      transform: scaleY(0.86);
    }
    .upd--current .upd__ver::after {
      opacity: 0.9;
      transform: translateY(0) scale(0.78, 0.92);
    }
  }

  /* The local preview can explicitly request motion so the effect is reviewable
   * even when the desktop/browser accessibility setting reduces motion. */
  @media (prefers-reduced-motion: reduce) {
    [data-motion-preview="on"] .upd--featured::before {
      animation: upd-ooze 9s ease-in-out infinite alternate !important;
    }
    [data-motion-preview="on"] .upd__drip-bead {
      animation: upd-rail-bead 7.2s cubic-bezier(0.7, 0.05, 0.3, 1) infinite !important;
    }
    [data-motion-preview="on"] .upd--current .upd__ver::before {
      animation: upd-chip-blood-stem 6.6s ease-in-out infinite !important;
    }
    [data-motion-preview="on"] .upd--current .upd__ver::after {
      animation: upd-chip-blood-drop 6.6s cubic-bezier(0.7, 0.05, 0.3, 1) infinite -2.2s !important;
    }
  }

  @media (max-width: 640px) {
    .upd {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .upd__meta {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }
  }
</style>
