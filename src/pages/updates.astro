---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import { changelog, changelogEntryId, getChangelogAccentHex, getChangelogDisplayVersion, getChangelogProjectKey } from '../data/changelog';

// The first entry for each project is its current release because changelog.ts
// sorts the feed newest-first. Current releases get the active aura, even when
// their note is intentionally just a maintenance release.
const latestEntryByProject = new Map();
for (const entry of changelog) {
  const projectKey = getChangelogProjectKey(entry);
  if (!latestEntryByProject.has(projectKey)) latestEntryByProject.set(projectKey, entry);
}
const newestEntry = changelog[0];
---

<Layout title="Updates — Maxxtopia" description="What we've shipped across the maxxer apps — releases, features, and the little quality-of-life fixes.">
  <article class="maxxtopia-motion-required relative" data-motion-preview data-motion-required="true">
    <Aurora intensity="low" motionRequired />
    <div class="absolute inset-0 bg-grid opacity-30"></div>

    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pt-20 pb-12">
      <p class="reveal reveal-1 text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
        Updates · maxxer-wide
      </p>
      <h1 class="reveal reveal-2 mt-3 text-[44px] sm:text-[64px] font-semibold tracking-[-0.03em] leading-[1.12]">
        <span class="gradient-text">Everything we've</span> <span class="serif-accent gradient-suite">shipped.</span>
      </h1>
      <p class="reveal reveal-3 mt-5 max-w-xl text-[15.5px] text-[var(--color-text-mid)] leading-relaxed">
        One page across every app in the suite. Big releases and the little quality-of-life
        fixes alike. Newest first.
      </p>
    </div>

    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pb-32">
      <div class="upd-list">
        {changelog.map((entry) => {
          const accent = getChangelogAccentHex(entry);
          const displayVersion = getChangelogDisplayVersion(entry);
          const isCurrent = latestEntryByProject.get(getChangelogProjectKey(entry)) === entry;
          const isFeatured = entry === newestEntry;
          const updateClasses = [
            'upd',
            'reveal-on-scroll',
            isCurrent ? 'upd--current' : '',
            isFeatured ? 'upd--featured' : '',
          ].filter(Boolean).join(' ');
          return (
            <article id={changelogEntryId(entry)} class={updateClasses} style={accent ? `--upd-accent: ${accent}` : ''}>
              {isCurrent && (
                <span class="upd__drip" aria-hidden="true">
                  <span class="upd__drip-bead"></span>
                </span>
              )}
              <div class="upd__meta">
                <time class="upd__date">{entry.date}</time>
                {displayVersion && (
                  <span
                    class="upd__ver"
                    title={entry.version ? `Technical version ${entry.version}` : undefined}
                    aria-label={entry.version ? `${displayVersion}, technical version ${entry.version}` : displayVersion}
                  >
                    {displayVersion}
                    {isCurrent && (
                      <span class="upd__ver-drips" aria-hidden="true">
                        <span class="upd__ver-drip upd__ver-drip--short"></span>
                        <span class="upd__ver-drip upd__ver-drip--main"></span>
                        <span class="upd__ver-drip upd__ver-drip--tail"></span>
                      </span>
                    )}
                  </span>
                )}
              </div>

              <div class="upd__content">
                {entry.productSlug ? (
                  <a href={`/${entry.productSlug}`} class="upd__product">{entry.product}</a>
                ) : (
                  <span class="upd__product upd__product--plain">{entry.product}</span>
                )}
                <h2 class="upd__title">{entry.title}</h2>
                {entry.body && <p class="upd__text">{entry.body}</p>}
                {entry.items && entry.items.length > 0 && (
                  <ul class="upd__list">
                    {entry.items.map((it) => <li class="upd__item">{it}</li>)}
                  </ul>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div class="reveal-on-scroll mt-14 pt-10 border-t border-[var(--color-line)]">
        <a href="/#apps" class="btn-primary">
          Browse the apps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </article>
</Layout>

<script is:inline>
  const motionPreview = new URLSearchParams(window.location.search).get('motion') === 'on';
  if (motionPreview) {
    document.querySelector('[data-motion-preview]')?.setAttribute('data-motion-preview', 'on');
  }

  const motionRequired = document.querySelector('[data-motion-required="true"]') !== null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (motionPreview || motionRequired || !reducedMotion) {
    const dripGroups = [...document.querySelectorAll('.upd__ver-drips')];
    const dripCycleMs = 4600;
    const randomizeDripGroup = (group) => {
      const drops = [...group.querySelectorAll('.upd__ver-drip')];
      const order = drops.map((_, index) => index);
      for (let index = order.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [order[index], order[swapIndex]] = [order[swapIndex], order[index]];
      }

      const activeDrops = new Set([order[0]]);
      drops.forEach((drop, index) => {
        drop.dataset.dropActive = String(activeDrops.has(index));
      });
    };

    dripGroups.forEach(randomizeDripGroup);
    if (dripGroups.length > 0) {
      window.setInterval(() => dripGroups.forEach(randomizeDripGroup), dripCycleMs);
    }
  }
</script>

<style>
  .upd-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .upd {
    --upd-accent: var(--color-magenta);
    position: relative;
    isolation: isolate;
    overflow: visible;
    display: grid;
    grid-template-columns: 124px 1fr;
    gap: 22px;
    padding: 20px 22px 20px 20px;
    border: 1px solid var(--color-line);
    border-left: 2px solid color-mix(in srgb, var(--upd-accent) 70%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg-card) 70%, transparent);
    transition: border-color 200ms ease, background 200ms ease;
  }
  .upd::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: -76px;
    left: -92px;
    width: 250px;
    height: 190px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--upd-accent) 17%, transparent) 0%,
      color-mix(in srgb, var(--upd-accent) 8%, transparent) 36%,
      transparent 74%
    );
    filter: blur(20px);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 0, 0) scale(0.92);
    transition: opacity 240ms ease;
  }
  .upd > * {
    position: relative;
    z-index: 1;
  }
  .upd__drip {
    position: absolute !important;
    z-index: 2 !important;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 3px;
    pointer-events: none;
  }
  .upd__drip::after {
    content: "";
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: -8px;
    width: 19px;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--upd-accent) 16%, transparent) 18%,
      color-mix(in srgb, var(--upd-accent) 22%, transparent) 58%,
      transparent 100%
    );
    filter: blur(7px);
    opacity: 0.62;
    pointer-events: none;
  }
  .upd__drip::before {
    content: "";
    position: absolute;
    z-index: 2;
    left: -10px;
    top: 0;
    width: 23px;
    height: 46px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, white 38%, var(--upd-accent)) 0%,
      color-mix(in srgb, var(--upd-accent) 62%, transparent) 34%,
      transparent 74%
    );
    filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    animation: upd-rail-aura 8.4s linear infinite;
    will-change: top, transform, opacity, filter;
  }
  .upd__drip-bead {
    content: "";
    position: absolute;
    z-index: 3;
    left: -4px;
    top: 0;
    width: 10px;
    height: 16px;
    clip-path: polygon(50% 0%, 78% 34%, 94% 60%, 88% 82%, 68% 96%, 50% 100%, 32% 96%, 12% 82%, 6% 60%, 22% 34%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--upd-accent) 52%, white),
      var(--upd-accent) 48%,
      color-mix(in srgb, var(--upd-accent) 68%, black)
    );
    box-shadow:
      0 0 10px color-mix(in srgb, var(--upd-accent) 68%, transparent),
      0 0 25px color-mix(in srgb, var(--upd-accent) 42%, transparent);
    opacity: 0;
    transform: translateY(0) scale(0.2);
    transform-origin: 50% 0;
    filter: blur(1.5px);
    animation: upd-rail-bead 8.4s linear infinite;
    will-change: top, transform, opacity, filter;
  }
  .upd__drip-bead::before {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 3px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, white 70%, var(--upd-accent));
    opacity: 0.68;
  }
  .upd--current::before {
    opacity: 0.52;
  }
  .upd--featured::before {
    opacity: 0.82;
    animation: upd-ooze 9s ease-in-out infinite alternate;
  }
  .upd:not(.upd--current):hover::before,
  .upd:not(.upd--current):focus-within::before {
    opacity: 0.24;
  }
  .upd--current:hover::before,
  .upd--current:focus-within::before {
    opacity: 0.66;
  }
  .upd:hover {
    border-color: var(--color-line-strong);
    border-left-color: var(--upd-accent);
    background: var(--color-bg-card);
  }

  /* Meta column — date stacked over the version pill. */
  .upd__meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    padding-top: 2px;
  }
  .upd__date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-subtle);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .upd__ver {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--upd-accent);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--upd-accent) 35%, transparent);
    background: color-mix(in srgb, var(--upd-accent) 10%, transparent);
  }
  .upd--current .upd__ver {
    position: relative;
    isolation: isolate;
    overflow: visible;
  }
  .upd__ver-drips {
    position: absolute;
    z-index: 2;
    left: 5px;
    right: 5px;
    top: calc(100% + 3px);
    bottom: auto;
    height: 20px;
    pointer-events: none;
  }
  .upd__ver-drip {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    width: 6px;
    height: 10px;
    clip-path: polygon(50% 0%, 78% 34%, 94% 60%, 88% 82%, 68% 96%, 50% 100%, 32% 96%, 12% 82%, 6% 60%, 22% 34%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--upd-accent) 52%, white),
      var(--upd-accent) 48%,
      color-mix(in srgb, var(--upd-accent) 68%, black)
    );
    box-shadow:
      0 0 8px color-mix(in srgb, var(--upd-accent) 58%, transparent),
      0 0 14px color-mix(in srgb, var(--upd-accent) 30%, transparent);
    opacity: 0;
    transform: translate3d(0, -1px, 0) scale(0.16, 0.18);
    transform-origin: 50% 0;
    pointer-events: none;
    animation: upd-chip-drip 4.6s cubic-bezier(0.2, 0.8, 0.24, 1) infinite var(--drip-delay, 0s);
    will-change: transform, opacity, filter;
  }
  .upd__ver-drip[data-drop-active="false"] {
    opacity: 0 !important;
  }
  .upd__ver-drip--short {
    --drip-delay: 0s;
    left: 12%;
    width: 5px;
    height: 8px;
  }
  .upd__ver-drip--main {
    --drip-delay: -0.22s;
    left: 47%;
    width: 7px;
    height: 11px;
  }
  .upd__ver-drip--tail {
    --drip-delay: -0.44s;
    left: auto;
    right: 0;
    width: 5px;
    height: 8px;
  }

  .upd__product {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--upd-accent);
    text-decoration: none;
    transition: opacity 160ms ease;
  }
  a.upd__product:hover { opacity: 0.7; }
  .upd__product--plain { color: var(--color-muted); }

  .upd__title {
    margin-top: 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text);
  }
  .upd__text {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-text-mid);
  }

  .upd__list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .upd__item {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-mid);
  }
  .upd__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--upd-accent);
    transform: rotate(45deg);
  }

  @keyframes upd-ooze {
    from { transform: translate3d(0, 0, 0) scale(0.94); }
    to { transform: translate3d(48px, 18px, 0) scale(1.12); }
  }

  @keyframes upd-rail-bead {
    0%, 6% { top: 0; opacity: 0; transform: scale(0.16, 0.22); filter: blur(1.5px); }
    12% { top: 0; opacity: 0.62; transform: scale(0.27, 0.36); filter: blur(0.9px); }
    28% { top: 16%; opacity: 0.84; transform: scale(0.43, 0.56); filter: blur(0.35px); }
    48% { top: 43%; opacity: 0.96; transform: scale(0.65, 0.82); filter: blur(0); }
    68% { top: 69%; opacity: 1; transform: scale(0.9, 1.1); filter: blur(0); }
    84% { top: calc(100% - 10px); opacity: 1; transform: scale(1.02, 1.2); filter: blur(0); }
    90% { top: calc(100% + 1px); opacity: 0.93; transform: scale(1.12, 1.34); filter: blur(0.15px); }
    96%, 100% { top: calc(100% + 31px); opacity: 0; transform: scale(0.2, 0.32); filter: blur(4px); }
  }

  @keyframes upd-rail-aura {
    0%, 6% { top: -8px; opacity: 0; transform: scale(0.26, 0.34); filter: blur(9px); }
    12% { top: -5px; opacity: 0.16; transform: scale(0.42, 0.52); filter: blur(8px); }
    28% { top: 10%; opacity: 0.29; transform: scale(0.62, 0.72); filter: blur(7px); }
    48% { top: 36%; opacity: 0.4; transform: scale(0.82, 0.9); filter: blur(7px); }
    68% { top: 62%; opacity: 0.48; transform: scale(1, 1.06); filter: blur(7px); }
    84% { top: calc(100% - 42px); opacity: 0.58; transform: scale(1.1, 1.16); filter: blur(7px); }
    90% { top: calc(100% - 24px); opacity: 0.46; transform: scale(1.16, 1.22); filter: blur(7px); }
    96%, 100% { top: calc(100% + 18px); opacity: 0; transform: scale(0.34, 0.5); filter: blur(10px); }
  }

  @keyframes upd-chip-drip {
    0%, 10% { opacity: 0; transform: translate3d(0, -1px, 0) scale(0.16, 0.16); filter: blur(1px); }
    15% { opacity: 0.16; transform: translate3d(0, 0, 0) scale(0.27, 0.26); filter: blur(0.65px); }
    21% { opacity: 0.48; transform: translate3d(0, 0.15px, 0) scale(0.44, 0.42); filter: blur(0.3px); }
    28% { opacity: 0.78; transform: translate3d(0, 0.55px, 0) scale(0.64, 0.62); filter: blur(0.1px); }
    35% { opacity: 0.97; transform: translate3d(0, 1.2px, 0) scale(0.84, 0.82); filter: blur(0); }
    42% { opacity: 1; transform: translate3d(0, 2.4px, 0) scale(0.99, 1.02); filter: blur(0); }
    51% { opacity: 0.96; transform: translate3d(0, 5.6px, 0) scale(1, 1.12); filter: blur(0.08px); }
    62% { opacity: 0.82; transform: translate3d(0, 9.9px, 0) scale(0.9, 1.06); filter: blur(0.24px); }
    75% { opacity: 0.58; transform: translate3d(0, 14.8px, 0) scale(0.72, 0.9); filter: blur(0.5px); }
    89% { opacity: 0.22; transform: translate3d(0, 20.8px, 0) scale(0.42, 0.66); filter: blur(1.1px); }
    100% { opacity: 0; transform: translate3d(0, 26px, 0) scale(0.18, 0.36); filter: blur(2.1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .upd,
    .upd__ver,
    .upd::before {
      transition: none;
    }
    .upd--featured::before {
      animation: none;
    }
    .upd__drip-bead {
      animation: none;
    }
    .upd__drip::before {
      animation: none;
      top: calc(100% - 46px);
      opacity: 0.46;
      transform: scale(1, 1.06);
      filter: blur(7px);
    }
    .upd__drip-bead {
      top: calc(100% - 10px);
      opacity: 0.96;
      transform: scale(0.92);
      filter: none;
    }
    .upd__ver-drip {
      animation: none;
    }
    .upd__ver-drip {
      opacity: 0.82;
      transform: translate3d(0, 0, 0) scale(0.8, 0.9);
    }
  }

  /* These update visuals are the page's content treatment, so the page opts in
   * explicitly even when the desktop/browser accessibility setting reduces motion. */
  @media (prefers-reduced-motion: reduce) {
    [data-motion-required="true"] .upd,
    [data-motion-required="true"] .upd__ver,
    [data-motion-required="true"] .upd::before {
      transition: border-color 200ms ease, background 200ms ease, opacity 240ms ease !important;
    }
    [data-motion-required="true"] .upd--featured::before,
    [data-motion-preview="on"] .upd--featured::before {
      animation: upd-ooze 9s ease-in-out infinite alternate !important;
    }
    [data-motion-required="true"] .upd__drip-bead,
    [data-motion-preview="on"] .upd__drip-bead {
      animation: upd-rail-bead 8.4s linear infinite !important;
    }
    [data-motion-required="true"] .upd__drip::before,
    [data-motion-preview="on"] .upd__drip::before {
      animation: upd-rail-aura 8.4s linear infinite !important;
    }
    [data-motion-required="true"] .upd__ver-drip,
    [data-motion-preview="on"] .upd__ver-drip {
      animation: upd-chip-drip 4.6s cubic-bezier(0.2, 0.8, 0.24, 1) infinite var(--drip-delay, 0s) !important;
    }
  }

  @media (max-width: 640px) {
    .upd {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .upd__meta {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }
  }
</style>
