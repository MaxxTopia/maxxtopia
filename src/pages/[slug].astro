// Per-LIVE-product receipts-band config — version meta + two specs +
// open-source repo. The 4-up replaces the old hero stats aside.
function fmtReleaseDate(iso: string | undefined): string {
  if (!iso) return '';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

// Per-product reconversion config — the closing CTA + 3-question FAQ.
// LIVE products use the install CTA; SOON / BETA products inherit
// `product.primaryCta` (typically the waitlist link). Three FAQs ceiling.
const reconvertConfig: Record<string, {
  closingLine: string;
  faqs: Array<{ q: string; a: string }>;
}> = {
  optimizationmaxxing: {
    closingLine: 'Tune what you measured. Revert what didn\'t help.',
    faqs: [
      {
        q: 'Is this just registry voodoo?',
        a: "No. Every tweak cites a Microsoft Learn doc, NVIDIA dev note, or vendor whitepaper before you flip the switch. Twenty live on this page; the other 80 ship cited inside the build. Hone publishes none of theirs. Paragon publishes none of theirs.",
      },
      {
        q: 'Will it brick my PC?',
        a: "No. Every action snapshots its pre-state to a local SQLite ledger before applying. One-click revert at any time, any tweak. Zero BIOS writes, zero kernel drivers — that line is a hard refusal in the engine.",
      },
      {
        q: "What's the catch?",
        a: "Free. 3.6 MB. The catch is that a handful of the more aggressive tweaks (CPU set pinning, certain registry deep cuts) live behind a one-time $8 VIP unlock. Everything else — including full undo — is unlocked from the install.",
      },
    ],
  },
  discordmaxxer: {
    closingLine: 'Same Discord. 753 MB less of it.',
    faqs: [
      {
        q: 'Will Discord ban me?',
        a: "We don't modify Discord's network protocol. Same WebSocket, same APIs, same identity flow — we just strip the renderer-side bloat. No mod logs report bans for client-side mods of this shape; we ship the source so you can audit what hits the wire.",
      },
      {
        q: 'Is my data safe?',
        a: "Your messages and voice still go to Discord's servers — that's where your friends are. What we strip is Discord-Inc.'s telemetry pipeline: analytics, crash beacons, ad-tech, growth experiments. Zero outbound calls outside the chat itself.",
      },
      {
        q: 'Is it really open source?',
        a: "Yes. The repo is in the receipts band above. Clone it, read the diff against stock, sign it with your own key. The whole point is that you don't have to take our word for what we stripped.",
      },
    ],
  },
  clipmaxxer: {
    closingLine: 'You stream. We post your shorts.',
    faqs: [
      {
        q: 'How does it work?',
        a: "It's done-for-you. You apply with your channel, we confirm we can automate your posting, then your best moments get cut to vertical, captioned, and posted to your socials on schedule. You don't touch an editor.",
      },
      {
        q: "What do the shorts look like?",
        a: "Vertical 9:16, your face kept in frame (per-frame face-tight reframe), captions burned in, cut to the moment. The same editor built for the suite — run for you.",
      },
      {
        q: "Who's it for, and what's it cost?",
        a: "Streamers with an audience already rolling. One flat monthly price, managed, cancel anytime — apply and we'll get you the details and onboarded.",
      },
    ],
  },
  dropmaxxer: {
    closingLine: 'Stop guessing your drop.',
    faqs: [
      {
        q: 'Is this just another loot map?',
        a: "No. Loot maps are static pictures with arrows. This is a drop calculator with cited Fortnite physics constants and a community-data corpus — when your path matches the corpus, you get a community-tested answer; when it doesn't, the calibrated physics solver runs the math.",
      },
      {
        q: "How do I know which answered?",
        a: "Every result carries a transparency badge in the UI: LT-EXACT, LT-NEAR, or SIMULATOR. You always know whether you're seeing a community-corroborated answer or a fresh physics calc. Most other tools won't even tell you they're guessing.",
      },
      {
        q: 'How current are the POIs?',
        a: "Current-season only. POIs are sourced from the live game catalog and refresh the day each season ships. Reality Falls isn't suggested because Reality Falls isn't a thing.",
      },
    ],
  },
  // aimmaxxer intentionally omitted — its page closes with the bespoke
  // "Aimmaxxer v2, the real deal" teaser in the AimWarmup section instead.
  viewmaxxing: {
    closingLine: 'One app. Every mood. Zero bills.',
    faqs: [
      {
        q: 'Is it really free? What\'s the catch?',
        a: "Free. No account, no subscription, no trial that flips to paid. It runs locally on your TV box, and your watch history and \"For You\" recs stay on the device — nothing is uploaded. The honest catch: it's a sideloaded, personal-grade app for TV boxes, not a Play Store download.",
      },
      {
        q: 'Will it run on my box?',
        a: "It's built for Android TV boxes, set-top boxes and Fire-Stick-class devices, and it's D-pad/remote-first by design. You sideload it — no store account needed — and the in-app updater keeps it current after that. No box? See the next answer — it runs on a PC too.",
      },
      {
        q: "No TV box — can I run it on my PC?",
        a: "Yes. It's a normal Android app, so a free Android emulator on Windows (BlueStacks is the easiest) runs it full-speed, and your keyboard's arrow keys drive it like a remote. Full step-by-step at maxxtopia.com/guides/viewmaxxing-on-pc — about ten minutes, no TV box required.",
      },
      {
        q: 'How do I get it?',
        a: "Join the Maxxtopia Discord and open the #free-stuff channel — the latest build (updated often) is posted there with sideload steps. Invite: discord.gg/S78eecbWdx. Sideload it onto your box or a PC emulator and open it.",
      },
    ],
  },
  extensionmaxxing: {
    closingLine: 'One blocker. Four browsers. Zero ads.',
    faqs: [
      {
        q: 'How do I install it?',
        a: "Download the zip, unzip it somewhere you'll keep it, then open chrome://extensions (or brave:// / edge://), turn on Developer mode, click Load unpacked, and pick the unzipped folder. A welcome tab opens and you're blocking. Takes about thirty seconds.",
      },
      {
        q: "Why isn't it on the Chrome Web Store?",
        a: "A YouTube and Twitch ad blocker on the store is a takedown waiting to happen — that's exactly how the big blockers got gutted. Self-hosting the build sidesteps the store's veto entirely. The trade-off is no silent auto-update; the popup flags you when a refresh is worth running, and filter lists update weekly on their own. Firefox gets a one-click signed build shortly.",
      },
      {
        q: 'Does it work on my phone?',
        a: "Yes — add our mobile filter list. In Brave (Android or iOS): Settings → Brave Shields & privacy → Content filtering → Add custom filter list, and paste https://dl.maxxtopia.com/adblockmaxxer-mobile.txt. It blocks ad and tracker domains across the web — display ads, trackers, Spotify-web and SoundCloud ads — and auto-refreshes. Mobile browsers can't run extension code, so the YouTube player-strip and Twitch swap stay desktop-only, and YouTube video ads remain unblockable on any phone. Honest reach over marketing reach.",
      },
    ],
  },
  snipemaxxer: {
    closingLine: 'Know the lobby. Win the points game.',
    faqs: [
      {
        q: 'Will this get me banned?',
        a: "No. Snipemaxxer never touches Fortnite's process — no memory reading, no injection, no overlay hooked into the game. It reads the official server replay of your match, the same public match data Fortnite Tracker and fortnite.gg work from. There's nothing for BattlEye or EAC to flag.",
      },
      {
        q: "I've landed and the report is empty. Is it broken?",
        a: "Almost certainly not — that's how it works. Snipemaxxer reads the official server replay of your match rather than the game's memory, and the replay is only what the server has already recorded. So the scouting report shows up roughly five minutes into the match and then trails the live game by about that much. Nothing appears in the first minutes because there is nothing to read yet. The one thing that is instant is your tournament standing: points, rank and qualify math come from the live leaderboard, not the replay.",
      },
      {
        q: 'How does it actually help mid-tournament?',
        a: "Two ways, at two speeds. Between games, the HUD polls your live tournament standing — your points, your rank, and how many games you have left in the window — and tells you, for the format you're playing, whether to play for placement or push for elims to make the cutoff. That part has no delay. Then, about five minutes into a match, the scouting report names the lobby: which pros and live streamers are in it, who's beaten down for an easy key, who's off-region, and where everyone landed. It's a read on the game you're in, not a live radar — but it's intel you cannot get from inside your own box fight.",
      },
      {
        q: 'Which modes does it work in?',
        a: "Tournaments only — FNCS, Cash Cups and other standard BR competitive events. It reads the official server replay Epic generates for those matches, so it's built for cups, not casual play. If it's not finding a game in Ranked, pubs, Reload or Zero Build arena, that's expected — those modes don't produce a downloadable replay to read. Set your Fortnite name once, tick auto-detect, and it finds your cup matches on its own. Runs on the same PC you play on — no second PC or capture card needed.",
      },
    ],
  },
  streammaxxing: {
    closingLine: 'Runs on your PC. Fires the instant it happens.',
    faqs: [
      {
        q: 'Does it cost anything?',
        a: "Free. No account, no subscription. It runs entirely on your PC — there's no server for us to bill you for. Botrix import, the clip trimmer, loudness-normalize, and voice-clone read-outs are all in the free build.",
      },
      {
        q: 'Will it work with my existing alerts?',
        a: "Yes. Paste your Botrix link and it pulls every alert and downloads all the media to your disk — same look, now firing locally. Nothing to rebuild from scratch.",
      },
      {
        q: 'Is the voice cloning private?',
        a: "It's consent-gated and 100% on-device. The voice is synthesized locally on your GPU from a short reference clip — no message, no audio, nothing ever leaves your machine.",
      },
    ],
  },
};

const receiptsConfig: Record<string, {
