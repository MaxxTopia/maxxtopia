---
import Layout from '../layouts/Layout.astro';
import StatusPill from '../components/StatusPill.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
if (!product) {
  return Astro.redirect('/404');
}

const related = products.filter((p) => p.slug !== product.slug).slice(0, 3);
const isLive = product.status === 'live';
---

<Layout
  title={`${product.name} — Maxxtopia`}
  description={product.tagline}
>
  <!-- Product hero -->
  <section class="relative overflow-hidden">
    <div class="ambient-glow"></div>
    <div class="absolute inset-0 bg-grid opacity-40"></div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-16 sm:pt-20 pb-16">
      <a href="/#suite" class="inline-flex items-center gap-1.5 text-[13px] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors mb-10">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        All products
      </a>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
        <div class="md:col-span-8">
          <div class="reveal reveal-1 flex items-center gap-3 mb-6">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] text-[var(--color-accent)] text-[22px]"
              aria-hidden="true"
            >
              {product.glyph}
            </span>
            <div>
              <p class="text-[11px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
                {product.category}
              </p>
              <h1 class="text-[28px] font-semibold tracking-tight">{product.name}</h1>
            </div>
            <div class="ml-auto flex items-center gap-2">
              <StatusPill status={product.status} />
              {product.version && (
                <span class="pill">{product.version}</span>
              )}
            </div>
          </div>

          <h2 class="reveal reveal-2 text-[36px] sm:text-[52px] font-semibold tracking-[-0.03em] leading-[1.02] gradient-text max-w-2xl">
            {product.tagline}
          </h2>

          <p class="reveal reveal-3 mt-6 text-[16.5px] leading-relaxed text-[var(--color-muted)] max-w-2xl">
            {product.longDescription}
          </p>

          <div class="reveal reveal-4 mt-8 flex flex-wrap items-center gap-3">
            {isLive ? (
              <a href={product.primaryCta.href} class="btn-primary">
                {product.primaryCta.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </a>
            ) : (
              <a href={product.primaryCta.href} class="btn-primary">
                {product.primaryCta.label}
              </a>
            )}
            {product.secondaryCta && (
              <a href={product.secondaryCta.href} class="btn-secondary">
                {product.secondaryCta.label}
              </a>
            )}
          </div>
        </div>

        {product.stats && product.stats.length > 0 && (
          <aside class="reveal reveal-5 md:col-span-4 grid grid-cols-2 gap-px rounded-xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
            {product.stats.map((s) => (
              <div class="bg-[var(--color-bg)] p-5">
                <p class="text-[11px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
                  {s.label}
                </p>
                <p class="mt-1.5 text-[22px] font-semibold tracking-tight">
                  {s.value}
                </p>
              </div>
            ))}
          </aside>
        )}
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[var(--color-line-strong)] to-transparent"></div>
  </section>

  <!-- Features -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20">
      <div class="mb-10">
        <p class="text-[12px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
          What's inside
        </p>
        <h2 class="mt-2 text-[28px] sm:text-[36px] font-semibold tracking-tight gradient-text leading-tight">
          Built for the player who measures.
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px rounded-xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {product.features.map((f, i) => (
          <div class="bg-[var(--color-bg)] p-6 sm:p-7">
            <div class="text-[var(--color-accent)] text-[13px] font-mono mb-3">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="text-[17px] font-semibold tracking-tight">{f.title}</h3>
            <p class="mt-2.5 text-[14.5px] text-[var(--color-muted)] leading-relaxed">
              {f.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Status / waitlist banner for non-live -->
  {!isLive && (
    <section class="relative">
      <div class="mx-auto max-w-6xl px-5 sm:px-8 pb-16">
        <div class="rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h3 class="text-[20px] font-semibold tracking-tight">
              {product.status === 'beta' ? 'In active beta.' : "We're building this now."}
            </h3>
            <p class="mt-2 text-[14.5px] text-[var(--color-muted)] max-w-md leading-relaxed">
              {product.status === 'beta'
                ? 'Join the early-access list. First spots will open as the suite hits v1.0.'
                : "Get notified the day it ships. No spam — just one email when it's ready."}
            </p>
          </div>
          <a href="#waitlist" class="btn-primary shrink-0">
            Join waitlist
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Related -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-20 border-t border-[var(--color-line)]">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="text-[12px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
            Also in the suite
          </p>
          <h2 class="mt-2 text-[24px] sm:text-[32px] font-semibold tracking-tight gradient-text">
            Different surface. Same standard.
          </h2>
        </div>
        <a href="/#suite" class="hidden sm:inline-flex btn-secondary">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {related.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>
</Layout>
