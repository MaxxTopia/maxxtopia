  versionDate: string;
  repoUrl: string | null;
  repoLabel: string;
  linkLabel?: string;
  linkSub?: string;
  stats: Array<{ label: string; value: string }>;
}> = {
  optimizationmaxxing: {
    version: omReleaseMeta.version,
    versionDate: fmtReleaseDate(omReleaseMeta.publishedAt),
    repoUrl: 'https://github.com/MaxxTopia/optimizationmaxxing',
    repoLabel: 'MaxxTopia/optimizationmaxxing',
    stats: [
      { label: 'Audited tweaks', value: '100' },
      { label: 'Installer size', value: '3.6 MB' },
    ],
  },
  discordmaxxer: {
    version: dmReleaseMeta.version,
    versionDate: fmtReleaseDate(dmReleaseMeta.publishedAt),
    repoUrl: 'https://github.com/MaxxTopia/discordmaxxer',
    repoLabel: 'MaxxTopia/discordmaxxer',
    stats: [
      { label: 'Resident RAM', value: '288 MB' },
      { label: 'Idle CPU', value: '0%' },
    ],
  },
  // Closed-source live products: no public repo, so the 4th cell becomes a
  // download CTA instead of a repo link.
  extensionmaxxing: {
    version: 'v1.2.7',
    versionDate: 'Jul 2026',
    repoUrl: 'https://dl.maxxtopia.com/adblockmaxxer-chrome-v1.2.7.zip',
    repoLabel: 'Chrome · Brave · Edge · Firefox',
    linkLabel: 'Download',
    linkSub: 'Free · MV3',
    stats: [
      { label: 'Browsers', value: '4' },
      { label: 'Filter rules', value: '21,370' },
    ],
  },
  streammaxxing: {
    // Keep in sync with the streammaxxing `version` in products.ts (shown in the hero pill).
    version: '0.1.15',
    versionDate: 'Jul 2026',
    repoUrl: 'https://dl.maxxtopia.com/streammaxxing/streammaxxing-latest-x64-setup.exe',
    repoLabel: 'Windows',
    linkLabel: 'Download',
    linkSub: 'Free installer',
    stats: [
      { label: 'Alert latency', value: 'Local' },
      { label: 'Price', value: 'Free' },
    ],
  },
};

// Per-product build status — drives the BuildStatus banner.
// Tuned by hand based on how close each product actually is.
// progress = hand-set self-estimate of how close each product is (not measured).
const buildStatus: Record<string, { progress: number; dropTarget: string; channel: string }> = {
  clipmaxxer:   { progress: 78, dropTarget: 'Q3 · 2026',        channel: 'v0.4 · INTERNAL ALPHA' },
  aimmaxxer:    { progress: 38, dropTarget: 'Q4 · 2026',        channel: 'v0.1 · CALIBRATION' },
  viewmaxxing:  { progress: 12, dropTarget: 'TBD',              channel: 'v0 · SCOPE RESEARCH' },
  editmaxxing:  { progress: 4,  dropTarget: 'ON HOLD',          channel: 'v0 · FEASIBILITY' },
};

export async function getStaticPaths() {
  // clipmaxxer has a bespoke, self-themed page at src/pages/clipmaxxer/index.astro
  // — exclude it here so the dynamic route doesn't also emit /clipmaxxer and
  // collide with the static one. The product stays in `products` so cards,
  // the home grid, the footer and the sitemap still link to it.
  return products
    .filter((product) => product.slug !== 'clipmaxxer')
    .map((product) => ({
      params: { slug: product.slug },
      props: { product },
    }));
}

const { product } = Astro.props;
if (!product) {
  return Astro.redirect('/404');
}

const related = products.filter((p) => p.slug !== product.slug).slice(0, 3);
const isLive = product.status === 'live';
const isBeta = product.status === 'beta';
const isSoon = product.status === 'soon' || product.status === 'dev';
const root = product.name.replace(/maxx(er|ing)$/i, '');
const suffix = product.name.match(/maxx(er|ing)$/i)?.[0] ?? '';
const screenshotMain = product.screenshots?.[0];
const screenshotExtras = product.screenshots?.slice(1) ?? [];

// Per-product accent treatment: viewmaxxing's green page recolors the hero
// number + stat tiles (kept in sync) and dims the loud suite-magenta CTA to a
// glassy emerald that matches the page. Everything else keeps the suite look.
const numGradient =
  product.slug === 'viewmaxxing' ? 'gradient-view'
  : product.slug === 'streammaxxing' ? 'gradient-omni'
  : product.slug === 'playlistmaxxing' ? 'gradient-music'
  : 'gradient-suite';
const primaryBtnClass = product.slug === 'viewmaxxing' ? 'btn-view' : 'btn-primary';

// AdBlock-Maxxer: pull the hero screenshot up into the empty right column
// (under the Live / version pills) instead of the full-width shot below.
const isExt = product.slug === 'extensionmaxxing';

// Aimmaxxer: interim resource page — per-game KovaaK warmups + gear advice +
// a "v2, the real deal" teaser (the AimWarmup section) instead of the generic
// feature grid / build-status banner.
const isAim = product.slug === 'aimmaxxer';

// LIVE-product fork: OM + DM each get a bespoke story shape that demonstrates
// the moat (sourced tweaks · subtracted MB) instead of a generic feature grid.
// SOON products keep the original card-grid treatment. Drives:
//   - stats aside hidden on LIVE (migrates to receipts band)
//   - per-product story sections render after the hero
const isOM = product.slug === 'optimizationmaxxing';
const isDM = product.slug === 'discordmaxxer';
// Dropmaxxer is a browser app — embed it live so visitors can test it in-page
// instead of just seeing a screenshot.
const isDrop = product.slug === 'dropmaxxer';
// Playlistmaxxing promotes its bespoke spinning-vinyl showcase to the hero;
// the 3-platform / mini-player / karaoke story continues beneath the deck.
const isPlaylist = product.slug === 'playlistmaxxing';
// Viewmaxxing gets a bespoke "One Remote" hero — a living-room TV that self-surfs
// through the real app's surfaces (Home/Movies/TV/Anime/YouTube/Twitch/Search),
// each a real captured screenshot. Replaces the shared hero.
const isView = product.slug === 'viewmaxxing';

// Products that pull their hero media UP into the right column, filling the
// empty space beside the giant hero number/tagline instead of the full-width
// shot below: the AdBlock welcome shot + snipemaxxer lobby screenshot (images),
// and the DM + OM demo players (videos). Left column narrows to 7 cols.
const isSnipe = product.slug === 'snipemaxxer';
const isClip = product.slug === 'clipmaxxer';
const isStream = product.slug === 'streammaxxing';
const heroAsideVideo = (isDM || isOM || isStream) && !!product.demoVideo;
const heroShotAside = isExt || isSnipe || isClip || heroAsideVideo;

// Clipmaxxer hero: two real Clipmaxxer-cut creator shorts (9:16) shown to the
// right of the "Done-for-you" stat as portfolio proof. They start frozen on the
// poster (muted = paused rule); a click plays the reel with sound.
const clipReels = isClip
  ? [
      { src: '/screenshots/clipmaxxer/demo-cut-tenz.mp4', poster: '/screenshots/clipmaxxer/demo-cut-tenz-poster.jpg', label: 'TenZ · clutch' },
      { src: '/screenshots/clipmaxxer/demo-cut-out.mp4', poster: '/screenshots/clipmaxxer/demo-cut-out-poster.jpg', label: 'Clutch cut' },
    ]
  : [];

// Downloadable .exe installers get the Windows system-requirements line + the
// SmartScreen reassurance. The old gate matched 'setup.exe', which never hit
// the real 'Name-Setup-x.y.z.exe' filenames — so the note silently never showed.
const isExeDownload = !!product.primaryCta?.href?.toLowerCase().endsWith('.exe');

// SEO <title>/description overrides — META ONLY, the visible hero copy is
// untouched. These lead with the real search keyword (nobody googles the
// coined brand word) and keep the meta description ≤160 chars.
const seoTitleOverride: Record<string, string> = {
  discordmaxxer: 'Lightweight Discord Client — 750 MB Less RAM | Discordmaxxer',
  optimizationmaxxing: 'Windows Game Optimizer — 100 Audited FPS Tweaks | Maxxtopia',
  extensionmaxxing: 'Free YouTube & Twitch Ad Blocker + More | AdBlock-Maxxer',
  streammaxxing: 'Free Stream Alerts, Overlays & TTS | Streammaxxing',
};
const seoDescOverride: Record<string, string> = {
  discordmaxxer: 'A lightweight Discord client that runs at 288 MB instead of 1,041 — same servers, friends and pings, 753 MB lighter. Free, native, zero telemetry.',
  optimizationmaxxing: 'A free Windows game optimizer: 100 audited, reversible FPS tweaks with cited sources and one-click undo. No placebos, no bloat, no telemetry.',
  extensionmaxxing: 'Free ad blocker for YouTube, Twitch and Spotify across Chrome, Brave, Edge and Firefox. Manifest V3-ready, no Web Store gatekeeping — and more than ads.',
  streammaxxing: 'Free, local Twitch stream alerts, overlays and TTS — no cloud hop, no delay. Import Botrix, trim clips, normalize loudness. Runs on your PC.',
};
const pageTitle = seoTitleOverride[product.slug] ?? `${product.name} — ${product.tagline}`;
const pageDescription = seoDescOverride[product.slug] ?? product.description;
// Products that show the How-it-works walkthrough ABOVE the feature zones:
// OM + dropmaxxer (zero-install / try-it-first), and streammaxxing (lead with
// the "here's everything it does" walkthrough before the latency moat zones).
const howItWorksFirst =
  isOM ||
  isDM ||
  product.slug === 'dropmaxxer' ||
  product.slug === 'streammaxxing' ||
  product.slug === 'extensionmaxxing';
const hasBespokeStory = isLive && (isOM || isDM);
const hasZones = Array.isArray(product.zones) && product.zones.length > 0;
// Any live product with a receipts config shows the trust strip (and hides
// the hero stats aside, since the band carries the same numbers). Covers the
// OM/DM bespoke pages plus the closed-source live products (ext, stream).
const hasReceiptsBand = isLive && !!receiptsConfig[product.slug];

// Per-product feature-section header. Each lands on the product's own
// register — generic "What's inside" is a fallback for products that
// haven't earned a bespoke framing yet.
type FeatureHeading = { eyebrow: string; left: string; right: string };
const featureHeadings: Record<string, FeatureHeading> = {
  optimizationmaxxing: { eyebrow: 'The receipts',   left: 'One hundred tweaks.',      right: 'All cited.' },
  discordmaxxer:       { eyebrow: 'The subtraction', left: 'We removed the bloat.',    right: 'All of it.' },
  clipmaxxer:          { eyebrow: 'The cascade',     left: 'Five signals.',            right: 'Never zero.' },
  dropmaxxer:          { eyebrow: 'The math',        left: 'Cited physics.',           right: 'Current map.' },
  aimmaxxer:           { eyebrow: 'The metrics',     left: 'Aim is four things.',      right: 'Drilled four ways.' },
  viewmaxxing:         { eyebrow: 'The lineup',      left: 'Five surfaces.',           right: 'One remote.' },
  extensionmaxxing:    { eyebrow: 'The coverage',    left: 'Four browsers.',           right: 'One blocker.' },
  streammaxxing:       { eyebrow: 'The latency',     left: 'No cloud hop.',            right: 'No delay.' },
  snipemaxxer:         { eyebrow: 'The edge',        left: 'Intel you can\'t get',     right: 'from inside the game.' },
  playlistmaxxing:     { eyebrow: 'The mixtape',     left: 'Every song you love,',     right: 'one page.' },
};
const featureHeading: FeatureHeading | undefined = featureHeadings[product.slug];

// SoftwareApplication JSON-LD — rich results in Google for live products.
// Per-slug keyword sets target real long-tail queries pulled from the
// niches each product competes in. They help topical relevance without
// muddying the visible brand voice in titles.
const softwareKeywords: Record<string, string> = {
  optimizationmaxxing: 'windows gaming optimizer, pc tweaking tool, free windows tuner, gaming pc optimization, low latency windows, fortnite optimization, valorant optimization, dpc latency tweaks, debloat windows 11, windows 11 gaming tweaks, hone alternative, paragon tweaks alternative',
  discordmaxxer: 'lightweight discord client, discord alternative, low ram discord, discord without telemetry, discord client for gamers, vencord alternative, discord ram usage, fast discord client, tournament mode discord, discord plugins',
  clipmaxxer: 'twitch clip maker, opusclip alternative, eklipse alternative, vod clipper, fortnite clip maker, valorant clip maker, replay clip generator, named opponent clips, tiktok shorts for streamers',
  dropmaxxer: 'fortnite drop calculator, drop spot tool, drop path calculator, droppingcalc alternative, fortnite poi planner, fortnite bus speed, fortnite landing optimization',
  aimmaxxer: 'kovaaks warmup routine, best kovaaks scenarios, valorant warmup routine, apex aim warmup, cs2 aim warmup, fortnite aim warmup, overwatch aim warmup, voltaic vdim, best mouse skates, ptfe vs glass mouse skates, tiger arc 2, ai aim trainer, kovaaks alternative',
  viewmaxxing: 'free streaming app for android tv, tv box streaming app, firestick streaming app, ad-free youtube on tv, free movie streaming app, anime streaming app, all-in-one streaming app, android tv box apk, kodi alternative, cord cutting app, twitch on tv box',
  extensionmaxxing: 'ad blocker, youtube ad blocker, twitch ad blocker, manifest v3 ad blocker, ublock origin alternative, ad blocker for chrome brave edge firefox, spotify ad blocker, twitch ads 1080p, ad blocker not on chrome web store, free ad blocker',
  streammaxxing: 'stream alerts, twitch alerts, local stream alerts, botrix alternative, streamlabs alerts alternative, twitch eventsub overlay, donation tts, voice clone tts alerts, obs alert overlay, free stream alerts, clip trimmer, loudness normalize alerts',
  snipemaxxer: 'fortnite lobby scout, fortnite tournament tool, fncs scout, cash cup helper, fortnite replay analyzer, who is in my fortnite lobby, fortnite pro tracker, fortnite live streamer detector, fortnite points calculator, fortnite qualify calculator, fortnite surge tracker, fortnite tournament coach',
  playlistmaxxing: 'cross-platform playlist, combine spotify soundcloud youtube, one playlist all platforms, unified music player, free online music player, no login music player, listen to soundcloud and youtube together, embed music player, music aggregator, web music hub, playlist across services, songs not on spotify',
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  alternateName: product.name.toLowerCase(),
  description: product.description,
  applicationCategory: ({
    'PC Tuning': 'UtilitiesApplication',
    'Communication': 'CommunicationApplication',
    'Browser Extension': 'BrowserApplication',
    'Stream Alerts': 'MultimediaApplication',
    'Streamer Tools': 'MultimediaApplication',
    'TV Streaming': 'MultimediaApplication',
    'Content': 'MultimediaApplication',
    'Music': 'MultimediaApplication',
  } as Record<string, string>)[product.category] ?? 'GameApplication',
  applicationSubCategory: product.category,
  operatingSystem:
    product.slug === 'viewmaxxing' ? 'Android'
    : product.slug === 'playlistmaxxing' ? 'Web browser'
    : 'Windows 10, Windows 11',
  ...(product.version && { softwareVersion: product.version }),
  ...(softwareKeywords[product.slug] && { keywords: softwareKeywords[product.slug] }),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: { '@type': 'Organization', name: 'Maxxtopia', url: 'https://maxxtopia.com' },
  url: `https://maxxtopia.com/${product.slug}/`,
};

// Per-product social card: a bespoke, branded 1200×630 card rendered for
// every product by scripts/render-og-product-cards.mjs → public/og/<slug>.png
// (run `npm run og:cards` after changing a name/tagline/accent). Each card
// carries the product name + tagline + accent, so shared links are visually
// distinct per app instead of all showing the generic site-wide /og.png.
const ogImage = `/og/${product.slug}.png`;

// VideoObject JSON-LD — lets Google surface the demo in video rich results.
// Only products with a demoVideo get one; uploadDate borrows the matching
// release date so the timestamp is honest rather than fabricated.
const firstVideo = product.demoVideo
  ? (Array.isArray(product.demoVideo) ? product.demoVideo[0] : product.demoVideo)
  : undefined;
const videoUploadDate = isOM ? omReleaseMeta.publishedAt : isDM ? dmReleaseMeta.publishedAt : undefined;
const videoSchema = firstVideo
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: `${product.name} — product demo`,
      description: product.description,
      thumbnailUrl: new URL(firstVideo.poster, Astro.site).href,
      contentUrl: new URL(firstVideo.src, Astro.site).href,
      ...(videoUploadDate && { uploadDate: videoUploadDate }),
      publisher: { '@type': 'Organization', name: 'Maxxtopia', url: 'https://maxxtopia.com' },
    }
  : null;

// BreadcrumbList JSON-LD — Home › Product. Earns the breadcrumb trail in
// SERP instead of a bare URL.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maxxtopia.com/' },
    { '@type': 'ListItem', position: 2, name: product.name, item: `https://maxxtopia.com/${product.slug}/` },
  ],
};

// FAQPage JSON-LD — mirrors the Q&A the ReconversionCTA renders visibly on the
// page (via native <details>), so it's Google-compliant, not injected-only
// markup. Emitted under the SAME gate as the visible FAQ block
// (`product.heroStat && reconvertConfig[product.slug]`) so the structured data
// can never claim FAQs the page doesn't actually show. Earns FAQ rich results
// and feeds the answer verbatim to GPT/Claude/Perplexity crawlers.
const faqEntry = reconvertConfig[product.slug];
const faqSchema = product.heroStat && faqEntry && faqEntry.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqEntry.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <!-- Product hero -->
  {isExt && <AdBlockDivide product={product} />}
  {isDM && <DiscordExhibitHero product={product} />}
  {isOM && <OMDiagnosticHero product={product} />}
  {isView && <ViewmaxxingHero product={product} />}
  {isSnipe && <SnipeMaxxerHero product={product} />}
  {isPlaylist && (
    <PlaylistShowcase
      accentHex={product.accentHex}
      accent2Hex={product.accent2Hex}
      logo={product.logo}
      appUrl={product.primaryCta.href}
    />
  )}
  {!isExt && !isDM && !isOM && !isView && !isSnipe && !isPlaylist && (
  <section class="relative overflow-hidden">
    <Aurora intensity="med" />
    <div class="absolute inset-0 bg-grid opacity-50"></div>
    {isBeta && <StatusTape variant="beta" />}

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-20 sm:pt-24 pb-16">
      {isDM && <DiscordKillshot />}
      <a href="/#apps" class="inline-flex items-center gap-1.5 text-[13px] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors mb-12">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        All products
      </a>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start">
        <div class={heroShotAside ? 'md:col-span-7' : 'md:col-span-8'}>
          <div class="reveal reveal-1 flex items-center gap-3.5 mb-8">
            <span class="glyph-badge !w-12 !h-12" style={`--accent: ${product.accentHex}; ${product.logo ? 'padding: 4px;' : ''}`} aria-hidden="true">
              {product.logo ? (
                <img src={product.logo} alt="" width="40" height="40" style="width: 100%; height: 100%; object-fit: contain;" />
              ) : (
                <span style={`color: ${product.accentHex}; font-size: 22px;`}>{product.glyph}</span>
              )}
            </span>
            <div>
              <p class="text-[10.5px] uppercase tracking-[0.1em] text-[var(--color-subtle)] font-mono">
                {product.category}
              </p>
              <h1 class="text-[24px] font-semibold tracking-tight">
                <span class="text-[var(--color-text)]">{root}</span><span class="brand-shimmer">{suffix}</span>
              </h1>
            </div>
            <div class="ml-auto flex items-center gap-2">
              <StatusPill status={product.status} />
              {product.version && <span class="pill">{product.version}</span>}
            </div>
          </div>

          {product.heroStat && (product.heroStat.inline ? (
            <p class="reveal reveal-2 mb-6 text-[12px] sm:text-[13px] uppercase tracking-[0.14em] font-mono text-[var(--color-muted)]">
              <span class="text-[var(--color-text)] font-semibold">{product.heroStat.value}</span> {product.heroStat.label}
            </p>
          ) : (
            <div class="reveal reveal-2 mb-6">
              <p
                class={`font-display ${numGradient} leading-[0.85] tracking-[0.005em]`}
                style="font-size: clamp(96px, 18vw, 220px);"
                aria-label={`${product.heroStat.value} ${product.heroStat.label}`}
              >
                {product.heroStat.value}
              </p>
              <p class="mt-2 text-[12px] sm:text-[13px] uppercase tracking-[0.14em] font-mono text-[var(--color-muted)]">
                {product.heroStat.label}
              </p>
            </div>
          ))}

          <h2 class="reveal reveal-3 text-[34px] sm:text-[48px] md:text-[58px] font-semibold tracking-[-0.025em] leading-[1.1] gradient-text max-w-2xl">
            {product.tagline}
          </h2>

          <p class="reveal reveal-4 mt-6 text-[16.5px] leading-[1.55] text-[var(--color-text-mid)] max-w-2xl">
            {product.longDescription}
          </p>

          <div class="reveal reveal-5 mt-9 flex flex-wrap items-center gap-3">
            {isLive ? (
              <a
                href={product.primaryCta.href}
                class={primaryBtnClass}
                target={product.primaryCta.external ? '_blank' : undefined}
                rel={product.primaryCta.external ? 'noopener' : undefined}
              >
                {product.primaryCta.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </a>
            ) : isBeta ? (
              <>
                <a
                  href={product.primaryCta.href}
                  class={primaryBtnClass}
                  target={product.primaryCta.external ? '_blank' : undefined}
                  rel={product.primaryCta.external ? 'noopener' : undefined}
                >
                  {product.primaryCta.label}
                </a>
                {product.deployedUrl && (
                  <a href={product.deployedUrl} target="_blank" rel="noopener" class="btn-secondary">
                    Open the live build
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
                    </svg>
                  </a>
                )}
              </>
            ) : (
              <a
                href={product.primaryCta.href}
                class={primaryBtnClass}
                target={product.primaryCta.external ? '_blank' : undefined}
                rel={product.primaryCta.external ? 'noopener' : undefined}
              >
                {product.primaryCta.label}
              </a>
            )}
            {product.secondaryCta && (
              <a
                href={product.secondaryCta.href}
                class="btn-secondary"
                target={product.secondaryCta.external ? '_blank' : undefined}
                rel={product.secondaryCta.external ? 'noopener' : undefined}
              >
                {product.secondaryCta.label}
              </a>
            )}
          </div>
          {product.tertiaryCta && (
            <p class="reveal reveal-5 mt-3 text-sm text-[var(--color-subtle)]">
              <a
                href={product.tertiaryCta.href}
                target={product.tertiaryCta.external ? '_blank' : undefined}
                rel={product.tertiaryCta.external ? 'noopener' : undefined}
                class="underline decoration-dotted underline-offset-2 hover:text-[var(--color-text)]"
              >
                {product.tertiaryCta.label} →
              </a>
              {product.tertiaryCta.note && (
                <span class="block mt-1 text-[var(--color-subtle)]">{product.tertiaryCta.note}</span>
              )}
            </p>
          )}
          {isExeDownload && (
            <>
              <p class="reveal reveal-5 mt-3 text-sm text-[var(--color-muted)]">
                <span class="inline-flex items-center gap-1.5 font-mono text-[13px]">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8M12 18v2"/></svg>
                  Windows 10 / 11 · 64-bit
                </span>
              </p>
              <p class="reveal reveal-5 mt-2 text-sm text-[var(--color-subtle)]">
                First launch may show a Windows "unknown publisher" notice — that's normal for a new indie app. Click <strong>More info → Run anyway</strong>. The auto-updater is cryptographically signed.
              </p>
            </>
          )}
        </div>

        {/* Stats aside: SOON products keep the 4-tile grid. LIVE products
            (OM, DM) hide it here — the same numbers re-emerge below in the
            Receipts band where they have room to breathe + carry citations. */}
        {!hasReceiptsBand && product.stats && product.stats.length > 0 && (
          <aside class="reveal reveal-6 md:col-span-4 grid grid-cols-2 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
            {product.stats.map((s) => (
              <div class="bg-[var(--color-bg-card)] p-5">
                <p class="text-[10.5px] uppercase tracking-[0.1em] text-[var(--color-subtle)] font-mono">
                  {s.label}
                </p>
                <p class={`font-display mt-2 text-[34px] sm:text-[40px] ${numGradient} leading-none`}>
                  {s.value}
                </p>
              </div>
            ))}
          </aside>
        )}

        {/* Hero media pulled into the right column, filling the empty space
            beside the giant hero number/tagline. Video products (DM, OM) get
            the compact demo player; image products (AdBlock welcome shot,
            snipemaxxer lobby) get a click-to-enlarge shot via the global
            data-zoom lightbox. */}
        {heroShotAside && (heroAsideVideo || screenshotMain || isClip) && (
          <aside class="reveal reveal-6 md:col-span-5 md:mt-12 hero-shot-aside">
            {isClip ? (
              <div class="clip-reels">
                <p class="clip-reels__eyebrow">Real cuts &middot; made with Clipmaxxer</p>
                <div class="clip-reels__grid">
                  {clipReels.map((r) => (
                    <figure class="clip-reel">
                      <video class="clip-reel__vid" poster={r.poster} preload="none" playsinline loop muted>
                        <source src={r.src} type="video/mp4" />
                      </video>
                      <button type="button" class="clip-reel__btn" aria-label={`Play ${r.label}`}>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                      </button>
                      <input type="range" class="clip-reel__vol" min="0" max="100" value="10" step="1" aria-label={`Volume for ${r.label}`} />
                      <figcaption class="clip-reel__cap">{r.label}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ) : heroAsideVideo ? (
              <ProductScreenshot
                src={screenshotMain ?? (Array.isArray(product.demoVideo) ? product.demoVideo[0].poster : product.demoVideo!.poster)}
                alt={`${product.name} demo`}
                video={product.demoVideo}
              />
            ) : (
              <button
                type="button"
                class="ext-hero-shot group relative block w-full cursor-zoom-in rounded-2xl overflow-hidden border border-[var(--color-line-strong)]"
                data-zoom={screenshotMain}
                aria-label={`Enlarge: ${product.name}`}
                style={`box-shadow: 0 24px 64px rgba(0,0,0,0.5), 0 0 0 1px ${product.accentHex}22, 0 0 60px ${product.accentHex}14;`}
              >
                <img
                  src={screenshotMain}
                  alt={`${product.name} screenshot`}
                  loading="eager"
                  decoding="async"
                  class="block w-full h-auto transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <span class="pointer-events-none absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-black/65 px-2.5 py-1 text-[11px] font-mono tracking-wide text-white/90 opacity-85 backdrop-blur transition-opacity group-hover:opacity-100">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
                  Click to enlarge
                </span>
              </button>
            )}
          </aside>
        )}
      </div>

      {/* Dropmaxxer: live, in-page "try it right here" window instead of a
           static hero shot — it's a browser app, so let visitors test it. */}
      {isDrop && (
        <LiveEmbed
          url={product.primaryCta.href}
          title={product.name}
          poster={screenshotMain}
          accentHex={product.accentHex}
          host="dropmaxxer.pages.dev"
        />
      )}

      {/* Apple-style hero shot (or demo video) for live + beta products.
           Products whose hero media moved into the right-column aside skip
           this full-width shot. */}
      {!heroShotAside && !isDrop && !isPlaylist && (screenshotMain || product.demoVideo) && (
        <ProductScreenshot
          src={screenshotMain ?? (Array.isArray(product.demoVideo) ? product.demoVideo[0].poster : product.demoVideo!.poster)}
          alt={`${product.name} demo`}
          extras={product.demoVideo ? [] : screenshotExtras}
          video={product.demoVideo}
        />
      )}

      {/* LIVE-product receipts band — version cadence + 2 specs + repo link.
          Replaces the hero stats aside that was dropped in Phase 1. */}
      {hasReceiptsBand && receiptsConfig[product.slug] && (
        <ReceiptsBand
          version={['streammaxxing', 'extensionmaxxing'].includes(product.slug) && product.version
            ? `v${product.version}`
            : receiptsConfig[product.slug].version}
          versionDate={receiptsConfig[product.slug].versionDate}
          repoUrl={product.slug === 'extensionmaxxing'
            ? product.primaryCta.href
            : receiptsConfig[product.slug].repoUrl}
          repoLabel={receiptsConfig[product.slug].repoLabel}
          linkLabel={receiptsConfig[product.slug].linkLabel}
          linkSub={receiptsConfig[product.slug].linkSub}
          stats={receiptsConfig[product.slug].stats}
          accentHex={product.accentHex}
        />
      )}

      {/* Coming-soon "live build" banner — replaces the diagonal marquee.
           Aimmaxxer suppresses it: its dedicated "v2, the real deal" teaser
           in the AimWarmup section is the single coming-soon signal. */}
      {isSoon && !isAim && (
        <div class="mt-12 max-w-3xl">
          <BuildStatus
            productName={product.name}
            progress={buildStatus[product.slug]?.progress ?? 50}
            dropTarget={buildStatus[product.slug]?.dropTarget ?? 'Q4 · 2026'}
            channel={buildStatus[product.slug]?.channel ?? 'v0.1 · INTERNAL'}
          />
        </div>
      )}
    </div>
  </section>
  )}

  {/* Bespoke-hero products (AdBlock / Discord) replace the standard hero, so the
      receipts trust strip that lived inside it is re-rendered here — the DM FAQ
      points to "the receipts band above", so it must survive the hero swap. */}
  {(isExt || isDM || isOM) && hasReceiptsBand && receiptsConfig[product.slug] && (
    <div class="mx-auto max-w-7xl px-5 sm:px-8 pt-14">
      <ReceiptsBand
        version={['streammaxxing', 'extensionmaxxing'].includes(product.slug) && product.version
          ? `v${product.version}`
          : receiptsConfig[product.slug].version}
        versionDate={receiptsConfig[product.slug].versionDate}
        repoUrl={product.slug === 'extensionmaxxing'
          ? product.primaryCta.href
          : receiptsConfig[product.slug].repoUrl}
        repoLabel={receiptsConfig[product.slug].repoLabel}
        linkLabel={receiptsConfig[product.slug].linkLabel}
        linkSub={receiptsConfig[product.slug].linkSub}
        stats={receiptsConfig[product.slug].stats}
        accentHex={product.accentHex}
      />
    </div>
  )}

  {/* OM: its demo video lived in the standard hero's right-column aside; the
      bespoke Diagnostic hero replaced that column, so re-home the video here,
      just below the hero + receipts band. */}
  {isOM && product.demoVideo && (
    <section class="relative">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 pt-10">
        <ProductScreenshot
          src={screenshotMain ?? (Array.isArray(product.demoVideo) ? product.demoVideo[0].poster : product.demoVideo.poster)}
          alt={`${product.name} demo`}
          extras={[]}
          video={product.demoVideo}
        />
      </div>
    </section>
  )}

  {/* OM + dropmaxxer show the How-it-works walkthrough ABOVE the feature
      zones (zero-install / try-it-first products); everyone else gets it
      after the Features section below. */}
  {howItWorksFirst && product.howItWorks && product.howItWorks.steps.length > 0 && (
    <HowItWorks howItWorks={product.howItWorks} accentHex={product.accentHex} />
  )}

  {/* Features — bespoke zones for LIVE products, card grid fallback for SOON.
      Aimmaxxer swaps this whole section for the bespoke AimWarmup below. */}
  {!isAim && (
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-24">
      <div class="reveal-on-scroll mb-12">
        <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
          {featureHeading?.eyebrow ?? "What's inside"}
        </p>
        <h2 class="mt-3 text-[32px] sm:text-[44px] font-semibold tracking-[-0.025em] leading-[1.04]">
          {featureHeading ? (
            <><span class="gradient-text">{featureHeading.left}</span> <span class="serif-accent gradient-suite">{featureHeading.right}</span></>
          ) : (
            <><span class="gradient-text">Built for the player</span> <span class="serif-accent gradient-suite">who measures.</span></>
          )}
        </h2>
      </div>

      {hasZones && product.zones ? (
        <div class="feature-zones">
          {product.zones.map((zone, i) => (
            <FeatureZone zone={zone} index={i} accentHex={product.accentHex} />
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
          {product.features.map((f, i) => (
            <div class={`reveal-on-scroll reveal-delay-${(i % 5) + 1} bg-[var(--color-bg-card)] p-7 sm:p-8 group hover:bg-[var(--color-bg-card-hover)] transition-colors`}>
              <div class="text-[var(--color-magenta)] text-[13px] font-mono mb-3.5 group-hover:text-[var(--color-cyan)] transition-colors">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="text-[17px] font-semibold tracking-tight">{f.title}</h3>
              <p class="mt-2.5 text-[14.5px] text-[var(--color-text-mid)] leading-relaxed">
                {f.body}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
  )}

  {/* Aimmaxxer: interim resource section — per-game KovaaK warmups + a brief
      mouse-skates take + the "v2, the real deal" teaser. */}
  {isAim && (
    <AimWarmup accentHex={product.accentHex} />
  )}

  {/* How it works — renders after the feature zones for products that
      aren't in the "walkthrough first" set (OM, dropmaxxer). */}
  {!howItWorksFirst && product.howItWorks && product.howItWorks.steps.length > 0 && (
    <HowItWorks howItWorks={product.howItWorks} accentHex={product.accentHex} />
  )}

  {/* OM-only: Source Wall — the moat made visible. */}
  {isOM && <SourceWall />}

  {/* DM-only: Cut Autopsy — subtraction made visible. */}
  {isDM && <CutAutopsy />}

  {/* Reconversion CTA: reprint the hero stat, drop the CTA once more,
      pre-empt the three obvious objections. Available for every product
      that has both a heroStat and reconvert copy (LIVE downloads,
      BETA + SOON waitlists). */}
  {product.heroStat && reconvertConfig[product.slug] && (
    <ReconversionCTA
      heroStat={product.heroStat}
      closingLine={reconvertConfig[product.slug].closingLine}
      ctaLabel={product.primaryCta.label}
      ctaHref={product.primaryCta.href}
      ctaExternal={product.primaryCta.external}
      faqs={reconvertConfig[product.slug].faqs}
      accentHex={product.accentHex}
    />
  )}

  <!-- Related -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-24 border-t border-[var(--color-line)]">
      <div class="reveal-on-scroll flex items-end justify-between mb-10">
        <div>
          <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono">
            Also in the apps
          </p>
          <h2 class="mt-3 text-[28px] sm:text-[36px] font-semibold tracking-[-0.025em] leading-[1.12]">
            <span class="gradient-text">Different surface.</span> <span class="serif-accent gradient-suite">Same standard.</span>
          </h2>
        </div>
        <a href="/#apps" class="hidden sm:inline-flex btn-secondary">
          View all
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {related.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Floating Notify-me CTA on coming-soon products (aimmaxxer uses its own
       v2 teaser CTA instead). -->
  {isSoon && !isAim && <NotifyMeCard productName={product.name} href={product.primaryCta.href} />}

  {/* The demo player carries its own 48px top margin — the aside already
      offsets it with md:mt-12, so zero the internal margin to keep the video
      aligned neatly beside the hero number instead of dropping too low. */}
  <style is:global>
    .hero-shot-aside .product-screenshot { margin-top: 0; }

    /* Clipmaxxer hero reels — two 9:16 creator cuts as portfolio proof. */
    .clip-reels__eyebrow { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-cyan); margin: 0 0 10px; }
    .clip-reels__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .clip-reel { position: relative; margin: 0; border-radius: 14px; overflow: hidden; border: 1px solid var(--color-line-strong); background: #000; aspect-ratio: 9 / 16; box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5); }
    .clip-reel__vid { width: 100%; height: 100%; object-fit: cover; display: block; }
    .clip-reel__btn { position: absolute; inset: 0; margin: auto; width: 46px; height: 46px; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, 0.6); background: linear-gradient(180deg, rgba(0, 212, 255, 0.92), rgba(76, 81, 247, 0.92)); color: #fff; display: flex; align-items: center; justify-content: center; padding-left: 3px; cursor: pointer; box-shadow: 0 8px 24px rgba(0, 212, 255, 0.4); transition: transform 0.18s ease, opacity 0.22s ease; }
    .clip-reel__btn:hover { transform: scale(1.08); }
    .clip-reel__btn.is-hidden { opacity: 0; pointer-events: none; }
    .clip-reel__cap { position: absolute; left: 8px; bottom: 8px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.04em; color: #fff; background: rgba(0, 0, 0, 0.55); padding: 3px 8px; border-radius: 999px; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    /* Per-reel volume slider - starts at 10% (value="10"), appears on hover. */
    .clip-reel__vol { position: absolute; left: 10px; right: 10px; bottom: 34px; width: calc(100% - 20px); z-index: 3; -webkit-appearance: none; appearance: none; height: 4px; margin: 0; border-radius: 999px; cursor: pointer; opacity: 0; transition: opacity 0.2s ease; background: linear-gradient(to right, #00d4ff 0%, #00d4ff var(--vol, 10%), rgba(255, 255, 255, 0.28) var(--vol, 10%), rgba(255, 255, 255, 0.28) 100%); }
    .clip-reel:hover .clip-reel__vol, .clip-reel__vol:focus-visible { opacity: 1; }
    .clip-reel__vol::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 12px; border-radius: 999px; background: #fff; border: 2px solid #00d4ff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4); cursor: pointer; }
    .clip-reel__vol::-moz-range-thumb { width: 12px; height: 12px; border-radius: 999px; background: #fff; border: 2px solid #00d4ff; cursor: pointer; }
  </style>

  <script>
    // Clipmaxxer hero reels: click to play with sound (frozen on poster until
    // then, honoring the muted = paused rule). Clicking the video toggles.
    document.querySelectorAll<HTMLElement>('.clip-reel').forEach((reel) => {
      const v = reel.querySelector('video');
      const btn = reel.querySelector<HTMLButtonElement>('.clip-reel__btn');
      const vol = reel.querySelector<HTMLInputElement>('.clip-reel__vol');
      if (!v || !btn) return;
      // Volume slider - defaults to 10% for everyone (value="10" in markup).
      const applyVol = () => {
        const pct = vol ? Number(vol.value) : 10;
        v.volume = pct / 100;
        vol?.style.setProperty('--vol', pct + '%');
      };
      applyVol();
      const play = () => { v.muted = false; applyVol(); v.play().catch(() => {}); btn.classList.add('is-hidden'); };
      const pause = () => v.pause();
      btn.addEventListener('click', play);
      v.addEventListener('click', () => { if (v.paused) play(); else pause(); });
      v.addEventListener('pause', () => btn.classList.remove('is-hidden'));
      vol?.addEventListener('input', () => { v.muted = false; applyVol(); });
    });
  </script>
</Layout>
