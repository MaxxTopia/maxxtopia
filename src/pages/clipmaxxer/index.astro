---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

/**
 * Clipmaxxer — bespoke, self-themed marketing page (KINETIC NEON direction,
 * locked 2026-07-10). Deliberately does NOT render through the shared
 * `[slug].astro` suite template — clipmaxxer is filtered out of that route's
 * getStaticPaths so this static page owns /clipmaxxer cleanly.
 *
 * COPY LAW: sell the RESULT, hide the METHOD. We say WHAT we deliver (the exact
 * opponent / weapon / moment, frame-accurate, drafts-only) and never HOW we get
 * it (no replay-file / Riot-API / killfeed mechanics). Prove by demonstration —
 * the hero readout — not by disclosure.
 *
 * Honesty rules that bind this copy: drafts-only (never auto-post), Instagram =
 * we hand you the finished file (no Reels API), no per-frame face-reframe claim,
 * no swipe queue / matchmaker, no visible competitor callouts.
 */
const product = products.find((p) => p.slug === 'clipmaxxer')!;
const APPLY_HREF = '/clipmaxxer/apply';

// Sample readout lines for the hero "YOU ENDED …" ticker. Illustrative only —
// invented gamertags, tagged "sample" in the UI so it never reads as a real
// endorsement. They demonstrate the named-opponent capability without leaking
// where the name comes from.
const readouts = [
  { tag: 'ZACKEY2X', badge: 'TWITCH', weapon: 'Phantom', clutch: '1v3 retake', t: '3h24m39s', delta: '+1' },
  { tag: 'n0va_flick', badge: 'PRO', weapon: 'Frenzy AR', clutch: 'box fight', t: '58m02s', delta: '+1' },
  { tag: 'APEXWOLF', badge: 'ORG', weapon: 'Operator', clutch: 'clean flick', t: '2h11m47s', delta: '+1' },
  { tag: 'stormEQ', badge: 'LIVE', weapon: 'Pump Shotgun', clutch: 'endgame 1v1', t: '1h39m12s', delta: '+1' },
];

// SEO — lead with the real search intent (nobody googles the coined word),
// keep description ≤160 chars. Mirrors the JSON-LD the [slug] route used to emit.
const pageTitle = 'Clipmaxxer — Done-for-You Clips That Name Who You Beat';
const pageDescription =
  'Done-for-you clip editing for streamers. We name the exact opponent, weapon and moment, cut it to vertical, caption it, and drop it in your drafts. Apply.';
const ogImage = '/og/clipmaxxer.png';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Clipmaxxer',
  alternateName: 'clipmaxxer',
  description: product.description,
  applicationCategory: 'MultimediaApplication',
  applicationSubCategory: 'Content',
  operatingSystem: 'Web browser',
  keywords:
    'twitch clip maker, opusclip alternative, eklipse alternative, vod clipper, fortnite clip maker, valorant clip maker, named opponent clips, tiktok shorts for streamers, done for you clipping service',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Maxxtopia', url: 'https://maxxtopia.com' },
  url: 'https://maxxtopia.com/clipmaxxer/',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maxxtopia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Clipmaxxer', item: 'https://maxxtopia.com/clipmaxxer/' },
  ],
};

const reels = [
  { src: '/screenshots/clipmaxxer/demo-cut-tenz.mp4', poster: '/screenshots/clipmaxxer/demo-cut-tenz-poster.jpg', label: 'clutch · named opponent' },
  { src: '/screenshots/clipmaxxer/demo-cut-out.mp4', poster: '/screenshots/clipmaxxer/demo-cut-out-poster.jpg', label: 'frame-accurate cut' },
];
---

<Layout title={pageTitle} description={pageDescription} image={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="clipx">
    <!-- ══════════════════════ HERO ══════════════════════ -->
    <section class="cx-hero">
      <div class="cx-hero__glow" aria-hidden="true"></div>
      <div class="cx-scanlines" aria-hidden="true"></div>

      <div class="cx-wrap">
        <a href="/#apps" class="cx-back">&larr; All products</a>

        <p class="cx-eyebrow">Done-for-you clipping &middot; Fortnite &amp; Valorant</p>

        <h1 class="cx-kinetic" aria-label="Stream. We clip. You blow up.">
          <span class="cx-line cx-line-1"><span>STREAM.</span></span>
          <span class="cx-line cx-line-2"><span>WE CLIP.</span></span>
          <span class="cx-line cx-line-3"><span>YOU BLOW UP.</span></span>
        </h1>

        <!-- The proof-by-demonstration centerpiece: a live named-opponent
             readout. Shows the capability without disclosing the method. -->
        <div class="cx-readout" aria-hidden="true">
          <div class="cx-readout__bar">
            <span class="cx-dot"></span>
            <span class="cx-readout__title">HIGHLIGHT DETECTED</span>
            <span class="cx-readout__sample">sample</span>
          </div>
          <div class="cx-readout__body">
            <span class="cx-readout__verb">YOU ENDED</span>
            <span class="cx-readout__tag">
              <b class="cx-readout__badge" id="cxBadge">TWITCH</b>
              <b class="cx-readout__name" id="cxName">ZACKEY2X</b><i class="cx-caret" id="cxCaret">_</i>
            </span>
            <span class="cx-readout__meta">
              <em id="cxWeapon">Phantom</em>
              <em id="cxClutch">1v3 retake</em>
              <em id="cxTime">3h24m39s</em>
              <em class="cx-readout__delta" id="cxDelta">+1</em>
            </span>
          </div>
        </div>

        <p class="cx-sub">
          We name the <b>exact opponent</b>, the <b>exact weapon</b> and the
          <b>exact moment</b> — at any audience size. Cut to vertical, captioned,
          dropped in your drafts. You tap publish.
        </p>

        <div class="cx-cta">
          <a href={APPLY_HREF} class="cx-btn cx-btn--primary">
            Apply — done-for-you
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#work" class="cx-btn cx-btn--ghost">See real cuts</a>
        </div>

        <p class="cx-microtrust">Drafts only &middot; we never post for you &middot; Fortnite &amp; Valorant live</p>
      </div>

      <a href="#signal" class="cx-scroll" aria-label="Scroll down">
        <span></span>
      </a>
    </section>

    <!-- ══════════════════════ 01 · THE SIGNAL ══════════════════════ -->
    <section class="cx-panel" id="signal">
      <div class="cx-wipe" aria-hidden="true"></div>
      <div class="cx-wrap cx-reveal">
        <p class="cx-tag">01 &middot; The signal</p>
        <h2 class="cx-h2">Loud moments and chat spikes<br/><span class="cx-grad">miss most of your highlights.</span></h2>
        <p class="cx-lead">
          Every other clipper is guessing. It waits for your mic to peak or chat to
          pop and hopes something happened there. We tested those signals against
          real crowd-clipped plays — they miss most of them. So we don't guess.
          We find the play itself, every fight, not just the loud ones.
        </p>

        <div class="cx-meters">
          <div class="cx-meter">
            <div class="cx-meter__head"><span>Loudest mic moments</span><em>misses most</em></div>
            <div class="cx-meter__track"><i style="--w:22%"></i></div>
          </div>
          <div class="cx-meter">
            <div class="cx-meter__head"><span>Chat-spike detection</span><em>misses most</em></div>
            <div class="cx-meter__track"><i style="--w:34%"></i></div>
          </div>
          <div class="cx-meter cx-meter--win">
            <div class="cx-meter__head"><span>What we actually find</span><em>every play</em></div>
            <div class="cx-meter__track"><i style="--w:100%"></i></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════ 02 · THE RANKING ══════════════════════ -->
    <section class="cx-panel cx-panel--alt" id="ranking">
      <div class="cx-wrap cx-reveal">
        <p class="cx-tag">02 &middot; The ranking</p>
        <h2 class="cx-h2">Sorted by <span class="cx-grad">who you beat.</span><br/>Not that you won.</h2>
        <p class="cx-lead">
          Every clip arrives with a name attached — so the best ones rise. Ended a
          pro? An org player? Someone live right now? That clip goes to the top and
          titles itself. The stuff that makes people stop scrolling, first.
        </p>

        <ul class="cx-board">
          <li class="cx-row cx-row--gold" style="--i:0">
            <span class="cx-row__rank">01</span>
            <span class="cx-row__who"><b>ZACKEY2X</b><i>TWITCH · live</i></span>
            <span class="cx-row__meta">Phantom · 1v3 retake</span>
          </li>
          <li class="cx-row" style="--i:1">
            <span class="cx-row__rank">02</span>
            <span class="cx-row__who"><b>n0va_flick</b><i>PRO</i></span>
            <span class="cx-row__meta">Frenzy · box fight</span>
          </li>
          <li class="cx-row" style="--i:2">
            <span class="cx-row__rank">03</span>
            <span class="cx-row__who"><b>APEXWOLF</b><i>ORG</i></span>
            <span class="cx-row__meta">Operator · clean flick</span>
          </li>
          <li class="cx-row cx-row--dim" style="--i:3">
            <span class="cx-row__rank">04</span>
            <span class="cx-row__who"><b>unknown</b><i>no name</i></span>
            <span class="cx-row__meta">what everyone else clips</span>
          </li>
        </ul>
        <p class="cx-note">Sample ranking &middot; a named opponent on every clip</p>
      </div>
    </section>

    <!-- ══════════════════════ 03 · THE CUT ══════════════════════ -->
    <section class="cx-panel" id="cut">
      <div class="cx-wipe" aria-hidden="true"></div>
      <div class="cx-wrap cx-reveal">
        <p class="cx-tag">03 &middot; The cut</p>
        <h2 class="cx-h2">Frame-accurate.<br/><span class="cx-grad">Even on delay.</span></h2>
        <p class="cx-lead">
          We cut on the exact second — no drift across a full minute. Stream on an
          anti-snipe delay like most competitive players? We measure it from your
          own footage and correct for it automatically. You never enter a number.
        </p>

        <div class="cx-facts">
          <div class="cx-fact"><b>0</b><span>frames of drift</span></div>
          <div class="cx-fact"><b>auto</b><span>broadcast-delay correction</span></div>
          <div class="cx-fact"><b>9:16</b><span>vertical, captions burned in</span></div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════ 04 · THE DELIVERY ══════════════════════ -->
    <section class="cx-panel cx-panel--alt" id="delivery">
      <div class="cx-wrap cx-reveal">
        <p class="cx-tag">04 &middot; The delivery</p>
        <h2 class="cx-h2">In your drafts.<br/><span class="cx-grad">Never posted for you.</span></h2>
        <p class="cx-lead">
          Each clip comes back vertical, captioned, with a written hook — pushed
          straight into your TikTok drafts. You open your phone and tap publish.
          We never post for you, and never will without you asking.
        </p>

        <div class="cx-chips">
          <span class="cx-chip cx-chip--on">TikTok · drafts inbox<i>live</i></span>
          <span class="cx-chip cx-chip--on">YouTube Shorts<i>on request</i></span>
          <span class="cx-chip">Instagram Reels<i>we hand you the file</i></span>
        </div>
      </div>
    </section>

    <!-- ══════════════════════ REAL CUTS ══════════════════════ -->
    <section class="cx-panel cx-work" id="work">
      <div class="cx-wrap cx-reveal">
        <p class="cx-tag">The proof</p>
        <h2 class="cx-h2">Real cuts. <span class="cx-grad">Made with Clipmaxxer.</span></h2>
        <div class="cx-reels">
          {reels.map((r) => (
            <figure class="cx-reel">
              <video class="cx-reel__vid" poster={r.poster} preload="none" playsinline loop muted>
                <source src={r.src} type="video/mp4" />
              </video>
              <button type="button" class="cx-reel__btn" aria-label={`Play ${r.label}`}>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
              <figcaption class="cx-reel__cap">{r.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════ FINAL CTA ══════════════════════ -->
    <section class="cx-final">
      <div class="cx-hero__glow" aria-hidden="true"></div>
      <div class="cx-wrap cx-reveal">
        <h2 class="cx-final__kinetic">
          <span>STREAM.</span> <span>WE CLIP.</span> <span class="cx-grad">YOU BLOW UP.</span>
        </h2>
        <p class="cx-final__sub">
          Managed, flat monthly, cancel anytime. Built for streamers with an
          audience already rolling. Tell us your channel — we'll take it from there.
        </p>
        <a href={APPLY_HREF} class="cx-btn cx-btn--primary cx-btn--big">
          Apply — done-for-you
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <p class="cx-microtrust">You tap publish · we never auto-post · limited beta spots</p>
      </div>
    </section>
  </div>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════
       CLIPMAXXER — bespoke KINETIC NEON theme. Scoped under `.clipx` so
       none of these tokens leak into the shared suite styling. Palette:
       hot magenta → acid lime → cyan on near-black. Own dark look.
       ═══════════════════════════════════════════════════════════════ */
    .clipx {
      --cx-ink: #05040a;
      --cx-ink-2: #0b0813;
      --cx-line: rgba(255,255,255,0.10);
      --cx-text: #f4f1ff;
      --cx-muted: #a49fb8;
      --cx-mag: #ff2d9b;
      --cx-lime: #c6ff2e;
      --cx-cyan: #17e0ff;
      --cx-grad: linear-gradient(100deg, var(--cx-mag) 0%, var(--cx-lime) 52%, var(--cx-cyan) 100%);
      position: relative;
      background: var(--cx-ink);
      color: var(--cx-text);
      /* Pull the page flush over the suite chrome's default canvas. */
      margin: 0;
      overflow: clip;
    }
    .clipx *,
    .clipx *::before,
    .clipx *::after { box-sizing: border-box; }

    .cx-wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; position: relative; z-index: 2; }
    @media (min-width: 640px) { .cx-wrap { padding: 0 40px; } }

    .cx-grad {
      background: var(--cx-grad);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }

    /* ── HERO ─────────────────────────────────────────────────────── */
    .cx-hero {
      position: relative;
      min-height: 100svh;
      display: flex; flex-direction: column; justify-content: center;
      padding: 96px 0 72px;
      overflow: hidden;
      background:
        radial-gradient(120% 80% at 50% -10%, rgba(255,45,155,0.14), transparent 60%),
        radial-gradient(90% 70% at 90% 20%, rgba(23,224,255,0.10), transparent 55%),
        var(--cx-ink);
    }
    .cx-hero__glow {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(40% 40% at 15% 90%, rgba(198,255,46,0.10), transparent 70%),
        radial-gradient(45% 45% at 80% 85%, rgba(255,45,155,0.12), transparent 70%);
      animation: cx-breathe 12s ease-in-out infinite;
    }
    @keyframes cx-breathe { 0%,100% { opacity:0.75; } 50% { opacity:1; } }

    .cx-scanlines {
      position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0.5;
      background-image: repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0 1px, transparent 1px 3px);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, #000, transparent 85%);
      mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, #000, transparent 85%);
    }

    .cx-back {
      display: inline-block; font-family: var(--font-mono); font-size: 12.5px;
      letter-spacing: 0.04em; color: var(--cx-muted); margin-bottom: 30px;
      transition: color 0.2s ease;
    }
    .cx-back:hover { color: var(--cx-text); }

    .cx-eyebrow {
      font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.24em;
      text-transform: uppercase; color: var(--cx-cyan); margin: 0 0 18px;
    }

    /* Kinetic type — oversized, snaps in one line at a time. */
    .cx-kinetic {
      font-family: var(--font-display);
      font-weight: 400;
      line-height: 0.86;
      letter-spacing: 0.01em;
      margin: 0;
      text-transform: uppercase;
    }
    .cx-line { display: block; overflow: hidden; }
    .cx-line > span {
      display: block;
      font-size: clamp(56px, 13vw, 168px);
      transform: translateY(112%) skewY(6deg);
      opacity: 0;
    }
    .cx-line-1 > span { color: var(--cx-text); }
    .cx-line-2 > span {
      background: var(--cx-grad);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .cx-line-3 > span { color: var(--cx-text); }

    /* Readout centerpiece */
    .cx-readout {
      margin: 34px 0 6px;
      max-width: 620px;
      border: 1px solid var(--cx-line);
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015));
      box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,45,155,0.10), 0 0 44px rgba(23,224,255,0.10);
      overflow: hidden;
      opacity: 0; transform: translateY(16px);
      animation: cx-fade-up 0.7s ease 1.35s forwards;
    }
    .cx-readout__bar {
      display: flex; align-items: center; gap: 9px;
      padding: 10px 14px; border-bottom: 1px solid var(--cx-line);
      background: rgba(0,0,0,0.25);
    }
    .cx-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--cx-lime); box-shadow: 0 0 10px var(--cx-lime); animation: cx-blink 1.6s steps(1) infinite; }
    @keyframes cx-blink { 0%,60% { opacity:1; } 61%,100% { opacity:0.25; } }
    .cx-readout__title { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; color: var(--cx-muted); }
    .cx-readout__sample {
      margin-left: auto; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--cx-muted); border: 1px solid var(--cx-line);
      padding: 2px 7px; border-radius: 999px;
    }
    .cx-readout__body { padding: 16px 16px 18px; display: flex; flex-direction: column; gap: 9px; }
    .cx-readout__verb { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; color: var(--cx-muted); }
    .cx-readout__tag { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .cx-readout__badge {
      font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; font-weight: 600;
      color: var(--cx-ink); background: var(--cx-cyan); padding: 3px 8px; border-radius: 6px;
    }
    .cx-readout__name {
      font-family: var(--font-display); font-weight: 400; letter-spacing: 0.02em;
      font-size: clamp(30px, 6vw, 46px); line-height: 1;
      background: var(--cx-grad); -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .cx-caret { font-style: normal; color: var(--cx-lime); font-size: clamp(26px,5vw,40px); animation: cx-blink 1s steps(1) infinite; margin-left: -4px; }
    .cx-readout__meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .cx-readout__meta em {
      font-style: normal; font-family: var(--font-mono); font-size: 12px; color: var(--cx-text);
      border: 1px solid var(--cx-line); padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,0.03);
    }
    .cx-readout__delta { color: var(--cx-ink) !important; background: var(--cx-lime) !important; border-color: transparent !important; font-weight: 700; }

    .cx-sub {
      margin: 26px 0 0; max-width: 560px;
      font-size: clamp(16px, 2vw, 19px); line-height: 1.55; color: var(--cx-muted);
    }
    .cx-sub b { color: var(--cx-text); font-weight: 600; }

    .cx-cta { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 14px; }
    .cx-btn {
      display: inline-flex; align-items: center; gap: 9px;
      font-weight: 700; font-size: 15.5px; letter-spacing: 0.01em;
      padding: 14px 22px; border-radius: 12px; border: 1px solid transparent;
      transition: transform 0.18s ease, box-shadow 0.22s ease, background 0.22s ease;
    }
    .cx-btn--primary {
      color: var(--cx-ink);
      background: var(--cx-grad);
      background-size: 160% 160%;
      box-shadow: 0 12px 34px rgba(255,45,155,0.32), 0 0 0 1px rgba(255,255,255,0.06) inset;
      animation: cx-grad-pan 6s ease infinite;
    }
    @keyframes cx-grad-pan { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .cx-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 44px rgba(255,45,155,0.42); }
    .cx-btn--ghost { color: var(--cx-text); border-color: var(--cx-line); background: rgba(255,255,255,0.03); }
    .cx-btn--ghost:hover { border-color: var(--cx-cyan); color: var(--cx-cyan); transform: translateY(-2px); }
    .cx-btn--big { font-size: 17.5px; padding: 17px 30px; }

    .cx-microtrust { margin-top: 16px; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.05em; color: var(--cx-muted); }

    .cx-scroll {
      position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%);
      width: 26px; height: 42px; border: 1.5px solid var(--cx-line); border-radius: 999px; z-index: 2;
    }
    .cx-scroll > span {
      position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; border-radius: 999px;
      background: var(--cx-cyan); transform: translateX(-50%); animation: cx-scroll 1.8s ease-in-out infinite;
    }
    @keyframes cx-scroll { 0% { opacity:0; transform: translate(-50%,0); } 40% { opacity:1; } 100% { opacity:0; transform: translate(-50%,16px); } }

    /* ── PANELS ───────────────────────────────────────────────────── */
    .cx-panel { position: relative; padding: 108px 0; border-top: 1px solid var(--cx-line); overflow: hidden; }
    .cx-panel--alt { background: var(--cx-ink-2); }
    .cx-tag {
      font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--cx-cyan); margin: 0 0 16px;
    }
    .cx-h2 {
      font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
      font-size: clamp(38px, 7vw, 84px); line-height: 0.92; letter-spacing: 0.01em;
      margin: 0 0 26px; color: var(--cx-text);
    }
    .cx-lead { max-width: 620px; font-size: clamp(16px, 1.7vw, 19px); line-height: 1.6; color: var(--cx-muted); margin: 0; }
    .cx-lead b { color: var(--cx-text); }
    .cx-note { margin: 18px 0 0; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.05em; color: var(--cx-muted); }

    /* Flash-cut wipe that sweeps across a panel as it enters view. */
    .cx-wipe {
      position: absolute; inset: 0; z-index: 1; pointer-events: none; transform: translateX(-101%);
      background: linear-gradient(100deg, transparent, rgba(198,255,46,0.10) 40%, rgba(23,224,255,0.10) 60%, transparent);
    }
    .cx-panel.is-in .cx-wipe { animation: cx-wipe 0.9s cubic-bezier(0.7,0,0.2,1) forwards; }
    @keyframes cx-wipe { 0% { transform: translateX(-101%);} 100% { transform: translateX(101%);} }

    /* Meters (signal panel) */
    .cx-meters { margin-top: 44px; display: grid; gap: 18px; max-width: 640px; }
    .cx-meter__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
    .cx-meter__head span { font-size: 14.5px; color: var(--cx-text); }
    .cx-meter__head em { font-style: normal; font-family: var(--font-mono); font-size: 12px; color: var(--cx-muted); }
    .cx-meter__track { height: 12px; border-radius: 999px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .cx-meter__track > i {
      display: block; height: 100%; width: 0; border-radius: 999px;
      background: rgba(255,255,255,0.20);
      transition: width 1.1s cubic-bezier(0.2,0.7,0.2,1);
    }
    .cx-panel.is-in .cx-meter__track > i { width: var(--w); }
    .cx-meter--win .cx-meter__head em { color: var(--cx-lime); }
    .cx-meter--win .cx-meter__track > i { background: var(--cx-grad); box-shadow: 0 0 18px rgba(198,255,46,0.4); }

    /* Board (ranking panel) */
    .cx-board { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 12px; max-width: 680px; }
    .cx-row {
      display: grid; grid-template-columns: 42px 1fr auto; align-items: center; gap: 16px;
      padding: 16px 18px; border: 1px solid var(--cx-line); border-radius: 14px;
      background: rgba(255,255,255,0.03);
      opacity: 0; transform: translateX(-22px);
    }
    .cx-panel.is-in .cx-row { animation: cx-slide-in 0.55s cubic-bezier(0.2,0.7,0.2,1) forwards; animation-delay: calc(var(--i) * 0.11s + 0.2s); }
    @keyframes cx-slide-in { to { opacity: 1; transform: translateX(0); } }
    .cx-row__rank { font-family: var(--font-display); font-size: 26px; color: var(--cx-muted); }
    .cx-row__who { display: flex; flex-direction: column; gap: 2px; }
    .cx-row__who b { font-size: 17px; font-weight: 700; color: var(--cx-text); }
    .cx-row__who i { font-style: normal; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; color: var(--cx-muted); }
    .cx-row__meta { font-family: var(--font-mono); font-size: 12.5px; color: var(--cx-muted); text-align: right; }
    .cx-row--gold {
      border-color: transparent;
      background: linear-gradient(100deg, rgba(255,45,155,0.16), rgba(23,224,255,0.12));
      box-shadow: 0 0 0 1px rgba(198,255,46,0.35), 0 16px 40px rgba(255,45,155,0.16);
    }
    .cx-row--gold .cx-row__rank { color: var(--cx-lime); }
    .cx-row--gold .cx-row__who b { color: #fff; }
    .cx-row--dim { opacity: 0.55; } /* base; overridden by keyframe end-state below */
    .cx-panel.is-in .cx-row--dim { animation: cx-slide-in-dim 0.55s cubic-bezier(0.2,0.7,0.2,1) forwards; animation-delay: calc(var(--i) * 0.11s + 0.2s); }
    @keyframes cx-slide-in-dim { to { opacity: 0.5; transform: translateX(0); } }
    .cx-row--dim .cx-row__who b { color: var(--cx-muted); }

    /* Facts (cut panel) */
    .cx-facts { margin-top: 46px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 640px; }
    .cx-fact { border: 1px solid var(--cx-line); border-radius: 14px; padding: 22px 18px; background: rgba(255,255,255,0.03); }
    .cx-fact b {
      display: block; font-family: var(--font-display); font-size: clamp(38px, 6vw, 60px); line-height: 0.9;
      background: var(--cx-grad); -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
    }
    .cx-fact span { display: block; margin-top: 8px; font-size: 13px; color: var(--cx-muted); line-height: 1.35; }
    @media (max-width: 560px) { .cx-facts { grid-template-columns: 1fr; } }

    /* Chips (delivery panel) */
    .cx-chips { margin-top: 44px; display: flex; flex-wrap: wrap; gap: 12px; }
    .cx-chip {
      display: inline-flex; flex-direction: column; gap: 3px;
      padding: 13px 18px; border-radius: 12px; border: 1px solid var(--cx-line);
      background: rgba(255,255,255,0.03); font-size: 15px; font-weight: 600; color: var(--cx-text);
    }
    .cx-chip i { font-style: normal; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--cx-muted); font-weight: 400; }
    .cx-chip--on { border-color: transparent; box-shadow: 0 0 0 1px rgba(23,224,255,0.4); background: rgba(23,224,255,0.08); }
    .cx-chip--on i { color: var(--cx-cyan); }

    /* Real cuts */
    .cx-reels { margin-top: 44px; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 20px; max-width: 520px; }
    .cx-reel { position: relative; margin: 0; border-radius: 16px; overflow: hidden; border: 1px solid var(--cx-line); background: #000; aspect-ratio: 9/16; box-shadow: 0 22px 54px rgba(0,0,0,0.55); }
    .cx-reel__vid { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cx-reel__btn {
      position: absolute; inset: 0; margin: auto; width: 54px; height: 54px; border-radius: 999px;
      border: 1.5px solid rgba(255,255,255,0.7); background: var(--cx-grad); color: var(--cx-ink);
      display: flex; align-items: center; justify-content: center; padding-left: 3px; cursor: pointer;
      box-shadow: 0 10px 28px rgba(255,45,155,0.4); transition: transform 0.18s ease, opacity 0.22s ease;
    }
    .cx-reel__btn:hover { transform: scale(1.09); }
    .cx-reel__btn.is-hidden { opacity: 0; pointer-events: none; }
    .cx-reel__cap {
      position: absolute; left: 10px; bottom: 10px; font-family: var(--font-mono); font-size: 10.5px;
      letter-spacing: 0.03em; color: #fff; background: rgba(0,0,0,0.6); padding: 4px 9px; border-radius: 999px;
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    }

    /* Final CTA */
    .cx-final {
      position: relative; text-align: center; padding: 120px 0 132px; overflow: hidden;
      border-top: 1px solid var(--cx-line);
      background:
        radial-gradient(80% 90% at 50% 120%, rgba(255,45,155,0.18), transparent 60%),
        var(--cx-ink);
    }
    .cx-final__kinetic {
      font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
      font-size: clamp(40px, 8vw, 104px); line-height: 0.9; letter-spacing: 0.01em; margin: 0;
    }
    .cx-final__kinetic > span { display: inline-block; }
    .cx-final__sub { max-width: 560px; margin: 26px auto 0; font-size: clamp(15px,1.6vw,18px); line-height: 1.6; color: var(--cx-muted); }
    .cx-final .cx-btn { margin-top: 34px; }
    .cx-final .cx-microtrust { text-align: center; }

    /* ── Scroll-reveal base (JS toggles .is-in on the section) ─────── */
    .cx-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2,0.7,0.2,1); }
    .is-in .cx-reveal, .cx-reveal.is-in { opacity: 1; transform: none; }

    /* ── HERO load animation (JS-free, plays on paint) ────────────── */
    .cx-line-1 > span { animation: cx-snap 0.72s cubic-bezier(0.16,1,0.3,1) 0.15s forwards; }
    .cx-line-2 > span { animation: cx-snap 0.72s cubic-bezier(0.16,1,0.3,1) 0.42s forwards; }
    .cx-line-3 > span { animation: cx-snap 0.72s cubic-bezier(0.16,1,0.3,1) 0.69s forwards; }
    @keyframes cx-snap { to { transform: translateY(0) skewY(0); opacity: 1; } }
    @keyframes cx-fade-up { to { opacity: 1; transform: none; } }

    /* ═══ REDUCED MOTION — kill flashes + auto-motion, show final state ═══ */
    @media (prefers-reduced-motion: reduce) {
      .clipx *, .clipx *::before, .clipx *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
      .cx-line > span { transform: none !important; opacity: 1 !important; }
      .cx-readout { opacity: 1 !important; transform: none !important; }
      .cx-reveal { opacity: 1 !important; transform: none !important; }
      .cx-row { opacity: 1 !important; transform: none !important; }
      .cx-row--dim { opacity: 0.5 !important; }
      .cx-meter__track > i { width: var(--w) !important; transition: none !important; }
      .cx-caret, .cx-dot { animation: none !important; }
      .cx-caret { opacity: 1; }
      .cx-wipe { display: none !important; }
      .cx-scroll > span { animation: none !important; opacity: 0.7; }
    }
  </style>

  <script>
    // ── Scroll reveal + panel flash-cut trigger (IntersectionObserver) ──
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const panels = document.querySelectorAll<HTMLElement>('.cx-panel, .cx-final');
      const reveals = document.querySelectorAll<HTMLElement>('.cx-reveal');

      if (reduce || !('IntersectionObserver' in window)) {
        panels.forEach((p) => p.classList.add('is-in'));
        reveals.forEach((r) => r.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        panels.forEach((p) => io.observe(p));
        reveals.forEach((r) => io.observe(r));
      }

      // ── Hero readout cycler: type a named-opponent line, hold, wipe, next ──
      const readouts = [
        { tag: 'ZACKEY2X', badge: 'TWITCH', weapon: 'Phantom', clutch: '1v3 retake', t: '3h24m39s', delta: '+1' },
        { tag: 'n0va_flick', badge: 'PRO', weapon: 'Frenzy AR', clutch: 'box fight', t: '58m02s', delta: '+1' },
        { tag: 'APEXWOLF', badge: 'ORG', weapon: 'Operator', clutch: 'clean flick', t: '2h11m47s', delta: '+1' },
        { tag: 'stormEQ', badge: 'LIVE', weapon: 'Pump Shotgun', clutch: 'endgame 1v1', t: '1h39m12s', delta: '+1' },
      ];
      const el = {
        badge: document.getElementById('cxBadge'),
        name: document.getElementById('cxName'),
        weapon: document.getElementById('cxWeapon'),
        clutch: document.getElementById('cxClutch'),
        time: document.getElementById('cxTime'),
        delta: document.getElementById('cxDelta'),
        caret: document.getElementById('cxCaret'),
      };
      if (!el.name) return;

      if (reduce) {
        // Static: just show the first line, no typing loop.
        const r = readouts[0];
        el.badge!.textContent = r.badge; el.name!.textContent = r.tag;
        el.weapon!.textContent = r.weapon; el.clutch!.textContent = r.clutch;
        el.time!.textContent = r.t; el.delta!.textContent = r.delta;
        return;
      }

      let i = 0;
      const sleep = (ms: number) => new Promise((res) => setTimeout(res, ms));
      const setMeta = (r: typeof readouts[number]) => {
        el.badge!.textContent = r.badge; el.weapon!.textContent = r.weapon;
        el.clutch!.textContent = r.clutch; el.time!.textContent = r.t; el.delta!.textContent = r.delta;
      };

      async function loop() {
        // Wait for the readout card's own fade-in before the first type.
        await sleep(2100);
        // Prime with the first line already shown (matches server markup).
        setMeta(readouts[0]);
        while (true) {
          i = (i + 1) % readouts.length;
          const r = readouts[i];
          // erase
          const cur = el.name!.textContent || '';
          for (let k = cur.length; k >= 0; k--) { el.name!.textContent = cur.slice(0, k); await sleep(28); }
          setMeta(r);
          // type
          for (let k = 1; k <= r.tag.length; k++) { el.name!.textContent = r.tag.slice(0, k); await sleep(52); }
          await sleep(2600);
        }
      }
      loop();
    })();

    // ── Real-cut reels: click to play with sound (muted = paused rule) ──
    document.querySelectorAll<HTMLElement>('.cx-reel').forEach((reel) => {
      const v = reel.querySelector('video');
      const btn = reel.querySelector<HTMLButtonElement>('.cx-reel__btn');
      if (!v || !btn) return;
      const play = () => { v.muted = false; v.volume = 0.85; v.play().catch(() => {}); btn.classList.add('is-hidden'); };
      const pause = () => v.pause();
      btn.addEventListener('click', play);
      v.addEventListener('click', () => { if (v.paused) play(); else pause(); });
      v.addEventListener('pause', () => btn.classList.remove('is-hidden'));
    });
  </script>
</Layout>
