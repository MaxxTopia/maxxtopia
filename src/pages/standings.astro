---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';

const standingsApi = '/api';
---

<style is:global>
.standings-page{--lb-ink: #05050b;--lb-panel: rgba(11, 9, 25, .94);--lb-panel-raised: rgba(17, 14, 36, .97);--lb-line: rgba(218, 220, 255, .13);--lb-text: #f7f4ff;--lb-muted: #aaa6bf;--lb-subtle: #706c84;--lb-cyan: #36e7ff;--lb-magenta: #d96bff;--lb-green: #66f6a3;--lb-red: #ff7b91;--lb-gold: #ffbd4a;--lb-gold-bright: #fff0bd;--lb-silver: #d4e0f0;--lb-bronze: #d99568;background:radial-gradient(circle at 9% 8%,rgba(161,83,255,.14),transparent 28rem),radial-gradient(circle at 88% 36%,rgba(0,212,255,.09),transparent 30rem),linear-gradient(135deg,#05050b,#0c071c 54%,#05060e)}
.standings-page:before{position:absolute;inset:0;background:radial-gradient(circle at 50% 14%,rgba(255,255,255,.035),transparent 32rem);content:"";pointer-events:none}
.sp-grid{opacity:.2;background-size:68px 68px;mask-image:linear-gradient(to bottom,black 0%,rgba(0,0,0,.8) 42%,transparent 76%)}
.sp-shell{width:min(1240px,calc(100% - 48px));padding:30px 0 58px}
.sp-hero{position:relative;max-width:none;padding:86px 0 52px;margin-bottom:30px}
.sp-hero:after{position:absolute;top:4rem;right:8%;width:22rem;height:13rem;border-radius:50%;background:radial-gradient(ellipse,rgba(0,212,255,.1),transparent 68%);content:"";pointer-events:none}
.sp-kicker{width:max-content;padding:7px 10px;border:1px solid rgba(54,231,255,.24);border-radius:999px;background:#36e7ff0b;color:var(--lb-cyan);box-shadow:0 0 26px #36e7ff0f;font-size:10px}
.sp-kicker-dot{width:6px;height:6px;box-shadow:0 0 16px #36e7fff2}
.sp-title-row{position:relative;z-index:1;margin-top:19px}
.sp-title-row h1{font-size:clamp(58px,9.5vw,134px);letter-spacing:-.085em;line-height:.8}
.sp-title-gradient{background:linear-gradient(110deg,#fff1c7,#ffbd4a 27%,#e975ff 60%,#36e7ff);filter:drop-shadow(0 13px 28px rgba(217,107,255,.13))}
.sp-title-gradient{-webkit-background-clip:text;background-clip:text;color:transparent}
.sp-title-mark{color:var(--lb-gold);text-shadow:0 0 24px rgba(255,189,74,.36)}
.sp-title-muted{color:#85819b;opacity:1}
.sp-intro{max-width:700px;margin-top:25px;color:#c4c0d3;font-size:16px;line-height:1.7}
.sp-hero-chip{min-width:194px;padding:17px 18px 15px;border-color:#36e7ff4d;border-radius:12px;background:radial-gradient(circle at 20% 10%,rgba(217,107,255,.18),transparent 58%),linear-gradient(145deg,#36e7ff1c,#ffbd4a12);box-shadow:inset 0 1px #ffffff14,0 18px 48px #0000004d,0 0 34px #36e7ff12;transform:rotate(1deg)}
.sp-chip-top{color:var(--lb-cyan)}
.sp-chip-main{font-size:27px;text-shadow:0 0 18px rgba(255,255,255,.12)}
.sp-chip-bottom{color:#aaa6bf}
.sp-stage{position:relative;border-color:#36e7ff47;border-radius:18px;background:linear-gradient(138deg,#180e32fa,#0a0818fa 54%,#091123fa),var(--lb-panel);box-shadow:0 34px 100px #00000073,0 0 46px #36e7ff0d,inset 0 1px #ffffff12}
.sp-stage:before{position:absolute;inset:0 12% auto 0;height:1px;background:linear-gradient(90deg,rgba(54,231,255,.85),rgba(217,107,255,.4),transparent);content:"";pointer-events:none}
.sp-stage:after{position:absolute;top:-11rem;right:-6rem;width:30rem;height:26rem;border-radius:50%;background:radial-gradient(ellipse,rgba(217,107,255,.1),transparent 68%);content:"";pointer-events:none}
.sp-stage>*{position:relative;z-index:1}
.sp-stage-topline{padding:31px 34px 24px;background:linear-gradient(105deg,rgba(54,231,255,.06),transparent 42%,rgba(217,107,255,.065))}
.sp-stage .sp-section-label{color:var(--lb-cyan)}
.sp-stage h2{font-size:clamp(25px,3vw,36px);letter-spacing:-.05em}
.sp-board-context{max-width:680px;margin-top:10px;color:#aaa6bf}
.sp-board-context i{color:var(--lb-magenta);text-shadow:0 0 12px rgba(217,107,255,.6)}
.sp-stage-actions{justify-content:flex-end}
.sp-processed-chip{padding:8px 11px;border-color:#66f6a352;border-radius:999px;background:#66f6a311;color:var(--lb-green);box-shadow:0 0 20px #66f6a30d}
.sp-quiet-button,.sp-refresh-button,.sp-segmented button{border-color:#ffffff29;border-radius:8px;background:#ffffff0b;color:#c7c3d5;box-shadow:inset 0 1px #ffffff0a}
.sp-refresh-button{border-color:#36e7ff6b;background:#36e7ff1b;color:#d1fbff;box-shadow:0 0 24px #36e7ff12,inset 0 1px #ffffff14}
.sp-quiet-button:hover,.sp-refresh-button:hover,.sp-segmented button:hover{border-color:#36e7ffb8;background:#36e7ff29;box-shadow:0 0 24px #36e7ff1a}
.sp-controls{padding:23px 34px 15px;background:#03030c29}
.sp-control{color:#8d89a1}
.sp-control select{border-color:#ffffff26;border-radius:8px;background:#050511e6;color:#f1eefb;box-shadow:inset 0 1px #ffffff0a,0 9px 22px #0000001f}
.sp-control select:focus{border-color:#36e7ff94;box-shadow:0 0 0 3px #36e7ff14}
.sp-segmented{overflow:hidden;border:1px solid rgba(255,255,255,.15);border-radius:8px}
.sp-segmented button{border:0;border-radius:0}
.sp-segmented button+button{border-left:1px solid rgba(255,255,255,.1)}
.sp-segmented button.is-active{border-color:transparent;background:linear-gradient(135deg,#ffbd4a45,#d96bff24);color:#fff0c1;box-shadow:0 0 24px #ffbd4a1f inset,0 0 18px #ffbd4a0f}
.sp-status-line{min-height:42px;padding:0 34px 17px;border-bottom-color:#ffffff14;color:#aaa6bf}
.sp-status-dot--good{background:var(--lb-green);box-shadow:0 0 15px #66f6a3d9}
.sp-status-dot--warn{background:var(--lb-gold);box-shadow:0 0 15px #ffbd4ab3}
.sp-status-delay{color:#77738b}
.sp-summary{grid-template-columns:1.2fr .8fr 1.1fr .8fr 1.2fr;border-top-color:#ffffff14;border-bottom-color:#ffffff14;background:linear-gradient(90deg,#36e7ff06,#0003 42%,#d96bff09)}
.sp-summary-item{min-height:76px;padding:13px 18px;border-right-color:#ffffff14}
.sp-summary-label{color:#77738b}
.sp-summary-item strong{color:#eeeaf8;font-size:13px}
.sp-summary-item--live{background:linear-gradient(90deg,rgba(102,246,163,.075),transparent)}
.sp-summary-item--live strong{color:var(--lb-green);text-shadow:0 0 17px rgba(102,246,163,.23)}
.sp-board{padding:0 34px 32px}
.sp-board-head,.sp-row{grid-template-columns:72px minmax(190px,1.35fr) 104px 72px 130px minmax(150px,.9fr);gap:13px}
.sp-board-head{padding:20px 17px 11px;color:#77738b;font-size:8px}
.sp-rows{gap:10px}
.sp-row{min-height:84px;padding:13px 17px 13px 16px;border-color:#dadcff1f;border-radius:10px;background:linear-gradient(105deg,#ffffff0b,#080714d6 54%,#0b0a19eb);box-shadow:0 12px 28px #0000002b,inset 0 1px #ffffff09}
.sp-row>*{position:relative;z-index:1}
.sp-row:before{inset:5px auto 5px -1px;width:3px;border-radius:10px;background:#ffffff40}
.sp-row:after{position:absolute;inset:0;background:radial-gradient(ellipse at 0% 50%,rgba(54,231,255,.08),transparent 43%);content:"";pointer-events:none}
.sp-row:hover{transform:translateY(-2px) translate(2px);border-color:#dadcff47;background:linear-gradient(105deg,#ffffff13,#0b0a1beb 54%,#0d0d1ff2);box-shadow:0 17px 34px #00000038,0 0 24px #36e7ff0b}
.sp-row--rank-1{min-height:96px;border-color:#ffbd4ab8;background:linear-gradient(105deg,#ffbd4a47,#ffbd4a18 30%,#d96bff11 64%,#0b0a19e6);box-shadow:0 0 0 1px #ffbd4a14,0 18px 45px #ffbd4a1c,0 0 38px #d96bff0d,inset 0 1px #fff2c233}
.sp-row--rank-1:before{width:4px;background:linear-gradient(#fff5c8,var(--lb-gold),var(--lb-magenta));box-shadow:0 0 18px #ffbd4ae6}
.sp-row--rank-1:after{background:radial-gradient(ellipse at 0% 50%,rgba(255,239,174,.22),transparent 39%),radial-gradient(ellipse at 78% 0%,rgba(217,107,255,.1),transparent 38%)}
.sp-row--rank-2{border-color:#d4e0f06b;background:linear-gradient(105deg,#d4e0f024,#d4e0f009 39%,#0b0a19e6);box-shadow:0 0 26px #d4e0f00e,inset 0 1px #f0f8ff1c}
.sp-row--rank-2:before{background:linear-gradient(#f3f8ff,var(--lb-silver));box-shadow:0 0 12px #d4e0f08c}
.sp-row--rank-3{border-color:#d9956875;background:linear-gradient(105deg,#d9956826,#d9956809 39%,#0b0a19e6);box-shadow:0 0 26px #d995680e,inset 0 1px #ffdcc51a}
.sp-row--rank-3:before{background:linear-gradient(#ffd0ad,var(--lb-bronze));box-shadow:0 0 12px #d995688c}
.sp-movement{color:#8c889f;font-size:12px}
.sp-movement-arrow{color:currentColor;text-shadow:0 0 14px currentColor}
.sp-player{gap:13px}
.sp-player strong{color:#f3effd;font-size:16px;text-shadow:0 0 16px rgba(255,255,255,.06)}
.sp-player-copy{gap:5px}
.sp-player-copy small{color:#9691aa;font-size:9px}
.sp-row--rank-1 .sp-player strong{color:var(--lb-gold-bright);text-shadow:0 0 20px rgba(255,189,74,.34)}
.sp-row--rank-1 .sp-player-copy small{color:#d7c5a0}
.sp-rank{min-width:45px;height:30px;border:1px solid rgba(255,255,255,.14);border-radius:6px;background:#ffffff12}
.sp-row--rank-1 .sp-rank{border-color:#ffbd4a7a;background:#ffbd4a3b;color:var(--lb-gold-bright);box-shadow:0 0 18px #ffbd4a1f}
.sp-row--rank-2 .sp-rank{border-color:#d4e0f04d;background:#d4e0f026;color:#eff5fd}
.sp-row--rank-3 .sp-rank{border-color:#d9956857;background:#d995682e;color:#ffd0ad}
.sp-points strong{color:#f5f2fc;font-size:23px;text-shadow:0 0 14px rgba(255,255,255,.07)}
.sp-row--rank-1 .sp-points strong{color:var(--lb-gold-bright);text-shadow:0 0 20px rgba(255,189,74,.46)}
.sp-points span,.sp-wins span,.sp-prize span{color:#77738b}
.sp-wins strong{color:#ece8f7;font-size:16px}
.sp-row--rank-1 .sp-wins strong{color:#fff2c8}
.sp-prize strong{color:var(--lb-green);text-shadow:0 0 16px rgba(102,246,163,.18)}
.sp-prize--tier-1 strong{color:var(--lb-gold-bright);text-shadow:0 0 18px rgba(255,189,74,.52)}
.sp-prize--tier-2 strong{color:var(--lb-silver);text-shadow:0 0 16px rgba(212,224,240,.35)}
.sp-prize--tier-3 strong{color:#ffc09a;text-shadow:0 0 16px rgba(217,149,104,.38)}
.sp-gap{color:#ffd47f}
.sp-last{color:var(--lb-green)}
.sp-footnote{position:relative;margin:0 34px 32px;padding:16px 18px;border-color:#36e7ff33;border-radius:10px;background:linear-gradient(105deg,#36e7ff14,#36e7ff06 48%,#d96bff09);box-shadow:0 0 28px #36e7ff09,inset 0 1px #ffffff0b}
.sp-footnote strong{color:#d7fbff}
.sp-footnote-mark{border-color:#36e7ffa3;color:var(--lb-cyan);box-shadow:0 0 14px #36e7ff1f}
.sp-lower-grid{gap:16px;margin-top:18px}
.sp-info-card{position:relative;overflow:hidden;min-height:204px;padding:27px 29px;border-color:#ffffff1f;border-radius:14px;background:linear-gradient(135deg,#140d2af2,#080813f5 70%);box-shadow:0 22px 52px #00000040,inset 0 1px #ffffff0e}
.sp-info-card>*{position:relative;z-index:1}
.sp-info-card:before{position:absolute;inset:0 28% auto 0;height:2px;background:linear-gradient(90deg,var(--lb-gold),transparent);content:""}
.sp-info-card:after{position:absolute;right:-4rem;bottom:-7rem;width:19rem;height:16rem;border-radius:50%;background:radial-gradient(ellipse,rgba(255,189,74,.13),transparent 68%);content:"";pointer-events:none}
.sp-info-card--cyan{border-color:#36e7ff33;background:linear-gradient(135deg,#0b1b2eeb,#080813f5 70%)}
.sp-info-card--cyan:before{background:linear-gradient(90deg,var(--lb-cyan),transparent)}
.sp-info-card--cyan:after{background:radial-gradient(ellipse,rgba(54,231,255,.13),transparent 68%)}
.sp-info-number{align-self:start;color:var(--lb-gold);font-family:var(--font-display);font-size:48px;letter-spacing:-.04em;line-height:.82;text-shadow:0 0 20px rgba(255,189,74,.18)}
.sp-info-card--cyan .sp-info-number{color:var(--lb-cyan);text-shadow:0 0 20px rgba(54,231,255,.18)}
.sp-info-card .sp-section-label{color:var(--lb-gold)}
.sp-info-card--cyan .sp-section-label{color:var(--lb-cyan)}
.sp-info-card h2{font-size:29px;letter-spacing:-.05em}
.sp-info-card p:last-child{margin-top:15px;color:#b9b4c9;font-size:13px;line-height:1.68}
.sp-footer-line{margin-top:34px;padding-top:20px;border-top-color:#ffffff1a;color:#8d89a1}
.sp-footer-line a{color:var(--lb-cyan);text-shadow:0 0 14px rgba(54,231,255,.16)}
.sp-footer-line a:hover{color:#edfdff}
@media(max-width:980px){.sp-summary{grid-template-columns:repeat(3,1fr)}
.sp-summary-item:nth-child(3){border-right:0}
.sp-summary-item:nth-child(-n+3){border-bottom:1px solid rgba(255,255,255,.08)}
.sp-summary-item--source{grid-column:1 / -1}
}
@media(max-width:820px){.sp-shell{width:min(100% - 28px,700px);padding-top:20px}
.sp-hero{padding-top:66px}
.sp-title-row{align-items:start;flex-direction:column}
.sp-hero-chip{align-self:start}
.sp-stage-topline{align-items:start;flex-direction:column;padding:25px 21px 20px}
.sp-stage-actions{width:100%;justify-content:start}
.sp-controls{grid-template-columns:1fr 1fr;padding:18px 21px 14px}
.sp-control--wide{grid-column:1 / -1;grid-row:1}
.sp-control--view{grid-column:2}
.sp-status-line{padding-left:21px;padding-right:21px}
.sp-summary{grid-template-columns:1fr 1fr}
.sp-summary-item:nth-child(2){border-right:0}
.sp-summary-item:nth-child(-n+2){border-bottom:1px solid rgba(255,255,255,.08)}
.sp-summary-item--source{grid-column:1 / -1}
.sp-board{padding-left:21px;padding-right:21px}
.sp-board-head{display:none}
.sp-row{grid-template-columns:48px minmax(110px,1fr) 82px;grid-template-areas:"move player points" "move math math";gap:0 9px;min-height:86px;padding:12px}
.sp-row--rank-1{min-height:94px}
.sp-movement{grid-area:move}
.sp-player{grid-area:player}
.sp-points{grid-area:points}
.sp-wins,.sp-prize{display:none}
.sp-math{grid-area:math;flex-direction:row;justify-content:space-between;align-items:center;padding-top:7px}
.sp-points{flex-direction:column;align-items:end;gap:1px}
.sp-footnote{margin-left:21px;margin-right:21px}
.sp-lower-grid{grid-template-columns:1fr}
}
@media(max-width:520px){.sp-shell{width:min(100% - 20px,500px);padding-top:14px}
.sp-hero{padding-top:56px;padding-bottom:42px}
.sp-title-row h1{font-size:62px}
.sp-intro{font-size:14px}
.sp-stage-actions{display:flex;flex-wrap:wrap;gap:7px}
.sp-processed-chip{flex:0 0 auto}
.sp-quiet-button,.sp-refresh-button{flex:1 1 calc(50% - 7px)}
.sp-controls{grid-template-columns:1fr}
.sp-control--wide,.sp-control--view{grid-column:auto;grid-row:auto}
.sp-summary-item{min-height:64px;padding:11px 13px}
.sp-summary-item strong{font-size:10px}
.sp-row{grid-template-columns:42px minmax(84px,1fr) 74px;padding-left:9px;padding-right:9px}
.sp-row--rank-1{min-height:91px}
.sp-movement{gap:2px;font-size:10px}
.sp-movement-arrow{font-size:20px}
.sp-rank{min-width:35px}
.sp-player{gap:6px}
.sp-player strong{font-size:12px}
.sp-player-copy small{font-size:8px}
.sp-gap,.sp-last{font-size:9px}
.sp-info-card{min-height:0;padding:21px}
.sp-info-number{font-size:42px}
.sp-footer-line{align-items:start;flex-direction:column}
}
.sp-overlay-mode{background:#05050b}
.sp-overlay-mode:before,.sp-overlay-mode .sp-stage:after{display:none}
.sp-overlay-mode .sp-stage{border-color:#36e7ff61;border-radius:10px;background:#070811f5;box-shadow:0 16px 40px #00000080,0 0 22px #36e7ff0f}
.sp-overlay-mode .sp-stage:before{display:none}
.sp-overlay-mode .sp-row{min-height:64px;padding:8px 9px;border-radius:7px;background:#ffffff09;box-shadow:none}
.sp-overlay-mode .sp-row--rank-1{min-height:64px;background:linear-gradient(100deg,#ffbd4a2e,#ffbd4a0a 55%,#ffffff06);box-shadow:0 0 22px #ffbd4a14}
.sp-overlay-mode .sp-row:hover{transform:none}
.sp-overlay-mode .sp-row:after{opacity:.3}
@media(prefers-reduced-motion:reduce){.sp-title-gradient{filter:none}
.sp-row{animation:none;transition:none}
.sp-quiet-button,.sp-refresh-button,.sp-segmented button{transition:none}
}
</style>

<style is="global">
  .standings-page .sp-rules {
    margin: 0 29px 24px;
    overflow: hidden;
    border: 1px solid rgba(107, 220, 255, .28);
    border-radius: 16px;
    background: radial-gradient(circle at 8% 0, rgba(107, 220, 255, .13), transparent 33%), linear-gradient(135deg, rgba(19, 28, 48, .94), rgba(10, 14, 28, .97) 52%, rgba(27, 17, 47, .94));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 16px 36px rgba(0, 0, 0, .24), 0 0 30px rgba(107, 220, 255, .07);
  }

  .standings-page .sp-rules summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 13px;
    min-height: 64px;
    padding: 0 18px;
    cursor: pointer;
    list-style: none;
  }

  .standings-page .sp-rules summary::-webkit-details-marker { display: none; }
  .standings-page .sp-rules summary::before { width: 7px; height: 7px; border-radius: 50%; background: var(--lb-cyan); box-shadow: 0 0 14px rgba(107, 220, 255, .82); content: ''; }
  .standings-page .sp-rules-title { color: #f2fbff; font: 700 10px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; text-shadow: 0 0 16px rgba(107, 220, 255, .24); }
  .standings-page .sp-rules-summary { overflow: hidden; color: var(--lb-muted); font: 500 9px var(--font-mono); text-align: right; text-overflow: ellipsis; white-space: nowrap; }
  .standings-page .sp-rules-chevron { color: var(--lb-cyan); font: 700 17px var(--font-mono); line-height: 1; transform: translateY(-2px); transition: transform 180ms ease; }
  .standings-page .sp-rules[open] .sp-rules-chevron { transform: rotate(180deg) translateY(2px); }
  .standings-page .sp-rules[open] summary { border-bottom: 1px solid rgba(255, 255, 255, .08); }

  .standings-page .sp-rules-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; padding: 14px 16px 0; }
  .standings-page .sp-rule { min-width: 0; padding: 13px 14px; border: 1px solid rgba(107, 220, 255, .14); border-radius: 11px; background: rgba(4, 7, 16, .46); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .045); }
  .standings-page .sp-rule span { display: block; margin-bottom: 7px; color: var(--lb-subtle); font: 600 8px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .standings-page .sp-rule strong { display: block; overflow-wrap: anywhere; color: #a9f2ff; font: 700 11px/1.35 var(--font-mono); text-shadow: 0 0 16px rgba(107, 220, 255, .3); }
  .standings-page .sp-rules-note { margin: 14px 16px 16px; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, .08); color: var(--lb-muted); font: 500 10px/1.55 var(--font-mono); }
  .standings-page .sp-prize-source { display: inline-block; width: fit-content; color: var(--lb-gold-bright); font: 600 8px var(--font-mono); text-decoration: none; text-shadow: 0 0 12px rgba(242, 189, 87, .24); }
  .standings-page .sp-prize-source:hover { color: #fff0bf; text-decoration: underline; }

  .standings-page .sp-empty {
    display: grid;
    place-items: center;
    gap: 9px;
    min-height: 162px;
    padding: 28px 20px;
    border: 1px dashed rgba(107, 220, 255, .24);
    border-radius: 12px;
    background: radial-gradient(circle at 50% 0, rgba(107, 220, 255, .08), transparent 54%), rgba(4, 7, 16, .32);
    color: var(--lb-muted);
    text-align: center;
  }

  .standings-page .sp-empty[hidden] { display: none; }
  .standings-page .sp-empty-icon { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(107, 220, 255, .35); border-radius: 50%; color: var(--lb-cyan); box-shadow: 0 0 25px rgba(107, 220, 255, .14); font: 700 20px var(--font-mono); }
  .standings-page .sp-empty strong { color: var(--lb-text); font-size: 15px; }
  .standings-page .sp-empty > span:not(.sp-empty-icon) { max-width: 620px; color: var(--lb-muted); font: 500 10px/1.6 var(--font-mono); }

  .standings-page .sp-future { width: min(100%, 790px); margin-top: 8px; text-align: left; }
  .standings-page .sp-future-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; color: var(--lb-cyan); font: 700 8px var(--font-mono); letter-spacing: .13em; }
  .standings-page .sp-future-heading span:last-child { color: var(--lb-subtle); font-weight: 500; letter-spacing: .06em; }
  .standings-page .sp-future-list { display: grid; gap: 7px; }
  .standings-page .sp-future-item { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 15px; width: 100%; padding: 10px 12px; border: 1px solid rgba(107, 220, 255, .14); border-radius: 8px; cursor: pointer; color: var(--lb-text); background: rgba(107, 220, 255, .045); text-align: left; transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .standings-page .sp-future-item:hover { border-color: rgba(107, 220, 255, .48); background: rgba(107, 220, 255, .1); box-shadow: 0 0 22px rgba(107, 220, 255, .1); transform: translateY(-1px); }
  .standings-page .sp-future-copy { display: grid; min-width: 0; gap: 4px; }
  .standings-page .sp-future-copy strong { overflow: hidden; color: #dffaff; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .standings-page .sp-future-copy small { overflow: hidden; color: #83b3ca; font: 500 9px var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .standings-page .sp-future-schedule { color: var(--lb-gold-bright); font: 600 9px var(--font-mono); text-align: right; white-space: nowrap; }
  .standings-page .sp-future-arrow { color: var(--lb-cyan); font: 700 16px var(--font-mono); text-shadow: 0 0 12px rgba(107, 220, 255, .55); }
  .standings-page .sp-overlay-mode .sp-rules { display: none; }

  @media (max-width: 820px) {
    .standings-page .sp-rules { margin-left: 20px; margin-right: 20px; }
    .standings-page .sp-rules-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .standings-page .sp-rules { margin-left: 15px; margin-right: 15px; }
    .standings-page .sp-rules summary { gap: 8px; padding: 0 11px; }
    .standings-page .sp-rules-summary { font-size: 8px; }
    .standings-page .sp-rules-grid { grid-template-columns: 1fr; padding-left: 11px; padding-right: 11px; }
    .standings-page .sp-rules-note { margin-left: 11px; margin-right: 11px; }
    .standings-page .sp-future-item { grid-template-columns: minmax(0, 1fr) auto; gap: 7px 10px; }
    .standings-page .sp-future-schedule { grid-column: 1; grid-row: 2; text-align: left; }
    .standings-page .sp-future-arrow { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>

