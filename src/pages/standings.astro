<Layout
  title="Tournament Standings — Maxxtopia"
  description="A live, replay-aware tournament leaderboard for Fortnite watch parties and stream overlays."
  hideChrome
>
  <div class="standings-page maxxtopia-motion-required" data-motion-required="true">
    <Aurora intensity="low" motionRequired />
    <div class="sp-grid" aria-hidden="true"></div>

    <div class="sp-shell">
      <header class="sp-hero">
        <div class="sp-kicker"><span class="sp-kicker-dot"></span> Watch party control room</div>
        <div class="sp-title-row">
          <div>
            <h1><span class="sp-title-gradient">Live Fortnite standings</span><span class="sp-title-mark">.</span></h1>
            <p class="sp-intro">Find the round being played now, then read a clean top-five or top-ten snapshot.</p>
          </div>
          <span class="sp-hero-chip">One clear board</span>
        </div>
      </header>

      <section class="sp-stage" aria-labelledby="sp-stage-title">
        <div class="sp-stage-topline">
          <div>
            <p class="sp-section-label">Tournament board</p>
            <h2 id="sp-stage-title">Choose a round, then read the board.</h2>
            <div class="sp-board-context"><span id="sp-board-event">Loading event</span><i aria-hidden="true">/</i><span id="sp-board-round">Loading round</span></div>
          </div>
          <div class="sp-stage-actions">
            <span class="sp-processed-chip" id="sp-board-status">WAITING FOR DATA</span>
            <button class="sp-quiet-button" id="sp-share" type="button">Copy board link</button>
            <button class="sp-quiet-button" id="sp-copy-overlay" type="button">Copy OBS URL</button>
            <button class="sp-refresh-button" id="sp-open-overlay" type="button">Open overlay <span aria-hidden="true">↗</span></button>
            <button class="sp-refresh-button" id="sp-refresh" type="button"><span aria-hidden="true">↻</span> Refresh</button>
            <details class="sp-rules" id="sp-rules">
              <summary>
                <span class="sp-rules-title">Format &amp; scoring</span>
                <span class="sp-rules-summary" id="sp-rules-summary">Provider details</span>
                <span class="sp-rules-chevron" aria-hidden="true">⌄</span>
              </summary>
              <div class="sp-rules-popover">
                <div class="sp-rules-grid">
                  <div class="sp-rule"><span>Format</span><strong id="sp-rule-format">Not published</strong></div>
                  <div class="sp-rule"><span>Kill points</span><strong id="sp-rule-kills">Not published</strong></div>
                  <div class="sp-rule"><span>Placement points</span><strong id="sp-rule-placement">Not published</strong></div>
                  <div class="sp-rule"><span>Payout model</span><strong id="sp-rule-payout">Not published</strong></div>
                </div>
                <p class="sp-rules-note" id="sp-rules-note">The provider has not published format or scoring details for this round.</p>
              </div>
            </details>
          </div>
        </div>

        <div class="sp-overlay-tools" aria-label="Overlay controls">
          <span class="sp-overlay-brand"><span class="sp-overlay-mark">M</span> STANDINGS <i>•</i> AFTER GAME</span>
          <div class="sp-overlay-tool-actions">
            <div class="sp-segmented sp-segmented--overlay" role="group" aria-label="Overlay board size">
              <button type="button" data-limit="5" aria-pressed="true">5</button>
              <button type="button" data-limit="10" aria-pressed="false">10</button>
            </div>
            <button class="sp-overlay-collapse" id="sp-overlay-collapse" type="button" aria-expanded="true"><span id="sp-overlay-collapse-label">Minimize</span><span aria-hidden="true">⌃</span></button>
            <a class="sp-overlay-full" id="sp-full-board" href="/standings/">Full board <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <section class="sp-discovery" aria-labelledby="sp-discovery-title">
          <div class="sp-discovery-heading">
            <div>
              <p class="sp-section-label">Start here</p>
              <h3 id="sp-discovery-title">Live now</h3>
              <p class="sp-discovery-copy">Current rounds are shown first. Select one to load its latest Epic snapshot.</p>
            </div>
            <span class="sp-discovery-count" id="sp-discovery-count">Loading rounds…</span>
          </div>
          <div class="sp-live-grid" id="sp-live-list"></div>
          <div class="sp-upcoming-block" id="sp-upcoming-block" hidden>
            <div class="sp-upcoming-heading"><span>Next up</span><span id="sp-upcoming-count">Upcoming rounds</span></div>
            <div class="sp-upcoming-grid" id="sp-upcoming-list"></div>
          </div>
        </section>

        <div class="sp-controls">
          <label class="sp-control">
            <span>Tournament region</span>
            <select id="sp-region">
              <option value="ALL">All regions</option>
              <option value="NAC">NA Central (NAC)</option>
              <option value="NAW">NA West (NAW)</option>
              <option value="EU">Europe (EU)</option>
              <option value="BR">Brazil (BR)</option>
              <option value="ASIA">Asia (ASIA)</option>
              <option value="OCE">Oceania (OCE)</option>
              <option value="ME">Middle East (ME)</option>
            </select>
          </label>
          <div class="sp-control sp-control--wide sp-window-picker">
            <label for="sp-window-search">Find a tournament</label>
            <div class="sp-search-wrap">
              <input id="sp-window-search" type="search" placeholder="Search event, round, or region" autocomplete="off" role="combobox" aria-controls="sp-window-results" aria-expanded="false" />
              <button id="sp-window-clear" class="sp-search-clear" type="button" aria-label="Clear tournament search" hidden>×</button>
            </div>
            <span class="sp-selected-window" id="sp-selected-window">No tournament selected</span>
            <div class="sp-window-results" id="sp-window-results" role="listbox" aria-label="Tournament rounds" hidden></div>
          </div>
          <div class="sp-control sp-control--view">
            <span>Board size</span>
            <div class="sp-segmented" role="group" aria-label="Board size">
              <button id="sp-top5" data-limit="5" class="is-active" type="button" aria-pressed="true">Top 5</button>
              <button id="sp-top10" data-limit="10" type="button" aria-pressed="false">Top 10</button>
            </div>
          </div>
        </div>

        <div class="sp-status-line" role="status" aria-live="polite">
          <span class="sp-status-dot" id="sp-status-dot"></span>
          <span id="sp-status">Loading tournament catalog…</span>
          <span class="sp-status-delay" id="sp-delay"></span>
        </div>

        <div class="sp-summary" aria-label="Leaderboard summary">
          <div class="sp-summary-item sp-summary-item--live"><span class="sp-summary-label">Signal</span><strong id="sp-signal">Waiting</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label" title="This board currently shows the provider's ranked top-five or top-ten snapshot">Board coverage</span><strong id="sp-count">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Last provider update</span><strong id="sp-updated">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Games reported</span><strong id="sp-games">—</strong></div>
          <div class="sp-summary-item sp-summary-item--prize"><span class="sp-summary-label" id="sp-prize-label">Prize pool</span><strong id="sp-prizepool" class="is-unpublished">Not published</strong><a id="sp-prize-source" class="sp-prize-source" href="#" target="_blank" rel="noreferrer" hidden>Official source ↗</a></div>
          <div class="sp-summary-item sp-summary-item--source"><span class="sp-summary-label">Source</span><strong id="sp-source">Epic leaderboard</strong></div>
        </div>

        <div class="sp-board" id="sp-board" aria-live="polite">
          <div class="sp-board-head" aria-hidden="true">
            <span>Move</span><span>Competitor</span><span>Points</span><span>Wins</span><span>Prize</span><span>Next target</span>
          </div>
          <div class="sp-rows" id="sp-rows"></div>
          <div class="sp-empty" id="sp-empty">
            <span class="sp-empty-icon" aria-hidden="true">◎</span>
            <strong id="sp-empty-title">Select a tournament to load the board.</strong>
            <span id="sp-empty-detail">When the provider has processed a replay, the first rows will appear here.</span>
            <div class="sp-future" id="sp-future" hidden>
              <div class="sp-future-heading"><span>UP NEXT</span><span id="sp-future-region">Provider schedule</span></div>
              <div class="sp-future-list" id="sp-future-list"></div>
            </div>
          </div>
        </div>

        <div class="sp-footnote">
          <span class="sp-footnote-mark">i</span>
          <p><strong>What this board shows.</strong> Epic replay and session processing can trail a live event by several minutes. This page currently shows the provider's ranked top-five or top-ten snapshot, never a fake full field, and keeps the last successful snapshot when an update is missing.</p>
        </div>
      </section>

      <section class="sp-lower-grid" aria-label="How to use the board">
        <article class="sp-info-card sp-info-card--gold">
          <span class="sp-info-number">01</span>
          <div><p class="sp-section-label">For the desk</p><h2>Catch the comeback.</h2><p>Every row carries the one detail a caster needs next: places gained, points to the player ahead, and the last-game swing.</p></div>
        </article>
        <article class="sp-info-card sp-info-card--cyan">
          <span class="sp-info-number">02</span>
          <div><p class="sp-section-label">For the stream</p><h2>One board, two homes.</h2><p>Use this page for the watch party. In Streammaxxing, copy the Standings OBS URL and choose Top 5 or Top 10 for the on-stream version.</p></div>
        </article>
      </section>

      <footer class="sp-footer-line">
        <span>Built for the watch party</span>
        <a href="/streammaxxing/">Open Streammaxxing <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </div>
</Layout>

<script define:vars={{ standingsApi }}>
  const API = standingsApi;
  const REGIONS = new Set(['ALL', 'NAC', 'NAW', 'EU', 'BR', 'ASIA', 'OCE', 'ME']);
  const REGION_LABELS = {
    ALL: 'All regions',
    NAC: 'NA Central (NAC)',
    NAW: 'NA West (NAW)',
    EU: 'Europe (EU)',
    BR: 'Brazil (BR)',
    ASIA: 'Asia (ASIA)',
    OCE: 'Oceania (OCE)',
    ME: 'Middle East (ME)',
  };
  const $ = (id) => document.getElementById(id);
  const state = {
    region: 'ALL',
    eventId: '',
    windowId: '',
    windows: [],
    limit: 5,
    pollSeconds: 90,
    timer: null,
    request: 0,
    catalogRequest: 0,
    standingsController: null,
    catalogController: null,
    hasRows: false,
    previousRows: new Map(),
    selectedWindow: null,
    windowSearch: '',
    overlay: false,
    collapsed: false,
  };

  function setStatus(message, tone = 'idle') {
    $('sp-status').textContent = message;
    $('sp-status-dot').className = `sp-status-dot sp-status-dot--${tone}`;
  }

  function formatNumber(value) {
    return Number(value || 0).toLocaleString('en-US');
  }

  function formatSigned(value) {
    const number = Number(value);
    if (!Number.isFinite(number) || number === 0) return '0';
    return `${number > 0 ? '+' : '−'}${formatNumber(Math.abs(number))}`;
  }

  function formatTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return '—';
    return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  }

  const PACIFIC_TIME_ZONE = 'America/Los_Angeles';

  function formatPacificTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return '—';
    return new Intl.DateTimeFormat('en-US', {
      timeZone: PACIFIC_TIME_ZONE,
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short',
    }).format(date);
  }

  function formatDateTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return 'Time not published';
    return date.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  }

  function firstPublished(...values) {
    for (const value of values) {
      if (value !== null && value !== undefined && value !== '') return value;
    }
    return null;
  }

  function readPublishedField(sources, keys) {
    for (const source of sources) {
      if (!source || typeof source !== 'object' || Array.isArray(source)) continue;
      for (const key of keys) {
        if (Object.prototype.hasOwnProperty.call(source, key)) {
          const value = source[key];
          if (value !== null && value !== undefined && value !== '') return value;
        }
      }
    }
    return null;
  }

  function providerSources(data = {}, item = {}) {
    return [
      data?.scoring,
      data?.rules,
      data?.payouts,
      item?.scoring,
      item?.rules,
      item?.payouts,
      data,
      item,
    ].filter(Boolean);
  }

  function formatPhase(item = {}, data = {}) {
    const explicit = firstPublished(
      item.roundType,
      item.phase,
      item.stage,
      item.format,
      item.competitionFormat,
      data.roundType,
      data.phase,
      data.stage,
      data.format,
      data.competitionFormat,
    );
    if (typeof explicit === 'string' && explicit.trim()) return explicit.trim();
    if (explicit && typeof explicit === 'object') {
      const label = firstPublished(explicit.label, explicit.name, explicit.title, explicit.type);
      if (label) return String(label);
    }
    const searchable = [item.name, item.windowName, item.windowId, item.eventName, item.eventId]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
    if (/\bsemi[- ]?finals?\b/.test(searchable)) return 'Semifinals';
    if (/\bfinals?\b/.test(searchable)) return 'Finals';
    if (/\bopens?\b/.test(searchable)) return 'Opens';
    if (/\bqualif/.test(searchable)) return 'Qualifiers';
    return 'Format not published';
  }

  function formatSchedule(item = {}) {
    const begin = item.beginTime || item.startTime || item.startsAt;
    const end = item.endTime || item.finishTime || item.endsAt;
    if (!begin && !end) return 'Time not published';
    if (!begin) return `Ends ${formatDateTime(end)}`;
    if (!end) return formatDateTime(begin);
    const beginDate = new Date(begin);
    const endDate = new Date(end);
    if (Number.isFinite(beginDate.getTime()) && Number.isFinite(endDate.getTime()) && beginDate.toDateString() === endDate.toDateString()) {
      return `${formatDateTime(begin)} – ${formatTime(end)}`;
    }
    return `${formatDateTime(begin)} – ${formatDateTime(end)}`;
  }

  function isUpcoming(item = {}) {
    if (item.status === 'upcoming' || item.upcoming === true) return true;
    if (item.live === true || item.status === 'live') return false;
    const begin = new Date(item.beginTime || item.startTime || item.startsAt);
    return Number.isFinite(begin.getTime()) && begin.getTime() > Date.now();
  }

  function isLive(item = {}) {
    return item.live === true || item.status === 'live';
  }

  function regionCode(item = {}) {
    const explicit = String(item.region || '').trim().toUpperCase();
    const suffix = String(item.windowId || '').match(/_(NAC|NAW|EU|BR|ASIA|OCE|ME)$/i)?.[1]?.toUpperCase();
    return suffix || explicit || '';
  }

  function regionLabel(value) {
    const code = String(value || '').toUpperCase();
    return REGION_LABELS[code] || (code ? code : 'Region not published');
  }

  function roundLabel(item = {}) {
    const round = item.windowName || item.roundName || item.windowId || 'Round';
    const phase = formatPhase(item);
    return phase !== 'Format not published' && !String(round).toLowerCase().includes(phase.toLowerCase())
      ? `${round} · ${phase}`
      : round;
  }

  function selectedWindow() {
    return state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId) || state.selectedWindow || null;
  }

  function renderEventContext(item = null, data = {}) {
    const event = item || {};
    $('sp-board-event').textContent = event.name || event.eventName || event.eventId || 'Tournament';
    const round = event.windowName || event.roundName || event.windowId || data.windowId || 'Round';
    const phase = formatPhase(event, data);
    const hasPhase = phase !== 'Format not published' && !String(round).toLowerCase().includes(phase.toLowerCase());
    $('sp-board-round').textContent = hasPhase ? `${round} · ${phase}` : round;
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('region', state.region);
    if (state.eventId) url.searchParams.set('eventId', state.eventId); else url.searchParams.delete('eventId');
    if (state.windowId) url.searchParams.set('windowId', state.windowId); else url.searchParams.delete('windowId');
    url.searchParams.set('limit', String(state.limit));
    url.searchParams.delete('playerRegion');
    if (state.overlay) url.searchParams.set('overlay', '1'); else url.searchParams.delete('overlay');
    window.history.replaceState({}, '', url);
  }

  function overlayUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('overlay', '1');
    url.searchParams.set('limit', String(state.limit));
    return url.toString();
  }

  function updateFullBoardLink() {
    const url = new URL(window.location.href);
    url.searchParams.delete('overlay');
    url.searchParams.set('limit', String(state.limit));
    $('sp-full-board').href = url.pathname + url.search;
  }

  function renderSelectedWindow() {
    const selected = selectedWindow();
    const label = $('sp-selected-window');
    if (!label) return;
    if (!selected) {
      label.textContent = 'No tournament selected';
      return;
    }
    label.textContent = `Selected: ${selected.name || selected.eventName || selected.eventId || 'Tournament'} · ${roundLabel(selected)} · ${regionLabel(regionCode(selected))}`;
  }

  function makeTournamentCard(item, variant = 'live') {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `sp-tournament-card sp-tournament-card--${variant}`;
    button.dataset.eventId = item.eventId || '';
    button.dataset.windowId = item.windowId || '';
    const selected = selectedWindow();
    button.setAttribute('aria-pressed', String(Boolean(selected && selected.eventId === item.eventId && selected.windowId === item.windowId)));

    const status = document.createElement('span');
    status.className = 'sp-tournament-card-status';
    status.textContent = variant === 'live' ? 'Live now' : variant === 'upcoming' ? 'Next up' : 'Recent';

    const name = document.createElement('strong');
    name.className = 'sp-tournament-card-name';
    name.textContent = item.name || item.eventName || item.eventId || 'Unnamed tournament';

    const round = document.createElement('span');
    round.className = 'sp-tournament-card-round';
    round.textContent = roundLabel(item);

    const meta = document.createElement('span');
    meta.className = 'sp-tournament-card-meta';
    meta.textContent = `${regionLabel(regionCode(item))} · ${variant === 'live' ? 'In progress' : formatSchedule(item)}`;

    const arrow = document.createElement('span');
    arrow.className = 'sp-tournament-card-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↗';

    button.append(status, name, round, meta, arrow);
    button.setAttribute('aria-label', `${status.textContent}: ${name.textContent}, ${round.textContent}, ${meta.textContent}`);
    return button;
  }

  function renderDiscovery() {
    const liveList = $('sp-live-list');
    const upcomingList = $('sp-upcoming-list');
    const upcomingBlock = $('sp-upcoming-block');
    if (!liveList || !upcomingList || !upcomingBlock) return;

    liveList.replaceChildren();
    upcomingList.replaceChildren();
    const live = state.windows.filter(isLive).slice(0, 6);
    const upcoming = state.windows.filter(isUpcoming).slice(0, 6);
    $('sp-discovery-count').textContent = live.length ? `${live.length} live now` : 'No live round in this region';

    if (live.length) {
      live.forEach((item) => liveList.append(makeTournamentCard(item, 'live')));
    } else {
      const empty = document.createElement('div');
      empty.className = 'sp-discovery-empty';
      empty.textContent = upcoming.length ? 'No round is live in this region. The next starts below.' : 'No live rounds were returned for this region.';
      liveList.append(empty);
    }

    upcomingBlock.hidden = upcoming.length === 0;
    $('sp-upcoming-count').textContent = upcoming.length ? `${upcoming.length} scheduled` : 'None scheduled';
    upcoming.forEach((item) => upcomingList.append(makeTournamentCard(item, 'upcoming')));
  }

  function renderWindowSearchResults(open = false) {
    const input = $('sp-window-search');
    const results = $('sp-window-results');
    const clear = $('sp-window-clear');
    if (!input || !results) return;
    const query = String(input.value || '').trim().toLowerCase();
    state.windowSearch = query;
    const live = state.windows.filter(isLive);
    const upcoming = state.windows.filter(isUpcoming);
    const recent = state.windows.filter((item) => !isLive(item) && !isUpcoming(item));
    const ordered = [...live, ...upcoming, ...recent];
    const candidates = (query
      ? ordered.filter((item) => `${item.name || ''} ${item.eventName || ''} ${roundLabel(item)} ${regionLabel(regionCode(item))} ${item.eventId || ''}`.toLowerCase().includes(query))
      : ordered
    ).slice(0, 10);

    results.replaceChildren();
    if (!candidates.length) {
      const empty = document.createElement('div');
      empty.className = 'sp-window-results-empty';
      empty.textContent = query ? 'No matching tournament rounds.' : 'No tournament rounds returned.';
      results.append(empty);
    } else {
      candidates.forEach((item) => {
        const button = makeTournamentCard(item, isLive(item) ? 'live' : isUpcoming(item) ? 'upcoming' : 'recent');
        button.classList.add('sp-window-result');
        button.setAttribute('role', 'option');
        results.append(button);
      });
    }
    results.hidden = !open;
    input.setAttribute('aria-expanded', String(open));
    if (clear) clear.hidden = !input.value;
  }

  function chooseWindow(eventId, windowId) {
    const item = state.windows.find((candidate) => candidate.eventId === eventId && candidate.windowId === windowId);
    if (!item) return;
    state.eventId = item.eventId || '';
    state.windowId = item.windowId || '';
    state.selectedWindow = item;
    $('sp-window-search').value = '';
    renderSelectedWindow();
    renderEventContext(item);
    renderRules(item, {});
    renderDiscovery();
    renderWindowSearchResults(false);
    updateUrl();
    loadStandings({ reset: true });
  }

  function renderFutureWindows() {
    const future = $('sp-future');
    const list = $('sp-future-list');
    if (!future || !list) return;
    list.replaceChildren();
    const upcoming = state.windows.filter(isUpcoming).slice(0, 4);
    future.hidden = upcoming.length === 0;
    if (!upcoming.length) return;

    $('sp-future-region').textContent = state.region === 'ALL' ? 'All regions' : regionLabel(state.region);
    upcoming.forEach((item) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'sp-future-item';
      button.dataset.eventId = item.eventId || '';
      button.dataset.windowId = item.windowId || '';

      const copy = document.createElement('span');
      copy.className = 'sp-future-copy';
      const name = document.createElement('strong');
      name.textContent = item.name || item.eventName || item.eventId || 'Unnamed tournament';
      const round = document.createElement('small');
      round.textContent = roundLabel(item);
      copy.append(name, round);

      const schedule = document.createElement('span');
      schedule.className = 'sp-future-schedule';
      schedule.textContent = formatSchedule(item);

      const arrow = document.createElement('span');
      arrow.className = 'sp-future-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      button.append(copy, schedule, arrow);
      button.setAttribute('aria-label', `Load ${name.textContent}, ${round.textContent}, ${schedule.textContent}`);
      list.append(button);
    });
  }

  function renderEmptyState(mode = 'default') {
    const title = $('sp-empty-title');
    const detail = $('sp-empty-detail');
    if (!title || !detail) return;
    const item = selectedWindow();
    const status = item?.status;
    if (mode === 'loading') {
      title.textContent = 'Loading provider snapshot…';
      detail.textContent = 'Fetching the selected tournament and round.';
    } else if (mode === 'no-selection') {
      title.textContent = 'Select a tournament round';
      detail.textContent = 'Choose a round above to load its standings.';
    } else if (mode === 'standings-error') {
      title.textContent = 'Standings unavailable';
      detail.textContent = 'The provider did not return a snapshot for this round. Try refreshing when it is reachable.';
    } else if (mode === 'catalog-error') {
      title.textContent = 'Tournament catalog unavailable';
      detail.textContent = 'The provider did not return a schedule. Try refreshing when it is reachable.';
    } else if (mode === 'no-catalog') {
      title.textContent = 'No tournament rounds available';
      detail.textContent = `There are no active rounds for ${state.region === 'ALL' ? 'the selected regions' : state.region} right now.`;
    } else if (mode === 'no-rows') {
      title.textContent = status === 'upcoming' ? 'This round has not started' : 'Waiting for provider snapshot';
      detail.textContent = status === 'upcoming'
        ? 'The next round is scheduled below. Standings will appear after the provider processes a replay.'
        : 'No processed standings were returned for this round yet.';
    } else {
      title.textContent = 'Select a tournament to load the board.';
      detail.textContent = 'When the provider has processed a replay, the first rows will appear here.';
    }
    renderFutureWindows();
  }

  function windowLabel(item) {
    const flags = [];
    if (isLive(item)) flags.push('Live now');
    else if (isUpcoming(item)) flags.push('Next up');
    else flags.push('Recent');
    const name = item.name || item.eventName || item.eventId || 'Unnamed tournament';
    return `${flags[0]} · ${name} · ${roundLabel(item)} · ${regionLabel(regionCode(item))}`;
  }

  function renderWindows() {
    if (!state.windows.length) {
      state.eventId = '';
      state.windowId = '';
      state.selectedWindow = null;
      renderEventContext(null);
      renderRules(null, {});
      renderSelectedWindow();
      renderDiscovery();
      renderWindowSearchResults(false);
      renderFutureWindows();
      updateUrl();
      return;
    }
    const preferred = state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId);
    const selected = preferred || state.windows.find(isLive) || state.windows.find(isUpcoming) || state.windows[0];
    state.eventId = selected.eventId || '';
    state.windowId = selected.windowId || '';
    state.selectedWindow = selected;
    renderSelectedWindow();
    renderEventContext(selected);
    renderRules(selected, {});
    renderDiscovery();
    renderWindowSearchResults(false);
    renderFutureWindows();
    updateUrl();
  }

  function renderLegacyRows(rows) {
    const container = $('sp-rows');
    container.replaceChildren();
    const visible = Array.isArray(rows) ? rows.slice(0, state.limit) : [];
    $('sp-count').textContent = visible.length ? `${visible.length} / ${state.limit}` : '—';
    state.hasRows = visible.length > 0;
    $('sp-empty').hidden = state.hasRows;
    if (!visible.length) return;

    visible.forEach((row, index) => {
      const rank = Number(row.rank) || index + 1;
      const delta = Number(row.rankDelta);
      const movement = Number.isFinite(delta) && delta !== 0;
      const article = document.createElement('article');
      const rankClass = rank <= 3 ? `sp-row--rank-${rank}` : 'sp-row--standard';
      article.className = `sp-row ${rankClass} ${movement ? (delta > 0 ? 'sp-row--up' : 'sp-row--down') : 'sp-row--steady'}`;
      article.style.setProperty('--row-delay', `${Math.min(index, 9) * 55}ms`);

      const move = document.createElement('div');
      move.className = 'sp-movement';
      move.setAttribute('aria-label', movement ? `${Math.abs(delta)} place${Math.abs(delta) === 1 ? '' : 's'} ${delta > 0 ? 'up' : 'down'}` : 'No movement');
      if (movement) {
        move.innerHTML = `<span class="sp-movement-arrow" aria-hidden="true">${delta > 0 ? '↑' : '↓'}</span><strong>${Math.abs(delta)}</strong>`;
      } else {
        move.innerHTML = '<span class="sp-movement-blank" aria-hidden="true"></span>';
      }

      const identity = document.createElement('div');
      identity.className = 'sp-player';
      const rankBadge = document.createElement('span');
      rankBadge.className = 'sp-rank';
      rankBadge.textContent = `#${rank}`;
      const name = document.createElement('strong');
      name.textContent = row.name || 'Player unavailable';
      identity.append(rankBadge, name);

      const points = document.createElement('div');
      points.className = 'sp-points';
      const pointsValue = document.createElement('strong');
      pointsValue.textContent = formatNumber(row.points);
      const pointsLabel = document.createElement('span');
      pointsLabel.textContent = 'PTS';
      points.append(pointsValue, pointsLabel);

      const math = document.createElement('div');
      math.className = 'sp-math';
      const gap = document.createElement('span');
      gap.className = 'sp-gap';
      gap.textContent = row.pointsToNext == null ? '— lead' : `+${formatNumber(row.pointsToNext)} to #${formatNumber(row.nextRank || Math.max(1, rank - 1))}`;
      const last = document.createElement('span');
      const lastKnown = row.lastGamePoints != null && Number.isFinite(Number(row.lastGamePoints));
      last.className = `sp-last ${lastKnown && Number(row.lastGamePoints) < 0 ? 'sp-last--negative' : ''}`;
      last.textContent = lastKnown ? `${formatSigned(row.lastGamePoints)} points · last game` : 'LAST GAME —';
      last.title = lastKnown ? `${formatSigned(row.lastGamePoints)} points scored in the last game` : 'Last-game points not published';
      math.append(gap, last);

      article.append(move, identity, points, math);
      container.append(article);
    });
  }

  function formatNullableNumber(value) {
    if (value === null || value === undefined || value === '') return '—';
    const number = Number(value);
    return Number.isFinite(number) ? number.toLocaleString('en-US') : '—';
  }

  function formatPrize(value, currency = 'USD') {
    const number = numericAmount(value);
    if (number === null) return '—';
    const symbol = currency === 'EUR' ? '€' : currency === 'GBP' ? '£' : '$';
    return symbol + number.toLocaleString('en-US', { maximumFractionDigits: 0 });
  }

  function numericAmount(value) {
    if (value === null || value === undefined || value === '') return null;
    if (value && typeof value === 'object') {
      return numericAmount(value.amount ?? value.value ?? value.total);
    }
    if (typeof value === 'string') value = value.replace(/[$,]/g, '');
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function prizePoolAmount(data) {
    const candidates = [data?.prizePool, data?.prizepool, data?.totalPrizePool, data?.payoutTotal, data?.payouts?.total];
    for (const candidate of candidates) {
      const amount = numericAmount(candidate);
      if (amount !== null) return amount;
    }
    return null;
  }

  function explicitPerWinAmount(data = {}, item = {}) {
    const value = readPublishedField(providerSources(data, item), ['perWin', 'payoutPerWin', 'rewardPerWin', 'moneyPerWin', 'winPayout', 'payoutPerVictory']);
    return numericAmount(value);
  }

  function renderPrizePool(data, fallback = 'Not published', item = selectedWindow()) {
    const element = $('sp-prizepool');
    if (!element) return;
    const pool = prizePoolAmount(data);
    const perWin = pool === null ? explicitPerWinAmount(data, item || {}) : null;
    const announced = typeof data?.prizeDisplay === 'string' && data.prizeDisplay.trim()
      ? data.prizeDisplay.trim()
      : String(data?.prizeStatus || '').toLowerCase() === 'announced'
        ? 'Amount pending'
        : '';
    const published = pool !== null || perWin !== null;
    $('sp-prize-label').textContent = data?.prizeLabel || (perWin !== null ? 'Payout per win' : 'Prize pool');
    element.textContent = pool !== null
      ? formatPrize(pool, data?.prizeCurrency)
      : perWin !== null
        ? `${formatPrize(perWin, data?.prizeCurrency)} / win`
        : announced || fallback;
    element.classList.toggle('is-published', published);
    element.classList.toggle('is-unpublished', !published);
    element.classList.toggle('is-announced', Boolean(announced) && !published);
    const sourceLink = $('sp-prize-source');
    const sourceUrl = typeof data?.prizeSourceUrl === 'string' && /^https:\/\//i.test(data.prizeSourceUrl)
      ? data.prizeSourceUrl
      : '';
    if (sourceLink) {
      sourceLink.hidden = !sourceUrl;
      if (sourceUrl) sourceLink.href = sourceUrl;
    }
  }

  function ruleValue(value, kind = '') {
    if (value === null || value === undefined || value === '') return 'Not published';
    if (typeof value === 'object') {
      const nested = kind === 'kills'
        ? readPublishedField([value], ['perKill', 'perElimination', 'pointsPerKill', 'pointsPerElimination'])
        : kind === 'placement'
          ? readPublishedField([value], ['points', 'pointsByPlacement', 'table', 'values'])
          : null;
      if (nested !== null && nested !== value) return ruleValue(nested, kind);
      const label = firstPublished(value.label, value.name, value.title, value.description, value.type);
      if (label) return String(label);
      return 'Published';
    }
    if (typeof value === 'boolean') return value ? 'Published' : 'Not published';
    if (typeof value === 'number' && Number.isFinite(value)) {
      if (kind === 'kills') return `${formatNumber(value)} pts / elimination`;
      if (kind === 'placement') return `${formatNumber(value)} pts`;
      return formatNumber(value);
    }
    return String(value);
  }

  function renderRules(item = null, data = {}) {
    const event = item || {};
    const sources = providerSources(data, event);
    const format = formatPhase(event, data);
    const kills = readPublishedField(sources, ['killPoints', 'eliminationPoints', 'pointsPerKill', 'pointsPerElimination', 'elimPoints', 'kills']);
    const placement = readPublishedField(sources, ['placementPoints', 'pointsForPlacement', 'placementScoring', 'placement']);
    const payoutModel = readPublishedField(sources, ['payoutModel', 'prizeModel', 'payoutType', 'prizeType', 'rewardType']);
    const perWin = explicitPerWinAmount(data, event);
    const payout = perWin !== null ? `${formatPrize(perWin)} / win` : ruleValue(payoutModel, 'payout');
    const scoringPublished = kills !== null || placement !== null;
    const payoutPublished = perWin !== null || payoutModel !== null;
    $('sp-rule-format').textContent = format;
    $('sp-rule-kills').textContent = ruleValue(kills, 'kills');
    $('sp-rule-placement').textContent = ruleValue(placement, 'placement');
    $('sp-rule-payout').textContent = payout;
    $('sp-rules-summary').textContent = `${format} · ${scoringPublished || payoutPublished ? 'metadata published' : 'details not published'}`;
    const source = data.source || 'The provider';
    $('sp-rules-note').textContent = scoringPublished || payoutPublished
      ? `Only format, scoring, and payout fields explicitly returned by ${source} are shown here.`
      : item || data.eventId
        ? `${source} has not published scoring or payout details for this round.`
        : 'Select a tournament round to check its published format and scoring details.';
  }

  function rankBadge(rank) {
    if (rank === 1) {
      return '<svg class="sp-trophy" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v4.6c0 3.02-2.1 5.28-5 5.28S7 11.62 7 8.6V4Z"/><path d="M7 6H3.8v2.1c0 2.1 1.52 3.7 3.55 3.7M17 6h3.2v2.1c0 2.1-1.52 3.7-3.55 3.7M12 13.9V18M8.5 20h7"/></svg>';
    }
    if (rank === 2) return '<span class="sp-rank-roman">II</span>';
    if (rank === 3) return '<span class="sp-rank-roman">III</span>';
    return '<span class="sp-rank-number">#' + rank + '</span>';
  }

  function animateStandingsNumber(element, from, to) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!element || !Number.isFinite(from) || !Number.isFinite(to) || from === to || reduceMotion) {
      if (element) element.textContent = formatNumber(to);
      return;
    }
    const started = performance.now();
    const duration = 720;
    const frame = (now) => {
      const progress = Math.min(1, (now - started) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = formatNumber(Math.round(from + (to - from) * eased));
      if (progress < 1) window.requestAnimationFrame(frame);
    };
    window.requestAnimationFrame(frame);
  }

  function renderRows(rows, totalPlayers = null) {
    const container = $('sp-rows');
    container.replaceChildren();
    const visible = Array.isArray(rows) ? rows.slice(0, state.limit) : [];
    $('sp-count').textContent = visible.length
      ? `Top ${state.limit} view · ${visible.length} shown`
      : `Top ${state.limit} view · no rows`;
    state.hasRows = visible.length > 0;
    $('sp-empty').hidden = state.hasRows;
    if (!visible.length) {
      state.previousRows = new Map();
      return;
    }

    const nextRows = new Map();
    visible.forEach((row, index) => {
      const rank = Number(row.rank) || index + 1;
      const delta = Number(row.rankDelta);
      const movement = Number.isFinite(delta) && delta !== 0;
      const rowKey = row.name || 'rank-' + rank;
      const prior = state.previousRows.get(rowKey);
      const article = document.createElement('article');
      const rankClass = rank <= 3 ? 'sp-row--rank-' + rank : 'sp-row--standard';
      article.className = 'sp-row ' + rankClass + ' ' + (movement ? (delta > 0 ? 'sp-row--up' : 'sp-row--down') : 'sp-row--steady');
      article.style.setProperty('--row-delay', Math.min(index, 9) * 48 + 'ms');
      article.dataset.rank = String(rank);

      const move = document.createElement('div');
      move.className = 'sp-movement';
      move.setAttribute('aria-label', movement ? Math.abs(delta) + ' place' + (Math.abs(delta) === 1 ? '' : 's') + ' ' + (delta > 0 ? 'up' : 'down') : 'No movement');
      move.innerHTML = movement
        ? '<span class="sp-movement-arrow" aria-hidden="true">' + (delta > 0 ? '↑' : '↓') + '</span><strong>' + Math.abs(delta) + '</strong>'
        : '<span class="sp-movement-blank" aria-hidden="true"></span>';

      const identity = document.createElement('div');
      identity.className = 'sp-player';
      const rankBadgeElement = document.createElement('span');
      rankBadgeElement.className = 'sp-rank';
      rankBadgeElement.innerHTML = rankBadge(rank);
      const identityCopy = document.createElement('span');
      identityCopy.className = 'sp-player-copy';
      const name = document.createElement('strong');
      name.textContent = row.name || 'Player unavailable';
      const meta = document.createElement('small');
      const selected = state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId);
      const region = regionCode({ region: row.region, windowId: row.windowId }) || (selected && regionCode(selected)) || (state.region !== 'ALL' ? state.region : '');
      meta.textContent = region ? regionLabel(region) + ' · ' + formatNullableNumber(row.games) + ' games' : formatNullableNumber(row.games) + ' games';
      identityCopy.append(name, meta);
      identity.append(rankBadgeElement, identityCopy);

      const points = document.createElement('div');
      points.className = 'sp-points';
      const pointsValue = document.createElement('strong');
      const currentPoints = Number(row.points);
      pointsValue.textContent = formatNullableNumber(row.points);
      const oldPoints = prior ? Number(prior.points) : NaN;
      if (Number.isFinite(oldPoints) && Number.isFinite(currentPoints) && oldPoints !== currentPoints) {
        pointsValue.classList.add(currentPoints > oldPoints ? 'sp-points-flash' : 'sp-points-flash-red');
        animateStandingsNumber(pointsValue, oldPoints, currentPoints);
      }
      const pointsLabel = document.createElement('span');
      pointsLabel.textContent = 'PTS';
      points.append(pointsValue, pointsLabel);

      const wins = document.createElement('div');
      wins.className = 'sp-wins';
      wins.innerHTML = '<strong>' + formatNullableNumber(row.wins) + '</strong><span>WINS</span>';

      const prize = document.createElement('div');
      prize.className = 'sp-prize ' + (rank <= 3 ? 'sp-prize--tier-' + rank : 'sp-prize--standard');
      const prizeKnown = numericAmount(row.prize) !== null;
      prize.innerHTML = '<strong>' + formatPrize(row.prize) + '</strong><span>' + (prizeKnown ? 'PUBLISHED PAYOUT' : 'PRIZE DATA PENDING') + '</span>';

      const math = document.createElement('div');
      math.className = 'sp-math';
      const gap = document.createElement('strong');
      gap.className = 'sp-gap';
      if (rank === 1) {
        gap.textContent = 'LEAD';
        gap.title = 'This player is currently leading the displayed standings.';
        gap.setAttribute('aria-label', gap.title);
      } else if (row.pointsToNext != null && Number.isFinite(Number(row.pointsToNext))) {
        const pointsToNext = Number(row.pointsToNext);
        const providerNextRank = Number(row.nextRank);
        const hasProviderNextRank = Number.isFinite(providerNextRank);
        const nextRank = hasProviderNextRank ? Math.max(1, providerNextRank) : Math.max(1, rank - 1);
        gap.textContent = (pointsToNext > 0 ? '+' : '') + formatNullableNumber(pointsToNext) + ' to #' + nextRank;
        gap.title = hasProviderNextRank
          ? 'Provider-reported gap: ' + formatNullableNumber(pointsToNext) + ' points to the next higher position (#' + nextRank + ').'
          : 'Provider-reported gap: ' + formatNullableNumber(pointsToNext) + ' points to the next higher position. Target #' + nextRank + ' follows the displayed board order.';
        gap.setAttribute('aria-label', gap.title);
      } else {
        gap.textContent = 'NEXT TARGET —';
        gap.title = 'The provider did not publish a points-to-next gap for this player.';
        gap.setAttribute('aria-label', gap.title);
      }
      const last = document.createElement('span');
      const lastKnown = row.lastGamePoints != null && Number.isFinite(Number(row.lastGamePoints));
      last.className = 'sp-last' + (lastKnown && Number(row.lastGamePoints) < 0 ? ' sp-last--negative' : '');
      last.textContent = lastKnown ? formatSigned(row.lastGamePoints) + ' points · last game' : 'LAST GAME —';
      last.title = lastKnown ? formatSigned(row.lastGamePoints) + ' points scored in the last game' : 'Last-game points not published';
      last.setAttribute('aria-label', last.title);
      math.append(gap, last);

      article.append(move, identity, points, wins, prize, math);
      container.append(article);
      nextRows.set(rowKey, { points: currentPoints });
    });
    state.previousRows = nextRows;
  }

  async function readJson(url, signal) {
    const response = await fetch(url, { signal, headers: { Accept: 'application/json' } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Provider returned HTTP ${response.status}`);
    return data;
  }

  function abortStandings() {
    if (state.standingsController) state.standingsController.abort();
    state.standingsController = null;
  }

  function abortCatalog() {
    if (state.catalogController) state.catalogController.abort();
    state.catalogController = null;
  }

  async function loadStandings({ quiet = false, reset = false } = {}) {
    window.clearTimeout(state.timer);
    const requestId = ++state.request;
    abortStandings();
    if (!state.eventId || !state.windowId) {
      renderRows([]);
      renderEmptyState('no-selection');
      renderRules(null, {});
      renderPrizePool({}, 'Not published', null);
      $('sp-signal').textContent = 'Choose a round';
      setStatus('Choose a tournament round to load standings.', 'idle');
      return;
    }
    if (reset) {
      renderRows([]);
      renderEmptyState('loading');
    } else if (!state.hasRows) {
      renderEmptyState('loading');
    }
    const item = selectedWindow();
    const controller = new AbortController();
    state.standingsController = controller;
    let timedOut = false;
    const timeoutHandler = window.setTimeout(() => {
      timedOut = true;
      controller.abort();
    }, 12000);
    if (reset || !quiet || !state.hasRows) renderPrizePool({}, 'Checking…', item);
    if (!quiet || reset) {
      const round = item?.windowName || item?.roundName || item?.windowId || 'selected round';
      setStatus(`Loading ${round}…`, 'loading');
    }
    try {
      const url = new URL(`${API}/standings`, window.location.origin);
      url.searchParams.set('eventId', state.eventId);
      url.searchParams.set('windowId', state.windowId);
      url.searchParams.set('limit', '10');
      const data = await readJson(url, controller.signal);
      if (requestId !== state.request) return;
      renderRows(data.rows);
      renderRules(item, data);
      renderPrizePool(data, 'Not published', item);
      if (!state.hasRows) renderEmptyState('no-rows');
      state.pollSeconds = Math.min(300, Math.max(60, Number(data.pollAfterSeconds) || 90));
      $('sp-signal').textContent = state.hasRows ? `Top ${state.limit} snapshot` : 'No processed rows';
      $('sp-updated').textContent = formatPacificTime(data.fetched);
      $('sp-source').textContent = data.source || 'Epic leaderboard';
      $('sp-games').textContent = Number.isFinite(Number(data.maxGames)) ? Number(data.maxGames).toLocaleString('en-US') : '—';
      $('sp-delay').textContent = data.replayAware ? 'Provider processing delay expected' : '';
      $('sp-board-status').textContent = state.hasRows ? `Updated ${formatPacificTime(data.fetched)}` : 'No processed rows';
      setStatus(`Updated ${formatPacificTime(data.fetched)} · showing the top ${state.limit} · next check in ${state.pollSeconds}s`, 'good');
      updateUrl();
      schedulePoll();
    } catch (error) {
      if (requestId !== state.request) return;
      if (error.name === 'AbortError' && !timedOut) return;
      $('sp-signal').textContent = state.hasRows ? 'Showing last good' : 'Unavailable';
      if (!state.hasRows) {
        renderPrizePool({}, 'Unavailable', item);
        renderEmptyState('standings-error');
      }
      $('sp-board-status').textContent = state.hasRows ? 'LAST GOOD SNAPSHOT' : 'DATA UNAVAILABLE';
      setStatus(state.hasRows ? `Provider update unavailable — showing the last good snapshot. ${error.message}` : `Standings unavailable: ${error.message}`, 'warn');
      schedulePoll();
    } finally {
      window.clearTimeout(timeoutHandler);
      if (state.standingsController === controller) state.standingsController = null;
    }
  }

  async function loadWindows() {
    state.eventId = new URLSearchParams(window.location.search).get('eventId') || state.eventId;
    state.windowId = new URLSearchParams(window.location.search).get('windowId') || state.windowId;
    const requestId = ++state.catalogRequest;
    abortCatalog();
    state.request += 1;
    abortStandings();
    window.clearTimeout(state.timer);
    renderRows([]);
    renderEmptyState('loading');
    setStatus(`Loading ${state.region === 'ALL' ? 'all regions' : state.region} tournaments…`, 'loading');
    const controller = new AbortController();
    state.catalogController = controller;
    let timedOut = false;
    const timeout = window.setTimeout(() => {
      timedOut = true;
      controller.abort();
    }, 12000);
    try {
      const url = new URL(`${API}/tournaments`, window.location.origin);
      url.searchParams.set('region', state.region);
      url.searchParams.set('history', '1');
      const data = await readJson(url, controller.signal);
      if (requestId !== state.catalogRequest) return;
      state.windows = Array.isArray(data.windows) ? data.windows : [];
      renderWindows();
      if (state.windows.length) {
        setStatus(`${state.windows.length} tournament rounds available · loading standings…`, 'loading');
        await loadStandings({ reset: true });
      } else {
        renderRows([]);
        renderEmptyState('no-catalog');
        $('sp-signal').textContent = 'No active rounds';
        $('sp-board-status').textContent = 'NO TOURNAMENTS';
        setStatus('No tournament rounds were returned for this region.', 'warn');
      }
    } catch (error) {
      if (requestId !== state.catalogRequest) return;
      if (error.name === 'AbortError' && !timedOut) return;
      state.windows = [];
      renderWindows();
      renderRows([]);
      renderEmptyState('catalog-error');
      $('sp-signal').textContent = 'Catalog unavailable';
      setStatus(`Tournament catalog unavailable: ${error.message}`, 'warn');
    } finally {
      window.clearTimeout(timeout);
      if (state.catalogController === controller) state.catalogController = null;
    }
  }

  function schedulePoll() {
    window.clearTimeout(state.timer);
    state.timer = window.setTimeout(() => {
      if (document.visibilityState === 'visible') loadStandings({ quiet: true });
      else schedulePoll();
    }, state.pollSeconds * 1000);
  }

  function setLimit(limit) {
    state.limit = limit === 10 ? 10 : 5;
    document.querySelectorAll('[data-limit]').forEach((button) => {
      const active = Number(button.dataset.limit) === state.limit;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    updateUrl();
    updateFullBoardLink();
    if (state.eventId && state.windowId) loadStandings({ quiet: true });
  }

  $('sp-region').addEventListener('change', (event) => {
    state.region = REGIONS.has(event.target.value) ? event.target.value : 'ALL';
    state.eventId = '';
    state.windowId = '';
    state.windows = [];
    state.selectedWindow = null;
    state.windowSearch = '';
    $('sp-window-search').value = '';
    abortStandings();
    window.clearTimeout(state.timer);
    updateUrl();
    renderRows([]);
    renderEmptyState('loading');
    loadWindows();
  });
  document.querySelectorAll('[data-limit]').forEach((button) => {
    button.addEventListener('click', () => setLimit(Number(button.dataset.limit)));
  });
  $('sp-refresh').addEventListener('click', () => loadStandings());
  ['sp-live-list', 'sp-upcoming-list', 'sp-future-list', 'sp-window-results'].forEach((id) => $(id).addEventListener('click', (event) => {
    const button = event.target.closest('button[data-event-id][data-window-id]');
    if (!button) return;
    chooseWindow(button.dataset.eventId || '', button.dataset.windowId || '');
  }));
  $('sp-window-search').addEventListener('focus', () => renderWindowSearchResults(true));
  $('sp-window-search').addEventListener('input', () => renderWindowSearchResults(true));
  $('sp-window-search').addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      renderWindowSearchResults(false);
      event.target.blur();
    }
  });
  $('sp-window-clear').addEventListener('click', () => {
    $('sp-window-search').value = '';
    renderWindowSearchResults(true);
    $('sp-window-search').focus();
  });
  document.addEventListener('click', (event) => {
    if (!event.target.closest('.sp-window-picker')) renderWindowSearchResults(false);
  });
  $('sp-open-overlay').addEventListener('click', () => window.open(overlayUrl(), '_blank', 'noopener,noreferrer'));
  $('sp-copy-overlay').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(overlayUrl());
      setStatus('OBS URL copied. Add it as a Browser Source in OBS.', 'good');
    } catch {
      setStatus('Copy was blocked by the browser. Use the address bar URL for OBS.', 'idle');
    }
  });
  $('sp-overlay-collapse').addEventListener('click', () => {
    state.collapsed = !state.collapsed;
    document.querySelector('.standings-page').classList.toggle('sp-overlay-collapsed', state.collapsed);
    $('sp-overlay-collapse').setAttribute('aria-expanded', String(!state.collapsed));
    $('sp-overlay-collapse-label').textContent = state.collapsed ? 'Expand' : 'Minimize';
  });
  $('sp-share').addEventListener('click', async () => {
    updateUrl();
    try {
      await navigator.clipboard.writeText(window.location.href);
      setStatus('Board link copied. Share it with the watch party.', 'good');
    } catch {
      setStatus('The board is ready to share from the address bar.', 'idle');
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && state.eventId) loadStandings({ quiet: true });
  });

  const params = new URLSearchParams(window.location.search);
  const initialRegion = String(params.get('region') || 'ALL').toUpperCase();
  state.region = REGIONS.has(initialRegion) ? initialRegion : 'ALL';
  state.limit = params.get('limit') === '10' ? 10 : 5;
  state.overlay = params.get('overlay') === '1' || params.get('view') === 'overlay';
  document.querySelector('.standings-page').classList.toggle('sp-overlay-mode', state.overlay);
  if (state.overlay) document.title = 'OBS Standings Overlay — Maxxtopia';
  $('sp-region').value = state.region;
  setLimit(state.limit);
  updateFullBoardLink();
  loadWindows();
</script>

<style is:global>
  .standings-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #080613;
  }

  .sp-grid {
    position: absolute;
    inset: 0;
    opacity: .22;
    pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .sp-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 92px 0 48px;
  }

  .sp-hero { max-width: 940px; margin-bottom: 38px; }
  .sp-kicker, .sp-section-label, .sp-chip-top, .sp-chip-bottom, .sp-summary-label, .sp-board-head, .sp-footer-line, .sp-info-number {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .sp-kicker { display: flex; align-items: center; gap: 9px; color: var(--color-cyan); font-size: 11px; font-weight: 600; }
  .sp-kicker-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 18px rgba(0,212,255,.9); animation: sp-pulse 2.4s ease-in-out infinite; }
  .sp-title-row { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-top: 15px; }
  .sp-title-row h1 { margin: 0; color: var(--color-text); font-size: clamp(52px, 8vw, 112px); letter-spacing: -.065em; line-height: .84; font-weight: 800; }
  .sp-title-gradient { background: linear-gradient(102deg, #ffe2a1 4%, #ffb23e 34%, #e25bff 67%, #00d4ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sp-title-mark { color: var(--color-warm); font-weight: 400; margin: 0 .08em; }
  .sp-title-muted { color: rgba(248,246,255,.32); font-size: .4em; font-family: var(--font-mono); letter-spacing: -.02em; vertical-align: .26em; }
  .sp-intro { max-width: 690px; margin: 24px 0 0; color: var(--color-text-mid); font-size: 16px; line-height: 1.65; }
  .sp-hero-chip { min-width: 172px; padding: 14px 15px 13px; border: 1px solid rgba(255,178,62,.36); border-radius: 9px; background: linear-gradient(145deg, rgba(255,178,62,.14), rgba(226,91,255,.08)); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 16px 40px rgba(0,0,0,.22); transform: rotate(2deg); }
  .sp-chip-top { display: block; color: var(--color-warm); font-size: 9px; }
  .sp-chip-main { display: block; margin-top: 4px; color: var(--color-text); font-family: var(--font-display); font-size: 25px; letter-spacing: .04em; line-height: .9; }
  .sp-chip-bottom { display: block; margin-top: 8px; color: var(--color-muted); font-size: 8px; letter-spacing: .05em; text-transform: none; }

  .sp-stage { border: 1px solid rgba(226,91,255,.22); border-radius: 18px; background: linear-gradient(140deg, rgba(22,12,46,.96), rgba(12,8,28,.97) 55%, rgba(13,19,39,.97)); box-shadow: 0 30px 90px rgba(0,0,0,.38), 0 0 0 1px rgba(255,255,255,.025) inset; overflow: hidden; }
  .sp-stage-topline { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 28px 30px 22px; border-bottom: 1px solid rgba(255,255,255,.075); }
  .sp-section-label { margin: 0 0 7px; color: var(--color-magenta); font-size: 10px; font-weight: 600; }
