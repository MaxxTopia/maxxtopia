<Layout
  title="Tournament Standings — Maxxtopia"
  description="A live, replay-aware tournament leaderboard for Fortnite watch parties and stream overlays."
  hideChrome
>
  <div class="standings-page maxxtopia-motion-required" data-motion-required="true" data-api={standingsApi}>
    <Aurora intensity="low" motionRequired />
    <div class="sp-grid" aria-hidden="true"></div>

    <div class="sp-shell">
      <header class="sp-hero">
        <div class="sp-kicker"><span class="sp-kicker-dot"></span> Watch party control room</div>
      </header>

      <section class="sp-stage" aria-labelledby="sp-stage-title">
        <div class="sp-stage-topline">
          <div>
            <p class="sp-section-label">Tournament board</p>
            <h2 id="sp-stage-title">The board between games.</h2>
            <div class="sp-board-context"><span id="sp-board-event">Loading event</span><i aria-hidden="true">/</i><span id="sp-board-round">Loading round</span></div>
          </div>
          <div class="sp-stage-actions">
            <span class="sp-processed-chip" id="sp-board-status">WAITING FOR DATA</span>
            <button class="sp-quiet-button" id="sp-share" type="button">Copy board link</button>
            <button class="sp-quiet-button" id="sp-copy-overlay" type="button">Copy OBS URL</button>
            <button class="sp-refresh-button" id="sp-open-overlay" type="button">Open overlay <span aria-hidden="true">↗</span></button>
            <button class="sp-refresh-button" id="sp-refresh" type="button"><span aria-hidden="true">↻</span> Refresh</button>
          </div>
        </div>

        <div class="sp-overlay-tools" aria-label="Overlay controls">
          <span class="sp-overlay-brand"><span class="sp-overlay-mark">M</span><span id="sp-overlay-view-label">STANDINGS</span> <i>•</i> AFTER GAME</span>
          <div class="sp-overlay-tool-actions">
            <div class="sp-segmented sp-segmented--overlay" role="group" aria-label="Overlay board size">
              <button type="button" data-limit="5" aria-pressed="true">5</button>
              <button type="button" data-limit="10" aria-pressed="false">10</button>
            </div>
            <span class="sp-overlay-crawl-status" id="sp-overlay-crawl-status" aria-live="off">TEAMS 1–5 / —</span>
            <button class="sp-overlay-crawl-toggle" id="sp-overlay-crawl-toggle" type="button" aria-pressed="false">Pause</button>
            <button class="sp-overlay-collapse" id="sp-overlay-collapse" type="button" aria-expanded="true"><span id="sp-overlay-collapse-label">Minimize</span><span aria-hidden="true">⌃</span></button>
            <a class="sp-overlay-full" id="sp-full-board" href="/standings/">Full board <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="sp-controls">
          <label class="sp-control">
            <span>Region</span>
            <select id="sp-region">
              <option value="ALL">All regions</option>
              <option value="NAC">NAC</option>
              <option value="NAW">NAW</option>
              <option value="EU">EU</option>
              <option value="BR">BR</option>
              <option value="ASIA">ASIA</option>
              <option value="OCE">OCE</option>
              <option value="ME">ME</option>
            </select>
          </label>
          <label class="sp-control sp-control--wide">
            <span>Tournament and round</span>
            <select id="sp-window" disabled>
              <option>Loading tournament catalog…</option>
            </select>
          </label>
          <div class="sp-control sp-control--view">
            <span>Board size</span>
            <div class="sp-segmented" role="group" aria-label="Board size">
              <button id="sp-top5" data-page-limit="5" class="is-active" type="button" aria-pressed="true">Top 5</button>
              <button id="sp-top10" data-page-limit="10" type="button" aria-pressed="false">Top 10</button>
              <button id="sp-all-teams" data-page-limit="all" type="button" aria-pressed="false">All teams</button>
            </div>
          </div>
        </div>

        <div class="sp-board-switch" aria-label="Leaderboard view">
          <div class="sp-board-switch-controls">
            <span class="sp-board-switch-label">BOARD VIEW</span>
            <div class="sp-segmented sp-segmented--views" role="group" aria-label="Leaderboard view">
              <button type="button" data-board-view="standings" aria-pressed="true">Standings</button>
              <button type="button" data-board-view="nonqualifiers" aria-pressed="false">Didn’t qualify</button>
            </div>
          </div>
          <div class="sp-view-context-wrap">
            <p class="sp-view-context" id="sp-view-context" aria-live="polite">Epic replay-processed standings · updates may trail the broadcast.</p>
            <details class="sp-roster-audit" id="sp-roster-audit" hidden>
              <summary id="sp-roster-audit-summary">Roster evidence</summary>
              <div class="sp-roster-audit-body" id="sp-roster-audit-body"></div>
            </details>
          </div>
        </div>

        <section class="sp-player-region-filter" id="sp-player-region-filter" aria-label="Filter leaderboard by player region">
          <div class="sp-player-region-heading">
            <span class="sp-player-region-label">PLAYER REGION</span>
            <span class="sp-player-region-scope" id="sp-player-region-scope">Filter within global Top 10</span>
          </div>
          <div class="sp-player-region-options" role="group" aria-label="Player competitive region">
            <button type="button" data-player-region="ALL" aria-pressed="true"><span>All</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="NA" aria-pressed="false"><span>NA</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="NAE" aria-pressed="false"><span>NA East</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="NAC" aria-pressed="false"><span>NA Central</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="NAW" aria-pressed="false"><span>NA West</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="EU" aria-pressed="false"><span>EU</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="BR" aria-pressed="false"><span>Brazil</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="ASIA" aria-pressed="false"><span>Asia</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="ME" aria-pressed="false"><span>Middle East</span><small data-region-count>0</small></button>
            <button type="button" data-player-region="OCE" aria-pressed="false"><span>Oceania</span><small data-region-count>0</small></button>
          </div>
          <p class="sp-player-region-result" id="sp-player-region-result" aria-live="polite">Showing all player regions in the loaded snapshot.</p>
        </section>

        <section class="sp-team-search" aria-label="Search tournament standings">
          <div class="sp-team-search-copy">
            <label for="sp-team-search-input">Find a player or team</label>
            <span>Search the entire selected tournament field</span>
          </div>
          <div class="sp-search-input-wrap">
            <span class="sp-search-icon" aria-hidden="true">⌕</span>
            <input id="sp-team-search-input" type="search" maxlength="80" autocomplete="off" placeholder="Try “cold” or “Twis Cold”" aria-describedby="sp-team-search-result" />
            <button id="sp-team-search-clear" type="button" aria-label="Clear player or team search" hidden>Clear</button>
          </div>
          <p class="sp-team-search-result" id="sp-team-search-result" role="status" aria-live="polite">Searches loaded standings and keeps each team’s current place.</p>
        </section>

        <div class="sp-status-line" role="status" aria-live="polite">
          <span class="sp-status-dot" id="sp-status-dot"></span>
          <span id="sp-status">Loading tournament catalog…</span>
          <span class="sp-status-delay" id="sp-delay"></span>
        </div>

        <div class="sp-summary" aria-label="Leaderboard summary">
          <div class="sp-summary-item sp-summary-item--live"><span class="sp-summary-label">Signal</span><strong id="sp-signal">Waiting</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label" id="sp-count-label" title="Team formats count a team as one Epic leaderboard entry">Players shown / total</span><strong id="sp-count">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Last provider update</span><strong id="sp-updated">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Games reported</span><strong id="sp-games">—</strong></div>
          <div class="sp-summary-item sp-summary-item--prize"><span class="sp-summary-label" id="sp-prize-label">Prize pool</span><strong id="sp-prizepool" class="is-unpublished">Not published</strong><a id="sp-prize-source" class="sp-prize-source" href="#" target="_blank" rel="noreferrer" hidden>Official source ↗</a></div>
          <div class="sp-summary-item sp-summary-item--source"><span class="sp-summary-label">Source</span><strong id="sp-source">Epic leaderboard</strong></div>
        </div>

        <details class="sp-rules" id="sp-rules">
          <summary>
            <span class="sp-rules-title">Format &amp; scoring</span>
            <span class="sp-rules-summary" id="sp-rules-summary">Provider details</span>
            <span class="sp-rules-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="sp-rules-grid">
            <div class="sp-rule"><span>Format</span><strong id="sp-rule-format">Not published</strong></div>
            <div class="sp-rule"><span>Kill points</span><strong id="sp-rule-kills">Not published</strong></div>
            <div class="sp-rule"><span>Placement points</span><strong id="sp-rule-placement">Not published</strong></div>
            <div class="sp-rule"><span>Payout model</span><strong id="sp-rule-payout">Not published</strong></div>
          </div>
          <p class="sp-rules-note" id="sp-rules-note">The provider has not published format or scoring details for this round.</p>
        </details>

        <div class="sp-board" id="sp-board" aria-live="polite">
          <div class="sp-board-head" aria-hidden="true">
            <span>Move</span><span>Competitor</span><span>Points</span><span>Wins</span><span id="sp-prize-head">Prize</span><span>Next target</span>
          </div>
          <div class="sp-crawl-window" id="sp-crawl-window">
            <div class="sp-rows" id="sp-rows"></div>
          </div>
          <div class="sp-empty" id="sp-empty">
            <span class="sp-empty-icon" aria-hidden="true">◎</span>
            <strong id="sp-empty-title">Select a tournament to load the board.</strong>
            <span id="sp-empty-detail">When the provider has processed a replay, the first rows will appear here.</span>
            <div class="sp-future" id="sp-future" hidden>
              <div class="sp-future-heading"><span>UP NEXT</span><span id="sp-future-region">Provider schedule</span></div>
              <div class="sp-future-list" id="sp-future-list"></div>
            </div>
          </div>
        </div>

        <div class="sp-footnote">
          <span class="sp-footnote-mark">i</span>
          <p><strong>Why “live-ish”?</strong> Epic replay and session processing can trail a live event by several minutes. This board shows the last successful provider snapshot and never invents a score while an update is missing.</p>
        </div>
      </section>

      <section class="sp-lower-grid" aria-label="How to use the board">
        <article class="sp-info-card sp-info-card--gold">
          <span class="sp-info-number">01</span>
          <div><p class="sp-section-label">For the desk</p><h2>Catch the comeback.</h2><p>Every row carries the one detail a caster needs next: places gained, points to the player ahead, and the last-game swing.</p></div>
        </article>
        <article class="sp-info-card sp-info-card--cyan">
          <span class="sp-info-number">02</span>
          <div><p class="sp-section-label">For the stream</p><h2>One board, two homes.</h2><p>Use this page for the watch party. In Streammaxxing, copy the Standings OBS URL and choose Top 5 or Top 10 for the on-stream version.</p></div>
        </article>
      </section>

      <footer class="sp-footer-line">
        <span>Built for the watch party</span>
        <a href="/streammaxxing">Open Streammaxxing <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </div>
</Layout>

<script>
  import { matchesStandingsSearch, matchingStandingsName } from '../lib/standings-search.js';
  import {
    STANDINGS_MAX_PAGES,
    STANDINGS_PAGE_CONCURRENCY,
    STANDINGS_PAGE_SIZE,
    planStandingsScan,
  } from '../lib/standings-pagination.js';

  const API = document.querySelector('.standings-page')?.dataset.api || '/api';
  const REGIONS = new Set(['ALL', 'NAC', 'NAW', 'EU', 'BR', 'ASIA', 'OCE', 'ME']);
  const PLAYER_REGION_LABELS = {
    ALL: 'All regions', NA: 'North America', NAE: 'NA East', NAC: 'NA Central', NAW: 'NA West',
    EU: 'EU', BR: 'Brazil', ASIA: 'Asia', ME: 'Middle East', OCE: 'Oceania',
  };
  const PLAYER_REGION_FILTERS = new Set(Object.keys(PLAYER_REGION_LABELS));
  const NORTH_AMERICA_REGIONS = new Set(['NA', 'NAE', 'NAC', 'NAW']);
  const $ = (id) => document.getElementById(id);
  const state = {
    region: 'ALL',
    playerRegion: 'ALL',
    eventId: '',
    windowId: '',
    windows: [],
    limit: 5,
    pageLimit: 5,
    pollSeconds: 90,
    timer: null,
    request: 0,
    catalogRequest: 0,
    standingsController: null,
    catalogController: null,
    hasRows: false,
    sourceRows: [],
    sourceTotalPlayers: null,
    searchQuery: '',
    previousRows: new Map(),
    selectedWindow: null,
    overlay: false,
    collapsed: false,
    boardView: 'standings',
    qualificationRank: null,
    rosterCoverage: null,
    scanLimited: false,
    scanError: '',
    scanLoading: false,
    memberRegionBasis: '',
    crawlIndex: 0,
    crawlTimer: null,
    crawlPaused: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
  };

  function setStatus(message, tone = 'idle') {
    $('sp-status').textContent = message;
    $('sp-status-dot').className = `sp-status-dot sp-status-dot--${tone}`;
  }

  function formatNumber(value) {
    return Number(value || 0).toLocaleString('en-US');
  }

  function rowMatchesPlayerRegion(row, filter = state.playerRegion) {
    if (filter === 'ALL') return true;
    const members = Array.isArray(row?.members) ? row.members : [];
    const knownRegions = Array.isArray(row?.memberRegions) ? row.memberRegions : [];
    const regions = knownRegions.length ? knownRegions : members.map((member) => member?.competitiveRegion);
    return regions.some((value) => {
      const region = String(value || '').trim().toUpperCase();
      if (filter === 'NA') return NORTH_AMERICA_REGIONS.has(region);
      return region === filter;
    });
  }

  function updateStandingsSearchChrome(matchingRows) {
    const query = state.searchQuery.trim();
    const clearButton = $('sp-team-search-clear');
    clearButton.hidden = !query;
    if (!query) {
      $('sp-team-search-result').textContent = 'Searches loaded standings and keeps each team’s current place.';
      return;
    }
    if (!matchingRows.length) {
      const scope = state.scanLoading ? 'in the pages loaded so far' : state.scanLimited ? 'in this partial tournament scan' : 'in the selected round';
      const region = state.playerRegion === 'ALL' ? '' : ` for ${PLAYER_REGION_LABELS[state.playerRegion] || state.playerRegion}`;
      $('sp-team-search-result').textContent = `No close match for “${query}”${region} ${scope}. Try fewer letters or clear the player-region filter.`;
      return;
    }
    const matches = matchingRows.slice(0, 3).map((row) => {
      const rank = Number(row.rank) || '—';
      const name = matchingStandingsName(row, query) || row.name || 'Team';
      return `${name} is currently #${rank}`;
    });
    const total = `${formatNumber(matchingRows.length)} ${matchingRows.length === 1 ? 'match' : 'matches'}`;
    const freshness = state.scanLoading ? ' · scan still loading' : state.scanLimited ? ' · partial field' : '';
    $('sp-team-search-result').textContent = `${total}${freshness} · ${matches.join(' · ')}`;
  }

  function updatePlayerRegionChrome(matchingRows = []) {
    const rows = Array.isArray(state.sourceRows) ? state.sourceRows : [];
    const hasKnownRegion = (value) => /^(NAC|NAW|NAE|NA|EU|BR|ASIA|OCE|ME)$/.test(String(value || '').trim().toUpperCase());
    const incompleteRegionCount = rows.filter((row) => {
      const regions = Array.isArray(row?.memberRegions)
        ? row.memberRegions
        : Array.isArray(row?.members) ? row.members.map((member) => member?.competitiveRegion) : [];
      return !regions.length || regions.some((region) => !hasKnownRegion(region));
    }).length;
    const countLabel = (count) => {
      if (state.boardView === 'nonqualifiers') return `${count} tracked-pro ${count === 1 ? 'entry' : 'entries'}`;
      return `${count} ${count === 1 ? 'team' : 'teams'}`;
    };
    const scope = state.boardView === 'nonqualifiers'
      ? 'tracked-pro scan'
      : state.scanLoading ? 'tournament field scan in progress'
        : state.scanLimited ? 'scanned tournament field' : 'tournament field';
    $('sp-player-region-scope').textContent = state.boardView === 'nonqualifiers'
      ? 'Filter within tracked-pro scan'
      : state.scanLoading ? 'Loading every tournament team…'
        : state.scanLimited ? 'Filter within the scanned field'
          : incompleteRegionCount ? `All teams · ${formatNumber(incompleteRegionCount)} region unknown` : 'Filter within all tournament teams';
    document.querySelectorAll('button[data-player-region]').forEach((button) => {
      const filter = button.dataset.playerRegion || 'ALL';
      const count = rows.filter((row) => rowMatchesPlayerRegion(row, filter)).length;
      const selected = filter === state.playerRegion;
      button.classList.toggle('is-active', selected);
      button.setAttribute('aria-pressed', String(selected));
      button.setAttribute('aria-label', `${PLAYER_REGION_LABELS[filter] || filter}: ${countLabel(count)} in the loaded ${scope}`);
      const countElement = button.querySelector('[data-region-count]');
      if (countElement) countElement.textContent = String(count);
    });
    const count = matchingRows.length;
    const regionCoverageNote = incompleteRegionCount
      ? `${formatNumber(incompleteRegionCount)} ${incompleteRegionCount === 1 ? 'team has' : 'teams have'} unresolved player-region data.`
      : 'Every team has resolved player-region data.';
    $('sp-player-region-result').textContent = state.playerRegion === 'ALL'
      ? `Showing all regions across ${countLabel(rows.length)}. ${state.boardView === 'nonqualifiers' ? '' : 'Duo teams match each region represented by either player. '}${regionCoverageNote}`.trim()
      : `${countLabel(count)} ${count === 1 ? 'matches' : 'match'} ${PLAYER_REGION_LABELS[state.playerRegion] || state.playerRegion} in the ${scope}; ${state.boardView === 'nonqualifiers' || state.scanLimited || incompleteRegionCount ? 'some player-region data may be incomplete' : 'duo teams match when either player has this region'}. ${regionCoverageNote} Original tournament ranks are preserved.`;
  }

  function formatSigned(value) {
    const number = Number(value);
    if (!Number.isFinite(number) || number === 0) return '0';
    return `${number > 0 ? '+' : '−'}${formatNumber(Math.abs(number))}`;
  }

  function formatTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return '—';
    return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  }

  const PACIFIC_TIME_ZONE = 'America/Los_Angeles';

  function formatPacificTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return '—';
    return new Intl.DateTimeFormat('en-US', {
      timeZone: PACIFIC_TIME_ZONE,
      hour: 'numeric',
      minute: '2-digit',
      timeZoneName: 'short',
    }).format(date);
  }

  function formatDateTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return 'Time not published';
    return date.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  }

  function firstPublished(...values) {
    for (const value of values) {
      if (value !== null && value !== undefined && value !== '') return value;
    }
    return null;
  }

  function readPublishedField(sources, keys) {
    for (const source of sources) {
      if (!source || typeof source !== 'object' || Array.isArray(source)) continue;
      for (const key of keys) {
        if (Object.prototype.hasOwnProperty.call(source, key)) {
          const value = source[key];
          if (value !== null && value !== undefined && value !== '') return value;
        }
      }
    }
    return null;
  }

  function providerSources(data = {}, item = {}) {
    return [
      data?.scoring,
      data?.rules,
      data?.payouts,
      item?.scoring,
      item?.rules,
      item?.payouts,
      data,
      item,
    ].filter(Boolean);
  }

  function formatPhase(item = {}, data = {}) {
    const explicit = firstPublished(
      item.roundType,
      item.phase,
      item.stage,
      item.format,
      item.competitionFormat,
      data.roundType,
      data.phase,
      data.stage,
      data.format,
      data.competitionFormat,
    );
    if (typeof explicit === 'string' && explicit.trim()) return explicit.trim();
    if (explicit && typeof explicit === 'object') {
      const label = firstPublished(explicit.label, explicit.name, explicit.title, explicit.type);
      if (label) return String(label);
    }
    const searchable = [item.name, item.windowName, item.windowId, item.eventName, item.eventId]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
    if (/\bsemi[- ]?finals?\b/.test(searchable)) return 'Semifinals';
    if (/\bfinals?\b/.test(searchable)) return 'Finals';
    if (/\bopens?\b/.test(searchable)) return 'Opens';
    if (/\bqualif/.test(searchable)) return 'Qualifiers';
    return 'Format not published';
  }

  function formatSchedule(item = {}) {
    const begin = item.beginTime || item.startTime || item.startsAt;
    const end = item.endTime || item.finishTime || item.endsAt;
    if (!begin && !end) return 'Time not published';
    if (!begin) return `Ends ${formatDateTime(end)}`;
    if (!end) return formatDateTime(begin);
    const beginDate = new Date(begin);
    const endDate = new Date(end);
    if (Number.isFinite(beginDate.getTime()) && Number.isFinite(endDate.getTime()) && beginDate.toDateString() === endDate.toDateString()) {
      return `${formatDateTime(begin)} – ${formatTime(end)}`;
    }
    return `${formatDateTime(begin)} – ${formatDateTime(end)}`;
  }

  function isUpcoming(item = {}) {
    if (item.status === 'upcoming' || item.upcoming === true) return true;
    if (item.live === true || item.status === 'live') return false;
    const begin = new Date(item.beginTime || item.startTime || item.startsAt);
    return Number.isFinite(begin.getTime()) && begin.getTime() > Date.now();
  }

  function selectedWindow() {
    return state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId) || state.selectedWindow || null;
  }

  function renderEventContext(item = null, data = {}) {
    const event = item || {};
    $('sp-board-event').textContent = event.name || event.eventName || event.eventId || 'Tournament';
    const round = event.windowName || event.roundName || event.windowId || data.windowId || 'Round';
    const phase = formatPhase(event, data);
    const hasPhase = phase !== 'Format not published' && !String(round).toLowerCase().includes(phase.toLowerCase());
    $('sp-board-round').textContent = hasPhase ? `${round} · ${phase}` : round;
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('region', state.region);
    if (!state.overlay && state.searchQuery.trim()) url.searchParams.set('search', state.searchQuery.trim());
    else url.searchParams.delete('search');
    if (state.playerRegion !== 'ALL') url.searchParams.set('playerRegion', state.playerRegion);
    else url.searchParams.delete('playerRegion');
    if (state.eventId) url.searchParams.set('eventId', state.eventId); else url.searchParams.delete('eventId');
    if (state.windowId) url.searchParams.set('windowId', state.windowId); else url.searchParams.delete('windowId');
    url.searchParams.set('limit', String(state.limit));
    if (!state.overlay && state.pageLimit === 'all') url.searchParams.set('showAll', '1');
    else url.searchParams.delete('showAll');
    if (state.overlay) url.searchParams.set('overlay', '1'); else url.searchParams.delete('overlay');
    if (state.boardView === 'nonqualifiers') url.searchParams.set('board', 'nonqualifiers'); else url.searchParams.delete('board');
    window.history.replaceState({}, '', url);
  }

  function overlayUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('overlay', '1');
    url.searchParams.set('limit', String(state.limit));
    url.searchParams.delete('search');
    url.searchParams.delete('showAll');
    if (state.playerRegion !== 'ALL') url.searchParams.set('playerRegion', state.playerRegion);
    else url.searchParams.delete('playerRegion');
    if (state.boardView === 'nonqualifiers') url.searchParams.set('board', 'nonqualifiers'); else url.searchParams.delete('board');
    return url.toString();
  }

  function updateFullBoardLink() {
    const url = new URL(window.location.href);
    url.searchParams.delete('overlay');
    url.searchParams.set('limit', String(state.limit));
    if (state.pageLimit === 'all') url.searchParams.set('showAll', '1');
    else url.searchParams.delete('showAll');
    if (state.playerRegion !== 'ALL') url.searchParams.set('playerRegion', state.playerRegion);
    else url.searchParams.delete('playerRegion');
    $('sp-full-board').href = url.pathname + url.search;
  }

  function renderRosterAudit(coverage = null) {
    const audit = $('sp-roster-audit');
    const body = $('sp-roster-audit-body');
    const candidates = Array.isArray(coverage?.requestedProCoverage) ? coverage.requestedProCoverage : [];
    audit.hidden = candidates.length === 0;
    body.replaceChildren();
    if (!candidates.length) return;

    const verifiedCount = Number(coverage?.accountIdsVerified || 0);
    $('sp-roster-audit-summary').textContent = `Roster evidence · ${formatNumber(candidates.length)} requested names`;

    const lead = document.createElement('p');
    lead.className = 'sp-audit-lead';
    lead.textContent = `${formatNumber(verifiedCount)} Epic account IDs are verified. Event-name evidence broadens the watchlist, but only exact IDs can match a standings row.`;
    body.append(lead);

    const list = document.createElement('ul');
    list.className = 'sp-audit-pros';
    const sourceLabels = {
      'global-qualifier-roster': 'Global qualifier field',
      'summit-grand-finals': 'Summit Grand Finals',
      'global-live-event-display-tag': 'Global Day 1 event tag',
    };
    for (const candidate of candidates) {
      const item = document.createElement('li');
      const top = document.createElement('div');
      top.className = 'sp-audit-pro-top';
      const name = document.createElement('strong');
      name.textContent = candidate.requestedName || candidate.handle || 'Unnamed candidate';
      const identity = document.createElement('span');
      identity.className = candidate.epicAccountIdVerified ? 'sp-audit-id sp-audit-id--verified' : 'sp-audit-id';
      identity.textContent = candidate.epicAccountIdVerified ? 'Epic ID verified' : 'Candidate';
      top.append(name, identity);
      item.append(top);

      const evidence = document.createElement('small');
      const details = [];
      if (candidate.handle && candidate.handle !== candidate.requestedName) details.push(`listed as ${candidate.handle}`);
      const sources = (Array.isArray(candidate.eventSources) ? candidate.eventSources : [])
        .map((source) => sourceLabels[source] || source);
      if (sources.length) details.push(sources.join(' · '));
      else details.push('No Summit / Global event entry matched');
      if (candidate.note) details.push(candidate.note);
      evidence.textContent = details.join(' — ');
      item.append(evidence);
      list.append(item);
    }
    body.append(list);

    const eventNote = document.createElement('p');
    eventNote.className = 'sp-audit-note';
    const summit = `${formatNumber(coverage?.summitGrandFinalDuos)} Summit Grand Finals duos from ${formatNumber(coverage?.summitLanDuos)} LAN duos; top ${formatNumber(coverage?.summitGlobalQualificationDuos)} advanced to Global`;
    const global = `${formatNumber(coverage?.globalQualifierDuos)} Global duos / ${formatNumber(coverage?.globalQualifierPlayers)} players`;
    const liveSample = `Global Day ${formatNumber(coverage?.globalLiveEventDay)} snapshot after ${formatNumber(coverage?.globalLiveEventMatchesObserved)} games`;
    const onic = Array.isArray(coverage?.requestedOrganizationTags)
      ? coverage.requestedOrganizationTags.find((entry) => entry.tag === 'ONIC')
      : null;
    const onicNote = onic ? ` ONIC appeared as an event display tag for ${onic.players.join(' and ')}; that is not contract verification.` : '';
    const organizations = Array.isArray(coverage?.targetOrganizations) ? coverage.targetOrganizations.join(', ') : '';
    eventNote.textContent = `${global}. ${summit}. ${liveSample}. ${organizations ? `Org discovery list: ${organizations}.` : ''}${onicNote} Event rosters do not verify Epic IDs or players’ home regions.`;
    body.append(eventNote);
  }

  function updateBoardViewChrome(qualification = null) {
    const isNonqualifierView = state.boardView === 'nonqualifiers';
    const page = document.querySelector('.standings-page');
    page?.setAttribute('data-board-view', state.boardView);
    document.querySelectorAll('button[data-board-view]').forEach((button) => {
      const active = button.dataset.boardView === state.boardView;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    $('sp-prize-head').textContent = isNonqualifierView ? 'Cut line' : 'Prize';
    $('sp-count-label').textContent = isNonqualifierView ? 'Tracked pros listed' : 'Players shown / total';
    $('sp-count-label').title = isNonqualifierView ? 'Tracked-player matches below the published cutoff' : 'Team formats count a team as one Epic leaderboard entry';
    $('sp-overlay-view-label').textContent = isNonqualifierView ? 'TRACKED PROS' : 'STANDINGS';
    $('sp-board').classList.toggle('sp-board--nonqualifiers', isNonqualifierView);

    if (!isNonqualifierView) {
      state.rosterCoverage = null;
      state.scanLimited = false;
      renderRosterAudit();
      $('sp-view-context').textContent = 'Epic replay-processed standings · updates may trail the broadcast.';
      return;
    }

    state.rosterCoverage = qualification?.rosterCoverage || null;
    renderRosterAudit(state.rosterCoverage);
    state.scanLimited = qualification?.scanComplete === false || Boolean(qualification?.scanLimited);
    const publishedRank = Number(qualification?.qualificationRank ?? qualification?.rank ?? state.qualificationRank);
    if (Number.isInteger(publishedRank) && publishedRank > 0) {
      state.qualificationRank = publishedRank;
      const scannedRows = Number(qualification?.scannedRows || 0);
      const scanRange = Number(qualification?.scannedThroughRank || 0);
      const scanNote = state.scanLimited
        ? ` Scan is partial: ${formatNumber(scannedRows)} rows checked through rank ${formatNumber(scanRange)}; the provider may have more.`
        : '';
      const coverage = qualification?.rosterCoverage;
      const unresolved = Array.isArray(coverage?.unresolvedHandles) ? coverage.unresolvedHandles : [];
      const coverageDetails = [
        `${formatNumber(coverage?.accountIdsVerified)} Epic account IDs verified`,
        Number.isFinite(Number(coverage?.globalQualifierPlayers))
          ? `${formatNumber(coverage.globalQualifierSeedHandleOverlap)}/${formatNumber(coverage.globalQualifierPlayers)} Global LAN qualifier handle names overlap the seed roster`
          : '',
        Number.isFinite(Number(coverage?.organizationCandidateCount))
          ? `${formatNumber(coverage.organizationCandidateSeedHandleOverlap)}/${formatNumber(coverage.organizationCandidateCount)} org discovery names overlap the seed roster`
          : '',
        coverage?.organizationEventTagsObservedOn
          ? `Epic Global event display tags last checked ${coverage.organizationEventTagsObservedOn}`
          : '',
        coverage?.officialRosterSources?.XP42?.observedOn
          ? `XP42 official Fortnite roster checked ${coverage.officialRosterSources.XP42.observedOn}`
          : '',
        coverage?.officialPowerRankingsObservedOn
          ? `Epic Competitive Power Rankings checked ${coverage.officialPowerRankingsObservedOn}`
          : '',
        coverage?.globalQualifierEventAccountIdsCrossChecked === false ? 'no Global event-entry account-ID cross-check yet' : '',
        Number(coverage?.homeRegionsVerified) === 0 ? 'no player home regions verified' : '',
        unresolved.length ? `unresolved seed: ${unresolved.join(', ')}` : '',
      ].filter(Boolean).join('; ');
      const rosterNote = coverage?.complete === false
        ? ` Roster coverage is incomplete (${coverageDetails}).`
        : '';
      const resolution = qualification?.nameResolution;
      const namesNote = Number(resolution?.resolved) < Number(resolution?.requested)
        ? ' Some matched Epic team names could not be resolved.'
        : '';
      $('sp-view-context').textContent = `Tracked roster matches with a processed game, currently outside the published Top ${formatNumber(publishedRank)} line. Matching uses Epic account IDs. Row regions are tournament regions, not inferred player home regions; a live below-cut position is not a final elimination.${rosterNote}${scanNote}${namesNote}`;
    } else if (qualification?.type === 'value') {
      $('sp-view-context').textContent = 'This round uses a points threshold rather than a published Top-N cutoff, so there is no verified “didn’t qualify” group.';
    } else if (qualification?.type === 'final') {
      $('sp-view-context').textContent = 'This is a final/prize round with no advancement cutoff, so there is no verified “didn’t qualify” group.';
    } else if (qualification?.type === 'none') {
      $('sp-view-context').textContent = 'Epic has not published a rank-based qualification cutoff for this round.';
    } else {
      $('sp-view-context').textContent = 'Choose a round with a published Top-N cutoff to see tracked pros outside the line.';
    }
  }

  function renderFutureWindows() {
    const future = $('sp-future');
    const list = $('sp-future-list');
    if (!future || !list) return;
    list.replaceChildren();
    const upcoming = state.windows.filter(isUpcoming).slice(0, 4);
    future.hidden = upcoming.length === 0;
    if (!upcoming.length) return;

    $('sp-future-region').textContent = state.region === 'ALL' ? 'All regions' : state.region;
    upcoming.forEach((item) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'sp-future-item';
      button.dataset.eventId = item.eventId || '';
      button.dataset.windowId = item.windowId || '';

      const copy = document.createElement('span');
      copy.className = 'sp-future-copy';
      const name = document.createElement('strong');
      name.textContent = item.name || item.eventName || item.eventId || 'Unnamed tournament';
      const round = document.createElement('small');
      const roundLabel = item.windowName || item.roundName || item.windowId || 'Round';
      const phase = formatPhase(item);
      round.textContent = phase !== 'Format not published' && !String(roundLabel).toLowerCase().includes(phase.toLowerCase()) ? `${roundLabel} · ${phase}` : roundLabel;
      copy.append(name, round);

      const schedule = document.createElement('span');
      schedule.className = 'sp-future-schedule';
      schedule.textContent = formatSchedule(item);

      const arrow = document.createElement('span');
      arrow.className = 'sp-future-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      button.append(copy, schedule, arrow);
      button.setAttribute('aria-label', `Load ${name.textContent}, ${round.textContent}, ${schedule.textContent}`);
      list.append(button);
    });
  }

  function renderEmptyState(mode = 'default') {
    const title = $('sp-empty-title');
    const detail = $('sp-empty-detail');
    if (!title || !detail) return;
    const item = selectedWindow();
    const status = item?.status;
    if (mode === 'loading') {
      title.textContent = 'Loading provider snapshot…';
      detail.textContent = 'Fetching the selected tournament and round.';
    } else if (mode === 'loading-nonqualifiers') {
      title.textContent = 'Loading tracked pros below the cut…';
      detail.textContent = 'Checking Epic’s published qualification line, player names, and processed game data.';
    } else if (mode === 'no-selection') {
      title.textContent = 'Select a tournament round';
      detail.textContent = 'Choose a round above to load its standings.';
    } else if (mode === 'no-region-match') {
      title.textContent = `No ${PLAYER_REGION_LABELS[state.playerRegion] || state.playerRegion} entries in this snapshot`;
      detail.textContent = state.boardView === 'nonqualifiers'
        ? 'This filter checks tracked pros in the current scan; player regions are inferred and may be unavailable.'
        : 'No matching resolved player regions appear in the loaded global Top 10. Region data is inferred and may be incomplete; try All regions or another round.';
    } else if (mode === 'no-search-match') {
      title.textContent = 'No close player or team match';
      detail.textContent = state.scanLoading
        ? 'The full tournament scan is still loading. Try again in a moment or clear the player-region filter.'
        : state.scanLimited
          ? 'The tournament scan is incomplete, so this player may be on a page that could not be loaded. Try a shorter name or clear the player-region filter.'
          : 'Try fewer letters, check the spelling, or clear the player-region filter.';
    } else if (mode === 'standings-error') {
      title.textContent = 'Standings unavailable';
      detail.textContent = 'The provider did not return a snapshot for this round. Try refreshing when it is reachable.';
    } else if (mode === 'catalog-error') {
      title.textContent = 'Tournament catalog unavailable';
      detail.textContent = 'The provider did not return a schedule. Try refreshing when it is reachable.';
    } else if (mode === 'no-catalog') {
      title.textContent = 'No tournament rounds available';
      detail.textContent = `There are no active rounds for ${state.region === 'ALL' ? 'the selected regions' : state.region} right now.`;
    } else if (mode === 'no-rows') {
      title.textContent = status === 'upcoming' ? 'This round has not started' : 'Waiting for provider snapshot';
      detail.textContent = status === 'upcoming'
        ? 'The next round is scheduled below. Standings will appear after the provider processes a replay.'
        : 'No processed standings were returned for this round yet.';
    } else if (mode === 'no-cutoff') {
      title.textContent = 'No rank-based cutoff for this round';
      detail.textContent = 'The provider publishes a points threshold or prize ladder here, not a Top-N qualification line. We will not guess who missed the cut.';
    } else if (mode === 'no-nonqualifiers') {
      title.textContent = status === 'upcoming' ? 'This round has not started' : state.scanLimited ? 'No matches in the scanned pages yet' : 'No tracked pros below the cut yet';
      detail.textContent = `${state.scanLimited ? 'The page scan reached its safety limit and is incomplete. ' : ''}Only processed games matched to an Epic account-ID roster are listed. Regional EU, NAC, and NAW Power Rankings have not been imported yet, so an empty result is not proof that no notable players missed the cut. A live below-cut position is not a final elimination, and Epic replay data may trail the broadcast.`;
    } else if (mode === 'nonqualifiers-error') {
      title.textContent = 'Outside-cut standings unavailable';
      detail.textContent = 'The provider did not return enough tournament data to verify the qualification line. Try refreshing when it is reachable.';
    } else {
      title.textContent = 'Select a tournament to load the board.';
      detail.textContent = 'When the provider has processed a replay, the first rows will appear here.';
    }
    renderFutureWindows();
  }

  function windowLabel(item) {
    const flags = [];
    if (item.live) flags.push('LIVE');
    else if (item.status === 'upcoming') flags.push('NEXT');
    else flags.push('RECENT');
    const name = item.name || item.eventName || item.eventId || 'Unnamed tournament';
    const round = item.windowName || item.roundName || item.windowId || 'Round';
    const phase = formatPhase(item);
    const region = item.region ? ` · ${item.region}` : '';
    const roundLabel = phase !== 'Format not published' && !String(round).toLowerCase().includes(phase.toLowerCase()) ? `${round} · ${phase}` : round;
    return `${flags[0]} · ${name} · ${roundLabel}${region}`;
  }

  function renderWindows() {
    const select = $('sp-window');
    select.replaceChildren();
    if (!state.windows.length) {
      select.add(new Option('No tournaments returned for this region', ''));
      select.disabled = true;
      state.eventId = '';
      state.windowId = '';
      state.selectedWindow = null;
      renderEventContext(null);
      renderRules(null, {});
      renderFutureWindows();
      updateUrl();
      return;
    }
    state.windows.forEach((item) => select.add(new Option(windowLabel(item), `${item.eventId}::${item.windowId}`)));
    const preferred = state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId);
    const selected = preferred || state.windows[0];
    state.eventId = selected.eventId || '';
    state.windowId = selected.windowId || '';
    state.selectedWindow = selected;
    select.value = `${state.eventId}::${state.windowId}`;
    select.disabled = false;
    renderEventContext(selected);
    renderRules(selected, {});
    renderFutureWindows();
    updateUrl();
  }

  function renderLegacyRows(rows) {
    const container = $('sp-rows');
    container.replaceChildren();
    const visible = Array.isArray(rows) ? rows.slice(0, state.limit) : [];
    $('sp-count').textContent = visible.length ? `${visible.length} / ${state.limit}` : '—';
    state.hasRows = visible.length > 0;
    $('sp-empty').hidden = state.hasRows;
    if (!visible.length) return;

    visible.forEach((row, index) => {
      const rank = Number(row.rank) || index + 1;
      const delta = Number(row.rankDelta);
      const movement = Number.isFinite(delta) && delta !== 0;
      const article = document.createElement('article');
      const rankClass = rank <= 3 ? `sp-row--rank-${rank}` : 'sp-row--standard';
      article.className = `sp-row ${rankClass} ${movement ? (delta > 0 ? 'sp-row--up' : 'sp-row--down') : 'sp-row--steady'}`;
      article.style.setProperty('--row-delay', `${Math.min(index, 9) * 55}ms`);

      const move = document.createElement('div');
      move.className = 'sp-movement';
      move.setAttribute('aria-label', movement ? `${Math.abs(delta)} place${Math.abs(delta) === 1 ? '' : 's'} ${delta > 0 ? 'up' : 'down'}` : 'No movement');
      if (movement) {
        move.innerHTML = `<span class="sp-movement-arrow" aria-hidden="true">${delta > 0 ? '↑' : '↓'}</span><strong>${Math.abs(delta)}</strong>`;
      } else {
        move.innerHTML = '<span class="sp-movement-blank" aria-hidden="true"></span>';
      }

      const identity = document.createElement('div');
      identity.className = 'sp-player';
      const rankBadge = document.createElement('span');
      rankBadge.className = 'sp-rank';
      rankBadge.textContent = `#${rank}`;
      const name = document.createElement('strong');
      name.textContent = row.name || 'Player unavailable';
      identity.append(rankBadge, name);

      const points = document.createElement('div');
      points.className = 'sp-points';
      const pointsValue = document.createElement('strong');
      pointsValue.textContent = formatNumber(row.points);
      const pointsLabel = document.createElement('span');
      pointsLabel.textContent = 'PTS';
      points.append(pointsValue, pointsLabel);

      const math = document.createElement('div');
      math.className = 'sp-math';
      const gap = document.createElement('span');
      gap.className = 'sp-gap';
      gap.textContent = row.pointsToNext == null ? '— lead' : `+${formatNumber(row.pointsToNext)} to #${formatNumber(row.nextRank || Math.max(1, rank - 1))}`;
      const last = document.createElement('span');
      const lastKnown = row.lastGamePoints != null && Number.isFinite(Number(row.lastGamePoints));
      last.className = `sp-last ${lastKnown && Number(row.lastGamePoints) < 0 ? 'sp-last--negative' : ''}`;
      last.textContent = lastKnown ? `${formatSigned(row.lastGamePoints)} points · last game` : 'LAST GAME —';
      last.title = lastKnown ? `${formatSigned(row.lastGamePoints)} points scored in the last game` : 'Last-game points not published';
      math.append(gap, last);

      article.append(move, identity, points, math);
      container.append(article);
    });
  }

  function formatNullableNumber(value) {
    if (value === null || value === undefined || value === '') return '—';
    const number = Number(value);
    return Number.isFinite(number) ? number.toLocaleString('en-US') : '—';
  }

  function formatPrize(value, currency = 'USD') {
    const number = numericAmount(value);
    if (number === null) return '—';
    const symbol = currency === 'EUR' ? '€' : currency === 'GBP' ? '£' : '$';
    return symbol + number.toLocaleString('en-US', { maximumFractionDigits: 0 });
  }

  function numericAmount(value) {
    if (value === null || value === undefined || value === '') return null;
    if (value && typeof value === 'object') {
      return numericAmount(value.amount ?? value.value ?? value.total);
    }
    if (typeof value === 'string') value = value.replace(/[$,]/g, '');
    const number = Number(value);
    return Number.isFinite(number) ? number : null;
  }

  function prizePoolAmount(data) {
    const candidates = [data?.prizePool, data?.prizepool, data?.totalPrizePool, data?.payoutTotal, data?.payouts?.total];
    for (const candidate of candidates) {
      const amount = numericAmount(candidate);
      if (amount !== null) return amount;
    }
    return null;
  }

  function explicitPerWinAmount(data = {}, item = {}) {
    const value = readPublishedField(providerSources(data, item), ['perWin', 'payoutPerWin', 'rewardPerWin', 'moneyPerWin', 'winPayout', 'payoutPerVictory']);
    return numericAmount(value);
  }

  function renderPrizePool(data, fallback = 'Not published', item = selectedWindow()) {
    const element = $('sp-prizepool');
    if (!element) return;
    const pool = prizePoolAmount(data);
    const perWin = pool === null ? explicitPerWinAmount(data, item || {}) : null;
    const announced = typeof data?.prizeDisplay === 'string' && data.prizeDisplay.trim()
      ? data.prizeDisplay.trim()
      : String(data?.prizeStatus || '').toLowerCase() === 'announced'
        ? 'Amount pending'
        : '';
    const published = pool !== null || perWin !== null;
    $('sp-prize-label').textContent = data?.prizeLabel || (perWin !== null ? 'Payout per win' : 'Prize pool');
    element.textContent = pool !== null
      ? formatPrize(pool, data?.prizeCurrency)
      : perWin !== null
        ? `${formatPrize(perWin, data?.prizeCurrency)} / win`
        : announced || fallback;
    element.classList.toggle('is-published', published);
    element.classList.toggle('is-unpublished', !published);
    element.classList.toggle('is-announced', Boolean(announced) && !published);
    const sourceLink = $('sp-prize-source');
    const sourceUrl = typeof data?.prizeSourceUrl === 'string' && /^https:\/\//i.test(data.prizeSourceUrl)
      ? data.prizeSourceUrl
      : '';
    if (sourceLink) {
      sourceLink.hidden = !sourceUrl;
      if (sourceUrl) sourceLink.href = sourceUrl;
    }
  }

  function ruleValue(value, kind = '') {
    if (value === null || value === undefined || value === '') return 'Not published';
    if (typeof value === 'object') {
      const nested = kind === 'kills'
        ? readPublishedField([value], ['perKill', 'perElimination', 'pointsPerKill', 'pointsPerElimination'])
        : kind === 'placement'
          ? readPublishedField([value], ['points', 'pointsByPlacement', 'table', 'values'])
          : null;
      if (nested !== null && nested !== value) return ruleValue(nested, kind);
      const label = firstPublished(value.label, value.name, value.title, value.description, value.type);
      if (label) return String(label);
      return 'Published';
    }
    if (typeof value === 'boolean') return value ? 'Published' : 'Not published';
    if (typeof value === 'number' && Number.isFinite(value)) {
      if (kind === 'kills') return `${formatNumber(value)} pts / elimination`;
      if (kind === 'placement') return `${formatNumber(value)} pts`;
      return formatNumber(value);
    }
    return String(value);
  }

  function renderRules(item = null, data = {}) {
    const event = item || {};
    const sources = providerSources(data, event);
    const format = formatPhase(event, data);
    const kills = readPublishedField(sources, ['killPoints', 'eliminationPoints', 'pointsPerKill', 'pointsPerElimination', 'elimPoints', 'kills']);
    const placement = readPublishedField(sources, ['placementPoints', 'pointsForPlacement', 'placementScoring', 'placement']);
    const payoutModel = readPublishedField(sources, ['payoutModel', 'prizeModel', 'payoutType', 'prizeType', 'rewardType']);
    const perWin = explicitPerWinAmount(data, event);
    const payout = perWin !== null ? `${formatPrize(perWin)} / win` : ruleValue(payoutModel, 'payout');
    const scoringPublished = kills !== null || placement !== null;
    const payoutPublished = perWin !== null || payoutModel !== null;
    $('sp-rule-format').textContent = format;
    $('sp-rule-kills').textContent = ruleValue(kills, 'kills');
    $('sp-rule-placement').textContent = ruleValue(placement, 'placement');
    $('sp-rule-payout').textContent = payout;
    $('sp-rules-summary').textContent = `${format} · ${scoringPublished || payoutPublished ? 'metadata published' : 'details not published'}`;
    const source = data.source || 'The provider';
    $('sp-rules-note').textContent = scoringPublished || payoutPublished
      ? `Only format, scoring, and payout fields explicitly returned by ${source} are shown here.`
      : item || data.eventId
        ? `${source} has not published scoring or payout details for this round.`
        : 'Select a tournament round to check its published format and scoring details.';
  }

  function rankBadge(rank) {
    if (rank === 1) {
      return '<svg class="sp-trophy" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v4.6c0 3.02-2.1 5.28-5 5.28S7 11.62 7 8.6V4Z"/><path d="M7 6H3.8v2.1c0 2.1 1.52 3.7 3.55 3.7M17 6h3.2v2.1c0 2.1-1.52 3.7-3.55 3.7M12 13.9V18M8.5 20h7"/></svg>';
    }
    if (rank === 2) return '<span class="sp-rank-roman">II</span>';
    if (rank === 3) return '<span class="sp-rank-roman">III</span>';
    return '<span class="sp-rank-number">#' + rank + '</span>';
  }

  function animateStandingsNumber(element, from, to) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!element || !Number.isFinite(from) || !Number.isFinite(to) || from === to || reduceMotion) {
      if (element) element.textContent = formatNumber(to);
      return;
    }
    const started = performance.now();
    const duration = 720;
    const frame = (now) => {
      const progress = Math.min(1, (now - started) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = formatNumber(Math.round(from + (to - from) * eased));
      if (progress < 1) window.requestAnimationFrame(frame);
    };
    window.requestAnimationFrame(frame);
  }

  function renderRows(rows, totalPlayers = null) {
    state.sourceRows = Array.isArray(rows) ? rows : [];
    state.sourceTotalPlayers = totalPlayers;
    renderVisibleRows();
  }

  function updateOverlayCrawlStatus(teamCount) {
    const status = $('sp-overlay-crawl-status');
    if (!status) return;
    const count = Math.max(0, Number(teamCount) || 0);
    const start = count ? Math.min(count, state.crawlIndex + 1) : 0;
    const end = count ? Math.min(count, state.crawlIndex + state.limit) : 0;
    const pad = (value) => String(value).padStart(Math.max(2, String(count || 0).length), '0');
    status.textContent = `TEAMS ${pad(start)}–${pad(end)} / ${formatNumber(count)}`;
    status.setAttribute('aria-label', count
      ? `Showing tournament teams ${start} through ${end} of ${count}`
      : 'Waiting for tournament teams');
  }

  function updateOverlayCrawlToggle() {
    const button = $('sp-overlay-crawl-toggle');
    if (!button) return;
    button.textContent = state.crawlPaused ? 'Resume' : 'Pause';
    button.setAttribute('aria-pressed', String(state.crawlPaused));
    button.setAttribute('aria-label', state.crawlPaused ? 'Resume automatic standings crawl' : 'Pause automatic standings crawl');
  }

  function resetOverlayCrawl() {
    window.clearTimeout(state.crawlTimer);
    state.crawlTimer = null;
    state.crawlIndex = 0;
    $('sp-crawl-window').classList.remove('sp-crawl-resetting');
  }

  function ensureOverlayCrawl(teamCount) {
    const shouldRun = state.overlay
      && !state.collapsed
      && !state.crawlPaused
      && !state.scanLoading
      && document.visibilityState === 'visible'
      && teamCount > state.limit;
    if (!shouldRun) {
      window.clearTimeout(state.crawlTimer);
      state.crawlTimer = null;
      return;
    }
    if (state.crawlTimer !== null) return;
    state.crawlTimer = window.setTimeout(() => {
      state.crawlTimer = null;
      const maxStart = Math.max(0, state.sourceRows.filter((row) => rowMatchesPlayerRegion(row)).length - state.limit);
      if (state.crawlIndex < maxStart) {
        state.crawlIndex += 1;
        renderVisibleRows();
      } else {
        const viewport = $('sp-crawl-window');
        viewport.classList.add('sp-crawl-resetting');
        state.crawlTimer = window.setTimeout(() => {
          state.crawlTimer = null;
          state.crawlIndex = 0;
          viewport.classList.remove('sp-crawl-resetting');
          renderVisibleRows();
        }, 300);
      }
    }, 5600);
  }

  function renderVisibleRows() {
    const container = $('sp-rows');
    $('sp-board').setAttribute('aria-live', state.overlay ? 'off' : 'polite');
    container.replaceChildren();
    const regionRows = state.sourceRows.filter((row) => rowMatchesPlayerRegion(row));
    const query = state.searchQuery.trim();
    const matchingRows = query
      ? regionRows.filter((row) => matchesStandingsSearch(row, query))
      : regionRows;
    updatePlayerRegionChrome(regionRows);
    updateStandingsSearchChrome(matchingRows);
    const pageVisible = query
      ? matchingRows
      : state.overlay
        ? matchingRows.slice(state.crawlIndex, state.crawlIndex + state.limit)
        : state.pageLimit === 'all' ? matchingRows : matchingRows.slice(0, state.pageLimit);
    const visible = pageVisible;
    const providerTotal = Number(state.sourceTotalPlayers);
    const totalLabel = Number.isFinite(providerTotal) && providerTotal > 0
      ? formatNumber(providerTotal)
      : '—';
    if (query) {
      $('sp-count-label').textContent = state.boardView === 'nonqualifiers' ? 'Tracked-pro matches' : 'Search matches';
      $('sp-count').textContent = `${formatNumber(visible.length)} / ${formatNumber(matchingRows.length)}`;
    } else if (state.playerRegion !== 'ALL') {
      $('sp-count-label').textContent = state.boardView === 'nonqualifiers' ? 'Shown / tracked matches' : 'Teams shown / matching teams';
      $('sp-count').textContent = `${visible.length} / ${matchingRows.length}`;
    } else {
      $('sp-count-label').textContent = state.boardView === 'nonqualifiers' ? 'Tracked pros shown' : 'Teams shown / tournament';
      $('sp-count').textContent = state.boardView === 'nonqualifiers'
        ? formatNumber(visible.length)
        : visible.length ? visible.length + ' / ' + totalLabel : '0 / ' + totalLabel;
    }
    updateOverlayCrawlStatus(matchingRows.length);
    updateOverlayCrawlToggle();
    container.classList.toggle('sp-rows--large', !state.overlay && visible.length > 30);
    ensureOverlayCrawl(matchingRows.length);
    state.hasRows = state.sourceRows.length > 0;
    $('sp-empty').hidden = visible.length > 0;
    if (!visible.length) {
      state.previousRows = new Map();
      $('sp-crawl-window').style.height = '';
      if (query) renderEmptyState('no-search-match');
      else if (state.sourceRows.length && state.playerRegion !== 'ALL') renderEmptyState('no-region-match');
      return;
    }

    const nextRows = new Map();
    visible.forEach((row, index) => {
      const rank = Number(row.rank) || index + 1;
      const delta = Number(row.rankDelta);
      const movement = Number.isFinite(delta) && delta !== 0;
      const rowKey = row.name || 'rank-' + rank;
      const prior = state.previousRows.get(rowKey);
      const article = document.createElement('article');
      const rankClass = rank <= 3 ? 'sp-row--rank-' + rank : 'sp-row--standard';
      article.className = 'sp-row ' + rankClass + ' ' + (movement ? (delta > 0 ? 'sp-row--up' : 'sp-row--down') : 'sp-row--steady');
      if (state.overlay && state.crawlIndex > 0) article.classList.add('sp-crawl-enter');
      article.style.setProperty('--row-delay', Math.min(index, 9) * 48 + 'ms');
      article.dataset.rank = String(rank);

      const move = document.createElement('div');
      move.className = 'sp-movement';
      move.setAttribute('aria-label', movement ? Math.abs(delta) + ' place' + (Math.abs(delta) === 1 ? '' : 's') + ' ' + (delta > 0 ? 'up' : 'down') : 'No movement');
      move.innerHTML = movement
        ? '<span class="sp-movement-arrow" aria-hidden="true">' + (delta > 0 ? '↑' : '↓') + '</span><strong>' + Math.abs(delta) + '</strong>'
        : '<span class="sp-movement-blank" aria-hidden="true"></span>';

      const identity = document.createElement('div');
      identity.className = 'sp-player';
      const rankBadgeElement = document.createElement('span');
      rankBadgeElement.className = 'sp-rank';
      rankBadgeElement.innerHTML = rankBadge(rank);
      const identityCopy = document.createElement('span');
      identityCopy.className = 'sp-player-copy';
      const members = Array.isArray(row.members)
        ? row.members.filter((member) => member && typeof member.name === 'string' && member.name.trim())
        : [];
      if (members.length) {
        const memberRegionBasis = state.memberRegionBasis || 'Competitive region inferred from Epic competitive event history; not nationality.';
        members.forEach((member) => {
          const line = document.createElement('span');
          line.className = 'sp-member-line';
          const memberName = document.createElement('strong');
          memberName.className = 'sp-member-name';
          memberName.textContent = member.name;
          line.append(memberName);
          const competitiveRegion = String(member.competitiveRegion || '').toUpperCase();
          if (/^(NAC|NAW|NAE|NA|EU|BR|ASIA|OCE|ME)$/.test(competitiveRegion)) {
            const regionTag = document.createElement('span');
            regionTag.className = 'sp-member-region';
            regionTag.textContent = competitiveRegion;
            regionTag.title = memberRegionBasis;
            regionTag.setAttribute('aria-label', competitiveRegion + ' competitive region; ' + memberRegionBasis);
            line.append(regionTag);
          }
          identityCopy.append(line);
        });
      } else {
        const name = document.createElement('strong');
        name.textContent = row.name || 'Player unavailable';
        identityCopy.append(name);
      }
      const meta = document.createElement('small');
      const selected = state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId);
      const region = row.region || (selected && selected.region) || (state.region !== 'ALL' ? state.region : '');
      const regionLabel = region ? region + ' event' : '';
      meta.textContent = regionLabel ? regionLabel + ' · ' + formatNullableNumber(row.games) + ' games' : formatNullableNumber(row.games) + ' games';
      const trackedPlayers = Array.isArray(row.trackedPlayers) ? row.trackedPlayers.filter(Boolean) : [];
      if (trackedPlayers.length) {
        const tracked = document.createElement('small');
        tracked.className = 'sp-tracked-pro';
        tracked.textContent = 'TRACKED · ' + trackedPlayers.join(' · ');
        tracked.setAttribute('aria-label', 'Tracked pro match: ' + trackedPlayers.join(', '));
        identityCopy.append(meta, tracked);
      } else {
        identityCopy.append(meta);
      }
      identity.append(rankBadgeElement, identityCopy);

      const points = document.createElement('div');
      points.className = 'sp-points';
      const pointsValue = document.createElement('strong');
      const currentPoints = Number(row.points);
      pointsValue.textContent = formatNullableNumber(row.points);
      const oldPoints = prior ? Number(prior.points) : NaN;
      if (Number.isFinite(oldPoints) && Number.isFinite(currentPoints) && oldPoints !== currentPoints) {
        pointsValue.classList.add(currentPoints > oldPoints ? 'sp-points-flash' : 'sp-points-flash-red');
        animateStandingsNumber(pointsValue, oldPoints, currentPoints);
      }
      const pointsLabel = document.createElement('span');
      pointsLabel.textContent = 'PTS';
      points.append(pointsValue, pointsLabel);

      const wins = document.createElement('div');
      wins.className = 'sp-wins';
      wins.innerHTML = '<strong>' + formatNullableNumber(row.wins) + '</strong><span>WINS</span>';

      const prize = document.createElement('div');
      if (state.boardView === 'nonqualifiers') {
        prize.className = 'sp-prize sp-prize--cut';
        const cutoff = document.createElement('strong');
        cutoff.textContent = Number.isInteger(state.qualificationRank) ? '#' + formatNumber(state.qualificationRank) : '—';
        const cutoffLabel = document.createElement('span');
        cutoffLabel.textContent = 'LAST QUALIFIED';
        prize.append(cutoff, cutoffLabel);
      } else {
        prize.className = 'sp-prize ' + (rank <= 3 ? 'sp-prize--tier-' + rank : 'sp-prize--standard');
        const prizeKnown = numericAmount(row.prize) !== null;
        prize.innerHTML = '<strong>' + formatPrize(row.prize) + '</strong><span>' + (prizeKnown ? 'PUBLISHED PAYOUT' : 'PRIZE DATA PENDING') + '</span>';
      }

      const math = document.createElement('div');
      math.className = 'sp-math';
      const gap = document.createElement('strong');
      gap.className = 'sp-gap';
      if (rank === 1) {
        gap.textContent = 'LEAD';
        gap.title = 'This player is currently leading the displayed standings.';
        gap.setAttribute('aria-label', gap.title);
      } else if (row.pointsToNext != null && Number.isFinite(Number(row.pointsToNext))) {
        const pointsToNext = Number(row.pointsToNext);
        const providerNextRank = Number(row.nextRank);
        const hasProviderNextRank = Number.isFinite(providerNextRank);
        const nextRank = hasProviderNextRank ? Math.max(1, providerNextRank) : Math.max(1, rank - 1);
        gap.textContent = (pointsToNext > 0 ? '+' : '') + formatNullableNumber(pointsToNext) + ' to #' + nextRank;
        gap.title = hasProviderNextRank
          ? 'Provider-reported gap: ' + formatNullableNumber(pointsToNext) + ' points to the next higher position (#' + nextRank + ').'
          : 'Provider-reported gap: ' + formatNullableNumber(pointsToNext) + ' points to the next higher position. Target #' + nextRank + ' follows the displayed board order.';
        gap.setAttribute('aria-label', gap.title);
      } else {
        gap.textContent = 'NEXT TARGET —';
        gap.title = 'The provider did not publish a points-to-next gap for this player.';
        gap.setAttribute('aria-label', gap.title);
      }
      const last = document.createElement('span');
      const lastKnown = row.lastGamePoints != null && Number.isFinite(Number(row.lastGamePoints));
      last.className = 'sp-last' + (lastKnown && Number(row.lastGamePoints) < 0 ? ' sp-last--negative' : '');
      last.textContent = lastKnown ? formatSigned(row.lastGamePoints) + ' points · last game' : 'LAST GAME —';
      last.title = lastKnown ? formatSigned(row.lastGamePoints) + ' points scored in the last game' : 'Last-game points not published';
      last.setAttribute('aria-label', last.title);
      math.append(gap, last);

      article.append(move, identity, points, wins, prize, math);
      container.append(article);
      nextRows.set(rowKey, { points: currentPoints });
    });
    state.previousRows = nextRows;
    const viewport = $('sp-crawl-window');
    if (state.overlay && visible.length) {
      const rowHeight = container.firstElementChild?.getBoundingClientRect().height || 64;
      const rowGap = Number.parseFloat(getComputedStyle(container).rowGap) || 7;
      viewport.style.height = `${Math.ceil(rowHeight * visible.length + rowGap * Math.max(0, visible.length - 1))}px`;
    } else {
      viewport.style.height = '';
    }
  }

  async function readJson(url, signal) {
    const response = await fetch(url, { signal, headers: { Accept: 'application/json' } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Provider returned HTTP ${response.status}`);
    return data;
  }

  function mergeStandingsPages(pages) {
    const ranked = [];
    let sequence = 0;
    [...pages.entries()].sort(([left], [right]) => left - right).forEach(([, page]) => {
      (Array.isArray(page.rows) ? page.rows : []).forEach((row) => {
        ranked.push({ row, sequence: sequence++ });
      });
    });
    ranked.sort((left, right) => {
      const rankDifference = (Number(left.row.rank) || 0) - (Number(right.row.rank) || 0);
      return rankDifference || left.sequence - right.sequence;
    });
    return ranked.map(({ row }, index) => {
      const previous = ranked[index - 1]?.row;
      const priorPoints = Number(previous?.points);
      const currentPoints = Number(row.points);
      return {
        ...row,
        nextRank: previous ? Number(previous.rank) || null : null,
        pointsToNext: previous && Number.isFinite(priorPoints) && Number.isFinite(currentPoints)
          ? Math.max(0, priorPoints - currentPoints + 1)
          : null,
      };
    });
  }

  function fullStandingsSnapshot(pageMap, firstPage, expectedPages, failedPages, pageLimited, terminalPage) {
    const actualLastPage = terminalPage == null ? expectedPages - 1 : terminalPage;
    const relevantFailures = failedPages.filter((page) => page <= actualLastPage);
    const hasEveryPage = Array.from({ length: actualLastPage + 1 }, (_, index) => pageMap.has(index)).every(Boolean);
    const scanLimited = pageLimited || relevantFailures.length > 0 || !hasEveryPage;
    const rows = mergeStandingsPages(new Map([...pageMap].filter(([page]) => page <= actualLastPage)));
    const total = firstPage.totalPlayers ?? firstPage.totalEntries ?? firstPage.totalTeams;
    return {
      ...firstPage,
      rows,
      totalPlayers: total ?? rows.length,
      scannedPages: pageMap.size,
      scannedRows: rows.length,
      scanComplete: !scanLimited && (terminalPage != null || pageMap.size >= expectedPages),
      scanLimited,
      ...(relevantFailures.length ? { failedPages: relevantFailures } : {}),
    };
  }

  function abortStandings() {
    if (state.standingsController) state.standingsController.abort();
    state.standingsController = null;
  }

  function abortCatalog() {
    if (state.catalogController) state.catalogController.abort();
    state.catalogController = null;
  }

  async function loadStandings({ quiet = false, reset = false } = {}) {
    window.clearTimeout(state.timer);
    const requestId = ++state.request;
    abortStandings();
    state.scanLoading = false;
    if (!state.eventId || !state.windowId) {
      renderRows([]);
      renderEmptyState('no-selection');
      renderRules(null, {});
      renderPrizePool({}, 'Not published', null);
      updateBoardViewChrome();
      $('sp-signal').textContent = 'Choose a round';
      setStatus('Choose a tournament round to load standings.', 'idle');
      return;
    }
    if (reset) {
      resetOverlayCrawl();
      state.scanLimited = false;
      state.scanError = '';
      renderRows([]);
      renderEmptyState(state.boardView === 'nonqualifiers' ? 'loading-nonqualifiers' : 'loading');
    } else if (!state.hasRows) {
      renderEmptyState(state.boardView === 'nonqualifiers' ? 'loading-nonqualifiers' : 'loading');
    }
    const item = selectedWindow();
    const controller = new AbortController();
    state.standingsController = controller;
    let timedOut = false;
    let timeoutHandler = window.setTimeout(() => {
      timedOut = true;
      controller.abort();
    }, state.boardView === 'nonqualifiers' ? 20000 : 60000);
    if (reset || !quiet || !state.hasRows) renderPrizePool({}, 'Checking…', item);
    if (!quiet || reset) {
      const round = item?.windowName || item?.roundName || item?.windowId || 'selected round';
      setStatus(`Loading ${round}…`, 'loading');
    }
    try {
      const makeStandingsUrl = (page = 0) => {
        const url = new URL(`${API}/standings`, window.location.origin);
        url.searchParams.set('eventId', state.eventId);
        url.searchParams.set('windowId', state.windowId);
        url.searchParams.set('limit', state.boardView === 'nonqualifiers' ? '10' : 'all');
        if (state.boardView === 'nonqualifiers') url.searchParams.set('view', 'nonqualifiers');
        else url.searchParams.set('page', String(page));
        return url;
      };
      let data = await readJson(makeStandingsUrl(0), controller.signal);
      if (requestId !== state.request) return;
      state.memberRegionBasis = typeof data.memberRegionBasis === 'string' && data.memberRegionBasis.trim()
        ? data.memberRegionBasis
        : 'Competitive region inferred from Epic competitive event history; not nationality.';
      state.scanLimited = false;
      state.scanError = '';
      if (state.boardView === 'nonqualifiers') {
        state.qualificationRank = null;
        updateBoardViewChrome(data.qualification ? {
          ...data.qualification,
          qualificationRank: data.qualificationRank,
          scanLimited: data.scanLimited,
          scannedPages: data.scannedPages,
          scannedRows: data.scannedRows,
          scannedThroughRank: data.scannedThroughRank,
          scanComplete: data.scanComplete,
          rosterCoverage: data.rosterCoverage,
          nameResolution: data.nameResolution,
        } : data);
      } else {
        updateBoardViewChrome();
        state.scanLoading = true;
      }
      renderRows(data.rows, data.totalPlayers ?? data.totalEntries ?? data.totalTeams);
      if (state.boardView === 'standings') {
        const pageMap = new Map([[0, data]]);
        const failedPages = [];
        const scanPlan = planStandingsScan(data);
        const { knownPages, expectedPages } = scanPlan;
        let pageLimited = scanPlan.pageLimited;
        if (expectedPages > 1) {
          window.clearTimeout(timeoutHandler);
          timeoutHandler = window.setTimeout(() => {
            timedOut = true;
            controller.abort();
          }, scanPlan.timeoutMs);
        }
        let terminalPage = data.scanComplete === true ? 0 : null;
        if (terminalPage == null) {
          for (let firstPage = 1; firstPage < expectedPages; firstPage += STANDINGS_PAGE_CONCURRENCY) {
            const pageNumbers = Array.from(
              { length: Math.min(STANDINGS_PAGE_CONCURRENCY, expectedPages - firstPage) },
              (_, index) => firstPage + index,
            );
            if (controller.signal.aborted) {
              pageLimited = true;
              break;
            }
            const results = await Promise.allSettled(pageNumbers.map((page) => readJson(makeStandingsUrl(page), controller.signal)));
            if (requestId !== state.request) return;
            results.forEach((result, index) => {
              const page = pageNumbers[index];
              if (result.status === 'fulfilled') {
                pageMap.set(page, result.value);
                if (result.value.scanComplete === true) {
                  terminalPage = terminalPage == null ? page : Math.min(terminalPage, page);
                }
                if (result.value.scanLimited) pageLimited = true;
              } else if (!controller.signal.aborted) {
                failedPages.push(page);
                state.scanError = `Page ${page + 1} unavailable`;
              }
            });
            if (terminalPage != null) {
              for (const page of [...pageMap.keys()]) if (page > terminalPage) pageMap.delete(page);
              break;
            }
            if (controller.signal.aborted) {
              pageLimited = true;
              state.scanError = timedOut ? 'Standings scan timed out' : 'Standings scan was interrupted';
              break;
            }
            const partialRows = mergeStandingsPages(pageMap);
            renderRows(partialRows, data.totalPlayers ?? data.totalEntries ?? data.totalTeams ?? partialRows.length);
            setStatus(`Loading full tournament field · ${pageMap.size} of ${expectedPages} pages`, 'loading');
          }
        }
        if (knownPages == null && terminalPage == null && pageMap.size >= STANDINGS_MAX_PAGES) pageLimited = true;
        data = fullStandingsSnapshot(pageMap, data, expectedPages, failedPages, pageLimited, terminalPage);
        state.scanLoading = false;
        state.scanLimited = data.scanLimited;
        if (data.scanLimited && !state.scanError) {
          state.scanError = knownPages > STANDINGS_MAX_PAGES
            ? `Tournament exceeds the ${STANDINGS_MAX_PAGES * STANDINGS_PAGE_SIZE}-team scan cap`
            : 'Some standings pages could not be loaded';
        }
        renderRows(data.rows, data.totalPlayers);
      }
      renderRules(item, data);
      renderPrizePool(data, 'Not published', item);
      if (!state.hasRows) {
        const noCutoff = state.boardView === 'nonqualifiers' && data.qualification?.type !== 'rank';
        renderEmptyState(state.boardView === 'nonqualifiers' ? (noCutoff ? 'no-cutoff' : 'no-nonqualifiers') : 'no-rows');
      }
      state.pollSeconds = Math.min(300, Math.max(60, Number(data.pollAfterSeconds) || 90));
      $('sp-signal').textContent = data.stale
        ? 'Last good snapshot'
        : state.hasRows
        ? state.boardView === 'nonqualifiers' ? 'Below the cut' : 'Provider snapshot'
        : state.boardView === 'nonqualifiers' ? 'No tracked pros below cut' : 'No processed rows';
      $('sp-updated').textContent = formatPacificTime(data.fetched);
      $('sp-source').textContent = data.source || 'Epic leaderboard';
      $('sp-games').textContent = Number.isFinite(Number(data.maxGames)) ? Number(data.maxGames).toLocaleString('en-US') : '—';
      $('sp-delay').textContent = data.replayAware ? 'PROCESSING DELAY EXPECTED' : '';
      const partialScan = state.boardView === 'nonqualifiers'
        ? data.scanComplete === false || Boolean(data.scanLimited)
        : state.scanLimited;
      $('sp-board-status').textContent = state.hasRows
        ? data.stale
          ? `LAST GOOD · ${state.boardView === 'nonqualifiers' ? `OUTSIDE TOP ${state.qualificationRank}` : 'STANDINGS'}${partialScan ? ' · INCOMPLETE FIELD' : ''} · ${formatPacificTime(data.fetched)}`
          : state.boardView === 'nonqualifiers' ? `OUTSIDE TOP ${state.qualificationRank}${partialScan ? ' · PARTIAL SCAN' : ''} · UPDATED ${formatPacificTime(data.fetched)}` : `STANDINGS${partialScan ? ' · INCOMPLETE FIELD' : ''} · UPDATED ${formatPacificTime(data.fetched)}`
        : state.boardView === 'nonqualifiers'
          ? partialScan ? 'NO MATCHES IN SCANNED PAGES · PARTIAL SCAN' : 'NO TRACKED PROS BELOW CUT'
          : partialScan ? 'NO PROCESSED ROWS · INCOMPLETE FIELD' : 'NO PROCESSED ROWS';
      setStatus(data.stale
        ? `Provider refresh unavailable · showing last good snapshot from ${formatPacificTime(data.fetched)} · retry in ${state.pollSeconds}s`
        : state.boardView === 'standings' && partialScan
          ? `Showing ${formatNumber(data.rows.length)} of ${formatNumber(data.totalPlayers)} teams · ${state.scanError || 'the tournament field scan is incomplete'} · retry in ${state.pollSeconds}s`
          : `Updated ${formatPacificTime(data.fetched)} · next check in ${state.pollSeconds}s`, data.stale || partialScan ? 'warn' : 'good');
      updateUrl();
      schedulePoll();
    } catch (error) {
      if (requestId !== state.request) return;
      if (error.name === 'AbortError' && !timedOut) return;
      $('sp-signal').textContent = state.hasRows ? 'Showing last good' : 'Unavailable';
      if (!state.hasRows) {
        renderPrizePool({}, 'Unavailable', item);
        renderEmptyState(state.boardView === 'nonqualifiers' ? 'nonqualifiers-error' : 'standings-error');
      }
      $('sp-board-status').textContent = state.hasRows ? 'LAST GOOD SNAPSHOT' : 'DATA UNAVAILABLE';
      setStatus(state.hasRows ? `Provider update unavailable — showing the last good snapshot. ${error.message}` : `Standings unavailable: ${error.message}`, 'warn');
      schedulePoll();
    } finally {
      state.scanLoading = false;
      window.clearTimeout(timeoutHandler);
      if (state.standingsController === controller) state.standingsController = null;
    }
  }

  async function loadWindows() {
    state.eventId = new URLSearchParams(window.location.search).get('eventId') || state.eventId;
    state.windowId = new URLSearchParams(window.location.search).get('windowId') || state.windowId;
    const requestId = ++state.catalogRequest;
    abortCatalog();
    state.request += 1;
    abortStandings();
    window.clearTimeout(state.timer);
    $('sp-window').disabled = true;
    renderRows([]);
    renderEmptyState('loading');
    setStatus(`Loading ${state.region === 'ALL' ? 'all regions' : state.region} tournaments…`, 'loading');
    const controller = new AbortController();
    state.catalogController = controller;
    let timedOut = false;
    const timeout = window.setTimeout(() => {
      timedOut = true;
      controller.abort();
    }, 12000);
    try {
      const url = new URL(`${API}/tournaments`, window.location.origin);
      url.searchParams.set('region', state.region);
      url.searchParams.set('history', '1');
      const data = await readJson(url, controller.signal);
      if (requestId !== state.catalogRequest) return;
      state.windows = Array.isArray(data.windows) ? data.windows : [];
      renderWindows();
      if (state.windows.length) {
        setStatus(`${state.windows.length} tournament rounds available · loading standings…`, 'loading');
        await loadStandings({ reset: true });
      } else {
        renderRows([]);
        renderEmptyState('no-catalog');
        $('sp-signal').textContent = 'No active rounds';
        $('sp-board-status').textContent = 'NO TOURNAMENTS';
        setStatus('No tournament rounds were returned for this region.', 'warn');
      }
    } catch (error) {
      if (requestId !== state.catalogRequest) return;
      if (error.name === 'AbortError' && !timedOut) return;
      state.windows = [];
      renderWindows();
      renderRows([]);
      renderEmptyState('catalog-error');
      $('sp-signal').textContent = 'Catalog unavailable';
      setStatus(`Tournament catalog unavailable: ${error.message}`, 'warn');
    } finally {
      window.clearTimeout(timeout);
      if (state.catalogController === controller) state.catalogController = null;
    }
  }

  function schedulePoll() {
    window.clearTimeout(state.timer);
    state.timer = window.setTimeout(() => {
      if (document.visibilityState === 'visible') loadStandings({ quiet: true });
      else schedulePoll();
    }, state.pollSeconds * 1000);
  }

  function setLimit(limit) {
    state.limit = limit === 10 ? 10 : 5;
    document.querySelectorAll('[data-limit]').forEach((button) => {
      const active = Number(button.dataset.limit) === state.limit;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    resetOverlayCrawl();
    updateUrl();
    updateFullBoardLink();
    renderVisibleRows();
  }

  function setPageLimit(limit) {
    state.pageLimit = limit === 'all' ? 'all' : Number(limit) === 10 ? 10 : 5;
    document.querySelectorAll('[data-page-limit]').forEach((button) => {
      const active = String(button.dataset.pageLimit) === String(state.pageLimit);
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    resetOverlayCrawl();
    updateUrl();
    updateFullBoardLink();
    renderVisibleRows();
  }

  function setBoardView(view) {
    const nextView = view === 'nonqualifiers' ? 'nonqualifiers' : 'standings';
    if (state.boardView === nextView) return;
    state.boardView = nextView;
    state.qualificationRank = null;
    resetOverlayCrawl();
    renderRows([]);
    renderEmptyState(state.eventId && state.windowId
      ? nextView === 'nonqualifiers' ? 'loading-nonqualifiers' : 'loading'
      : 'no-selection');
    updateBoardViewChrome();
    updateUrl();
    updateFullBoardLink();
    if (state.eventId && state.windowId) loadStandings({ reset: true });
    else renderEmptyState('no-selection');
  }

  document.querySelectorAll('button[data-board-view]').forEach((button) => {
    button.addEventListener('click', () => setBoardView(button.dataset.boardView));
  });

  document.querySelectorAll('button[data-player-region]').forEach((button) => {
    button.addEventListener('click', () => {
      const nextRegion = String(button.dataset.playerRegion || 'ALL').toUpperCase();
      state.playerRegion = PLAYER_REGION_FILTERS.has(nextRegion) ? nextRegion : 'ALL';
      resetOverlayCrawl();
      updateUrl();
      updateFullBoardLink();
      renderVisibleRows();
    });
  });

  const searchInput = $('sp-team-search-input');
  const clearSearchButton = $('sp-team-search-clear');
  searchInput.addEventListener('input', () => {
    state.searchQuery = searchInput.value.slice(0, 80);
    resetOverlayCrawl();
    updateUrl();
    updateFullBoardLink();
    renderVisibleRows();
  });
  clearSearchButton.addEventListener('click', () => {
    searchInput.value = '';
    state.searchQuery = '';
    resetOverlayCrawl();
    updateUrl();
    updateFullBoardLink();
    renderVisibleRows();
    searchInput.focus();
  });

  $('sp-region').addEventListener('change', (event) => {
    state.region = REGIONS.has(event.target.value) ? event.target.value : 'ALL';
    state.eventId = '';
    state.windowId = '';
    state.windows = [];
    state.selectedWindow = null;
    state.qualificationRank = null;
    updateBoardViewChrome();
    abortStandings();
    window.clearTimeout(state.timer);
    updateUrl();
    renderRows([]);
    renderEmptyState('loading');
    loadWindows();
  });
  $('sp-window').addEventListener('change', (event) => {
    const [eventId, windowId] = String(event.target.value || '').split('::');
    state.eventId = eventId || '';
    state.windowId = windowId || '';
    state.selectedWindow = selectedWindow();
    state.qualificationRank = null;
    updateBoardViewChrome();
    renderEventContext(state.selectedWindow);
    renderRules(state.selectedWindow, {});
    updateUrl();
    loadStandings({ reset: true });
  });
  document.querySelectorAll('[data-limit]').forEach((button) => {
    button.addEventListener('click', () => setLimit(Number(button.dataset.limit)));
  });
  document.querySelectorAll('[data-page-limit]').forEach((button) => {
    button.addEventListener('click', () => setPageLimit(button.dataset.pageLimit));
  });
  $('sp-refresh').addEventListener('click', () => loadStandings());
  $('sp-future-list').addEventListener('click', (event) => {
    const button = event.target.closest('button[data-event-id][data-window-id]');
    if (!button) return;
    state.eventId = button.dataset.eventId || '';
    state.windowId = button.dataset.windowId || '';
    state.selectedWindow = selectedWindow();
    state.qualificationRank = null;
    updateBoardViewChrome();
    const select = $('sp-window');
    select.value = `${state.eventId}::${state.windowId}`;
    renderEventContext(state.selectedWindow);
    renderRules(state.selectedWindow, {});
    updateUrl();
    loadStandings({ reset: true });
  });
  $('sp-open-overlay').addEventListener('click', () => window.open(overlayUrl(), '_blank', 'noopener,noreferrer'));
  $('sp-copy-overlay').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(overlayUrl());
      setStatus('OBS URL copied. Add it as a Browser Source in OBS.', 'good');
    } catch {
      setStatus('Copy was blocked by the browser. Use the address bar URL for OBS.', 'idle');
    }
  });
  $('sp-overlay-collapse').addEventListener('click', () => {
    state.collapsed = !state.collapsed;
    document.querySelector('.standings-page').classList.toggle('sp-overlay-collapsed', state.collapsed);
    $('sp-overlay-collapse').setAttribute('aria-expanded', String(!state.collapsed));
    $('sp-overlay-collapse-label').textContent = state.collapsed ? 'Expand' : 'Minimize';
    if (state.collapsed) {
      window.clearTimeout(state.crawlTimer);
      state.crawlTimer = null;
    } else {
      ensureOverlayCrawl(state.sourceRows.filter((row) => rowMatchesPlayerRegion(row)).length);
    }
  });
  $('sp-overlay-crawl-toggle').addEventListener('click', () => {
    state.crawlPaused = !state.crawlPaused;
    updateOverlayCrawlToggle();
    if (state.crawlPaused) {
      window.clearTimeout(state.crawlTimer);
      state.crawlTimer = null;
    } else {
      ensureOverlayCrawl(state.sourceRows.filter((row) => rowMatchesPlayerRegion(row)).length);
    }
  });
  $('sp-share').addEventListener('click', async () => {
    updateUrl();
    try {
      await navigator.clipboard.writeText(window.location.href);
      setStatus('Board link copied. Share it with the watch party.', 'good');
    } catch {
      setStatus('The board is ready to share from the address bar.', 'idle');
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState !== 'visible') {
      window.clearTimeout(state.crawlTimer);
      state.crawlTimer = null;
      return;
    }
    if (state.eventId) loadStandings({ quiet: true });
    else ensureOverlayCrawl(state.sourceRows.filter((row) => rowMatchesPlayerRegion(row)).length);
  });

  const params = new URLSearchParams(window.location.search);
  const initialRegion = String(params.get('region') || 'ALL').toUpperCase();
  state.region = REGIONS.has(initialRegion) ? initialRegion : 'ALL';
  const initialPlayerRegion = String(params.get('playerRegion') || 'ALL').toUpperCase();
  state.playerRegion = PLAYER_REGION_FILTERS.has(initialPlayerRegion) ? initialPlayerRegion : 'ALL';
  state.limit = params.get('limit') === '10' ? 10 : 5;
  state.pageLimit = params.get('showAll') === '1' ? 'all' : 5;
  state.boardView = params.get('board') === 'nonqualifiers' ? 'nonqualifiers' : 'standings';
  state.overlay = params.get('overlay') === '1' || params.get('view') === 'overlay';
  state.searchQuery = state.overlay ? '' : String(params.get('search') || '').slice(0, 80);
  searchInput.value = state.searchQuery;
  document.querySelector('.standings-page').classList.toggle('sp-overlay-mode', state.overlay);
  updateBoardViewChrome();
  if (state.overlay) document.title = 'OBS Standings Overlay — Maxxtopia';
  $('sp-region').value = state.region;
  updatePlayerRegionChrome();
  setLimit(state.limit);
  setPageLimit(state.pageLimit);
  updateFullBoardLink();
  loadWindows();
</script>

<style is:global>
  .standings-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #080613;
  }

  .sp-grid {
    position: absolute;
    inset: 0;
    opacity: .22;
    pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .sp-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 92px 0 48px;
  }

  .sp-hero { max-width: 940px; margin-bottom: 38px; }
  .sp-kicker, .sp-section-label, .sp-chip-top, .sp-chip-bottom, .sp-summary-label, .sp-board-head, .sp-footer-line, .sp-info-number {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .sp-kicker { display: flex; align-items: center; gap: 9px; color: var(--color-cyan); font-size: 11px; font-weight: 600; }
  .sp-kicker-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 18px rgba(0,212,255,.9); animation: sp-pulse 2.4s ease-in-out infinite; }
  .sp-title-row { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-top: 15px; }
  .sp-title-row h1 { margin: 0; color: var(--color-text); font-size: clamp(52px, 8vw, 112px); letter-spacing: -.065em; line-height: .84; font-weight: 800; }
  .sp-title-gradient { background: linear-gradient(102deg, #ffe2a1 4%, #ffb23e 34%, #e25bff 67%, #00d4ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
