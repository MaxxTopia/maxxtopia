---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';

const standingsApi = '/api';
---

<Layout
  title="Tournament Standings — Maxxtopia"
  description="A live, replay-aware tournament leaderboard for Fortnite watch parties and stream overlays."
>
  <main class="standings-page maxxtopia-motion-required" data-motion-required="true">
    <Aurora intensity="low" motionRequired />
    <div class="sp-grid" aria-hidden="true"></div>

    <div class="sp-shell">
      <header class="sp-hero">
        <div class="sp-kicker"><span class="sp-kicker-dot"></span> Watch party control room</div>
        <div class="sp-title-row">
          <div>
            <h1><span class="sp-title-gradient">Standings</span><span class="sp-title-mark">/</span><span class="sp-title-muted">live-ish</span></h1>
            <p class="sp-intro">
              The scoreboard for the moments between games. Pick any available Epic tournament,
              see the comeback math, then send the same board straight into OBS through Streammaxxing.
            </p>
          </div>
          <div class="sp-hero-chip" aria-label="Replay-aware tournament data">
            <span class="sp-chip-top">EPIC DATA</span>
            <span class="sp-chip-main">REPLAY AWARE</span>
            <span class="sp-chip-bottom">updates on the provider clock</span>
          </div>
        </div>
      </header>

      <section class="sp-stage" aria-labelledby="sp-stage-title">
        <div class="sp-stage-topline">
          <div>
            <p class="sp-section-label">Tournament board</p>
            <h2 id="sp-stage-title">Choose the lobby you’re watching.</h2>
          </div>
          <div class="sp-stage-actions">
            <button class="sp-quiet-button" id="sp-share" type="button">Copy board link</button>
            <button class="sp-refresh-button" id="sp-refresh" type="button"><span aria-hidden="true">↻</span> Refresh</button>
          </div>
        </div>

        <div class="sp-controls">
          <label class="sp-control">
            <span>Region</span>
            <select id="sp-region">
              <option value="ALL">All regions</option>
              <option value="NAC">NAC</option>
              <option value="NAW">NAW</option>
              <option value="EU">EU</option>
              <option value="BR">BR</option>
              <option value="ASIA">ASIA</option>
              <option value="OCE">OCE</option>
              <option value="ME">ME</option>
            </select>
          </label>
          <label class="sp-control sp-control--wide">
            <span>Tournament and round</span>
            <select id="sp-window" disabled>
              <option>Loading tournament catalog…</option>
            </select>
          </label>
          <div class="sp-control sp-control--view">
            <span>Board size</span>
            <div class="sp-segmented" role="group" aria-label="Board size">
              <button id="sp-top5" class="is-active" type="button" aria-pressed="true">Top 5</button>
              <button id="sp-top10" type="button" aria-pressed="false">Top 10</button>
            </div>
          </div>
        </div>

        <div class="sp-status-line" role="status" aria-live="polite">
          <span class="sp-status-dot" id="sp-status-dot"></span>
          <span id="sp-status">Loading tournament catalog…</span>
        </div>

        <div class="sp-summary" aria-label="Leaderboard summary">
          <div class="sp-summary-item sp-summary-item--live"><span class="sp-summary-label">Signal</span><strong id="sp-signal">Waiting</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Players shown</span><strong id="sp-count">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Last provider update</span><strong id="sp-updated">—</strong></div>
          <div class="sp-summary-item"><span class="sp-summary-label">Source</span><strong id="sp-source">Epic leaderboard</strong></div>
        </div>

        <div class="sp-board" id="sp-board" aria-live="polite">
          <div class="sp-board-head" aria-hidden="true">
            <span>Move</span><span>Player</span><span>Points</span><span>Gap / last game</span>
          </div>
          <div class="sp-rows" id="sp-rows"></div>
          <div class="sp-empty" id="sp-empty">
            <span class="sp-empty-icon" aria-hidden="true">◎</span>
            <strong>Select a tournament to load the board.</strong>
            <span>When the provider has processed a replay, the first rows will appear here.</span>
          </div>
        </div>

        <div class="sp-footnote">
          <span class="sp-footnote-mark">i</span>
          <p><strong>Why “live-ish”?</strong> Epic replay and session processing can trail a live event by several minutes. This board shows the last successful provider snapshot and never invents a score while an update is missing.</p>
        </div>
      </section>

      <section class="sp-lower-grid" aria-label="How to use the board">
        <article class="sp-info-card sp-info-card--gold">
          <span class="sp-info-number">01</span>
          <div><p class="sp-section-label">For the desk</p><h2>Catch the comeback.</h2><p>Every row carries the one detail a caster needs next: places gained, points to the player ahead, and the last-game swing.</p></div>
        </article>
        <article class="sp-info-card sp-info-card--cyan">
          <span class="sp-info-number">02</span>
          <div><p class="sp-section-label">For the stream</p><h2>One board, two homes.</h2><p>Use this page for the watch party. In Streammaxxing, copy the Standings OBS URL and choose Top 5 or Top 10 for the on-stream version.</p></div>
        </article>
      </section>

      <footer class="sp-footer-line">
        <span>Built for the watch party</span>
        <a href="/streammaxxing">Open Streammaxxing <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </main>
</Layout>

<script define:vars={{ standingsApi }}>
  const API = standingsApi;
  const REGIONS = new Set(['ALL', 'NAC', 'NAW', 'EU', 'BR', 'ASIA', 'OCE', 'ME']);
  const $ = (id) => document.getElementById(id);
  const state = {
    region: 'ALL',
    eventId: '',
    windowId: '',
    windows: [],
    limit: 5,
    pollSeconds: 90,
    timer: null,
    request: 0,
    hasRows: false,
  };

  function setStatus(message, tone = 'idle') {
    $('sp-status').textContent = message;
    $('sp-status-dot').className = `sp-status-dot sp-status-dot--${tone}`;
  }

  function formatNumber(value) {
    return Number(value || 0).toLocaleString('en-US');
  }

  function formatSigned(value) {
    const number = Number(value);
    if (!Number.isFinite(number) || number === 0) return '0';
    return `${number > 0 ? '+' : '−'}${formatNumber(Math.abs(number))}`;
  }

  function formatTime(value) {
    const date = new Date(value);
    if (!Number.isFinite(date.getTime())) return '—';
    return date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    url.searchParams.set('region', state.region);
    if (state.eventId) url.searchParams.set('eventId', state.eventId); else url.searchParams.delete('eventId');
    if (state.windowId) url.searchParams.set('windowId', state.windowId); else url.searchParams.delete('windowId');
    url.searchParams.set('limit', String(state.limit));
    window.history.replaceState({}, '', url);
  }

  function windowLabel(item) {
    const flags = [];
    if (item.live) flags.push('LIVE');
    else if (item.status === 'upcoming') flags.push('NEXT');
    else flags.push('RECENT');
    const name = item.name || item.eventName || item.eventId || 'Unnamed tournament';
    const round = item.windowName || item.windowId || 'Round';
    const region = item.region ? ` · ${item.region}` : '';
    return `${flags[0]} · ${name} · ${round}${region}`;
  }

  function renderWindows() {
    const select = $('sp-window');
    select.replaceChildren();
    if (!state.windows.length) {
      select.add(new Option('No tournaments returned for this region', ''));
      select.disabled = true;
      return;
    }
    state.windows.forEach((item) => select.add(new Option(windowLabel(item), `${item.eventId}::${item.windowId}`)));
    const preferred = state.windows.find((item) => item.eventId === state.eventId && item.windowId === state.windowId);
    const selected = preferred || state.windows[0];
    state.eventId = selected.eventId || '';
    state.windowId = selected.windowId || '';
    select.value = `${state.eventId}::${state.windowId}`;
    select.disabled = false;
    updateUrl();
  }

  function renderRows(rows) {
    const container = $('sp-rows');
    container.replaceChildren();
    const visible = Array.isArray(rows) ? rows.slice(0, state.limit) : [];
    $('sp-count').textContent = visible.length ? `${visible.length} / ${state.limit}` : '—';
    state.hasRows = visible.length > 0;
    $('sp-empty').hidden = state.hasRows;
    if (!visible.length) return;

    visible.forEach((row, index) => {
      const rank = Number(row.rank) || index + 1;
      const delta = Number(row.rankDelta);
      const movement = Number.isFinite(delta) && delta !== 0;
      const article = document.createElement('article');
      article.className = `sp-row sp-row--rank-${Math.min(3, rank)} ${movement ? (delta > 0 ? 'sp-row--up' : 'sp-row--down') : 'sp-row--steady'}`;
      article.style.setProperty('--row-delay', `${Math.min(index, 9) * 55}ms`);

      const move = document.createElement('div');
      move.className = 'sp-movement';
      move.setAttribute('aria-label', movement ? `${Math.abs(delta)} place${Math.abs(delta) === 1 ? '' : 's'} ${delta > 0 ? 'up' : 'down'}` : 'No movement');
      if (movement) {
        move.innerHTML = `<span class="sp-movement-arrow" aria-hidden="true">${delta > 0 ? '↑' : '↓'}</span><strong>${Math.abs(delta)}</strong>`;
      } else {
        move.innerHTML = '<span class="sp-movement-blank" aria-hidden="true"></span>';
      }

      const identity = document.createElement('div');
      identity.className = 'sp-player';
      const rankBadge = document.createElement('span');
      rankBadge.className = 'sp-rank';
      rankBadge.textContent = `#${rank}`;
      const name = document.createElement('strong');
      name.textContent = row.name || 'Player unavailable';
      identity.append(rankBadge, name);

      const points = document.createElement('div');
      points.className = 'sp-points';
      const pointsValue = document.createElement('strong');
      pointsValue.textContent = formatNumber(row.points);
      const pointsLabel = document.createElement('span');
      pointsLabel.textContent = 'PTS';
      points.append(pointsValue, pointsLabel);

      const math = document.createElement('div');
      math.className = 'sp-math';
      const gap = document.createElement('span');
      gap.className = 'sp-gap';
      gap.textContent = row.pointsToNext == null ? '— lead' : `+${formatNumber(row.pointsToNext)} to #${formatNumber(row.nextRank || Math.max(1, rank - 1))}`;
      const last = document.createElement('span');
      last.className = `sp-last ${Number(row.lastGamePoints) < 0 ? 'sp-last--negative' : ''}`;
      last.textContent = `${formatSigned(row.lastGamePoints)} last game`;
      math.append(gap, last);

      article.append(move, identity, points, math);
      container.append(article);
    });
  }

  async function readJson(url, signal) {
    const response = await fetch(url, { signal, headers: { Accept: 'application/json' } });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `Provider returned HTTP ${response.status}`);
    return data;
  }

  async function loadStandings({ quiet = false } = {}) {
    if (!state.eventId || !state.windowId) {
      renderRows([]);
      $('sp-signal').textContent = 'Choose a round';
      setStatus('Choose a tournament round to load standings.', 'idle');
      return;
    }
    const requestId = ++state.request;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 12000);
    if (!quiet) setStatus('Checking the latest processed sessions…', 'loading');
    try {
      const url = new URL(`${API}/standings`, window.location.origin);
      url.searchParams.set('eventId', state.eventId);
      url.searchParams.set('windowId', state.windowId);
      url.searchParams.set('limit', '10');
      const data = await readJson(url, controller.signal);
      if (requestId !== state.request) return;
      renderRows(data.rows);
      state.pollSeconds = Math.min(300, Math.max(60, Number(data.pollAfterSeconds) || 90));
      $('sp-signal').textContent = state.hasRows ? 'Provider snapshot' : 'No processed rows';
      $('sp-updated').textContent = formatTime(data.fetched);
      $('sp-source').textContent = data.source || 'Epic leaderboard';
      setStatus(`Updated ${formatTime(data.fetched)} · next check in ${state.pollSeconds}s`, 'good');
      updateUrl();
      schedulePoll();
    } catch (error) {
      if (requestId !== state.request) return;
      $('sp-signal').textContent = state.hasRows ? 'Showing last good' : 'Unavailable';
      setStatus(state.hasRows ? `Provider update unavailable — showing the last good snapshot. ${error.message}` : `Standings unavailable: ${error.message}`, 'warn');
      schedulePoll();
    } finally {
      window.clearTimeout(timeout);
    }
  }

  async function loadWindows() {
    state.eventId = new URLSearchParams(window.location.search).get('eventId') || state.eventId;
    state.windowId = new URLSearchParams(window.location.search).get('windowId') || state.windowId;
    $('sp-window').disabled = true;
    setStatus(`Loading ${state.region === 'ALL' ? 'all regions' : state.region} tournaments…`, 'loading');
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 12000);
    try {
      const url = new URL(`${API}/tournaments`, window.location.origin);
      url.searchParams.set('region', state.region);
      url.searchParams.set('history', '1');
      const data = await readJson(url, controller.signal);
      state.windows = Array.isArray(data.windows) ? data.windows : [];
      renderWindows();
      setStatus(state.windows.length ? `${state.windows.length} tournament rounds available · loading standings…` : 'No tournament rounds were returned for this region.', state.windows.length ? 'loading' : 'warn');
      await loadStandings();
    } catch (error) {
      state.windows = [];
      renderWindows();
      renderRows([]);
      $('sp-signal').textContent = 'Catalog unavailable';
      setStatus(`Tournament catalog unavailable: ${error.message}`, 'warn');
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function schedulePoll() {
    window.clearTimeout(state.timer);
    state.timer = window.setTimeout(() => {
      if (document.visibilityState === 'visible') loadStandings({ quiet: true });
      else schedulePoll();
    }, state.pollSeconds * 1000);
  }

  function setLimit(limit) {
    state.limit = limit === 10 ? 10 : 5;
    $('sp-top5').classList.toggle('is-active', state.limit === 5);
    $('sp-top10').classList.toggle('is-active', state.limit === 10);
    $('sp-top5').setAttribute('aria-pressed', String(state.limit === 5));
    $('sp-top10').setAttribute('aria-pressed', String(state.limit === 10));
    updateUrl();
    loadStandings({ quiet: true });
  }

  $('sp-region').addEventListener('change', (event) => {
    state.region = REGIONS.has(event.target.value) ? event.target.value : 'ALL';
    state.eventId = '';
    state.windowId = '';
    loadWindows();
  });
  $('sp-window').addEventListener('change', (event) => {
    const [eventId, windowId] = String(event.target.value || '').split('::');
    state.eventId = eventId || '';
    state.windowId = windowId || '';
    updateUrl();
    loadStandings();
  });
  $('sp-top5').addEventListener('click', () => setLimit(5));
  $('sp-top10').addEventListener('click', () => setLimit(10));
  $('sp-refresh').addEventListener('click', () => loadStandings());
  $('sp-share').addEventListener('click', async () => {
    updateUrl();
    try {
      await navigator.clipboard.writeText(window.location.href);
      setStatus('Board link copied. Share it with the watch party.', 'good');
    } catch {
      setStatus('The board is ready to share from the address bar.', 'idle');
    }
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && state.eventId) loadStandings({ quiet: true });
  });

  const params = new URLSearchParams(window.location.search);
  const initialRegion = String(params.get('region') || 'ALL').toUpperCase();
  state.region = REGIONS.has(initialRegion) ? initialRegion : 'ALL';
  state.limit = params.get('limit') === '10' ? 10 : 5;
  $('sp-region').value = state.region;
  setLimit(state.limit);
  loadWindows();
</script>

<style is:global>
  .standings-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #080613;
  }

  .sp-grid {
    position: absolute;
    inset: 0;
    opacity: .22;
    pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
  }

  .sp-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 92px 0 48px;
  }

  .sp-hero { max-width: 940px; margin-bottom: 38px; }
  .sp-kicker, .sp-section-label, .sp-chip-top, .sp-chip-bottom, .sp-summary-label, .sp-board-head, .sp-footer-line, .sp-info-number {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .sp-kicker { display: flex; align-items: center; gap: 9px; color: var(--color-cyan); font-size: 11px; font-weight: 600; }
  .sp-kicker-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 18px rgba(0,212,255,.9); animation: sp-pulse 2.4s ease-in-out infinite; }
  .sp-title-row { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-top: 15px; }
  .sp-title-row h1 { margin: 0; color: var(--color-text); font-size: clamp(52px, 8vw, 112px); letter-spacing: -.065em; line-height: .84; font-weight: 800; }
  .sp-title-gradient { background: linear-gradient(102deg, #ffe2a1 4%, #ffb23e 34%, #e25bff 67%, #00d4ff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sp-title-mark { color: var(--color-warm); font-weight: 400; margin: 0 .08em; }
  .sp-title-muted { color: rgba(248,246,255,.32); font-size: .4em; font-family: var(--font-mono); letter-spacing: -.02em; vertical-align: .26em; }
  .sp-intro { max-width: 690px; margin: 24px 0 0; color: var(--color-text-mid); font-size: 16px; line-height: 1.65; }
  .sp-hero-chip { min-width: 172px; padding: 14px 15px 13px; border: 1px solid rgba(255,178,62,.36); border-radius: 9px; background: linear-gradient(145deg, rgba(255,178,62,.14), rgba(226,91,255,.08)); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 16px 40px rgba(0,0,0,.22); transform: rotate(2deg); }
  .sp-chip-top { display: block; color: var(--color-warm); font-size: 9px; }
  .sp-chip-main { display: block; margin-top: 4px; color: var(--color-text); font-family: var(--font-display); font-size: 25px; letter-spacing: .04em; line-height: .9; }
  .sp-chip-bottom { display: block; margin-top: 8px; color: var(--color-muted); font-size: 8px; letter-spacing: .05em; text-transform: none; }

  .sp-stage { border: 1px solid rgba(226,91,255,.22); border-radius: 18px; background: linear-gradient(140deg, rgba(22,12,46,.96), rgba(12,8,28,.97) 55%, rgba(13,19,39,.97)); box-shadow: 0 30px 90px rgba(0,0,0,.38), 0 0 0 1px rgba(255,255,255,.025) inset; overflow: hidden; }
  .sp-stage-topline { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 28px 30px 22px; border-bottom: 1px solid rgba(255,255,255,.075); }
  .sp-section-label { margin: 0 0 7px; color: var(--color-magenta); font-size: 10px; font-weight: 600; }
  .sp-stage h2, .sp-info-card h2 { margin: 0; color: var(--color-text); font-size: clamp(23px, 3vw, 34px); letter-spacing: -.045em; }
  .sp-stage-actions { display: flex; gap: 9px; align-items: center; }
  .sp-quiet-button, .sp-refresh-button, .sp-segmented button { border: 1px solid rgba(255,255,255,.13); border-radius: 7px; background: rgba(255,255,255,.045); color: var(--color-text-mid); padding: 10px 13px; font: 600 11px var(--font-mono); letter-spacing: .03em; transition: background 160ms ease, border-color 160ms ease, transform 160ms ease; }
  .sp-refresh-button { border-color: rgba(0,212,255,.35); background: rgba(0,212,255,.1); color: #c9f8ff; }
  .sp-quiet-button:hover, .sp-refresh-button:hover, .sp-segmented button:hover { border-color: rgba(0,212,255,.6); background: rgba(0,212,255,.14); transform: translateY(-1px); }
  .sp-refresh-button span { font-size: 16px; vertical-align: -1px; }
  .sp-controls { display: grid; grid-template-columns: minmax(150px, .7fr) minmax(300px, 1.8fr) minmax(190px, .85fr); gap: 12px; padding: 22px 30px 14px; }
  .sp-control { display: flex; flex-direction: column; gap: 7px; color: var(--color-muted); font: 10px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .sp-control select { width: 100%; min-height: 43px; border: 1px solid rgba(255,255,255,.12); border-radius: 7px; background: rgba(5,4,15,.76); color: var(--color-text); padding: 0 12px; font: 500 13px var(--font-sans); letter-spacing: 0; text-transform: none; }
  .sp-control select:disabled { color: var(--color-muted); opacity: .82; }
  .sp-segmented { display: flex; height: 43px; }
  .sp-segmented button { flex: 1; border-radius: 7px 0 0 7px; padding: 0 10px; color: var(--color-muted); }
  .sp-segmented button + button { border-left: 0; border-radius: 0 7px 7px 0; }
  .sp-segmented button.is-active { border-color: rgba(255,178,62,.55); background: rgba(255,178,62,.16); color: #ffe4ae; box-shadow: 0 0 22px rgba(255,178,62,.08) inset; }
  .sp-status-line { display: flex; align-items: center; gap: 9px; min-height: 26px; padding: 0 30px 17px; color: var(--color-muted); font-size: 12px; }
  .sp-status-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: var(--color-muted); }
  .sp-status-dot--good { background: var(--color-success); box-shadow: 0 0 12px rgba(74,222,128,.7); }
  .sp-status-dot--loading { background: var(--color-cyan); animation: sp-pulse 1s ease-in-out infinite; }
  .sp-status-dot--warn { background: var(--color-warm); box-shadow: 0 0 12px rgba(255,178,62,.6); }
  .sp-summary { display: grid; grid-template-columns: 1fr 1fr 1.2fr 1.3fr; border-top: 1px solid rgba(255,255,255,.075); border-bottom: 1px solid rgba(255,255,255,.075); background: rgba(0,0,0,.16); }
  .sp-summary-item { min-height: 67px; display: flex; flex-direction: column; justify-content: center; gap: 6px; padding: 10px 20px; border-right: 1px solid rgba(255,255,255,.075); }
  .sp-summary-item:last-child { border-right: 0; }
  .sp-summary-label { color: var(--color-muted); font-size: 9px; }
  .sp-summary-item strong { color: var(--color-text); font: 600 12px var(--font-mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-summary-item--live strong { color: var(--color-success); }
  .sp-board { padding: 0 30px 28px; }
  .sp-board-head { display: grid; grid-template-columns: 74px minmax(160px, 1fr) 130px minmax(160px, 220px); gap: 14px; padding: 18px 16px 10px; color: var(--color-subtle); font-size: 9px; }
