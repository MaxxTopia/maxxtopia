---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import SuiteMarquee from '../components/SuiteMarquee.astro';
import Aurora from '../components/Aurora.astro';
import { liveProducts, upcomingProducts, products } from '../data/products';

// Drive the headline count off the real product list so it never drifts.
const totalCount = products.length;

// Lead the live grid with the strongest-pull products, not raw array order:
// the flagship tuner, then the widest-appeal ad blocker, then the deepest
// streamer app, then the Discord client.
const liveOrder = ['optimizationmaxxing', 'extensionmaxxing', 'streammaxxing', 'discordmaxxer'];
const liveSorted = [...liveProducts].sort(
  (a, b) => liveOrder.indexOf(a.slug) - liveOrder.indexOf(b.slug),
);
---

<Layout>
  <Hero />

  <SuiteMarquee />

  <!-- Apps -->
  <section id="apps" class="relative spotlight">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-28">
      <div class="reveal-on-scroll mb-14">
        <div class="flex items-center gap-3.5 flex-wrap">
          <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
            The apps
          </p>
          <span class="omnitrix-badge" aria-label={`${liveProducts.length} apps live now`}>
            <span class="omnitrix-badge__core">{liveProducts.length}</span>
            <span class="omnitrix-badge__label">live now</span>
          </span>
        </div>
        <h2 class="mt-3 text-[40px] sm:text-[56px] font-semibold tracking-[-0.025em] gradient-text leading-[1.02]">
          {totalCount} tools. <span class="serif-accent gradient-suite">One mission.</span>
        </h2>
        <p class="mt-4 max-w-xl text-[15.5px] text-[var(--color-text-mid)] leading-relaxed">
          Each product solves one problem the way a pro would solve it themselves.
          No bloat. No telemetry.
        </p>
      </div>

      <!-- Live products -->
      {liveProducts.length > 0 && (
        <div class="mb-14">
          <div class="reveal-on-scroll flex items-center gap-3 mb-6">
            <span class="text-[11px] uppercase tracking-[0.1em] text-[#4ade80] font-mono">
              ● Available now
            </span>
            <div class="flex-1 h-px bg-gradient-to-r from-[var(--color-line)] via-[var(--color-line-strong)] to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {liveSorted.map((p, i) => <ProductCard product={p} index={i} large />)}
          </div>
        </div>
      )}

      <!-- Upcoming -->
      {upcomingProducts.length > 0 && (
        <div>
          <div class="reveal-on-scroll flex items-center gap-3 mb-6">
            <span class="text-[11px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono">
              ◇ In the lab
            </span>
            <div class="flex-1 h-px bg-gradient-to-r from-[var(--color-line)] via-[var(--color-line-strong)] to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {upcomingProducts.map((p, i) => <ProductCard product={p} index={i} />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Arcade strip: palette-correct, placed AFTER the apps grid so it reinforces the suite instead of intercepting the product funnel -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <a href="/play" class="scb group" aria-label="Play Sprite Cannon — the free Maxxtopia Arcade game">
        <!-- seamless rotating aurora behind the cannon -->
        <span class="scb__aurora" aria-hidden="true"></span>
        <span class="scb__stars" aria-hidden="true"></span>
        <span class="scb__vig" aria-hidden="true"></span>

        <!-- copy -->
        <div class="scb__copy">
          <p class="scb__eyebrow font-mono">&#9670; Maxxtopia Arcade</p>
          <h2 class="scb__head"><span class="gradient-text">We build serious tools.</span> <span class="serif-accent gradient-suite">And one ridiculous game.</span></h2>
          <p class="scb__sub">Sprite Cannon — free, in your browser, no signup. 50+ skins, a global leaderboard, zero reason not to.</p>
          <span class="scb__cta">&#9654;&#65038; Play Sprite Cannon</span>
        </div>

        <!-- the launch: a cannon fires the sprite in a seamless arc -->
        <div class="scb__scene" aria-hidden="true">
          <span class="scb__shot"><img src="/play/spritecannon/imported/spritecannon/skins/fastboi.png" alt="" width="84" height="84" loading="lazy" decoding="async" /></span>
          <span class="scb__flash"></span>
          <span class="scb__cannon">
            <span class="scb__barrel"></span>
            <span class="scb__wheel"></span>
            <span class="scb__mount"></span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <style>
    /* Arcade banner "The Launch": a CSS cannon fires the sprite across the strip
       in a seamless arc (sprite is invisible at the loop seam, so the wrap never
       pops), over a rotating aurora + drifting stars. The one alive, playful
       panel on an otherwise calm page. */
    .scb {
      position: relative; display: flex; align-items: center; justify-content: space-between;
      gap: 1.5rem; overflow: hidden; min-height: 192px; isolation: isolate;
      padding: 1.6rem clamp(1.25rem, 4vw, 2.75rem);
      border: 1px solid var(--color-line); border-radius: 18px; text-decoration: none;
      background:
        radial-gradient(120% 160% at 86% 120%, rgba(76,81,247,0.16), transparent 55%),
        radial-gradient(90% 140% at 0% -20%, rgba(226,91,255,0.10), transparent 60%),
        var(--color-bg-card);
      box-shadow: 0 14px 46px -24px rgba(226,91,255,0.4);
      transition: border-color .3s ease, transform .3s ease, box-shadow .3s ease;
    }
    .scb:hover { border-color: var(--color-magenta); transform: translateY(-2px); box-shadow: 0 18px 56px -20px rgba(226,91,255,0.55); }

    /* seamless rotating aurora (0deg == 360deg, matching end stops) */
    .scb__aurora {
      position: absolute; right: 3%; top: 50%; width: 360px; height: 360px; margin-top: -180px;
      z-index: 0; pointer-events: none; border-radius: 50%; filter: blur(42px); opacity: .5;
      background: conic-gradient(from 0deg, #e25bff, #4c51f7, #00d4ff, #ffb23e, #e25bff);
      animation: scbSpin 22s linear infinite; will-change: transform;
    }
    /* drifting star specks (one tile of translate == seamless) */
    .scb__stars {
      position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .5;
      background-image:
        radial-gradient(1.5px 1.5px at 30px 40px, var(--color-text-mid) 50%, transparent),
        radial-gradient(1px 1px at 130px 90px, var(--color-cyan) 50%, transparent),
        radial-gradient(1.5px 1.5px at 90px 150px, var(--color-magenta) 50%, transparent),
        radial-gradient(1px 1px at 170px 20px, var(--color-text-mid) 50%, transparent);
      background-size: 200px 180px; animation: scbDrift 26s linear infinite;
    }
    .scb__vig {
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background: linear-gradient(90deg, rgba(10,6,18,0.85) 0%, rgba(10,6,18,0.42) 30%, transparent 60%);
    }

    /* copy */
    .scb__copy { position: relative; z-index: 3; max-width: 60%; }
    .scb__eyebrow { margin: 0 0 .5rem; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--color-cyan); }
    .scb__head { margin: 0; font-size: clamp(1.4rem, 3.4vw, 2.1rem); line-height: 1.12; font-weight: 600; letter-spacing: -0.02em; }
    .scb__head .serif-accent { display: inline; font-weight: 400; }
    .scb__sub { margin: .65rem 0 1.05rem; max-width: 46ch; font-size: .9rem; line-height: 1.5; color: var(--color-text-mid); }
    .scb__cta {
      display: inline-flex; align-items: center; gap: .45rem; padding: .58rem 1.3rem; border-radius: 999px;
      font-size: .95rem; font-weight: 600; letter-spacing: .02em; color: #0a0612;
      background: linear-gradient(90deg, var(--color-magenta), var(--color-cyan));
      box-shadow: 0 0 16px rgba(226,91,255,0.35); transition: box-shadow .3s ease, transform .3s ease;
    }
    .scb:hover .scb__cta { box-shadow: 0 0 28px rgba(226,91,255,0.6); transform: translateY(-1px); }

    /* the launch scene */
    .scb__scene { position: relative; z-index: 2; width: 280px; align-self: stretch; flex-shrink: 0; }
    .scb__cannon { position: absolute; right: 26px; bottom: 14px; width: 120px; height: 92px; }
    .scb__barrel {
      position: absolute; right: 8px; bottom: 26px; width: 116px; height: 40px; border-radius: 10px 18px 18px 10px;
      background: linear-gradient(160deg, #3b2f6e, #1a1136 70%); border: 1px solid var(--color-line);
      transform-origin: 86% 50%; transform: rotate(-38deg); box-shadow: inset 0 2px 4px rgba(255,255,255,0.08);
    }
    .scb__barrel::after {
      content: ""; position: absolute; left: -3px; top: 50%; width: 16px; height: 38px; transform: translateY(-50%);
      border-radius: 8px; background: radial-gradient(ellipse at center, #0a0612 55%, var(--color-indigo) 110%);
    }
    .scb__wheel {
      position: absolute; right: 30px; bottom: 0; width: 58px; height: 58px; border-radius: 50%;
      background: radial-gradient(circle at 38% 35%, #2a1c52, #120a28 72%); border: 2px solid var(--color-indigo);
      box-shadow: inset 0 0 0 9px rgba(226,91,255,0.10), 0 0 16px rgba(76,81,247,0.35);
    }
    .scb__wheel::after { content: ""; position: absolute; inset: 22px; border-radius: 50%; background: var(--color-magenta); box-shadow: 0 0 8px var(--color-magenta); }
    .scb__mount { position: absolute; right: 18px; bottom: -2px; width: 84px; height: 12px; border-radius: 4px; background: linear-gradient(90deg, var(--color-indigo), #1a1136); }

    .scb__flash {
      position: absolute; right: 96px; bottom: 70px; width: 60px; height: 60px; border-radius: 50%; opacity: 0; transform: scale(.3);
      background: radial-gradient(circle, #fff 0%, var(--color-warm) 28%, var(--color-magenta) 55%, transparent 72%);
      animation: scbFlash 4.4s ease-out infinite;
    }
    .scb__shot {
      position: absolute; right: 100px; bottom: 74px; width: 84px; height: 84px; opacity: 0;
      animation: scbFly 4.4s cubic-bezier(.33,0,.4,1) infinite; will-change: transform, opacity;
    }
    .scb__shot::before {
      content: ""; position: absolute; right: 8px; bottom: 10px; width: 92px; height: 14px; transform-origin: right center; transform: rotate(28deg);
      background: linear-gradient(90deg, transparent, rgba(0,212,255,0) 10%, rgba(0,212,255,0.55) 78%, rgba(255,255,255,0.85));
      border-radius: 999px; filter: blur(2px);
    }
    .scb__shot img { width: 84px; height: 84px; object-fit: contain; filter: drop-shadow(0 0 10px rgba(0,212,255,0.55)) drop-shadow(0 2px 4px rgba(0,0,0,0.5)); }

    @keyframes scbSpin { to { transform: rotate(360deg); } }
    @keyframes scbDrift { to { transform: translateX(-200px); } }
    @keyframes scbFlash { 0% { opacity: 0; transform: scale(.3); } 3% { opacity: 1; transform: scale(1.05); } 9% { opacity: 0; transform: scale(1.4); } 100% { opacity: 0; transform: scale(.3); } }
    /* invisible at 0% AND 100% so the wrap back to the muzzle can never be seen */
    @keyframes scbFly {
      0%   { opacity: 0; transform: translate(0,0) scale(.5) rotate(0deg); }
      4%   { opacity: 0; transform: translate(-4px,-3px) scale(.65) rotate(-4deg); }
      9%   { opacity: 1; transform: translate(-14px,-10px) scale(.85) rotate(-8deg); }
      32%  { opacity: 1; transform: translate(-74px,-46px) scale(1) rotate(-16deg); }
      55%  { opacity: 1; transform: translate(-134px,-58px) scale(1.05) rotate(-24deg); }
      74%  { opacity: .9; transform: translate(-184px,-34px) scale(1) rotate(-32deg); }
      86%  { opacity: 0; transform: translate(-212px,-6px) scale(.92) rotate(-38deg); }
      100% { opacity: 0; transform: translate(0,0) scale(.5) rotate(0deg); }
    }

    @media (max-width: 700px) { .scb__copy { max-width: 100%; } .scb__scene { display: none; } }

    @media (prefers-reduced-motion: reduce) {
      .scb__aurora, .scb__stars, .scb__flash, .scb__shot { animation: none; }
      .scb__shot { opacity: 1; transform: translate(-118px,-54px) scale(1.05) rotate(-22deg); }
      .scb__flash { opacity: .8; transform: scale(1); }
      .scb:hover { transform: none; }
    }
  </style>

  <!-- Principles -->
  <section id="principles" class="relative">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-28 border-t border-[var(--color-line)]">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
        <div class="md:col-span-5 reveal-on-scroll">
          <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
            The principle
          </p>
          <h2 class="mt-3 text-[36px] sm:text-[48px] font-semibold tracking-[-0.025em] leading-[1.04]">
            <span class="gradient-text">Built like the tools we</span><br/>
            <span class="serif-accent gradient-suite">wished existed.</span>
          </h2>
          <p class="mt-6 text-[15.5px] text-[var(--color-text-mid)] leading-relaxed">
            Most gaming tools are someone trying to monetize a Discord script.
            We started over. Native binaries. Cited sources. Snapshot-backed
            actions. Ship-quality typography. Software you'd be proud to ship at
            a multi-billion-dollar company — for the players who care about
            the millisecond.
          </p>
        </div>

        <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
          {[
            { n: '01', t: 'Native, not Electron', b: 'Rust + Tauri for the tuner, an optimized fork for the Discord client, Manifest V3 for the ad blocker. Megabytes, not gigabytes.' },
            { n: '02', t: 'Sourced, not guessed', b: 'Every tweak cites Microsoft Learn, vendor docs, or a verified community source. Placebos rejected on principle.' },
            { n: '03', t: 'Reversible by design', b: 'Snapshot-backed apply. Undo any tweak, anytime. One-click restore-point.' },
            { n: '04', t: 'No telemetry. Ever.',  b: 'Local-only. No analytics. No remote calls. Software that respects you.' },
          ].map((card, i) => (
            <div class={`reveal-on-scroll reveal-delay-${i + 1} bg-[var(--color-bg-card)] p-7 group hover:bg-[var(--color-bg-card-hover)] transition-colors`}>
              <div class="text-[var(--color-magenta)] text-[18px] font-mono mb-3 group-hover:text-[var(--color-cyan)] transition-colors">
                {card.n}
              </div>
              <h3 class="text-[17px] font-semibold tracking-tight">{card.t}</h3>
              <p class="mt-2.5 text-[14px] text-[var(--color-muted)] leading-relaxed">
                {card.b}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-28">
      <div class="reveal-on-scroll relative overflow-hidden rounded-[28px] border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] p-10 sm:p-20 text-center">
        <Aurora intensity="med" />
        <div class="relative">
          <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono mb-4">
            ✦ Start here
          </p>
          <h2 class="text-[36px] sm:text-[56px] font-semibold tracking-[-0.025em] leading-[1.02] max-w-3xl mx-auto">
            <span class="gradient-text">Start with the tuner.</span>
            <span class="serif-accent gradient-suite">The rest will follow.</span>
          </h2>
          <p class="mt-6 text-[16px] text-[var(--color-text-mid)] max-w-md mx-auto leading-relaxed">
            Four apps live. All free, all native — no account, no subscription. Start with the 3.6 MB tuner; the rest of the suite is one click away.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="/optimizationmaxxing" class="btn-primary">
              Get Optimizationmaxxing
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/why" class="btn-secondary">
              Why we built this
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* "N live now" — Omnitrix-style green dial: a glowing core that pulses
     like the watch activating, marking how many apps are live right now. */
  .omnitrix-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    border: 1px solid rgba(74, 222, 128, 0.45);
    background:
      radial-gradient(circle at 17px 50%, rgba(74, 222, 128, 0.20), transparent 62%),
      rgba(74, 222, 128, 0.05);
    font-family: var(--font-mono);
  }
  .omnitrix-badge__core {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 38%, #8effb0 0%, #25c462 55%, #119544 100%);
    color: #04140a;
    font-weight: 800;
    font-size: 15px;
    line-height: 1;
    box-shadow:
      0 0 0 2px rgba(74, 222, 128, 0.35),
      0 0 16px rgba(74, 222, 128, 0.85),
      0 0 30px rgba(74, 222, 128, 0.45);
    animation: omnitrix-pulse 1.9s ease-in-out infinite;
  }
  .omnitrix-badge__label {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #86f7ab;
    font-weight: 600;
  }
  @keyframes omnitrix-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 2px rgba(74, 222, 128, 0.35),
        0 0 16px rgba(74, 222, 128, 0.85),
        0 0 30px rgba(74, 222, 128, 0.45);
    }
    50% {
      box-shadow:
        0 0 0 4px rgba(74, 222, 128, 0.22),
        0 0 26px rgba(74, 222, 128, 1),
        0 0 52px rgba(74, 222, 128, 0.7);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .omnitrix-badge__core { animation: none; }
  }
</style>
