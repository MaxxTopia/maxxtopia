---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import { liveProducts, upcomingProducts } from '../data/products';
---

<Layout>
  <Hero />

  <!-- Suite -->
  <section id="suite" class="relative">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-24">
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="text-[12px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
            The suite
          </p>
          <h2 class="mt-2 text-[34px] sm:text-[44px] font-semibold tracking-tight gradient-text">
            Seven tools. One mission.
          </h2>
          <p class="mt-3 max-w-xl text-[15px] text-[var(--color-muted)] leading-relaxed">
            Each product solves one problem the way a pro would solve it themselves.
            No bloat. No telemetry. No subscription traps.
          </p>
        </div>
      </div>

      <!-- Live products -->
      {liveProducts.length > 0 && (
        <div class="mb-12">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-[11px] uppercase tracking-[0.08em] text-[var(--color-accent)] font-mono">
              Available now
            </span>
            <div class="flex-1 h-px bg-[var(--color-line)]"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {liveProducts.map((p, i) => <ProductCard product={p} index={i} />)}
          </div>
        </div>
      )}

      <!-- Upcoming -->
      {upcomingProducts.length > 0 && (
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="text-[11px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
              In the lab
            </span>
            <div class="flex-1 h-px bg-[var(--color-line)]"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {upcomingProducts.map((p, i) => <ProductCard product={p} index={i} />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Why -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-24 border-t border-[var(--color-line)]">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <p class="text-[12px] uppercase tracking-[0.08em] text-[var(--color-subtle)] font-mono">
            The principle
          </p>
          <h2 class="mt-2 text-[32px] sm:text-[40px] font-semibold tracking-tight gradient-text leading-[1.05]">
            Built like the tools we wish existed.
          </h2>
          <p class="mt-5 text-[15.5px] text-[var(--color-muted)] leading-relaxed">
            Most gaming tools are someone trying to monetize a Discord script.
            We started over. Native binaries. Cited sources. Snapshot-backed
            actions. Ship-quality typography. Software you'd be proud to ship at
            a multi-billion-dollar company — for an audience that mostly just
            wants their game to feel snappier.
          </p>
        </div>

        <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-px rounded-xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
          <div class="bg-[var(--color-bg)] p-6">
            <div class="text-[var(--color-accent)] text-[20px] font-mono mb-2">01</div>
            <h3 class="text-[16px] font-semibold tracking-tight">Native, not Electron</h3>
            <p class="mt-2 text-[14px] text-[var(--color-muted)] leading-relaxed">
              Rust + Tauri for the tuner. Optimized Vesktop fork for the comms client.
              Megabytes, not gigabytes.
            </p>
          </div>
          <div class="bg-[var(--color-bg)] p-6">
            <div class="text-[var(--color-accent)] text-[20px] font-mono mb-2">02</div>
            <h3 class="text-[16px] font-semibold tracking-tight">Sourced, not vibed</h3>
            <p class="mt-2 text-[14px] text-[var(--color-muted)] leading-relaxed">
              Every tweak cites Microsoft Learn, vendor docs, or a verified community source.
              Placebos rejected on principle.
            </p>
          </div>
          <div class="bg-[var(--color-bg)] p-6">
            <div class="text-[var(--color-accent)] text-[20px] font-mono mb-2">03</div>
            <h3 class="text-[16px] font-semibold tracking-tight">Reversible by design</h3>
            <p class="mt-2 text-[14px] text-[var(--color-muted)] leading-relaxed">
              Snapshot-backed apply. Undo any tweak, anytime. One-click restore-point.
            </p>
          </div>
          <div class="bg-[var(--color-bg)] p-6">
            <div class="text-[var(--color-accent)] text-[20px] font-mono mb-2">04</div>
            <h3 class="text-[16px] font-semibold tracking-tight">No telemetry</h3>
            <p class="mt-2 text-[14px] text-[var(--color-muted)] leading-relaxed">
              Local-only. No analytics. No remote calls. Software that respects you.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 py-24">
      <div class="relative overflow-hidden rounded-2xl border border-[var(--color-line-strong)] bg-[var(--color-bg-card)] p-10 sm:p-16 text-center">
        <div class="ambient-glow"></div>
        <div class="relative">
          <h2 class="text-[32px] sm:text-[44px] font-semibold tracking-tight gradient-text leading-[1.05] max-w-2xl mx-auto">
            Start with the tuner. The rest will follow.
          </h2>
          <p class="mt-4 text-[15.5px] text-[var(--color-muted)] max-w-md mx-auto leading-relaxed">
            Free to download. Free to use. Single 3.6 MB installer. No account required.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="/optimizationmaxxing" class="btn-primary">
              Get Optimizationmaxxing
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/manifesto" class="btn-secondary">
              Why we built this
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
