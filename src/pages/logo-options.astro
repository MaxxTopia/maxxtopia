---
import Layout from '../layouts/Layout.astro';

const options = [
  {
    id: 'slice',
    label: 'E · The Slice  ←  the live mark',
    pitch: 'Circular face (only round mark in the suite — pops in the sidebar). Discord-blurple bubble = the "Discord" half of the wordmark. Magenta cleaved fragment = the "maxxer" half being shed. Slice is where the two halves meet. Particle trail dissolves magenta → white into the suite speed-accents (optimization in motion). I-beam cursor inside replaces the typing-dot cliché. Hairline maxxer-magenta ring on the circle = suite signature.',
    src: '/logos/discordmaxxer-alt-slice.svg',
  },
  {
    id: 'current',
    label: 'A · Chat bubble + typing dots',
    pitch: 'Universal comms silhouette. Bubble + 3 blurple dots = "active comms".',
    src: '/logos/discordmaxxer.svg',
  },
  {
    id: 'headset',
    label: 'B · Gaming headset + boom mic',
    pitch: 'Gaming-comms specific. Says "voice chat / squad / pro setup".',
    src: '/logos/discordmaxxer-alt-headset.svg',
  },
  {
    id: 'd-mono',
    label: 'C · Geometric "d" monogram + presence pip',
    pitch: 'Most minimal. Letter + green online dot = brand-coded "Discord."',
    src: '/logos/discordmaxxer-alt-d-mono.svg',
  },
  {
    id: 'wave',
    label: 'D · Broadcast burst (concentric arcs)',
    pitch: 'Most abstract. Reads as "signal / live / broadcasting" — not Discord literal.',
    src: '/logos/discordmaxxer-alt-wave.svg',
  },
];

const sizes = [
  { px: 32,  caption: 'sidebar' },
  { px: 64,  caption: 'card hover' },
  { px: 128, caption: 'product hero' },
  { px: 256, caption: 'OG / favicon' },
];
---

<Layout title="Discordmaxxer logo — options" noindex>
  <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-20 pb-16">
    <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
      Internal · pick one
    </p>
    <h1 class="mt-3 text-[40px] sm:text-[56px] font-semibold tracking-[-0.025em] leading-[1.02]">
      <span class="gradient-text">Discordmaxxer logo —</span>
      <span class="serif-accent gradient-suite">four directions.</span>
    </h1>
    <p class="mt-4 max-w-2xl text-[15px] text-[var(--color-text-mid)] leading-relaxed">
      Same Discord-blurple Apple squircle on each — the four options vary by what
      sits on the face. Each is shown at the four sizes the suite actually uses,
      so you can tell which holds up at favicon scale and which only works big.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-12">
      {options.map((opt) => (
        <article class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-bg-card)] p-7 sm:p-9">
          <header class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-[22px] font-semibold tracking-tight">{opt.label}</h2>
            <code class="text-[11px] font-mono text-[var(--color-subtle)]">{opt.src}</code>
          </header>
          <p class="mt-2 text-[14px] text-[var(--color-text-mid)] leading-relaxed max-w-xl">
            {opt.pitch}
          </p>

          <div class="mt-7 grid grid-cols-2 sm:grid-cols-4 gap-px rounded-xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
            {sizes.map((s) => (
              <div class="bg-[var(--color-bg)] p-6 flex flex-col items-center gap-3">
                <div
                  class="flex items-center justify-center"
                  style={`width: ${s.px}px; height: ${s.px}px;`}
                >
                  <img src={opt.src} alt="" width={s.px} height={s.px} style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
                <p class="text-[10.5px] uppercase tracking-[0.1em] text-[var(--color-subtle)] font-mono">
                  {s.px}px · {s.caption}
                </p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>

    <p class="mt-10 text-[14px] text-[var(--color-text-mid)]">
      Pick a letter (A / B / C / D), I'll set it as the live discordmaxxer logo
      and delete the rest.
    </p>
  </section>
</Layout>
