---
import Layout from '../../layouts/Layout.astro';
import Aurora from '../../components/Aurora.astro';

/**
 * Discordmaxxer pricing — Hypixel-style 4-tier ladder + Founder scarcity slot.
 * In-app VipCard.tsx links here; "Open Discord ticket" buttons send buyers
 * to the Maxxtopia Discord, where the Maxx bot's ticket-panel buttons spawn
 * a private thread per buyer (per-tier handler in tickets-worker/worker.js).
 *
 * Pricing locked 2026-05-09 (project_discordmaxxer.md "Option A pricing").
 */

const DISCORD_INVITE = 'https://discord.gg/S78eecbWdx';

type Tier = {
  bracket: string;
  bracketColor: string;
  plusColor?: string;
  monthly: string;
  annual: string;
  pitch: string;
  perks: string[];
  ctaLabel: string;
  ctaHref: string;
  highlight?: boolean;
  upsell?: string;
};

const TIERS: Tier[] = [
  {
    bracket: '[FREE]',
    bracketColor: '#9aa1ad',
    monthly: '$0',
    annual: 'Free forever',
    pitch: 'The whole client. Every plugin, every theme, Tournament Mode, the Hub. Nothing crippled, nothing nagware.',
    perks: [
      'All ~30 default-on Vencord plugins',
      '5 free themes (maxxer · val · sonic · dmc · bo3)',
      'Tournament Mode (perf-only, screenshare-friendly)',
      'CompactView · MassDelete · GIF favorites tab',
      '1 saved video-background slot',
      'Dragon Sword animated cursor',
      'Founder badges visible on others\' popouts',
    ],
    ctaLabel: 'Download the client',
    ctaHref: 'https://github.com/MaxxTopia/discordmaxxer/releases/latest',
  },
  {
    bracket: '[MAXXER]',
    bracketColor: '#55FF55',
    monthly: '$4 / mo',
    annual: '$38 / yr · save 20%',
    pitch: 'The status flex starter. A green [VIP] tag in front of your name when you type, plus a glowing avatar ring everywhere you go.',
    perks: [
      'Typing prefix — [VIP] in the indicator',
      'Avatar tier ring · 1px outline + glow',
      '5 animated cursor skins (Sharingan · Rinnegan · Rasengan · Chidori · Stiiizy smoke trail)',
      '5 saved video-background slots',
    ],
    ctaLabel: 'Open Discord ticket →',
    ctaHref: DISCORD_INVITE,
    upsell: 'Click "Buy MAXXER — $4/mo" in #open-ticket on the Maxxtopia Discord.',
  },
  {
    bracket: '[MAXXER+]',
    bracketColor: '#55FFFF',
    monthly: '$9 / mo',
    annual: '$86 / yr · save 20%',
    pitch: 'The everyday Discord upgrade. Video backgrounds, an aqua glow on your name in member lists, three exclusive anime themes — the stuff people DM you about.',
    perks: [
      'Everything in MAXXER',
      'Custom video backgrounds (URL or upload)',
      '3 exclusive themes — Akatsuki · DMC: Devil Trigger · Eminence in Shadow',
      'Member-list name tint with aqua glow-glimmer pulse',
      'Profile popout banner stripe',
      '20 saved video-background slots',
    ],
    ctaLabel: 'Open Discord ticket →',
    ctaHref: DISCORD_INVITE,
    upsell: 'Click "Buy MAXXER+ — $9/mo" in #open-ticket on the Maxxtopia Discord.',
    highlight: true,
  },
  {
    bracket: '[MAXXER++]',
    bracketColor: '#FFAA00',
    plusColor: '#FF5555',
    monthly: '$17 / mo',
    annual: '$163 / yr · save 20%',
    pitch: 'The full flex. Vanilla-visible custom presence text, voice-channel name color, beta builds, plugin votes. Friends on stock Discord see your status.',
    perks: [
      'Everything in MAXXER+',
      'Animated tier badge (gold→red shimmer)',
      'Custom presence text — vanilla-visible flex on every friend\'s list',
      'Voice channel name color (gold tint while in VC)',
      'Beta-channel auto-updates (early-access features)',
      'Plugin votes — vote on what ships next via #vip-chat polls',
      '"Discordmaxxer++ supporter" credit strip on your profile popout',
      'Unlimited saved video-background slots',
    ],
    ctaLabel: 'Open Discord ticket →',
    ctaHref: DISCORD_INVITE,
    upsell: 'Click "Buy MAXXER++ — $17/mo" in #open-ticket on the Maxxtopia Discord.',
  },
];

const FOUNDER_DESCRIPTION = `33 ever, never reissued. Pay once, own one numbered Founder slot from #1 to #33 for life. ` +
  `Each Founder gets a unique gold gem on their profile popout (visible to every Discordmaxxer user), ` +
  `1 month MAXXER++ free, a 1-month MAXXER++ gift code to drop on a friend, and — most importantly — ` +
  `MAXXER++ price-locked at $12/mo for life. When the rest of the world pays $30+/mo for fancy Discord clients, ` +
  `Founders pay $12 forever.`;

// BreadcrumbList JSON-LD — Home › Discordmaxxer › Pricing for the nested route.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maxxtopia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Discordmaxxer', item: 'https://maxxtopia.com/discordmaxxer' },
    { '@type': 'ListItem', position: 3, name: 'Pricing', item: 'https://maxxtopia.com/discordmaxxer/vip' },
  ],
};
---

<Layout
  title="Discordmaxxer Pricing — MAXXER through MAXXER++ + Founder slots"
  description="MAXXER $4/mo · MAXXER+ $9/mo · MAXXER++ $17/mo · Founder $67-one-time (33 ever). Open a Discord ticket to subscribe — checkout walks you through PayPal/BTC/Venmo, and Diggy DMs your activation code."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="relative">
    <Aurora intensity="med" />
    <div class="absolute inset-0 bg-grid opacity-30"></div>

    <!-- Hero -->
    <section class="relative mx-auto max-w-5xl px-5 sm:px-8 pt-20 sm:pt-24 pb-10">
      <a
        href="/discordmaxxer"
        class="inline-flex items-center gap-1.5 text-[13px] text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors mb-10"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to discordmaxxer
      </a>

      <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono reveal reveal-1">
        Discordmaxxer · pricing
      </p>
      <h1 class="reveal reveal-2 mt-4 text-[44px] sm:text-[72px] font-semibold tracking-[-0.035em] leading-[0.98] text-[var(--color-text)]">
        <span class="block">The whole client is free.</span>
        <span class="serif-accent gradient-suite block">The flex is paid.</span>
      </h1>
      <p class="reveal reveal-3 mt-7 text-[18px] sm:text-[20px] leading-[1.4] text-[var(--color-text-mid)] max-w-2xl">
        Four paid tiers + a 33-slot Founder loop. Every paying tier is cosmetic + cross-user status surfacing — paid subscribers <em>see each other</em> light up across every server. The client itself stays 100% free, forever.
      </p>
    </section>

    <!-- 4 tier cards -->
    <section class="relative mx-auto max-w-5xl px-5 sm:px-8 pb-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {TIERS.map((tier) => (
          <div class="reveal-on-scroll vip-tier-card-shell relative">
            <div
              class="vip-tier-card__smoke absolute -inset-[18px] z-0 rounded-[2rem] pointer-events-none"
              aria-hidden="true"
              style={`--tier-color: ${tier.bracketColor};`}
            ></div>

            <div
              class="vip-tier-card relative isolate overflow-visible rounded-2xl border p-7 sm:p-8 transition-all"
              style={`--tier-color: ${tier.bracketColor}; color: color-mix(in srgb, ${tier.bracketColor} 62%, var(--color-text-mid)); border-color: ${tier.bracketColor}; background: var(--color-bg-card); box-shadow: ${tier.highlight
                ? `0 0 0 1px ${tier.bracketColor}88, 0 0 26px ${tier.bracketColor}55, inset 0 0 42px ${tier.bracketColor}18, 0 10px 28px rgba(0,0,0,0.34);`
                : `0 0 0 1px ${tier.bracketColor}60, 0 0 20px ${tier.bracketColor}42, inset 0 0 34px ${tier.bracketColor}12, 0 10px 26px rgba(0,0,0,0.32);`}`}
            >

            {tier.highlight && (
              <div
                class="absolute z-20 -top-3 left-7 whitespace-nowrap rounded-full border px-2.5 py-1 text-[10.5px] font-mono uppercase tracking-[0.12em] font-semibold"
                style={`background: ${tier.bracketColor}; border-color: ${tier.bracketColor}; color: #08050f; box-shadow: 0 0 16px ${tier.bracketColor}77, 0 0 30px ${tier.bracketColor}2f;`}
              >
                Most-picked
              </div>
            )}

            <div class="relative z-10">
              <!-- Bracket badge — Hypixel-style colored tag -->
              <div class="mb-5 flex items-baseline gap-3 flex-wrap">
                <span
                  style={`color: ${tier.bracketColor}; font-family: 'Tungsten Bold', 'Bebas Neue', 'Oswald', 'Arial Black', sans-serif; font-size: 32px; font-weight: 800; letter-spacing: 0.02em; text-shadow: 0 0 12px ${tier.bracketColor}66, 0 1px 0 rgba(0,0,0,0.75);`}
                >
                  {tier.plusColor ? (
                    <><span>{tier.bracket.slice(0, -3)}</span><span style={`color: ${tier.plusColor}; text-shadow: 0 0 10px ${tier.plusColor}66;`}>++</span><span>]</span></>
                  ) : tier.bracket}
                </span>
                <div class="flex flex-col">
                  <span class="text-[20px] font-semibold" style={`color: color-mix(in srgb, ${tier.bracketColor} 90%, var(--color-text)); text-shadow: 0 0 10px ${tier.bracketColor}50;`}>{tier.monthly}</span>
                  <span class="text-[12px] font-mono" style={`color: color-mix(in srgb, ${tier.bracketColor} 64%, var(--color-muted)); text-shadow: 0 0 8px ${tier.bracketColor}28;`}>{tier.annual}</span>
                </div>
              </div>

              <p class="mb-5 text-[14.5px] leading-[1.55]" style={`color: color-mix(in srgb, ${tier.bracketColor} 68%, var(--color-text-mid)); text-shadow: 0 0 14px ${tier.bracketColor}32;`}>
                {tier.pitch}
              </p>

              <ul class="space-y-2.5 mb-7">
                {tier.perks.map((perk) => (
                  <li class="flex items-start gap-2.5 text-[13.5px] leading-[1.45]" style={`color: color-mix(in srgb, ${tier.bracketColor} 62%, var(--color-text-mid)); text-shadow: 0 0 10px ${tier.bracketColor}28;`}>
                    <span style={`color: ${tier.bracketColor}; flex-shrink: 0; margin-top: 1px; text-shadow: 0 0 12px ${tier.bracketColor}88;`}>✓</span>
                    <span set:html={perk} />
                  </li>
                ))}
              </ul>

              <a
                href={tier.ctaHref}
                target="_blank"
                rel="noopener noreferrer"
                class="block text-center px-5 py-3 rounded-lg text-[14px] font-semibold transition-all"
                style={`background: ${tier.bracketColor}; color: #08050f; border: 1px solid ${tier.bracketColor}; box-shadow: 0 0 18px ${tier.bracketColor}66, 0 4px 18px rgba(0,0,0,0.3);`}
              >
                {tier.ctaLabel}
              </a>

              {tier.upsell && (
                <p class="mt-3 text-[11.5px] leading-[1.45]" style={`color: color-mix(in srgb, ${tier.bracketColor} 56%, var(--color-muted)); text-shadow: 0 0 9px ${tier.bracketColor}28;`}>
                  {tier.upsell}
                </p>
              )}
            </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Founder strip — scarcity slot -->
    <section id="founder" class="relative mx-auto max-w-5xl px-5 sm:px-8 pb-20">
      <div
        class="relative rounded-2xl p-8 sm:p-10 border overflow-hidden"
        style="border-color: rgba(243,175,25,0.45); background: linear-gradient(135deg, rgba(243,175,25,0.08) 0%, rgba(255,85,85,0.06) 100%); box-shadow: 0 0 0 1px rgba(243,175,25,0.18) inset, 0 8px 28px rgba(243,175,25,0.18);"
      >
        <div
          class="absolute top-0 left-0 right-0 h-[3px] opacity-70"
          style="background: linear-gradient(90deg, transparent, #FFAA00, transparent);"
        ></div>

        <div class="flex items-start gap-5 sm:gap-7 flex-wrap">
          <!-- Gem icon -->
          <span
            class="inline-flex items-center justify-center flex-shrink-0"
            style="width: 72px; height: 72px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #FFD27A, #C68A1A 60%, #5A3508 100%); box-shadow: 0 0 18px rgba(255,170,0,0.6), inset 0 0 8px rgba(255,255,255,0.35); font-family: 'Tungsten Bold', 'Bebas Neue', 'Oswald', 'Arial Black', sans-serif; font-size: 30px; font-weight: 800; color: #1a0e02; letter-spacing: 0.02em;"
            title="Founder badge"
          >
            #
          </span>

          <div class="flex-1 min-w-[280px]">
            <p class="text-[11px] uppercase tracking-[0.14em] font-mono mb-2" style="color: #FFD27A;">
              ◇ Scarcity slot · 33 ever
            </p>
            <h2
              class="font-display leading-[0.9] tracking-[-0.01em] mb-4"
              style="font-size: clamp(48px, 8vw, 88px); color: #FFD580;"
            >
              Founder #(x)
            </h2>
            <p class="text-[13.5px] sm:text-[14.5px] leading-[1.6] text-[var(--color-text-mid)] max-w-2xl mb-6">
              {FOUNDER_DESCRIPTION}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-7">
              <div class="rounded-xl p-4 border" style="border-color: rgba(243,175,25,0.25); background: rgba(0,0,0,0.18);">
                <p class="text-[11px] uppercase tracking-[0.1em] font-mono text-[var(--color-muted)] mb-1.5">One-time price</p>
                <p class="text-[28px] font-bold" style="color: #FFD27A;">$67</p>
              </div>
              <div class="rounded-xl p-4 border" style="border-color: rgba(243,175,25,0.25); background: rgba(0,0,0,0.18);">
                <p class="text-[11px] uppercase tracking-[0.1em] font-mono text-[var(--color-muted)] mb-1.5">Slots remaining</p>
                <p class="text-[28px] font-bold" style="color: #FFD27A;">33 / 33</p>
              </div>
              <div class="rounded-xl p-4 border" style="border-color: rgba(243,175,25,0.25); background: rgba(0,0,0,0.18);">
                <p class="text-[11px] uppercase tracking-[0.1em] font-mono text-[var(--color-muted)] mb-1.5">Price-locked at</p>
                <p class="text-[28px] font-bold" style="color: #FFD27A;">$12 / mo</p>
                <p class="text-[10.5px] text-[var(--color-muted)] font-mono mt-0.5">forever</p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href={DISCORD_INVITE}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-6 py-3 rounded-lg text-[14px] font-bold uppercase tracking-[0.04em]"
                style="background: linear-gradient(135deg, #FFD27A, #FFAA00); color: #1a0e02; box-shadow: 0 0 22px rgba(255,170,0,0.45);"
              >
                Claim a Founder slot →
              </a>
              <span class="text-[11.5px] text-[var(--color-muted)] font-mono">
                Click "Buy Founder #(x) — $67" in #open-ticket on the Maxxtopia Discord.
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Checkout flow explainer -->
    <section class="relative mx-auto max-w-5xl px-5 sm:px-8 pb-24">
      <div class="checkout-panel-shell relative isolate">
        <div class="checkout-panel__halo absolute -inset-4 rounded-[2rem] pointer-events-none" aria-hidden="true"></div>

        <div class="checkout-panel relative overflow-hidden rounded-[1.75rem] border p-6 sm:p-9">
          <div class="checkout-panel__wash checkout-panel__wash--cyan" aria-hidden="true"></div>
          <div class="checkout-panel__wash checkout-panel__wash--gold" aria-hidden="true"></div>
          <div class="checkout-panel__grid" aria-hidden="true"></div>

          <div class="relative z-10">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-2xl">
                <p class="checkout-panel__eyebrow mb-3">
                  <span aria-hidden="true">◇</span> How checkout works
                </p>
                <h2 class="text-[34px] sm:text-[48px] leading-[0.98] tracking-[-0.035em] font-semibold text-[var(--color-text)]">
                  The route to your tier.
                </h2>
                <p class="mt-4 max-w-xl text-[14px] sm:text-[15px] leading-[1.55] text-[var(--color-text-mid)]">
                  A short, human-guided handoff from the Discord ticket to your activated rig.
                </p>
              </div>

              <div class="checkout-panel__status self-start lg:self-auto">
                <span class="checkout-panel__status-dot" aria-hidden="true"></span>
                <span>MANUAL CHECKOUT</span>
                <span class="checkout-panel__status-divider" aria-hidden="true"></span>
                <span>NO AUTO-RENEW</span>
              </div>
            </div>

            <div class="checkout-route" aria-label="Checkout route">
              <span class="checkout-route__node" style="--route-color: #00d4ff;">01 <b>DISCORD</b></span>
              <span class="checkout-route__arrow" aria-hidden="true">→</span>
              <span class="checkout-route__node" style="--route-color: #55FFFF;">02 <b>TIER</b></span>
              <span class="checkout-route__arrow" aria-hidden="true">→</span>
              <span class="checkout-route__node" style="--route-color: #FFAA00;">03 <b>PAYMENT</b></span>
              <span class="checkout-route__arrow" aria-hidden="true">→</span>
              <span class="checkout-route__node" style="--route-color: #55FF55;">04 <b>ACTIVATE</b></span>
            </div>

            <ol class="checkout-steps">
              <li class="checkout-step" style="--step-color: #00d4ff;">
                <div class="checkout-step__top">
                  <span class="checkout-step__number">01</span>
                  <span class="checkout-step__eyebrow">Start here</span>
                </div>
                <h3 class="checkout-step__title">Open the door</h3>
                <p class="checkout-step__copy">
                  Click any "Open Discord ticket" button above. You'll land in the Maxxtopia Discord (suite-wide community hub).
                </p>
              </li>

              <li class="checkout-step" style="--step-color: #55FFFF;">
                <div class="checkout-step__top">
                  <span class="checkout-step__number">02</span>
                  <span class="checkout-step__eyebrow">Choose your tier</span>
                </div>
                <h3 class="checkout-step__title">Pick your flex</h3>
                <p class="checkout-step__copy">
                  In <code class="checkout-inline-code">#open-ticket</code>, click the "Buy Discordmaxxer [tier]" button. A private thread opens with you and Diggy — only the two of you can see it.
                </p>
              </li>

              <li class="checkout-step" style="--step-color: #FFAA00;">
                <div class="checkout-step__top">
                  <span class="checkout-step__number">03</span>
                  <span class="checkout-step__eyebrow">Settle up</span>
                </div>
                <h3 class="checkout-step__title">Pick a payment</h3>
                <p class="checkout-step__copy">
                  Tell Diggy your preferred payment: <strong>PayPal · BTC · Venmo · Cash App</strong>. He sends the address + amount. Once payment lands, he DMs your 16-character HWID-bound activation code.
                </p>
              </li>

              <li class="checkout-step" style="--step-color: #55FF55;">
                <div class="checkout-step__top">
                  <span class="checkout-step__number">04</span>
                  <span class="checkout-step__eyebrow">Claim it</span>
                </div>
                <h3 class="checkout-step__title">Activate your rig</h3>
                <p class="checkout-step__copy">
                  In Discordmaxxer: open the Hub panel → VIP claim → paste code. First-claim-wins — your tier locks to your rig forever, even offline. The Maxx bot grants your <code class="checkout-inline-code">@VIP</code> role in the Discord with one click.
                </p>
              </li>
            </ol>

            <div class="checkout-panel__footer">
              <div class="checkout-reassurance">
                <span class="checkout-reassurance__mark" aria-hidden="true">✓</span>
                <div>
                  <p class="checkout-reassurance__title">No surprise renewal loop.</p>
                  <p class="checkout-reassurance__copy">
                    We don't run Stripe yet — every paying tier flows through Discord tickets. Codes are product-specific and HWID-bound: Discordmaxxer codes work in Discordmaxxer, while Optimizationmaxxing codes work in Optimizationmaxxing. Founder codes unlock both products. No subscriptions get auto-charged. No "trial → silent renewal" traps. We send a manual reminder when your month is up.
                  </p>
                </div>
              </div>

              <a
                href={DISCORD_INVITE}
                target="_blank"
                rel="noopener noreferrer"
                class="checkout-panel__cta"
              >
                Open Maxxtopia Discord <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .vip-tier-card__smoke {
    border: 14px solid var(--tier-color);
    filter: blur(24px);
    opacity: 0.42;
    transform: translate3d(-1%, 1%, 0) scale(0.96);
    animation: vip-tier-smoke 8s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .vip-tier-card__smoke::before,
  .vip-tier-card__smoke::after {
    content: '';
    position: absolute;
    width: 52%;
    height: 34%;
    border-radius: 999px;
    background: var(--tier-color);
    filter: blur(28px);
    opacity: 0.68;
  }

  .vip-tier-card__smoke::before {
    left: -7%;
    bottom: -4%;
  }

  .vip-tier-card__smoke::after {
    right: -7%;
    top: -4%;
  }

  .vip-tier-card-shell:hover .vip-tier-card__smoke {
    opacity: 0.58;
  }

  @keyframes vip-tier-smoke {
    0%,
    100% {
      transform: translate3d(-1%, 1%, 0) scale(0.96);
      opacity: 0.32;
    }

    50% {
      transform: translate3d(2%, -2%, 0) scale(1.03);
      opacity: 0.60;
    }
  }

  .checkout-panel-shell {
    isolation: isolate;
  }

  .checkout-panel__halo {
    background:
      radial-gradient(circle at 8% 18%, rgba(0, 212, 255, 0.24), transparent 30%),
      radial-gradient(circle at 92% 84%, rgba(255, 170, 0, 0.20), transparent 32%);
    filter: blur(24px);
    opacity: 0.72;
    animation: checkout-halo-breathe 9s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .checkout-panel {
    background:
      linear-gradient(135deg, rgba(22, 12, 45, 0.98), rgba(10, 6, 18, 0.98) 70%),
      var(--color-bg-card);
    border-color: rgba(0, 212, 255, 0.34);
    box-shadow:
      0 0 0 1px rgba(226, 91, 255, 0.16) inset,
      0 0 32px rgba(0, 212, 255, 0.12),
      0 22px 58px rgba(0, 0, 0, 0.34);
  }

  .checkout-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.035) inset;
  }

  .checkout-panel__wash {
    position: absolute;
    width: 22rem;
    height: 16rem;
    border-radius: 999px;
    filter: blur(48px);
    opacity: 0.13;
    pointer-events: none;
  }

  .checkout-panel__wash--cyan {
    top: -9rem;
    left: -8rem;
