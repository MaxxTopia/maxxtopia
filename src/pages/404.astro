---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
---

<Layout title="404 — Maxxtopia" noindex>
  <section class="relative overflow-hidden min-h-[80vh] flex items-center">
    <Aurora intensity="med" />
    <div class="absolute inset-0 bg-grid opacity-50"></div>
    <div class="relative mx-auto max-w-2xl px-5 sm:px-8 py-32 text-center">
      <p class="reveal reveal-1 text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono">
        404 · Off the bus path
      </p>
      <h1 class="reveal reveal-2 mt-5 text-[64px] sm:text-[88px] font-semibold tracking-[-0.03em] leading-[1]">
        <span class="gradient-text">That page</span><br/>
        <span class="serif-accent gradient-suite">doesn't exist.</span>
      </h1>
      <p class="reveal reveal-3 mt-8 text-[16.5px] text-[var(--color-text-mid)] leading-relaxed max-w-md mx-auto">
        Maybe it shipped. Maybe it's still in the lab. Either way, it's not here.
      </p>
      <div class="reveal reveal-4 mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn-primary">
          Back to home
        </a>
        <a href="/#suite" class="btn-secondary">
          Browse suite
        </a>
      </div>
    </div>
  </section>
</Layout>
