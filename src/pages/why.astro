---
import Layout from '../layouts/Layout.astro';
import Aurora from '../components/Aurora.astro';
import { liveProducts, products } from '../data/products';

const liveCount = liveProducts.length;
const totalCount = products.length;

// Category villains, not named competitors. Stock Discord stays — it's the
// platform we improve, not a rival product.
const villains = [
  { name: 'PC tuners',       stat: '200 MB',  body: 'Electron settings panel.' },
  { name: 'Driver utilities', stat: '81 MB',   body: 'Heavier than what they tune.' },
  { name: 'Stock Discord',    stat: '1,041 MB', body: '14 outbound calls on launch.' },
];

// Receipts. Real numbers we can defend.
const receipts = [
  { stat: '87',         label: 'Tweaks shipped', body: 'Each cited. Each reversible.' },
  { stat: '−753 MB',    label: 'Discord RAM cut', body: 'Native rewrite. Shipping now.' },
  { stat: `${liveCount}/${totalCount}`, label: 'Apps live',       body: 'The rest are cooking.' },
  { stat: '0',          label: 'Trackers',        body: 'Forever.' },
];

const principles = [
  { t: 'Sourced. Or it doesn\'t ship.',    b: 'Every tweak cites a primary source. No source, no build.' },
  { t: 'Native or nothing.',                 b: '3.6 MB tuner. 288 MB Discord. Bundle size is a moral position.' },
  { t: 'Reversible by default.',             b: 'Snapshot-backed. Undo any change, anytime. No paid undo tier.' },
  { t: 'No telemetry. Ever.',                b: "We don't analytics you. We don't error-report you. We don't 'help us improve' you." },
  { t: "Measure. Don't just modify.",        b: 'Live DPC. Latency probes. PCIe diagnostics. Trust, then verify.' },
  { t: "Iterate until you'd defend it.",     b: 'The discordmaxxer logo took five tries. The first four were generic. The fifth wasn\'t.' },
];
---

<Layout
  title="Why — Built to actually work"
  description="Most gaming software is Chromium pretending to be an app. Ours isn't. Receipts, principles, and a refusal."
>
  <article class="relative">
    <Aurora intensity="low" />
    <div class="absolute inset-0 bg-grid opacity-30"></div>

    <!-- Hero — declaration first. No prose. -->
    <div class="relative mx-auto max-w-3xl px-5 sm:px-8 pt-24 pb-20">
      <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono reveal reveal-1">
        Why · v0.1
      </p>
      <h1 class="reveal reveal-2 mt-4 text-[44px] sm:text-[80px] font-semibold tracking-[-0.035em] leading-[0.95] gradient-text">
        Built to <span class="serif-accent gradient-suite">actually work.</span>
      </h1>
      <p class="reveal reveal-3 mt-7 text-[20px] sm:text-[24px] leading-[1.35] text-[var(--color-text-mid)] max-w-xl">
        Most gaming software is Chromium pretending to be an app. Ours isn't.
      </p>
    </div>

    <!-- The status quo — three category villains, no name-drops. -->
    <section class="relative mx-auto max-w-5xl px-5 sm:px-8 pb-20">
      <p class="reveal-on-scroll text-[11px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono mb-6">
        ◇ The status quo
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {villains.map((v, i) => (
          <div class={`reveal-on-scroll reveal-delay-${i + 1} bg-[var(--color-bg-card)] p-7 sm:p-8`}>
            <p class="text-[12px] uppercase tracking-[0.1em] text-[var(--color-subtle)] font-mono">
              {v.name}
            </p>
            <p class="font-display mt-2 text-[56px] sm:text-[72px] gradient-suite leading-none">
              {v.stat}
            </p>
            <p class="mt-4 text-[14.5px] leading-[1.5] text-[var(--color-text-mid)]">
              {v.body}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- The refusal — single line, full bleed. -->
    <section class="relative mx-auto max-w-3xl px-5 sm:px-8 py-16">
      <h2 class="reveal-on-scroll text-[40px] sm:text-[60px] font-semibold tracking-[-0.03em] leading-[1] text-[var(--color-text)]">
        We don't ship that. <span class="serif-accent gradient-suite">Period.</span>
      </h2>
    </section>

    <!-- Receipts — four real numbers we can defend. -->
    <section class="relative mx-auto max-w-5xl px-5 sm:px-8 pb-20">
      <p class="reveal-on-scroll text-[11px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono mb-6">
        ✦ Receipts
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {receipts.map((r, i) => (
          <div class={`reveal-on-scroll reveal-delay-${(i % 4) + 1} bg-[var(--color-bg-card)] p-6 sm:p-7`}>
            <p class="text-[11px] uppercase tracking-[0.1em] text-[var(--color-subtle)] font-mono">
              {r.label}
            </p>
            <p class="font-display mt-2 text-[44px] sm:text-[60px] gradient-suite leading-none">
              {r.stat}
            </p>
            <p class="mt-3 text-[13px] leading-[1.5] text-[var(--color-text-mid)]">
              {r.body}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Principles — six rules, one-line each. -->
    <section class="relative mx-auto max-w-3xl px-5 sm:px-8 pb-20">
      <p class="reveal-on-scroll text-[11px] uppercase tracking-[0.1em] text-[var(--color-cyan)] font-mono mb-8">
        ✶ Six rules
      </p>
      <div class="space-y-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)]">
        {principles.map((p, i) => (
          <div class={`reveal-on-scroll reveal-delay-${(i % 5) + 1} bg-[var(--color-bg-card)] p-6 sm:p-7 group hover:bg-[var(--color-bg-card-hover)] transition-colors flex items-baseline gap-4 sm:gap-6`}>
            <span class="text-[12px] font-mono text-[var(--color-magenta)] group-hover:text-[var(--color-cyan)] transition-colors shrink-0 w-6">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              <h3 class="text-[var(--color-text)] text-[20px] sm:text-[24px] font-semibold tracking-[-0.015em] leading-tight">
                {p.t}
              </h3>
              <p class="mt-2 text-[14.5px] leading-[1.55] text-[var(--color-text-mid)]">
                {p.b}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- The apps — one-liners stacked. -->
    <section class="relative mx-auto max-w-3xl px-5 sm:px-8 py-16">
      <p class="reveal-on-scroll text-[11px] uppercase tracking-[0.1em] text-[var(--color-magenta)] font-mono mb-6">
        ✶ The suite
      </p>
      <ul class="space-y-3 text-[18px] sm:text-[22px] font-medium tracking-[-0.01em] text-[var(--color-text-mid)]">
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Optimizationmaxxing.</span> Tunes the rig.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Discordmaxxer.</span> −753 MB. Same Discord.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Clipmaxxer.</span> Stream tonight. Posted by morning.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Dropmaxxer.</span> The drop, picked.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Aimmaxxer.</span> Drill the gap.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Viewmaxxing.</span> The audience graph, watched.</li>
        <li class="reveal-on-scroll"><span class="text-[var(--color-text)]">Editmaxxing.</span> One mechanic. Tight.</li>
      </ul>
    </section>

    <!-- Closing — slogan, CTA. -->
    <section class="relative mx-auto max-w-3xl px-5 sm:px-8 pb-32">
      <h2 class="reveal-on-scroll text-[36px] sm:text-[52px] font-semibold tracking-[-0.025em] leading-[1.05]">
        Different tools. <span class="serif-accent gradient-suite">Same standard.</span>
      </h2>
      <p class="reveal-on-scroll mt-6 text-[16px] text-[var(--color-text-mid)]">
        Built by a player who counts ms. For everyone else who does too.
      </p>
      <p class="reveal-on-scroll mt-10">
        <span class="slogan">made by diggy</span>
      </p>

      <div class="reveal-on-scroll mt-12 pt-10 border-t border-[var(--color-line)]">
        <a href="/#apps" class="btn-primary">
          Browse the apps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
  </article>
</Layout>
