---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import MagneticAndTilt from '../components/MagneticAndTilt.astro';
import MaxxerSidebar from '../components/MaxxerSidebar.astro';
import DailyQuote from '../components/DailyQuote.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the cross-suite sidebar (e.g., on 404). */
  hideSidebar?: boolean;
};

const {
  title = 'Maxxtopia — Native gaming utilities for the players who count frame times',
  description = "Native gaming utilities, sourced and reversible, with zero telemetry. PC tuner with 100 audited Windows tweaks. Discord client at 288 MB instead of 1,041. Clip matchmaker that knows what's trending today. Built by a single player for players who care about the millisecond.",
  image = '/og.png',
  noindex = false,
  hideSidebar = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Site-wide structured data so engines can build a knowledge graph
// entry for "Maxxtopia" — surfaces sitelinks, the brand pill in SERP,
// and the search-box widget once we have enough authority.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Maxxtopia',
  alternateName: ['Maxxer Suite', 'Maxxer'],
  url: 'https://maxxtopia.com',
  logo: 'https://maxxtopia.com/maxxtopia-clavicular-512.png',
  description:
    "Native gaming utilities for the players who count frame times. Sourced, reversible, zero telemetry.",
  founder: { '@type': 'Person', name: 'Diggy', url: 'https://x.com/DTburnr' },
  sameAs: [
    'https://x.com/DTburnr',
    'https://github.com/MaxxTopia',
    'https://discord.gg/S78eecbWdx',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Maxxtopia',
  url: 'https://maxxtopia.com',
  description:
    "Native gaming utilities for the players who count frame times.",
  publisher: { '@type': 'Organization', name: 'Maxxtopia' },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://maxxtopia.com/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

// Cloudflare Web Analytics — paste the beacon token in PUBLIC_CF_ANALYTICS_TOKEN
// (.env.local or Cloudflare Pages env vars). Beacon does nothing if unset, so
// dev/preview environments stay unmeasured automatically.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// Sentry DSN — paste the project DSN in PUBLIC_SENTRY_DSN to enable error
// reporting. Same pattern: nothing loads if unset, so the site has zero
// Sentry weight when you haven't turned it on.
const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN;

// Search-engine ownership verification tokens. Paste the token string
// (just the token, NOT the full meta tag) into Cloudflare Pages env vars
// and the matching meta tag will render. Lets us verify GSC + Bing
// Webmaster + Yandex without committing tokens to git.
const googleVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerify = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const yandexVerify = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
    {bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
    {yandexVerify && <meta name="yandex-verification" content={yandexVerify} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Maxxtopia" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@DTburnr" />
    <meta name="twitter:creator" content="@DTburnr" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0612" />

    <!-- Site-wide structured data: Organization + WebSite. Homepage
         also gets the SearchAction widget. -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- RSS feed for /updates so feed readers, Discord/Slack bots, and
         GitHub-action mirrors can auto-pick up changelog drops. -->
    <link rel="alternate" type="application/rss+xml" title="Maxxtopia updates" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Bebas+Neue&family=Bowlby+One&family=Crimson+Pro:ital,wght@1,400;1,500;1,600;1,700&family=Metal+Mania&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={hideSidebar ? '' : 'has-sidebar'}>
    <CustomCursor />
    <Header />
    {!hideSidebar && <MaxxerSidebar />}
    <main>
      <slot />
    </main>
    <Footer />
    <RevealOnScroll />
    <MagneticAndTilt />
    <!-- Floating quote-of-the-day widget — always visible across every page. -->
    <DailyQuote />

    {/* Cloudflare Web Analytics — only renders when the token env var is set. */}
    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}

    {/* Sentry browser SDK — same pattern, only loads when DSN is configured. */}
    {sentryDsn && (
      <>
        <script is:inline src="https://browser.sentry-cdn.com/8.49.0/bundle.tracing.min.js" crossorigin="anonymous"></script>
        <script is:inline define:vars={{ sentryDsn, env: import.meta.env.MODE }}>
          {`
            if (typeof Sentry !== 'undefined') {
              Sentry.init({
                dsn: sentryDsn,
                environment: env,
                integrations: [Sentry.browserTracingIntegration()],
                tracesSampleRate: 0.1,
                // Don't ship sensitive URLs / search params to Sentry.
                beforeSend(event) {
                  if (event.request && event.request.url) {
                    try {
                      const u = new URL(event.request.url);
                      event.request.url = u.origin + u.pathname;
                    } catch (_) {}
                  }
                  return event;
                },
              });
            }
          `}
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  @media (min-width: 1024px) {
    body.has-sidebar > main,
    body.has-sidebar > footer {
      padding-left: 64px;
    }
  }
</style>
