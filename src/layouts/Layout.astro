---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import MagneticAndTilt from '../components/MagneticAndTilt.astro';
import MaxxerSidebar from '../components/MaxxerSidebar.astro';
import DailyQuote from '../components/DailyQuote.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the cross-suite sidebar (e.g., on 404). */
  hideSidebar?: boolean;
};

const {
  title = 'Maxxtopia — Native gaming utilities for the players who count frame times',
  description = "Native gaming utilities, sourced and reversible, with zero telemetry. PC tuner with 87 audited Windows tweaks. Discord client at 288 MB instead of 1,041. Clip matchmaker that knows what's trending today. Built by a single player for players who care about the millisecond.",
  image = '/og.png',
  noindex = false,
  hideSidebar = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Maxxtopia" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0612" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Bebas+Neue&family=Bowlby+One&family=Metal+Mania&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={hideSidebar ? '' : 'has-sidebar'}>
    <CustomCursor />
    <Header />
    {!hideSidebar && <MaxxerSidebar />}
    <main>
      <slot />
    </main>
    <Footer />
    <RevealOnScroll />
    <MagneticAndTilt />
    <!-- Floating quote-of-the-day widget — always visible across every page. -->
    <DailyQuote />
  </body>
</html>

<style is:global>
  @media (min-width: 1024px) {
    body.has-sidebar > main,
    body.has-sidebar > footer {
      padding-left: 64px;
    }
  }
</style>
