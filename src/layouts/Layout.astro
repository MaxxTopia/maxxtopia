---
import '../styles/global.css';
// Self-hosted fonts — same families + weights previously loaded from
// fonts.googleapis.com, now served from our own origin (removes the
// render-blocking third-party request + gets the 1-year immutable cache).
// @fontsource declares Geist as 'Geist Sans' (see --font-sans in global.css).
// No visual change.
import '@fontsource/geist-sans/300.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-sans/800.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@fontsource/bebas-neue/400.css';
import '@fontsource/bowlby-one/400.css';
import '@fontsource/crimson-pro/400-italic.css';
import '@fontsource/crimson-pro/500-italic.css';
import '@fontsource/crimson-pro/600-italic.css';
import '@fontsource/crimson-pro/700-italic.css';
import '@fontsource/metal-mania/400.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';
import MagneticAndTilt from '../components/MagneticAndTilt.astro';
import MaxxerSidebar from '../components/MaxxerSidebar.astro';
import DailyQuote from '../components/DailyQuote.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Hide the cross-suite sidebar (e.g., on 404). */
  hideSidebar?: boolean;
  /** OpenGraph type — 'website' for most pages, 'article' for guides. */
  ogType?: 'website' | 'article';
  /** ISO date — emits article:published_time when ogType is 'article'. */
  articlePublished?: string;
  /** ISO date — emits article:modified_time when ogType is 'article'. */
  articleModified?: string;
};

const {
  // Kept ≤60 chars so it doesn't truncate in the SERP, and leads with the
  // real category keyword instead of the old 73-char brand-vibe line.
  title = 'Maxxtopia — Free Native Gaming Utilities, Zero Telemetry',
  // ≤160 chars so the SERP snippet stops mid-sentence-truncating.
  description = "Native gaming tools — sourced, reversible, zero telemetry. A 100-tweak Windows tuner, a 288 MB Discord client, an ad blocker, a stream studio, and more. Free.",
  image = '/og.png',
  noindex = false,
  hideSidebar = false,
  ogType = 'website',
  articlePublished,
  articleModified,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Site-wide structured data so engines can build a knowledge graph
// entry for "Maxxtopia" — surfaces sitelinks, the brand pill in SERP,
// and the search-box widget once we have enough authority.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Maxxtopia',
  alternateName: ['Maxxer Suite', 'Maxxer'],
  url: 'https://maxxtopia.com',
  logo: 'https://maxxtopia.com/maxxtopia-clavicular-512.png',
  description:
    "Native gaming utilities for the players who count frame times. Sourced, reversible, zero telemetry.",
  founder: { '@type': 'Person', name: 'Diggy', url: 'https://x.com/DTburnr' },
  sameAs: [
    'https://x.com/DTburnr',
    'https://github.com/MaxxTopia',
    'https://discord.gg/S78eecbWdx',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Maxxtopia',
  url: 'https://maxxtopia.com',
  description:
    "Native gaming utilities for the players who count frame times.",
  publisher: { '@type': 'Organization', name: 'Maxxtopia' },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://maxxtopia.com/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

// Cloudflare Web Analytics — paste the beacon token in PUBLIC_CF_ANALYTICS_TOKEN
// (.env.local or Cloudflare Pages env vars). Beacon does nothing if unset, so
// dev/preview environments stay unmeasured automatically.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// Sentry DSN — paste the project DSN in PUBLIC_SENTRY_DSN to enable error
// reporting. Same pattern: nothing loads if unset, so the site has zero
// Sentry weight when you haven't turned it on.
const sentryDsn = import.meta.env.PUBLIC_SENTRY_DSN;

// Search-engine ownership verification tokens. Paste the token string
// (just the token, NOT the full meta tag) into Cloudflare Pages env vars
// and the matching meta tag will render. Lets us verify GSC + Bing
// Webmaster + Yandex without committing tokens to git.
const googleVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerify = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const yandexVerify = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {googleVerify && <meta name="google-site-verification" content={googleVerify} />}
    {bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
    {yandexVerify && <meta name="yandex-verification" content={yandexVerify} />}

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {ogType === 'article' && (articleModified || articlePublished) && <meta property="article:modified_time" content={articleModified ?? articlePublished} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Maxxtopia" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@DTburnr" />
    <meta name="twitter:creator" content="@DTburnr" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0612" />

    <!-- Site-wide structured data: Organization + WebSite. Homepage
         also gets the SearchAction widget. -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- RSS feed for /updates so feed readers, Discord/Slack bots, and
         GitHub-action mirrors can auto-pick up changelog drops. -->
    <link rel="alternate" type="application/rss+xml" title="Maxxtopia updates" href="/rss.xml" />

    <!-- Fonts are self-hosted (imported in this layout's frontmatter via
         @fontsource) — no third-party Google Fonts request. -->

  </head>
  <body class={hideSidebar ? '' : 'has-sidebar'}>
    <a href="#main" class="skip-link">Skip to content</a>
    <CustomCursor />
    <Header />
    {!hideSidebar && <MaxxerSidebar />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <RevealOnScroll />
    <MagneticAndTilt />
    <!-- Floating quote-of-the-day widget — always visible across every page. -->
    <DailyQuote />

    {/* Cloudflare Web Analytics — only renders when the token env var is set. */}
    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}

    {/* Sentry browser SDK — same pattern, only loads when DSN is configured. */}
    {sentryDsn && (
      <>
        <script is:inline src="https://browser.sentry-cdn.com/8.49.0/bundle.tracing.min.js" integrity="sha384-ClKMlPTNaNgXMxZjUwnVClom3V4p5CV5IcNIjKSEboUgXUPPgnxubASQ8kSCrZri" crossorigin="anonymous"></script>
        <script is:inline define:vars={{ sentryDsn, env: import.meta.env.MODE }}>
          {`
            if (typeof Sentry !== 'undefined') {
              Sentry.init({
                dsn: sentryDsn,
                environment: env,
                integrations: [Sentry.browserTracingIntegration()],
                tracesSampleRate: 0.1,
                // Don't ship sensitive URLs / search params to Sentry.
                beforeSend(event) {
                  if (event.request && event.request.url) {
                    try {
                      const u = new URL(event.request.url);
                      event.request.url = u.origin + u.pathname;
                    } catch (_) {}
                  }
                  return event;
                },
              });
            }
          `}
        </script>
      </>
    )}
  </body>
</html>

<style is:global>
  @media (min-width: 1024px) {
    body.has-sidebar > main,
    body.has-sidebar > footer {
      padding-left: 64px;
    }
  }
</style>
