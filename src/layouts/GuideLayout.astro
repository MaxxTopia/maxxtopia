---
import Layout from './Layout.astro';
import { getGuide } from '../data/guides';
import { getProduct } from '../data/products';

type Props = { slug: string };
const { slug } = Astro.props;

const guide = getGuide(slug);
if (!guide) throw new Error(`GuideLayout: no guide found for slug "${slug}"`);
const product = guide.product ? getProduct(guide.product) : undefined;

const canonical = new URL(`/guides/${guide.slug}/`, Astro.site).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  datePublished: guide.date,
  dateModified: guide.updated ?? guide.date,
  image: 'https://maxxtopia.com/og.png',
  author: { '@type': 'Organization', name: 'Maxxtopia', url: 'https://maxxtopia.com' },
  publisher: {
    '@type': 'Organization',
    name: 'Maxxtopia',
    logo: { '@type': 'ImageObject', url: 'https://maxxtopia.com/maxxtopia-clavicular-512.png' },
  },
  mainEntityOfPage: canonical,
};

// BreadcrumbList JSON-LD — Home › Guides › this article. Guides render a
// visible breadcrumb but had no schema, so the SERP got a bare URL instead
// of the breadcrumb trail. Products already had this; guides now match.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://maxxtopia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://maxxtopia.com/guides/' },
    { '@type': 'ListItem', position: 3, name: guide.title, item: canonical },
  ],
};
---

<Layout
  title={`${guide.title} — Maxxtopia`}
  description={guide.description}
  ogType="article"
  articlePublished={guide.date}
  articleModified={guide.updated ?? guide.date}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <main class="guide" style={product ? `--accent: ${product.accentHex}` : ''}>
    <nav class="guide__crumbs" aria-label="Breadcrumb">
      <a href="/guides/">Guides</a><span aria-hidden="true">/</span>
      <span>{guide.title}</span>
    </nav>

    <header class="guide__head">
      <div class="guide__meta">
        {product && <a class="guide__tag" href={`/${product.slug}/`}>{product.name}</a>}
        <span class="guide__mins">{guide.readMins} min read</span>
      </div>
      <h1 class="guide__title">{guide.title}</h1>
    </header>

    <article class="guide-prose">
      <slot />
    </article>

    {product && (
      <aside class="guide__cta" aria-label="Related tool">
        <div>
          <p class="guide__cta-eyebrow">The shortcut</p>
          <p class="guide__cta-name">{product.name}</p>
          <p class="guide__cta-tag">{product.tagline}</p>
        </div>
        <a class="guide__cta-btn" href={`/${product.slug}/`}>See {product.name} →</a>
      </aside>
    )}
  </main>
</Layout>

<style>
  .guide { max-width: 46rem; margin: 0 auto; padding: 5rem 1.5rem 5rem; }
  .guide__crumbs {
    font-family: var(--font-mono); font-size: 0.78rem; color: #7d7a8a;
    display: flex; gap: 0.5rem; margin-bottom: 2rem;
  }
  .guide__crumbs a { color: var(--accent, #e25bff); text-decoration: none; }
  .guide__meta { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
  .guide__tag {
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--accent, #e25bff); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 40%, transparent);
    border-radius: 999px; padding: 0.15rem 0.6rem;
  }
  .guide__mins { font-family: var(--font-mono); font-size: 0.72rem; color: #7d7a8a; }
  .guide__title {
    font-family: var(--font-display); font-size: clamp(2.1rem, 5vw, 3.2rem);
    line-height: 1.05; margin: 0;
  }

  .guide-prose { margin-top: 2.5rem; font-size: 1.06rem; line-height: 1.7; color: #cbc8d6; }
  .guide-prose :global(h2) {
    font-size: 1.5rem; line-height: 1.25; margin: 2.4rem 0 0.9rem; color: #f3f1f8;
    font-family: var(--font-sans); font-weight: 700;
  }
  .guide-prose :global(h3) { font-size: 1.15rem; margin: 1.8rem 0 0.6rem; color: #ece9f4; }
  .guide-prose :global(p) { margin: 0 0 1.1rem; }
  .guide-prose :global(ul), .guide-prose :global(ol) { margin: 0 0 1.2rem; padding-left: 1.3rem; }
  .guide-prose :global(li) { margin: 0 0 0.5rem; }
  .guide-prose :global(strong) { color: #f3f1f8; }
  .guide-prose :global(a) { color: var(--accent, #e25bff); text-decoration: underline; text-underline-offset: 2px; }
  .guide-prose :global(blockquote) {
    border-left: 3px solid var(--accent, #e25bff); margin: 1.4rem 0; padding: 0.2rem 0 0.2rem 1.1rem;
    color: #aeabbd; font-style: italic;
  }

  /* TL;DR callout — the one-glance answer at the top of every guide.
     Scannable, on-brand ("no fluff"), and the single biggest readability win. */
  .guide-prose :global(.tldr) {
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 35%, transparent);
    background: color-mix(in srgb, var(--accent, #e25bff) 7%, transparent);
    border-radius: 0.9rem; padding: 1.1rem 1.3rem; margin: 0 0 2.2rem;
  }
  .guide-prose :global(.tldr__label) {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent, #e25bff); margin: 0 0 0.5rem; font-weight: 700;
  }
  .guide-prose :global(.tldr p) { margin: 0; color: #ddd9e8; font-size: 1.02rem; }
  .guide-prose :global(.tldr ul) { margin: 0.5rem 0 0; }
  .guide-prose :global(.tldr li) { color: #ddd9e8; }

  .guide__cta {
    margin-top: 3.5rem; padding: 1.5rem 1.6rem; border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 35%, transparent);
    background: color-mix(in srgb, var(--accent, #e25bff) 8%, transparent);
    display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap;
  }
  .guide__cta-eyebrow {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent, #e25bff); margin: 0 0 0.35rem;
  }
  .guide__cta-name { font-size: 1.25rem; font-weight: 700; margin: 0 0 0.2rem; color: #fff; }
  .guide__cta-tag { font-size: 0.95rem; color: #a5a2b3; margin: 0; }
  .guide__cta-btn {
    font-family: var(--font-mono); font-size: 0.9rem; white-space: nowrap;
    background: var(--accent, #e25bff); color: #0a0612; font-weight: 700;
    padding: 0.7rem 1.1rem; border-radius: 0.6rem; text-decoration: none;
  }
</style>

<!-- Shared "scannable guide" visual system (gx-*). Accent-driven: each guide
     inherits --accent from its product, so the same blocks recolor per page.
     Secondary is the site cyan. Global so slotted guide markup can use them. -->
<style is:global>
  .guide { --gx-c: #00d4ff; }

  /* Hero panel */
  .gx-hero {
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 45%, transparent);
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent, #e25bff) 16%, transparent), transparent 60%),
      radial-gradient(120% 140% at 100% 100%, color-mix(in srgb, var(--gx-c) 12%, transparent), transparent 60%),
      #ffffff05;
    border-radius: 1.1rem; padding: 1.5rem 1.4rem; margin: 0 0 1.8rem;
  }
  .gx-hero__kicker {
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent, #e25bff); margin: 0 0 0.6rem; font-weight: 700;
  }
  .gx-hero__line { font-size: 1.28rem; line-height: 1.4; color: #f3f1f8; margin: 0; font-weight: 600; }
  .gx-hero__line strong { color: var(--accent, #e25bff); }
  .gx-hero .gx-glance { margin-top: 1.1rem; }

  /* At-a-glance chips */
  .gx-glance { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gx-chip {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; color: #ece9f4;
    background: #ffffff0d; border: 1px solid #ffffff1f; border-radius: 999px; padding: 0.34rem 0.75rem;
  }
  .gx-chip__i { font-size: 0.95rem; }

  .gx-intro { font-size: 1.06rem; line-height: 1.65; color: #cbc8d6; margin: 0 0 1rem; }

  /* Punchier section headers than base prose */
  .gx-guide h2 { font-size: 1.55rem; margin: 2.4rem 0 1rem; color: #fff; letter-spacing: -0.01em; }
  .gx-guide h3 { margin: 0 0 0.4rem; color: #fff; font-size: 1.12rem; }

  /* Accent-check list (the "good"/why-it-works list) */
  .gx-checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .gx-checks li {
    position: relative; padding: 0.75rem 0.9rem 0.75rem 2.4rem; margin: 0;
    background: #ffffff06; border: 1px solid #ffffff12; border-radius: 0.7rem;
    color: #cbc8d6; line-height: 1.5; font-size: 0.99rem;
  }
  .gx-checks li::before {
    content: "\2713"; position: absolute; left: 0.85rem; top: 0.7rem;
    color: var(--accent, #e25bff); font-weight: 900; font-size: 1rem;
  }
  .gx-checks strong { color: #f3f1f8; }

  /* Red-cross list (the "skip this"/placebo list) */
  .gx-nope { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
  .gx-nope li {
    position: relative; padding: 0.7rem 0.9rem 0.7rem 2.4rem; margin: 0;
    background: color-mix(in srgb, #ff5c5c 6%, transparent); border: 1px solid color-mix(in srgb, #ff5c5c 22%, transparent);
    border-radius: 0.7rem; color: #d7c8c8; line-height: 1.5; font-size: 0.97rem;
  }
  .gx-nope li::before {
    content: "\2715"; position: absolute; left: 0.9rem; top: 0.7rem; color: #ff6b6b; font-weight: 900; font-size: 0.95rem;
  }
  .gx-nope strong { color: #ffd9d9; }

  /* Numbered step / ranked cards */
  .gx-steps { display: grid; gap: 0.9rem; }
  .gx-step {
    display: flex; gap: 1rem; align-items: flex-start;
    background: linear-gradient(180deg, #ffffff08, #ffffff03);
    border: 1px solid #ffffff14; border-left: 3px solid var(--accent, #e25bff);
    border-radius: 0.9rem; padding: 1.1rem 1.2rem;
  }
  .gx-step__num {
    flex: 0 0 auto; width: 2.4rem; height: 2.4rem; border-radius: 0.7rem;
    display: grid; place-items: center; font-family: var(--font-display), sans-serif;
    font-size: 1.5rem; font-weight: 800; color: #0a0612;
    background: linear-gradient(135deg, var(--accent, #e25bff), var(--gx-c));
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent, #e25bff) 35%, transparent);
  }
  .gx-step__body { min-width: 0; }
  .gx-step__body p { margin: 0 0 0.45rem; color: #c5c2d2; line-height: 1.55; font-size: 0.99rem; }
  .gx-step__body p:last-child { margin-bottom: 0; }
  .gx-note {
    font-size: 0.9rem !important;
    color: color-mix(in srgb, var(--accent, #e25bff) 55%, #d8d5e2) !important;
    background: color-mix(in srgb, var(--accent, #e25bff) 9%, transparent); border-radius: 0.5rem;
    padding: 0.5rem 0.65rem; margin-top: 0.5rem !important;
  }
  .gx-tag {
    font-family: var(--font-mono); font-size: 0.86em; color: var(--gx-c);
    background: color-mix(in srgb, var(--gx-c) 14%, transparent); border-radius: 0.35rem; padding: 0.05rem 0.4rem;
  }

  /* Keycaps + controls grid */
  .gx-key {
    display: inline-grid; place-items: center; min-width: 1.7rem; height: 1.7rem; padding: 0 0.4rem;
    font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; color: #f3f1f8;
    background: linear-gradient(180deg, #2a2740, #1a1830);
    border: 1px solid #4a4668; border-bottom-width: 3px; border-radius: 0.4rem; margin: 0 0.12rem;
    vertical-align: middle;
  }
  .gx-key--wide { min-width: 3.2rem; }
  .gx-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.7rem; margin: 1rem 0; }
  .gx-ctrl {
    display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-align: center;
    background: #ffffff06; border: 1px solid #ffffff14; border-radius: 0.8rem; padding: 1rem 0.6rem;
  }
  .gx-ctrl__keys { display: flex; flex-wrap: wrap; justify-content: center; }
  .gx-ctrl__label { font-size: 0.86rem; color: #b9b6c7; font-weight: 600; }

  /* Big-number spec tiles (stats, physics constants) */
  .gx-specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 0.7rem; margin: 1rem 0; }
  .gx-spec {
    background: #ffffff06; border: 1px solid #ffffff14; border-radius: 0.8rem; padding: 0.9rem 0.8rem; text-align: center;
  }
  .gx-spec__v {
    font-family: var(--font-display), sans-serif; font-size: 1.9rem; line-height: 1; font-weight: 800;
    background: linear-gradient(135deg, var(--accent, #e25bff), var(--gx-c));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .gx-spec__l { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: #8f8ca0; margin-top: 0.35rem; }

  /* Callout box (accent default, cyan variant) */
  .gx-callout {
    border-radius: 0.9rem; padding: 1.1rem 1.2rem; margin: 1.4rem 0;
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 40%, transparent);
    background: color-mix(in srgb, var(--accent, #e25bff) 8%, transparent);
  }
  .gx-callout--cyan { border-color: color-mix(in srgb, var(--gx-c) 40%, transparent); background: color-mix(in srgb, var(--gx-c) 8%, transparent); }
  .gx-callout__tag {
    font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent, #e25bff); font-weight: 700; margin: 0 0 0.5rem;
  }
  .gx-callout--cyan .gx-callout__tag { color: var(--gx-c); }
  .gx-callout p { margin: 0 0 0.6rem; color: #d3d0de; line-height: 1.55; }
  .gx-callout p:last-child { margin-bottom: 0; }
  .gx-mini { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 0.5rem; }
  .gx-mini li { color: #c5c2d2; line-height: 1.5; padding-left: 1.1rem; position: relative; font-size: 0.96rem; }
  .gx-mini li::before { content: "\25B8"; position: absolute; left: 0; color: var(--accent, #e25bff); }
  .gx-callout--cyan .gx-mini li::before { color: var(--gx-c); }
  .gx-mini strong { color: #f3f1f8; }

  /* Icon tip rows */
  .gx-tips { display: grid; gap: 0.6rem; }
  .gx-tip {
    display: flex; gap: 0.8rem; align-items: flex-start;
    background: #ffffff06; border: 1px solid #ffffff12; border-radius: 0.7rem; padding: 0.8rem 0.95rem;
    color: #c5c2d2; line-height: 1.5; font-size: 0.98rem;
  }
  .gx-tip__i { font-size: 1.15rem; flex: 0 0 auto; }
  .gx-tip strong { color: #f3f1f8; }

  /* Problem -> fix rows */
  .gx-fixes { display: grid; gap: 0.6rem; }
  .gx-fix {
    display: grid; grid-template-columns: minmax(8.5rem, 0.42fr) 1fr; gap: 0.9rem; align-items: center;
    background: #ffffff06; border: 1px solid #ffffff12; border-radius: 0.7rem; padding: 0.8rem 0.95rem;
  }
  .gx-fix__p { font-weight: 700; color: #ffcaca; font-size: 0.95rem; display: flex; align-items: center; gap: 0.4rem; }
  .gx-fix__p::before { content: "\2715"; color: #ff6b6b; font-weight: 900; }
  .gx-fix__f { color: #c5c2d2; line-height: 1.5; font-size: 0.95rem; }
  .gx-fix__f strong { color: #f3f1f8; }

  /* Closing note */
  .gx-outro {
    margin: 1.8rem 0 0; padding: 1.1rem 1.2rem; border-radius: 0.9rem;
    background: color-mix(in srgb, var(--accent, #e25bff) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent, #e25bff) 30%, transparent);
    color: #d3d0de; line-height: 1.6; font-size: 1rem;
  }
  .gx-outro strong { color: var(--accent, #e25bff); }

  @media (max-width: 480px) {
    .gx-fix { grid-template-columns: 1fr; gap: 0.35rem; }
    .gx-step { padding: 1rem; }
  }
</style>
